{
  "schema": "numi.research-study.v1",
  "id": "physically-qualified-imagination-ii",
  "title": "Physically Qualified Imagination at Scale",
  "status": "pilot_rejected",
  "branch": "numisolver",
  "evidence_scope": "Apple Silicon simulator evidence only; no hardware or sim-to-real claim",
  "research_question": "Can solver qualification turn compositional left, right, and bilateral hand-raising proposals into autonomous humanoid skills without degrading a fixed, previously qualified standing base after the generator is removed?",
  "pilot_decision": "Rejected before confirmatory execution: the inherited full-body actor was not stable under the current action contract and 64 updates increased held-out physical failure. No confirmatory learning claim is made.",
  "hypotheses": [
    "Solver-qualified imagination improves autonomous target-arm completion under a matched transition budget.",
    "Left-to-right symmetry and bilateral composition remain physically stable when initialized from the same qualified standing actor.",
    "The improvement persists with ARDY disconnected and does not regress support, tilt, termination, or failed-step outcomes."
  ],
  "learner_seeds": [2650443581, 2650443582, 2650443583, 2650443584, 2650443585],
  "evaluation_seed": 3650443581,
  "methods": [
    {
      "id": "matched_ppo",
      "description": "Native PPO initialized from the fixed standing actor with no generated teacher.",
      "teacher_disconnected_evaluation": false,
      "train_args": [
        "--fixed-learning-rate",
        "--learning-rate", "0.000002",
        "--minimum-learning-rate", "0.000002",
        "--maximum-learning-rate", "0.000002"
      ]
    },
    {
      "id": "qualified_imagination",
      "description": "A task-specific ARDY proposal executed by NumiSolver; valid realized transitions receive continuous distillation weight.",
      "teacher_disconnected_evaluation": true,
      "train_args": [
        "--interaction-student-authority", "0",
        "--imagination-distillation-coefficient", "10",
        "--fixed-learning-rate",
        "--learning-rate", "0.000002",
        "--minimum-learning-rate", "0.000002",
        "--maximum-learning-rate", "0.000002"
      ]
    }
  ],
  "tasks": [
