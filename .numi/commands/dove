#!/bin/sh
set -eu

# BirdFlowMetal owns the fluid and moving-surface solve.  This Numi capability
# exposes both the prescribed Deetjen evidence path and BirdFlow's separate,
# provenance-gated schema-2 D3Q19 flight ladder.  The latter never borrows
# mass properties from Deetjen or from the Numi hybrid.

if [ "${1:-}" = "--numi-describe" ]; then
    printf '%s\n' "Run BirdFlowMetal prescribed Deetjen replay or provenance-gated schema-2 D3Q19 dove flight."
    exit 0
fi

if [ "${1:-}" = "--help" ]; then
    cat <<'EOF'
usage: numi dove [replay] [--archive FILE] [--json]
       numi dove train [numi train options]
       numi dove evaluate [numi evaluate options]
       numi dove measured-audit --input DATASET.json [--chord-cells N] [--json]
       numi dove measured-trim --input DATASET.json [BirdFlow trim options]
       numi dove hover-control-sweep --input DATASET.json [BirdFlow hover options]
       numi dove measured-flight --input DATASET.json [BirdFlow flight options]
       numi dove measured-confirm --input DATASET.json [BirdFlow confirmation options]

`replay` builds and runs BirdFlowMetal's measured-surface Deetjen dove
through-flight replay. With no --archive, it writes a timestamped report below
.numi/runs/birdflow-deetjen-dove/ in this workspace.

`train` and `evaluate` run Numi's ground-takeoff, state-responsive articulated-wing dove. Two
policy actions modulate bilateral wingbeat amplitude while the robot owns the
hinge phase; a device-resident eight-station spanwise load pass reads resolved
motion, body state, and wind before the articulated ABA solve. Each station
contributes force and moment through the wing body, so the next physical state
depends on distributed wing load inside the regular rollback transaction.

The `measured-*` modes pass an explicit schema-2 specimen to BirdFlowMetal's
own D3Q19 implementation. `measured-trim` is an optional prescribed
force/moment diagnostic, not a release gate. `measured-flight` runs one coupled
six-DOF trajectory with momentum and per-part-load ledgers, and
`measured-confirm` runs an independent five-cycle forward-flight, 1/2/4
body-step, and coupled-closure ladder. Forward progress and speed are recorded
for control analysis rather than forced toward zero. These modes reject schema
1 inputs; they do not manufacture missing specimen data.

`hover-control-sweep` is for the explicitly virtual robot only: it screens a
declared power-stroke/recovery-stroke pitch actuator in still air with fixed
body D3Q19 runs. Its result is a kinematic feasibility map, not trim or free
flight evidence.

Environment:
  NUMI_BIRDFLOW_ROOT  BirdFlowMetal checkout (default: /Users/home/BirdFlowMetal)

`replay` is prescribed-motion CFD: its aerodynamic load does not control the
dove. The trainable robot is separately labelled hybrid because public Deetjen
inputs lack complete same-specimen mass and bilateral wing inertia, and it
uses authored aerodynamic closure coefficients. A schema-2 archive can be a
quantitative D3Q19 *numerical* flight result only within the provenance of its
input; it is a real-bird result only when its geometry, kinematics, and inertial
properties were actually measured from that same specimen. No mode is a
hardware claim.
EOF
    exit 0
fi

workspace=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
# This workspace owns the Dove native source and its verified Swift executables.
# The shared Numi dispatcher may otherwise select an older runtime-root build
# that predates `--birdflow-dove`, even though the workspace command advertises
# it. An explicit user override still wins.
if [ -z "${NUMI_BUILD_DIR:-}" ] && \
   [ -x "$workspace/build-dove-swift/bin/metalrobo_task_train" ] && \
   [ -x "$workspace/build-dove-swift/bin/metalrobo_task_rollout" ]; then
    export NUMI_BUILD_DIR="$workspace/build-dove-swift"
fi
mode=${1:-replay}
case "$mode" in
    train)
        shift
        # The recursive Numi capability must keep this workspace as its runtime
        # root too: training selection loads its Python adapter from there, and
        # that adapter projects the dove source flag into held-out rollouts.
        export NUMI_LAB_ROOT="$workspace"
        # The dove is an open-ended flight learner.  Retain matched rollouts
        # as diagnostics, but advance its latest candidate rather than using
        # them to block exploration.
        export NUMI_ADVANCE_CANDIDATE=1
        exec numi train --birdflow-dove \
            --initialize-policy birdflow_deetjen_dove_hybrid_policy "$@"
        ;;
    evaluate)
        shift
        export NUMI_LAB_ROOT="$workspace"
        exec numi evaluate --birdflow-dove "$@"
        ;;
    replay)
        if [ "$#" -gt 0 ]; then
            shift
        fi
        ;;
    measured-audit|measured-trim|hover-control-sweep|measured-flight|measured-confirm)
        shift
        ;;
    --archive|--json)
        ;;
    *)
        printf '%s\n' "numi dove: unknown mode '$mode'; use --help" >&2
        exit 2
        ;;
esac
birdflow_root=${NUMI_BIRDFLOW_ROOT:-/Users/home/BirdFlowMetal}
swift build -c release --product birdflow --package-path "$birdflow_root" >/dev/null
birdflow="$birdflow_root/.build/release/birdflow"

case "$mode" in
    replay|--archive|--json)
        manifest="$birdflow_root/ValidationInputs/deetjen-ob-f03-surface-v1/manifest.json"
        force_target="$birdflow_root/ValidationInputs/deetjen-ob-f03-force-v1.json"
        if [ ! -f "$manifest" ] || [ ! -f "$force_target" ]; then
            printf '%s\n' "BirdFlowMetal Deetjen inputs are unavailable under: $birdflow_root" >&2
            printf '%s\n' "Set NUMI_BIRDFLOW_ROOT to a checkout containing ValidationInputs/." >&2
            exit 1
        fi
        archive_supplied=false
        for argument in "$@"; do
            case "$argument" in
                --archive|--archive=*) archive_supplied=true ;;
            esac
        done
        if [ "$archive_supplied" = false ]; then
            output_dir="$workspace/.numi/runs/birdflow-deetjen-dove"
            mkdir -p "$output_dir"
            set -- --archive "$output_dir/deetjen-dove-through-flight-$(date -u +%Y%m%dT%H%M%SZ)-$$.json" "$@"
        fi
        printf '%s\n' "Numi dove: BirdFlowMetal prescribed Deetjen through-flight (not free flight)."
        exec "$birdflow" simulate deetjen-dove \
            --input "$manifest" \
            --force-target "$force_target" \
            "$@"
        ;;
    measured-audit|measured-trim|hover-control-sweep|measured-flight|measured-confirm)
        input_path=''
        archive_supplied=false
        expect_input=false
        for argument in "$@"; do
            if [ "$expect_input" = true ]; then
                input_path=$argument
                expect_input=false
                continue
            fi
            case "$argument" in
                --input) expect_input=true ;;
                --input=*) input_path=${argument#--input=} ;;
                --archive|--archive=*) archive_supplied=true ;;
            esac
        done
        if [ "$expect_input" = true ] || [ -z "$input_path" ]; then
            printf '%s\n' "numi dove $mode: --input DATASET.json is required" >&2
            exit 2
        fi
        if [ ! -f "$input_path" ]; then
            printf '%s\n' "numi dove $mode: input does not exist: $input_path" >&2
            exit 2
        fi
        if [ "$archive_supplied" = false ] && [ "$mode" != measured-audit ] && [ "$mode" != hover-control-sweep ]; then
            output_dir="$workspace/.numi/runs/birdflow-$mode"
            mkdir -p "$output_dir"
            set -- --archive "$output_dir/$(basename "$input_path" .json)-$(date -u +%Y%m%dT%H%M%SZ)-$$" "$@"
        fi
        case "$mode" in
            measured-audit)
                printf '%s\n' "Numi dove: BirdFlowMetal schema audit (no Metal allocation)."
                exec "$birdflow" replay measured-bird --audit-only "$@"
                ;;
            measured-trim)
                printf '%s\n' "Numi dove: BirdFlowMetal optional schema-2 force/moment diagnostic."
                exec "$birdflow" replay measured-bird --trim-search "$@"
                ;;
            hover-control-sweep)
                printf '%s\n' "Numi dove: BirdFlowMetal virtual hover-control D3Q19 screening."
                exec "$birdflow" replay measured-bird --hover-control-sweep "$@"
                ;;
            measured-flight)
                printf '%s\n' "Numi dove: BirdFlowMetal schema-2 coupled D3Q19 free-flight trajectory."
                exec "$birdflow" replay measured-bird \
                    --free-flight --momentum-ledger --part-loads "$@"
                ;;
            measured-confirm)
                printf '%s\n' "Numi dove: BirdFlowMetal schema-2 forward-flight numerical confirmation."
                exec "$birdflow" replay measured-bird \
                    --free-flight-confirmation "$@"
                ;;
        esac
        ;;
esac
