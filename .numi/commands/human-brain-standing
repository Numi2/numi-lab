#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "--numi-describe" ]]; then
    printf '%s\n' 'Run source-pinned native Human standing with NumiBrain receptor and muscle participation. Defaults to a four-step smoke run; set NUMI_HUMAN_BRAIN_STEPS=10000 for the 10-second quiet-stance gate. The run records accepted sensor and muscle audits plus accepted body-motion and COM/support records.'
    exit 0
fi

if (( $# > 1 )); then
    printf 'usage: %s [new-output-directory]\n' "$0" >&2
    exit 2
fi

command_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
repository_root=$(CDPATH= cd -- "$command_directory/../.." && pwd -P)
human_repository=${NUMI_HUMAN_BRAIN_HUMAN_REPOSITORY:-${NUMI_HUMAN_SOURCE_ROOT:-"$HOME/numilab-human"}}
expected_human_revision=${NUMI_HUMAN_BRAIN_HUMAN_REVISION:-f9d50d0ecaa3394f19f056aa0f28eb52a4e2770e}
actual_human_revision=$(git -C "$human_repository" rev-parse HEAD 2>/dev/null || printf unavailable)
if [[ "$actual_human_revision" != "$expected_human_revision" ]]; then
    printf 'Human source revision mismatch: expected %s, found %s\n' "$expected_human_revision" "$actual_human_revision" >&2
    exit 1
fi
if ! human_status=$(git -C "$human_repository" status --porcelain 2>/dev/null); then
    printf 'Cannot inspect Human source worktree: %s\n' "$human_repository" >&2
    exit 1
fi
if [[ -n "$human_status" ]]; then
    printf 'Human source worktree is dirty: %s\n' "$human_repository" >&2
    exit 1
fi
brain_repository=${NUMI_HUMAN_BRAIN_REPOSITORY:-${NUMI_BRAIN_ROOT:-"$HOME/numi-brain"}}
expected_brain_revision=${NUMI_HUMAN_BRAIN_REVISION:-0f7f1e4dcb29c885eddb8ca2a673f26dba537004}
actual_brain_revision=$(git -C "$brain_repository" rev-parse HEAD 2>/dev/null || printf unavailable)
if [[ "$actual_brain_revision" != "$expected_brain_revision" ]]; then
    printf 'NumiBrain source revision mismatch: expected %s, found %s\n' "$expected_brain_revision" "$actual_brain_revision" >&2
    exit 1
fi
if ! brain_status=$(git -C "$brain_repository" status --porcelain 2>/dev/null); then
    printf 'Cannot inspect NumiBrain source worktree: %s\n' "$brain_repository" >&2
    exit 1
fi
if [[ -n "$brain_status" ]]; then
    printf 'NumiBrain source worktree is dirty: %s\n' "$brain_repository" >&2
    exit 1
fi
build_directory=${NUMI_HUMAN_BRAIN_BUILD_DIR:-"$repository_root/build"}
binary=${NUMI_HUMAN_BRAIN_BINARY:-"$build_directory/bin/metalrobo_numilab_human_myosim_visual_probe"}
lab_library="$build_directory/lib/libmetalrobo.dylib"
source_directory=${NUMI_HUMAN_BRAIN_SOURCE_DIR:-"$human_repository/Docs/media/native-runtime-source-package-20260915/input"}
brain_library=${NUMI_HUMAN_BRAIN_DYLIB:-}
if [[ -z "$brain_library" ]]; then
    for directory in "$brain_repository/.build/arm64-apple-macosx/release" \
                     "$brain_repository/.build/release" \
                     "$brain_repository/.build/out/Products/Release"; do
        if [[ -f "$directory/libNumiBrainHumanStanding.dylib" ]]; then
            brain_library="$directory/libNumiBrainHumanStanding.dylib"
            break
        fi
    done
fi
brain_resource_bundle="$(dirname -- "$brain_library")/NumiBrain_NumiBrainMetal.bundle"
rigid_source="$source_directory/myosim-fullbody-core-reference.nhrigid"
muscle_source="$source_directory/myosim-fullbody-muscle-reference.nhmyo"
contact_source="$source_directory/myosim-fullbody-support-contact.nhcnt"
equality_source="$source_directory/myosim-fullbody-joint-equalities.nheq"
tendon_source="$source_directory/numi-human-tendon-attachments.nhtendon"
bone_source=${NUMI_HUMAN_BRAIN_BONES:-"$HOME/human-completion-20260907/input/bodyparts3d-myosim-major-bones.nhbones"}
muscle_surface_source=${NUMI_HUMAN_BRAIN_MUSCLE_SURFACES:-}
seed=${NUMI_HUMAN_BRAIN_SEED:-1314213193}
steps=${NUMI_HUMAN_BRAIN_STEPS:-4}
if [[ ! "$steps" =~ ^[1-9][0-9]*$ ]] || (( ${#steps} > 5 )) || (( steps > 10000 )); then
    printf 'NUMI_HUMAN_BRAIN_STEPS must be from 1 through 10000: %s\n' "$steps" >&2
    exit 2
fi
sensor_audit=${NUMI_HUMAN_BRAIN_SENSOR_AUDIT:-1}
motor_audit_interval=${NUMI_HUMAN_BRAIN_MOTOR_AUDIT_INTERVAL:-1}
geometry_overlap=${NUMI_HUMAN_OVERLAP_GEOMETRY:-1}
stand_backend=${NUMI_HUMAN_BRAIN_STAND_BACKEND:-gpu-stand}
if [[ -n "${NUMI_HUMAN_BRAIN_STAND_BACKEND:-}" &&
      "$stand_backend" != gpu-stand && "$stand_backend" != cpu-one-handoff ]]; then
    printf 'NUMI_HUMAN_BRAIN_STAND_BACKEND must be gpu-stand or cpu-one-handoff: %s\n' "$stand_backend" >&2
    exit 2
fi
if [[ -z "${NUMI_HUMAN_BRAIN_STAND_BACKEND:-}" &&
      "${NUMI_HUMAN_STAND_CPU_FINISH:-0}" == 1 ]]; then
    # Preserve existing experimental CPU invocations without changing their
    # flags, and label the source-bound manifest truthfully.
    stand_backend=external-cpu-finish
    if [[ "${NUMI_HUMAN_STAND_CPU_ONE_HANDOFF:-0}" == 1 ]]; then
        stand_backend=external-cpu-one-handoff
    fi
fi
if [[ "$stand_backend" == gpu-stand &&
      "${NUMI_HUMAN_STAND_CPU_FINISH:-0}" == 1 ]]; then
    printf 'gpu-stand conflicts with inherited CPU finish flags\n' >&2
    exit 2
fi
if [[ "$geometry_overlap" != 0 && "$geometry_overlap" != 1 ]]; then
    printf 'NUMI_HUMAN_OVERLAP_GEOMETRY must be 0 or 1: %s\n' "$geometry_overlap" >&2
    exit 2
fi
if [[ "$sensor_audit" != 0 && "$sensor_audit" != 1 ]]; then
    printf 'NUMI_HUMAN_BRAIN_SENSOR_AUDIT must be 0 or 1: %s\n' "$sensor_audit" >&2
    exit 2
fi
if [[ ! "$motor_audit_interval" =~ ^(0|[1-9][0-9]*)$ ]] ||
   (( ${#motor_audit_interval} > 4 )) ||
   (( motor_audit_interval > 1000 )) ||
   { (( motor_audit_interval > 0 )) && [[ "$sensor_audit" != 1 ]]; }; then
    printf 'NUMI_HUMAN_BRAIN_MOTOR_AUDIT_INTERVAL must be 0..1000 and requires sensor audit: %s\n' "$motor_audit_interval" >&2
    exit 2
fi
mechanics_only=${NUMI_HUMAN_BRAIN_MECHANICS_ONLY:-0}
if [[ "$mechanics_only" != 0 && "$mechanics_only" != 1 ]]; then
    printf 'NUMI_HUMAN_BRAIN_MECHANICS_ONLY must be 0 or 1: %s\n' "$mechanics_only" >&2
    exit 2
fi

require_file() {
    if [[ ! -f "$1" ]]; then
        printf 'required Human Brain input is missing: %s\n' "$1" >&2
        exit 1
    fi
}

require_file "$binary"
require_file "$lab_library"
require_file "$brain_library"
if [[ ! -d "$brain_resource_bundle" ]]; then
    printf 'required Brain Metal resource bundle is missing: %s\n' "$brain_resource_bundle" >&2
    exit 1
fi
for brain_shader in MemoryState DecisionState; do
    if [[ ! -f "$brain_resource_bundle/$brain_shader.metal" &&
          ! -f "$brain_resource_bundle/Shaders/$brain_shader.metal" ]]; then
        printf 'required Brain Metal shader is missing: %s\n' "$brain_shader" >&2
        exit 1
    fi
done
require_file "$rigid_source"
require_file "$muscle_source"
require_file "$contact_source"
require_file "$equality_source"
require_file "$tendon_source"
require_file "$bone_source"
if [[ -n "$muscle_surface_source" ]]; then
    require_file "$muscle_surface_source"
fi
if [[ "${NUMI_HUMAN_BRAIN_DISABLE_STATIC_CACHE:-0}" != 0 &&
      "${NUMI_HUMAN_BRAIN_DISABLE_STATIC_CACHE:-0}" != 1 ]]; then
    printf 'NUMI_HUMAN_BRAIN_DISABLE_STATIC_CACHE must be 0 or 1\n' >&2
    exit 2
fi
if { [[ -n "${NUMI_HUMAN_STATIC_EQUILIBRIUM_CACHE_PATH:-}" ]] &&
     [[ -z "${NUMI_HUMAN_STATIC_EQUILIBRIUM_CACHE_KEY:-}" ]]; } ||
   { [[ -z "${NUMI_HUMAN_STATIC_EQUILIBRIUM_CACHE_PATH:-}" ]] &&
     [[ -n "${NUMI_HUMAN_STATIC_EQUILIBRIUM_CACHE_KEY:-}" ]]; }; then
    printf 'static Human cache needs both path and key\n' >&2
    exit 2
fi
if [[ "${NUMI_HUMAN_BRAIN_DISABLE_STATIC_CACHE:-0}" == 1 &&
      -n "${NUMI_HUMAN_STATIC_EQUILIBRIUM_CACHE_PATH:-}" ]]; then
    printf 'static Human cache cannot be both disabled and explicitly selected\n' >&2
    exit 2
fi

if (( $# == 1 )); then
    output_directory=$1
    if [[ -e "$output_directory" ]]; then
        printf 'refusing to reuse existing output directory: %s\n' "$output_directory" >&2
        exit 1
    fi
    mkdir -p "$(dirname -- "$output_directory")"
    mkdir "$output_directory"
else
    run_root=${NUMI_HUMAN_BRAIN_RUN_ROOT:-"$HOME/NumiHumanBrainRuns"}
    mkdir -p "$run_root"
    output_directory=$(mktemp -d "$run_root/native-standing.XXXXXX")
fi

arguments=(
    "$rigid_source"
    "$muscle_source"
    "$bone_source"
    "$output_directory"
    --persistent-metal-stand
    --muscle-step-seconds 0.001
    --muscle-step-count "$steps"
    --persistent-source-passive-joint-tissue
    --stand-contact-iterations 64
    --support-contact-payload "$contact_source"
    --joint-equality-payload "$equality_source"
    --tendon-payload "$tendon_source"
    --dimension 512
    --support-stance-dof 2 0.02
    --support-stance-dof 108 0.1
    --support-stance-dof 109 0.1
    --support-stance-dof 110 0.1
    --support-stance-dof 122 0.1
    --support-stance-dof 123 0.1
    --support-stance-dof 124 0.1
    --support-stance-contact 2
    --support-stance-contact 3
    --support-stance-contact 4
    --support-stance-contact 5
    --support-stance-contact 6
    --support-stance-contact 7
    --stand-brain-library "$brain_library"
    --stand-brain-seed "$seed"
)
if [[ -n "$muscle_surface_source" ]]; then
    arguments+=(--soft-tissue-payload "$muscle_surface_source")
fi
if [[ -n "${NUMI_HUMAN_BRAIN_PROGRAM:-}" ]]; then
    require_file "$NUMI_HUMAN_BRAIN_PROGRAM"
    if [[ -z "${NUMI_HUMAN_BRAIN_JOINT_PATH_CALIBRATION:-}" ]]; then
        NUMI_HUMAN_BRAIN_JOINT_PATH_CALIBRATION=$(python3 -c '
import json, sys
with open(sys.argv[1], encoding="utf-8") as source:
    program = json.load(source)
print("1" if program.get("jointPathFeedback") is not None else "0")
' "$NUMI_HUMAN_BRAIN_PROGRAM")
        export NUMI_HUMAN_BRAIN_JOINT_PATH_CALIBRATION
    fi
    arguments+=(--stand-brain-program "$NUMI_HUMAN_BRAIN_PROGRAM")
fi
# A generated source needs its prepared joint paths to select the existing
# frozen v4 feedback controller. An explicit v1-v3 program retains its inferred
# source mode; setting the flag to zero remains the tonic ablation.
NUMI_HUMAN_BRAIN_JOINT_PATH_CALIBRATION=${NUMI_HUMAN_BRAIN_JOINT_PATH_CALIBRATION:-1}
if [[ "$NUMI_HUMAN_BRAIN_JOINT_PATH_CALIBRATION" != 0 &&
      "$NUMI_HUMAN_BRAIN_JOINT_PATH_CALIBRATION" != 1 ]]; then
    printf 'NUMI_HUMAN_BRAIN_JOINT_PATH_CALIBRATION must be 0 or 1\n' >&2
    exit 2
fi
export NUMI_HUMAN_BRAIN_JOINT_PATH_CALIBRATION
export NUMI_HUMAN_BRAIN_PROGRAM_EXPORT="$output_directory/numi-brain/prepared-brain-program.json"
if [[ "$mechanics_only" == 1 ]]; then
    arguments+=(--mechanics-only)
fi
if [[ -n "${NUMI_HUMAN_BRAIN_PUSH_START_STEP:-}" ]]; then
    for name in NUMI_HUMAN_BRAIN_PUSH_DURATION_STEPS NUMI_HUMAN_BRAIN_PUSH_FORCE_X_N NUMI_HUMAN_BRAIN_PUSH_FORCE_Y_N NUMI_HUMAN_BRAIN_PUSH_FORCE_Z_N; do
        if [[ -z "${!name:-}" ]]; then
            printf 'timed Human Brain push requires %s\n' "$name" >&2
            exit 2
        fi
    done
    arguments+=(--stand-push "$NUMI_HUMAN_BRAIN_PUSH_START_STEP"
        "$NUMI_HUMAN_BRAIN_PUSH_DURATION_STEPS"
        "$NUMI_HUMAN_BRAIN_PUSH_FORCE_X_N"
        "$NUMI_HUMAN_BRAIN_PUSH_FORCE_Y_N"
        "$NUMI_HUMAN_BRAIN_PUSH_FORCE_Z_N")
fi

{
    printf 'output_directory=%s\nhuman_source_revision=%s\nbrain_source_revision=%s\n' "$output_directory" "$actual_human_revision" "$actual_brain_revision"
    printf 'native_timestep_microseconds=1000\nbrain_epoch_microseconds=1000\nrequested_physical_steps=%s\nseed=%s\n' "$steps" "$seed"
    printf 'accepted_sensor_audit=%s\n' "$sensor_audit"
    printf 'accepted_motor_audit_interval=%s\n' "$motor_audit_interval"
    printf 'accepted_com_momentum_audit=1\naccepted_body_motion_audit=1\naccepted_body_motion_cadence_steps=1\n'
    printf 'mechanics_only=%s\n' "$mechanics_only"
    printf 'binary '; shasum -a 256 "$binary"
    printf 'lab_library '; shasum -a 256 "$lab_library"
    printf 'brain_library '; shasum -a 256 "$brain_library"
    while IFS= read -r resource_file; do
        printf 'brain_resource '; shasum -a 256 "$resource_file"
    done < <(find "$brain_resource_bundle" -type f -print | sort)
    while IFS= read -r metallib; do
        printf 'metal_library '; shasum -a 256 "$metallib"
    done < <(find "$build_directory" -type f -name '*.metallib' -print | sort)
    printf 'rigid_source '; shasum -a 256 "$rigid_source"
    printf 'muscle_source '; shasum -a 256 "$muscle_source"
    printf 'support_contact_source '; shasum -a 256 "$contact_source"
    printf 'joint_equality_source '; shasum -a 256 "$equality_source"
    printf 'tendon_source '; shasum -a 256 "$tendon_source"
    printf 'bodyparts3d_bone_source '; shasum -a 256 "$bone_source"
    if [[ -n "$muscle_surface_source" ]]; then
        printf 'bodyparts3d_muscle_surface_source '; shasum -a 256 "$muscle_surface_source"
    fi
    printf 'launcher '; shasum -a 256 "$repository_root/.numi/commands/human-brain-standing"
    if [[ -n "${NUMI_HUMAN_BRAIN_PROGRAM:-}" ]]; then
        printf 'locomotor_program '; shasum -a 256 "$NUMI_HUMAN_BRAIN_PROGRAM"
    fi
    for source_file in \
        CMakeLists.txt \
        apps/numilab_human_myosim_visual_probe.mm \
        apps/NumiHumanBrainController.hpp \
        apps/NumiHumanBrainReceptors.hpp \
        apps/NumiHumanBrainSource.hpp \
        include/metalrobo/MetalArticulatedOperator.hpp \
        include/metalrobo/NumiBrainHumanStandingABI.h \
        src/metal/MetalArticulatedOperator.mm; do
        printf 'lab_source_file=%s ' "$source_file"
        shasum -a 256 "$repository_root/$source_file"
    done
    source_revision=${NUMI_HUMAN_BRAIN_SOURCE_REVISION:-}
    if [[ -z "$source_revision" && -f "$build_directory/NUMI_LAB_SOURCE_REVISION" ]]; then
        source_revision=$(<"$build_directory/NUMI_LAB_SOURCE_REVISION")
    fi
    if [[ -z "$source_revision" ]]; then
        source_revision=$(git -C "$repository_root" rev-parse HEAD 2>/dev/null || printf 'unavailable')
    fi
    printf 'lab_source_revision=%s\n' "$source_revision"
    printf 'geometry_overlap=%s\n' "$geometry_overlap"
    printf 'stand_solver_backend=%s\n' "$stand_backend"
    printf 'joint_path_calibration=%s\n' "${NUMI_HUMAN_BRAIN_JOINT_PATH_CALIBRATION:-0}"
    printf 'command='
    printf '%q ' "$binary" "${arguments[@]}"
    printf '\n'
} > "$output_directory/launch.manifest"

# Keep the exact inputs that this receipt hashes. One content-addressed copy
# serves every cohort member, and APFS clones avoid duplicating physical bytes.
# A later rebuild may replace a build path but cannot replace this run's owner.
artifact_root=${NUMI_HUMAN_BRAIN_ARTIFACT_STORE:-"$(dirname -- "$output_directory")/.native-artifact-store"}
mkdir -p "$artifact_root"
if (( steps >= 1000 )); then
    available_kib=$(df -k "$artifact_root" | tail -n 1 | awk '{print $4}')
    if (( available_kib < 10 * 1024 * 1024 )); then
        printf 'Human Brain long run needs at least 10 GiB free for audits and retained inputs\n' >&2
        exit 1
    fi
fi
while IFS= read -r manifest_input; do
    read -r kind digest original <<< "$manifest_input"
    case "$kind" in
        binary|lab_library|brain_library|brain_resource|metal_library|rigid_source|muscle_source|support_contact_source|joint_equality_source|tendon_source|bodyparts3d_bone_source|bodyparts3d_muscle_surface_source|launcher|locomotor_program|lab_source_file=*) ;;
        *) continue ;;
    esac
    retained="$artifact_root/$digest"
    if [[ ! -f "$retained" ]]; then
        temporary=$(mktemp -d "$artifact_root/.copy.XXXXXXXX")
        if ! cp -c -p "$original" "$temporary/artifact"; then
            cp -p "$original" "$temporary/artifact"
        fi
        actual=$(shasum -a 256 "$temporary/artifact" | awk '{print $1}')
        if [[ "$actual" != "$digest" ]]; then
            printf 'retained Human Brain input changed during capture: %s\n' "$original" >&2
            exit 1
        fi
        ln "$temporary/artifact" "$retained" 2>/dev/null || true
        rm -r "$temporary"
    fi
    actual=$(shasum -a 256 "$retained" | awk '{print $1}')
    if [[ "$actual" != "$digest" ]]; then
        printf 'retained Human Brain input hash mismatch: %s\n' "$retained" >&2
        exit 1
    fi
    printf 'retained_artifact %s %s\n' "$digest" "$retained" >> "$output_directory/launch.manifest"
done < <(sed -n '/^binary /,/^command=/p' "$output_directory/launch.manifest")

# Static standing equilibrium is independent of the Brain seed and episode
# length. Bind its cache to the exact native physics executable, input packs,
# shader libraries, and fixed standing options recorded above. This lets
# repeated independent minds reuse initialization without sharing brain state.
if [[ -n "${NUMI_HUMAN_STATIC_EQUILIBRIUM_CACHE_PATH:-}" ||
      -n "${NUMI_HUMAN_STATIC_EQUILIBRIUM_CACHE_KEY:-}" ]]; then
    printf 'static_cache_mode=external\nstatic_cache_key=%s\nstatic_cache_path=%s\n' \
        "$NUMI_HUMAN_STATIC_EQUILIBRIUM_CACHE_KEY" \
        "$NUMI_HUMAN_STATIC_EQUILIBRIUM_CACHE_PATH" >> "$output_directory/launch.manifest"
elif [[ "${NUMI_HUMAN_BRAIN_DISABLE_STATIC_CACHE:-0}" == 1 ]]; then
    printf 'static_cache_mode=disabled\n' >> "$output_directory/launch.manifest"
else
    cache_root=${NUMI_HUMAN_BRAIN_STATIC_CACHE_DIR:-"${NUMI_HUMAN_BRAIN_RUN_ROOT:-$HOME/NumiHumanBrainRuns}/.static-equilibrium-cache"}
    cache_key=$({
        printf '%s\n' 'numi.human.static-equilibrium-cache.v1'
        printf '%s\n' 'timestep=0.001' 'activation=default' \
            'source-passive-joint-tissue=1' 'stand-contact-iterations=64' \
            'support-stance-dof=2:0.02,108:0.1,109:0.1,110:0.1,122:0.1,123:0.1,124:0.1' \
            'support-stance-contact=2,3,4,5,6,7'
        awk '/^(binary |lab_library |metal_library |rigid_source |muscle_source |support_contact_source |joint_equality_source |tendon_source |bodyparts3d_bone_source |bodyparts3d_muscle_surface_source |launcher |lab_source_file=)/ { print }' \
            "$output_directory/launch.manifest"
    } | shasum -a 256 | awk '{ print $1 }')
    mkdir -p "$cache_root"
    export NUMI_HUMAN_STATIC_EQUILIBRIUM_CACHE_KEY=$cache_key
    export NUMI_HUMAN_STATIC_EQUILIBRIUM_CACHE_PATH="$cache_root/$cache_key.bin"
    printf 'static_cache_mode=source_bound\nstatic_cache_key=%s\nstatic_cache_path=%s\n' \
        "$cache_key" "$NUMI_HUMAN_STATIC_EQUILIBRIUM_CACHE_PATH" >> "$output_directory/launch.manifest"
fi

printf 'numi_human_brain_run_directory=%s\n' "$output_directory"
export NUMI_HUMAN_BRAIN_SENSOR_AUDIT="$sensor_audit"
export NUMI_HUMAN_BRAIN_MOTOR_AUDIT_INTERVAL="$motor_audit_interval"
export NUMI_HUMAN_ACCEPTED_COM_MOMENTUM_AUDIT=1
export NUMI_HUMAN_ACCEPTED_BODY_MOTION_AUDIT=1
export NUMI_HUMAN_ACCEPTED_COM_MOMENTUM_AUDIT_SEGMENT_STEPS=1
export NUMI_HUMAN_EXECUTION_STAGES=${NUMI_HUMAN_EXECUTION_STAGES:-1}
export NUMI_HUMAN_OVERLAP_GEOMETRY="$geometry_overlap"
if [[ "$stand_backend" == cpu-one-handoff ]]; then
    # The native operator admits this path only for its exact single-Human,
    # unassisted source shape. The CPU factor and ordered finish are one
    # continuation of the same accepted Brain/physics transaction.
    export NUMI_HUMAN_SPLIT_STAND=1
    export NUMI_HUMAN_PARALLEL_MASS_ASSEMBLY=1
    export NUMI_HUMAN_STAND_FREE_SPLIT=1
    export NUMI_HUMAN_STAND_FREE_HANDOFF_PROBE=1
    export NUMI_HUMAN_STAND_CPU_FINISH=1
    export NUMI_HUMAN_STAND_CPU_FACTOR=1
    export NUMI_HUMAN_STAND_CPU_EQUALITY=1
    export NUMI_HUMAN_STAND_CPU_EQUALITY_FACTOR=1
    export NUMI_HUMAN_STAND_CPU_PROJECTED_RAW=1
    export NUMI_HUMAN_STAND_CPU_FREE=1
    export NUMI_HUMAN_STAND_CPU_ONE_HANDOFF=1
    export NUMI_HUMAN_STAND_CPU_CONDITION_NEON=1
    export NUMI_HUMAN_STAND_CPU_ACCELERATE_FACTOR=1
fi
# macOS strips inherited DYLD variables while launching the bash shebang.
# Bind the Lab dylib beside the selected binary inside this launcher so an
# isolated build cannot silently execute the previous build's GPU runtime.
export DYLD_LIBRARY_PATH="$build_directory/lib${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"
set +e
"$binary" "${arguments[@]}" 2>&1 | tee "$output_directory/launch.log"
pipeline_status=("${PIPESTATUS[@]}")
set -e
launcher_status=${pipeline_status[0]}
if (( pipeline_status[1] != 0 )); then
    launcher_status=${pipeline_status[1]}
fi
if (( launcher_status == 0 )); then
    # Retain the exact source and program admitted by the native participant.
    # This also binds generated baselines for transition extraction and replay.
    for generated_kind in prepared_brain_source locomotor_program; do
        generated="$output_directory/numi-brain/prepared-brain-source.json"
        if [[ "$generated_kind" == locomotor_program ]]; then
            generated="$NUMI_HUMAN_BRAIN_PROGRAM_EXPORT"
        fi
        require_file "$generated"
        digest=$(shasum -a 256 "$generated" | awk '{print $1}')
        retained="$artifact_root/$digest"
        if [[ ! -f "$retained" ]]; then
            temporary=$(mktemp -d "$artifact_root/.copy.XXXXXXXX")
            if ! cp -c -p "$generated" "$temporary/artifact"; then
                cp -p "$generated" "$temporary/artifact"
            fi
            ln "$temporary/artifact" "$retained" 2>/dev/null || true
            rm -r "$temporary"
        fi
        if [[ "$(shasum -a 256 "$retained" | awk '{print $1}')" != "$digest" ]]; then
            printf 'generated Human Brain artifact hash mismatch: %s\n' "$generated" >&2
            exit 1
        fi
        printf '%s %s %s\nretained_artifact %s %s\n' \
            "$generated_kind" "$digest" "$generated" "$digest" "$retained" >> "$output_directory/launch.manifest"
    done
fi
{
