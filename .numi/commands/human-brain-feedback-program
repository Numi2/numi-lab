#!/usr/bin/env python3
"""Author one v1 muscle feedback program from an actual prepared Human run."""

import hashlib
import json
import math
import re
import sys
from pathlib import Path


def valid_support_source(source: dict) -> bool:
    if source.get("version") == 1:
        return "supportEndpoints" not in source
    if source.get("version") != 2:
        return False
    endpoints = source.get("supportEndpoints")
    if not isinstance(endpoints, list) or len(endpoints) != 10:
        return False
    identities = set()
    receptors = set()
    for endpoint in endpoints:
        if not isinstance(endpoint, dict):
            return False
        values = [endpoint.get(key) for key in (
            "sourceEndpointIdentifier", "bodyIdentifier",
            "sourceGeometryIndex", "touchReceptorIndex")]
        if any(type(value) is not int for value in values):
            return False
        identifier, body, geometry, receptor = values
        if (not 0 <= body < 157 or not 0 <= geometry < 0xffffffff
                or not 0 <= receptor < 10
                or identifier != ((body << 32) | geometry)
                or identifier == 0):
            return False
        identities.add((body, geometry))
        receptors.add(receptor)
    return len(identities) == 10 and receptors == set(range(10))


def main() -> int:
    if len(sys.argv) != 5:
        print(
            "usage: human-brain-feedback-program RUN_DIR LENGTH_GAIN "
            "VELOCITY_GAIN_SECONDS OUTPUT.json",
            file=sys.stderr,
        )
        return 2
    run = Path(sys.argv[1])
    destination = Path(sys.argv[4])
    if destination.exists():
        raise ValueError("refusing to replace an existing feedback program")
    length_gain = float(sys.argv[2])
    velocity_gain = float(sys.argv[3])
    if not (math.isfinite(length_gain) and 0 <= length_gain <= 10
            and math.isfinite(velocity_gain) and 0 <= velocity_gain <= 1):
        raise ValueError("feedback gains are outside the Brain v1 finite bounds")

    source_path = run / "prepared-brain-source.json"
    if not source_path.is_file():
        source_path = run / "numi-brain" / "prepared-brain-source.json"
    source_bytes = source_path.read_bytes()
    source = json.loads(source_bytes)
    binding = next(
        (line for line in (run / "launch.log").read_text().splitlines()
         if line.startswith("human_brain_native_binding=configured ")),
        None,
    )
    if binding is None:
        raise ValueError("run has no native Brain source binding")
    def field(name: str) -> int:
        match = re.search(rf"(?:^| ){re.escape(name)}=([0-9]+)(?: |$)", binding)
        if match is None:
            raise ValueError(f"native Brain binding lacks {name}")
        return int(match.group(1))

    if (not valid_support_source(source) or source.get("bodyCount") != 157
            or len(source.get("channels", [])) != 416
            or source.get("modelSourceFingerprint") != field("model_source_fingerprint")):
        raise ValueError("prepared source does not match the accepted Human Brain binding")
    channels = []
    for index, row in enumerate(source["channels"]):
        if row.get("muscleIdentifier") != index:
            raise ValueError("prepared muscle channel order is invalid")
        reference = float(row["referenceLengthMeters"])
        tonic = float(row["tonicExcitation"])
        if not (math.isfinite(reference) and reference > 0
                and math.isfinite(tonic) and 0 <= tonic <= 1):
            raise ValueError("prepared muscle reference or tonic drive is invalid")
        channels.append({
            "muscleIdentifier": index,
            "referenceLengthMeters": reference,
            "tonicExcitation": tonic,
            "lengthGain": length_gain,
            "velocityGainSeconds": velocity_gain,
            "gaitSine": 0.0,
            "gaitCosine": 0.0,
            "maximumExcitation": 1.0,
        })
    program = {
        "version": 1,
        "modelSourceFingerprint": field("model_source_fingerprint"),
        "sensoryProfileFingerprint": field("sensory_profile_fingerprint"),
        "calibrationArtifactSHA256": hashlib.sha256(source_bytes).hexdigest(),
        "epochMicroseconds": field("epoch_microseconds"),
        "periodMicroseconds": 0,
        "channels": channels,
    }
    destination.parent.mkdir(parents=True, exist_ok=True)
    destination.write_text(json.dumps(program, separators=(",", ":")) + "\n")
    print(f"human_brain_feedback_program={destination}")
    print(f"source_sha256={program['calibrationArtifactSHA256']}")
    print(f"length_gain={length_gain} velocity_gain_seconds={velocity_gain}")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, KeyError, json.JSONDecodeError) as error:
        print(f"human-brain-feedback-program: {error}", file=sys.stderr)
        raise SystemExit(1)
