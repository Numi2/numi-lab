+bool MetalHybridObjectTracker::researchCheckpointHost(TrackerHostCheckpoint& out) const {
+    if (!state_ || !state_->compiled || !state_->renderer ||
+        state_->researchCadence || state_->researchAcceptedMetadata || state_->researchCandidateMetadata)
+        return false;
+    auto& renderer = *state_->renderer->state_;
+    const std::lock_guard lock(renderer.mutex);
+    out.metadata = renderer.activeMetadata;
+    out.activeEnvironmentCount = renderer.activeEnvironmentCount;
+    out.uniforms = state_->maskedDepthRenderUniforms;
+    out.observationSequence = state_->observationSequence;
+    out.lastSensorSequence = state_->lastSensorSequence;
+    out.allowMixedOnce = state_->researchAllowMixedOnce;
+    return true;
+}
+
+void MetalHybridObjectTracker::researchRestoreHost(const TrackerHostCheckpoint& saved) noexcept {
+    if (!state_ || !state_->renderer) return;
+    try {
+        auto& renderer = *state_->renderer->state_;
+        const std::lock_guard lock(renderer.mutex);
+        renderer.activeMetadata = saved.metadata;
+        renderer.activeEnvironmentCount = saved.activeEnvironmentCount;
+        state_->maskedDepthRenderUniforms = saved.uniforms;
+        state_->observationSequence = saved.observationSequence;
+        state_->lastSensorSequence = saved.lastSensorSequence;
+        state_->researchAllowMixedOnce = saved.allowMixedOnce;
+    } catch (...) {}
+}
+
 bool MetalHybridObjectTracker::researchDirectWinnerEnabled() const { return state_ && state_->directWinnerMaskedDepth; }
 
