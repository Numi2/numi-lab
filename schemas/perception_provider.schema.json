{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metalrobo.dev/schemas/perception_provider.schema.json",
  "title": "MetalRobo PerceptionProviderV1 descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "content_hash",
    "input_modalities",
    "capabilities",
    "temporal_window",
    "accepts_device_buffers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "content_hash": {
      "type": "string",
      "minLength": 1
    },
    "input_modalities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "linear_rgb",
          "metric_depth",
          "depth_validity"
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "dense_depth",
          "semantic",
          "instance",
          "tracking",
          "object_pose",
          "keypoint",
          "dense_feature",
          "embedding"
        ]
      }
    },
    "temporal_window": {
      "type": "integer",
      "minimum": 1
    },
    "accepts_device_buffers": {
      "type": "boolean"
    },
    "coordinate_frames": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "pixel",
          "camera",
          "robot_base",
          "world",
          "object"
        ]
      }
    }
  }
}
