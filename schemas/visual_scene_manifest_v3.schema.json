{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metalrobo.dev/schemas/visual_scene_manifest_v3.schema.json",
  "title": "MetalRobo VisualSceneManifestV3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "coordinate_convention",
    "world_fingerprint",
    "fingerprint",
    "visual_pack_hashes",
    "environment_map_hash",
    "light_rig_hash",
    "preprocessing_provenance",
    "render_scene"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "coordinate_convention": {
      "const": "x-forward,y-left,z-up"
    },
    "world_fingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "fingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "visual_pack_hashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "environment_map_hash": {
      "type": "string",
      "minLength": 1
    },
    "light_rig_hash": {
      "type": "string",
      "minLength": 1
    },
    "preprocessing_provenance": {
      "type": "string",
      "minLength": 1
    },
    "render_scene": {
      "$ref": "#/$defs/render_scene"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "fingerprint": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "render_scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "asset_count",
        "body_count",
        "gaussian_count",
        "visual_pack_count",
        "sensor_binding_count",
        "light_count",
        "environment_id",
        "light_rig_id",
        "fingerprint"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "asset_count": {
          "type": "integer",
          "minimum": 1
        },
        "body_count": {
          "$ref": "#/$defs/count"
        },
        "gaussian_count": {
          "$ref": "#/$defs/count"
        },
        "visual_pack_count": {
          "type": "integer",
          "minimum": 1
        },
        "sensor_binding_count": {
          "$ref": "#/$defs/count"
        },
        "light_count": {
          "type": "integer",
          "minimum": 1
        },
        "environment_id": {
          "$ref": "#/$defs/id"
        },
        "light_rig_id": {
          "$ref": "#/$defs/id"
        },
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        }
      }
    }
  }
}
