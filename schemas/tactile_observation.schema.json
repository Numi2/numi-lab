{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metalrobo.dev/schemas/tactile_observation.schema.json",
  "title": "MetalRobo metric tactile observation contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "abi_version",
    "fingerprint",
    "primary_representation",
    "depth_unit",
    "velocity_unit",
    "force_unit",
    "torque_unit",
    "layout",
    "sensors",
    "dense_channels",
    "summary_channels",
    "wrench_source",
    "center_of_pressure_definition",
    "simulation_translator_required",
    "real_sensor_input"
  ],
  "properties": {
    "schema": {
      "const": "metalrobo.tactile_observation"
    },
    "abi_version": {
      "const": 1
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{16}$"
    },
    "primary_representation": {
      "const": "metric_normal_penetration"
    },
    "depth_unit": {
      "const": "m"
    },
    "velocity_unit": {
      "const": "m/s"
    },
    "force_unit": {
      "const": "N"
    },
    "torque_unit": {
      "const": "N*m"
    },
    "layout": {
      "const": "environment_sensor_row_major"
    },
    "sensors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sensor"
      }
    },
    "dense_channels": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "const": "penetration_depth_m"
        },
        {
          "const": "validity_bits"
        },
        {
          "const": "object_shape_id"
        },
        {
          "const": "depth_velocity_m_per_s"
        }
      ],
      "items": false
    },
    "summary_channels": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "prefixItems": [
        {
          "const": "sensor_pose"
        },
        {
          "const": "timestamp_s"
        },
        {
          "const": "net_force_n"
        },
        {
          "const": "net_torque_nm"
        },
        {
          "const": "center_of_pressure_sensor_m"
        },
        {
          "const": "center_of_pressure_force_weight_n"
        },
        {
          "const": "geometric_contact_centroid_m"
        },
        {
          "const": "contact_area_m2"
        },
        {
          "const": "maximum_depth_m"
        },
        {
          "const": "mean_depth_m"
        }
      ],
      "items": false
    },
    "wrench_source": {
      "const": "physics_solver_impulse_over_explicit_interval"
    },
    "center_of_pressure_definition": {
      "const": "solver_force_magnitude_weighted_contact_position"
    },
    "simulation_translator_required": {
      "const": false
    },
    "real_sensor_input": {
      "const": "camera_to_metric_depth_translator"
    }
  },
  "$defs": {
    "sensor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "width",
        "height",
        "surface_kind",
        "maximum_depth_m",
        "active_threshold_m",
        "shell_thickness_m",
        "update_period_steps",
        "parent_body",
        "backing_shape"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "surface_kind": {
          "enum": [
            0,
            1,
            2
          ]
        },
        "maximum_depth_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "active_threshold_m": {
          "type": "number",
          "minimum": 0
        },
        "shell_thickness_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "update_period_steps": {
          "type": "integer",
          "minimum": 1
        },
        "parent_body": {
          "type": "integer",
          "minimum": 0
        },
        "backing_shape": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
