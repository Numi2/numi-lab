{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metalrobo.dev/schemas/visual_scene_manifest.schema.json",
  "title": "MetalRobo VisualSceneManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "coordinate_convention",
    "world_fingerprint",
    "fingerprint",
    "body_count",
    "assets",
    "render_scene"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "coordinate_convention": {
      "const": "x-forward,y-left,z-up"
    },
    "world_fingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "fingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "body_count": {
      "type": "integer",
      "minimum": 1
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "render_scene": {
      "$ref": "#/$defs/render_scene"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "fingerprint": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "pattern": "^(0x)?[A-Fa-f0-9]{1,16}$"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^(sha256:)?[A-Fa-f0-9]{64}$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "semantic_class",
        "representation",
        "binding",
        "source_uri",
        "content_hash",
        "license",
        "preprocessing_provenance",
        "semantic_id",
        "instance_id",
        "body_indices",
        "shape_indices"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "semantic_class": {
          "$ref": "#/$defs/id"
        },
        "representation": {
          "enum": [
            "triangle_mesh",
            "gaussian_field",
            "procedural"
          ]
        },
        "binding": {
          "enum": [
            "world",
            "asset",
            "rigid_body",
            "articulated_link"
          ]
        },
        "source_uri": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "preprocessing_provenance": {
          "type": "string",
          "minLength": 1
        },
        "semantic_id": {
          "type": "integer",
          "minimum": 1
        },
        "instance_id": {
          "type": "integer",
          "minimum": 1
        },
        "body_indices": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "shape_indices": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "preprocessing": {
          "type": "object"
        }
      }
    },
    "render_scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gaussian_count",
        "mesh_vertex_count",
        "mesh_triangle_count",
        "material_count",
        "sensor_binding_count",
        "content_hash"
      ],
      "properties": {
        "gaussian_count": {
          "type": "integer",
          "minimum": 0
        },
        "mesh_vertex_count": {
          "type": "integer",
          "minimum": 0
        },
        "mesh_triangle_count": {
          "type": "integer",
          "minimum": 0
        },
        "material_count": {
          "type": "integer",
          "minimum": 0
        },
        "sensor_binding_count": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
