{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://numi.dev/schemas/pointworld_forecast.schema.json",
  "title": "PointFlowForecastPack",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "provider", "model_pack_fingerprint", "observation_fingerprint", "candidate_fingerprint", "candidate_count", "prediction_frames", "scene_point_count", "domains", "provider_timings_ms", "stage_fingerprints", "sha256"],
  "properties": {
    "format": {"const": "numi.pointworld-forecast.v1"},
    "provider": {"type": "string", "minLength": 1},
    "model_pack_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observation_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_count": {"type": "integer", "minimum": 1},
    "prediction_frames": {"const": 10},
    "scene_point_count": {"type": "integer", "minimum": 1, "maximum": 12000},
    "domains": {"type": "array", "minItems": 1, "items": {"enum": ["droid", "behavior"]}},
    "provider_timings_ms": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
    "stage_fingerprints": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
