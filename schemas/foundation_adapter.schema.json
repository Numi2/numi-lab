{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://numi-lab.dev/schemas/foundation_adapter.schema.json",
  "title": "Numi Lab foundation adapter",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "provider", "robot", "observation", "action_outputs", "controller", "interaction"],
  "properties": {
    "format": { "const": "numi.foundation-adapter.v1" },
    "id": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "robot": { "type": "string", "minLength": 1 },
    "observation": {
      "type": "object",
      "required": ["root_archive_key", "root_q_offset", "root_q_count", "joint_q_offset", "state_groups"],
      "properties": {
        "root_archive_key": { "type": "string", "minLength": 1 },
        "root_q_offset": { "type": "integer", "minimum": 0 },
        "root_q_count": { "const": 7 },
        "root_frame": { "const": "center_of_mass" },
        "root_center_of_mass_local_xyz": {
          "type": "array",
          "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
          "minItems": 3,
          "maxItems": 3
        },
        "joint_q_offset": { "type": "integer", "minimum": 0 },
        "state_groups": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/stateGroup" }
        }
      }
    },
    "action_outputs": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/namedJoints" }
    },
    "controller": {
      "type": "object",
      "required": ["joint_order", "default_pose", "task_action_scale", "velocity_limits", "position_limits", "policy_timestep_seconds"],
      "properties": {
        "joint_order": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "default_pose": { "$ref": "#/$defs/numberArray" },
        "task_action_scale": { "$ref": "#/$defs/positiveArray" },
        "velocity_limits": { "$ref": "#/$defs/positiveArray" },
        "position_limits": {
          "type": "array", "minItems": 1,
          "items": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "minItems": 2, "maxItems": 2 }
        },
        "policy_timestep_seconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "interaction": {
      "type": "object",
      "required": ["contact_tracks"],
      "properties": {
        "contact_tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "task_contact_group", "counterpart", "mode", "confidence"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "task_contact_group": { "type": "string", "minLength": 1 },
              "counterpart": { "type": "string", "minLength": 1 },
              "mode": { "type": "integer", "minimum": 0, "maximum": 5 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    },
    "unmapped_output_semantics": { "type": "object", "additionalProperties": { "type": "string" } },
    "native_contract": {
      "type": "object",
      "properties": {
        "library_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "contract_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  },
  "$defs": {
    "namedJoints": {
      "type": "object", "required": ["name", "joints"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "joints": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "stateGroup": {
      "allOf": [
        { "$ref": "#/$defs/namedJoints" },
        { "type": "object", "required": ["placeholder_count"], "properties": { "placeholder_count": { "type": "integer", "minimum": 0 } } }
      ]
    },
    "numberArray": { "type": "array", "minItems": 1, "items": { "type": "number" } },
    "positiveArray": { "type": "array", "minItems": 1, "items": { "type": "number", "exclusiveMinimum": 0 } }
  }
}
