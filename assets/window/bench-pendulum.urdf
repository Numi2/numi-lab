<?xml version="1.0"?>
<robot name="Bench Pendulum">
  <material name="stand"><color rgba="0.12 0.27 0.37 1"/></material>
  <material name="arm"><color rgba="0.92 0.39 0.07 1"/></material>
  <material name="pivot"><color rgba="0.62 0.72 0.76 1"/></material>
  <link name="bench">
    <inertial>
      <mass value="5"/>
      <inertia ixx="0.13" ixy="0" ixz="0" iyy="0.12" iyz="0" izz="0.09"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.025"/><geometry><box size="0.30 0.44 0.05"/></geometry>
      <material name="stand"/>
    </visual>
    <visual>
      <origin xyz="0 -0.15 0.34"/><geometry><box size="0.07 0.07 0.66"/></geometry>
      <material name="stand"/>
    </visual>
    <visual>
      <origin xyz="0 0.15 0.34"/><geometry><box size="0.07 0.07 0.66"/></geometry>
      <material name="stand"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.65" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.028" length="0.40"/></geometry>
      <material name="pivot"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025"/><geometry><box size="0.30 0.44 0.05"/></geometry>
    </collision>
  </link>
  <link name="pendulum">
    <inertial>
      <origin xyz="0 0 -0.26"/><mass value="1"/>
      <inertia ixx="0.021" ixy="0" ixz="0" iyy="0.021" iyz="0" izz="0.003"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.23"/><geometry><box size="0.038 0.055 0.46"/></geometry>
      <material name="arm"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.46"/><geometry><sphere radius="0.066"/></geometry>
      <material name="arm"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.23"/><geometry><box size="0.038 0.055 0.46"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 -0.46"/><geometry><sphere radius="0.066"/></geometry>
    </collision>
  </link>
  <joint name="pivot" type="revolute">
    <parent link="bench"/><child link="pendulum"/>
    <origin xyz="0 0 0.65"/><axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="2.6" effort="12" velocity="20"/>
    <dynamics damping="0.08" friction="0"/>
  </joint>
</robot>
