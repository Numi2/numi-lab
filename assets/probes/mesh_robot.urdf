<robot name="mesh_robot">
  <link name="mesh_base">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0"
               iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <collision>
      <geometry>
        <mesh filename="mesh_package/meshes/convex_cube.obj"
              scale="2 4 6"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 4"/>
      <geometry>
        <mesh filename="package://mesh_package/meshes/convex_cube.obj"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 -2"/>
      <geometry>
        <mesh filename="mesh_package/meshes/convex_tetra.stl"/>
      </geometry>
    </collision>
  </link>
</robot>
