#usda 1.0
(
    defaultPrim = "Scene"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Scene"
{
    def Material "dove_wing_material"
    {
        token outputs:surface.connect = </Scene/dove_wing_material/Shader.outputs:surface>
        def Shader "Shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.58, 0.61, 0.67)
            color3f inputs:emissiveColor = (0.319, 0.3355, 0.36850000000000005)
            float inputs:opacity = 1.0
            float inputs:roughness = 0.72
            token outputs:surface
        }
    }
    def Mesh "dove_wing_mesh"
    {
        uniform token subdivisionScheme = "none"
        uniform bool doubleSided = true
        rel material:binding = </Scene/dove_wing_material>
        point3f[] points = [
            (-0.12, -0.12, -0.8),
            (0.12, -0.12, -0.8),
            (0.12, 0.12, -0.8),
            (-0.12, 0.12, -0.8),
            (-0.12, -0.12, 0.8),
            (0.12, -0.12, 0.8),
            (0.12, 0.12, 0.8),
            (-0.12, 0.12, 0.8),
        ]
        int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
        int[] faceVertexIndices = [0, 1, 2, 0, 2, 3, 4, 7, 6, 4, 6, 5, 0, 4, 5, 0, 5, 1, 1, 5, 6, 1, 6, 2, 2, 6, 7, 2, 7, 3, 3, 7, 4, 3, 4, 0]
    }
}
