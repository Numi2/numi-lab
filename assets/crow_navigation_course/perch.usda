#usda 1.0
(
    defaultPrim = "Scene"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Scene"
{
    def Material "wall_material"
    {
        token outputs:surface.connect = </Scene/wall_material/Shader.outputs:surface>
        def Shader "Shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.78, 0.8, 0.84)
            color3f inputs:emissiveColor = (0.42900000000000005, 0.44000000000000006, 0.462)
            float inputs:opacity = 1.0
            float inputs:roughness = 0.72
            token outputs:surface
        }
    }
    def Mesh "wall_mesh"
    {
        uniform token subdivisionScheme = "none"
        uniform bool doubleSided = true
        rel material:binding = </Scene/wall_material>
        point3f[] points = [
            (-0.1, -0.72, -0.055),
            (0.1, -0.72, -0.055),
            (0.1, 0.72, -0.055),
            (-0.1, 0.72, -0.055),
            (-0.1, -0.72, 0.055),
            (0.1, -0.72, 0.055),
            (0.1, 0.72, 0.055),
            (-0.1, 0.72, 0.055),
        ]
        int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
        int[] faceVertexIndices = [0, 1, 2, 0, 2, 3, 4, 7, 6, 4, 6, 5, 0, 4, 5, 0, 5, 1, 1, 5, 6, 1, 6, 2, 2, 6, 7, 2, 7, 3, 3, 7, 4, 3, 4, 0]
    }
}
