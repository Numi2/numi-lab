+                isinstance(rv_delta, list) and len(rv_delta) == 3 and
+                isinstance(lv_delta, list) and len(lv_delta) == 3 and
+                all(isinstance(v, (int, float)) and np.isfinite(v) for v in rv + lv + rv_delta + lv_delta),
