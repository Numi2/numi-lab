+struct alignas(16) LegacyNMFEMNodeStateGPUv45 {
+    mr_float4 positionAndMass;
+    mr_float4 velocityAndInverseMass;
+    mr_float4 restAndFixed;
+    mr_float4 deltaVelocity;
+    mr_float4 referenceDisplacementAndMode;
