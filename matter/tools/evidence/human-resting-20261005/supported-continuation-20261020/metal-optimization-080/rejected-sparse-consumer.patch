+struct PartitionedReductionCoefficientIndexMap {
+    std::vector<std::uint32_t> nodeModeValueIndices;
+    std::vector<std::uint32_t> regionModeSupportOffsets;
+    std::vector<std::uint32_t> regionModeSupportValueIndices;
+    std::string error;
+    [[nodiscard]] bool valid() const noexcept { return error.empty(); }
+};
+
+[[nodiscard]] inline PartitionedReductionCoefficientIndexMap
+buildPartitionedReductionDenseCoefficientIndexMap(
+    const std::span<const nm_float4> denseBasis,
+    const std::uint32_t basisNodeCount,
+    const std::uint32_t modeCount,
+    const std::span<const std::uint32_t> blockModeIndices,
+    const std::uint32_t regionCount,
+    const std::uint32_t blockModeCount,
+    const PartitionedReductionSparseSupport& support
+) {
+    PartitionedReductionCoefficientIndexMap out;
+    const auto fail = [&](const char* message) {
+        out.error = message;
+        out.nodeModeValueIndices.clear();
+        out.regionModeSupportOffsets.clear();
+        out.regionModeSupportValueIndices.clear();
+        return out;
+    };
+    if (!support.valid() || basisNodeCount == 0u || modeCount == 0u ||
+        regionCount == 0u || blockModeCount == 0u ||
+        denseBasis.size() != static_cast<std::size_t>(basisNodeCount) * modeCount ||
+        blockModeIndices.size() != static_cast<std::size_t>(regionCount) * blockModeCount ||
+        support.regionSupportRanges.size() != regionCount ||
+        support.nodeModeRanges.size() != basisNodeCount)
+        return fail("dense support coefficient-map inputs have inconsistent dimensions");
+    out.regionModeSupportOffsets.assign(
+        static_cast<std::size_t>(regionCount) * blockModeCount + 1u, 0u);
+    for (std::uint32_t region = 0u; region < regionCount; ++region) {
+        const auto range = support.regionSupportRanges[region];
+        if (static_cast<std::uint64_t>(range.first) + range.count >
+            support.regionSupportRows.size())
+            return fail("dense support coefficient-map region range escapes its rows");
+        for (std::uint32_t local = 0u; local < blockModeCount; ++local) {
+            const std::uint32_t packed = region * blockModeCount + local;
+            const std::uint32_t mode = blockModeIndices[packed];
+            if (mode >= modeCount)
+                return fail("dense support coefficient-map mode is out of range");
+            if (out.regionModeSupportValueIndices.size() >
+                std::numeric_limits<std::uint32_t>::max())
+                return fail("dense support coefficient-map exceeds uint32 addressing");
+            out.regionModeSupportOffsets[packed] =
+                static_cast<std::uint32_t>(out.regionModeSupportValueIndices.size());
+            for (std::uint32_t i = 0u; i < range.count; ++i) {
+                const std::uint32_t row = support.regionSupportRows[range.first + i];
+                if (row >= basisNodeCount)
+                    return fail("dense support coefficient-map row is out of range");
+                const std::uint64_t index =
+                    static_cast<std::uint64_t>(mode) * basisNodeCount + row;
+                if (index >= denseBasis.size())
+                    return fail("dense support coefficient-map index escapes basis");
+                out.regionModeSupportValueIndices.push_back(
+                    static_cast<std::uint32_t>(index));
+            }
+        }
+    }
+    out.regionModeSupportOffsets.back() = static_cast<std::uint32_t>(
+        out.regionModeSupportValueIndices.size());
+    out.nodeModeValueIndices.reserve(support.nodeModeSlots.size());
+    for (std::uint32_t row = 0u; row < basisNodeCount; ++row) {
+        const auto rowRange = support.nodeModeRanges[row];
+        if (static_cast<std::uint64_t>(rowRange.first) + rowRange.count >
+            support.nodeModeSlots.size())
+            return fail("dense node-mode range escapes support slot list");
+        for (std::uint32_t j = 0u; j < rowRange.count; ++j) {
+            const std::uint32_t packed = support.nodeModeSlots[rowRange.first + j];
+            const std::uint32_t region = packed / blockModeCount;
+            const std::uint32_t local = packed - region * blockModeCount;
+            if (region >= regionCount || local >= blockModeCount)
+                return fail("dense node-mode slot is outside its block map");
+            const auto regionRange = support.regionSupportRanges[region];
+            const auto begin = support.regionSupportRows.begin() + regionRange.first;
+            const auto end = begin + regionRange.count;
+            const auto found = std::lower_bound(begin, end, row);
+            if (found == end || *found != row)
+                return fail("dense node-mode row is missing from regional support");
+            const std::uint64_t mapIndex =
+                static_cast<std::uint64_t>(out.regionModeSupportOffsets[packed]) +
+                static_cast<std::uint64_t>(found - begin);
+            if (mapIndex >= out.regionModeSupportValueIndices.size())
+                return fail("dense node-mode map index escapes support index list");
+            out.nodeModeValueIndices.push_back(
+                out.regionModeSupportValueIndices[mapIndex]);
+        }
+    }
+    return out;
+}
+
