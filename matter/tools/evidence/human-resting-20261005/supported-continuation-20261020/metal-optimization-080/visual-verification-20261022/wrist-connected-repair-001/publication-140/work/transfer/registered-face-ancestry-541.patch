+        error="registered face ancestry CSR arrays or parent face count are incomplete";return false;
+    }
+    for(std::size_t face=0;face<surface.faces.size();++face){
+        const auto begin=offsets[face],end=offsets[face+1u];
+        if(begin>=end||end>rows.size()){
+            error="registered face ancestry CSR has an empty or out-of-range face row="+std::to_string(face);return false;
+        }
+        for(std::uint32_t entry=begin;entry<end;++entry)
