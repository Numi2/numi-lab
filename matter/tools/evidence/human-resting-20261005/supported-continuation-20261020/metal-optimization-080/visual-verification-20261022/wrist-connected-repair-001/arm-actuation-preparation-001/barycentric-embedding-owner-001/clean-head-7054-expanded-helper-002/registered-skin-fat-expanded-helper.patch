+            layer.outerLocal[i]=add(surface.donorLocalPoints[i],transform(m,sub(outer[i],surface.worldPoints[i])));
+            layer.innerLocal[i]=add(surface.donorLocalPoints[i],transform(m,sub(inner[i],surface.worldPoints[i])));
