+        for(const auto& face:surface.faces){auto f=face;std::sort(f.begin(),f.end());auto a=f[0],b=f[1],d=f[2];
+            layer.volumeM3+=std::abs(tetVolume(outer[a],outer[b],outer[d],inner[d]))+
