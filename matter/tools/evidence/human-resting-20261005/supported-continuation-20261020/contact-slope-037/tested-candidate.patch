+// Derivative of the current IPC potential along the Newton path, before
+// endpoint rounding. The actual rounded endpoints still own CCD and energy
+// acceptance. A rounded alpha=1 chord is not this path's derivative.
+inline float contactBarrierDirectionalDerivative(
+    const NMDeformableContactGPU contact,
+    const float3 displacement[6],
+    const float dt
+) {
+    float impulseDotDisplacement = 0.0f;
+    for (uint local = 0u; local < 6u; ++local) {
+        const uint supportNode = deformableContactNode(contact, local);
+        if (supportNode == NM_INVALID_INDEX) continue;
+        const float3 barrierImpulse =
+            deformableContactWeight(contact, local) * contact.barrier.x *
+                contact.normalAndTOI.xyz -
+            contact.mollifier.y * deformableMollifierGradient(contact, local);
+        impulseDotDisplacement += dot(barrierImpulse, displacement[local]);
+    }
+    return -impulseDotDisplacement / max(dt, 1.0e-20f);
+}
