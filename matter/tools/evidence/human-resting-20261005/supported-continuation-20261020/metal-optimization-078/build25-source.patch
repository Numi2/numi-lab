+    device const NMFGMRESStateGPU* states [[buffer(1)]],
+    device const NMMatterStatusGPU* statuses [[buffer(2)]],
+    constant uint& prefixCommandCount [[buffer(3)]],
+    constant uint& tailCommandCount [[buffer(4)]],
+    device uint2* ranges [[buffer(5)]],
+    uint global [[thread_position_in_grid]]
+) {
+    if (global != 0u) return;
+    bool active = dispatch.environmentCount == 1u &&
+        environmentHealthy(statuses, 0u) &&
+        states[0].diagnostics.z <= 0.5f;
+    ranges[0] = uint2(0u, active ? prefixCommandCount : 0u);
+    ranges[1] = uint2(0u, active ? tailCommandCount : 0u);
+}
