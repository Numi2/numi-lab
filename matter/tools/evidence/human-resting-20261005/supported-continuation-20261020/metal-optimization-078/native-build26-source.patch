+kernel void nm_partitioned_reduction_hybrid_copy_modes(
+    constant NMPartitionedReductionBlockDispatchGPU& dispatch [[buffer(0)]],
+    device const nm_float4* source [[buffer(1)]],
+    device nm_float4* destination [[buffer(2)]],
+    uint gid [[thread_position_in_grid]]
+) {
+    const ulong total = ulong(dispatch.environmentCount) * dispatch.globalNodeCount;
+    if (gid >= total) return;
+    const uint environment = gid / dispatch.globalNodeCount;
+    const uint node = gid - environment * dispatch.globalNodeCount;
+    const ulong totalNodes = ulong(dispatch.environmentCount) * dispatch.globalNodeCount;
+    const ulong field = totalNodes + gid;
+    destination[field] = node < dispatch.modeCount
+        ? source[field] : nm_float4(0.0f);
+}
+
+kernel void nm_partitioned_reduction_hybrid_validate_rows(
+    constant NMPartitionedReductionBlockDispatchGPU& dispatch [[buffer(0)]],
+    device const uint* globalNodeIndices [[buffer(1)]],
+    device const NMPartitionedReductionSparseRangeGPU* nodeModeRanges [[buffer(2)]],
+    device const NMFEMNodeStateGPU* candidateNodes [[buffer(3)]],
+    device NMMatterStatusGPU* statuses [[buffer(4)]],
+    constant uint& objectIndex [[buffer(5)]],
+    uint gid [[thread_position_in_grid]]
+) {
+    const ulong total = ulong(dispatch.environmentCount) * dispatch.basisNodeCount;
+    if (gid >= total) return;
+    const uint environment = gid / dispatch.basisNodeCount;
+    const uint row = gid - environment * dispatch.basisNodeCount;
+    if (nodeModeRanges[row].count == 0u) return;
+    const uint globalNode = globalNodeIndices[row];
+    if (globalNode >= dispatch.globalNodeCount) {
+        recordFailure(statuses[environment], NM_STATUS_INVALID_DISPATCH,
+            objectIndex, globalNode,
+            float4(float(row), float(globalNode),
+                   float(dispatch.globalNodeCount), 0.0f));
+        return;
+    }
+    const float fixed = candidateNodes[
+        environment * dispatch.globalNodeCount + globalNode]
+        .restAndFixed.w;
+    if (!isfinite(fixed) || fixed != 0.0f)
+        recordFailure(statuses[environment], NM_STATUS_INVALID_DISPATCH,
+            objectIndex, globalNode,
+            float4(float(row), fixed, 0.0f, 0.0f));
+}
+
+kernel void nm_partitioned_reduction_hybrid_clear_inactive_field(
+    constant NMPartitionedReductionBlockDispatchGPU& dispatch [[buffer(0)]],
+    device nm_float4* vector [[buffer(1)]],
+    uint gid [[thread_position_in_grid]]
+) {
+    const ulong total = ulong(dispatch.environmentCount) * dispatch.globalNodeCount;
+    if (gid >= total) return;
+    const ulong fieldBase =
+        ulong(dispatch.environmentCount) * dispatch.globalNodeCount + gid;
+    vector[fieldBase] = nm_float4(0.0f);
+}
+
+kernel void nm_partitioned_reduction_hybrid_zero_selected(
+    constant NMPartitionedReductionBlockDispatchGPU& dispatch [[buffer(0)]],
+    device const uint* globalNodeIndices [[buffer(1)]],
+    device const NMPartitionedReductionSparseRangeGPU* nodeModeRanges [[buffer(2)]],
+    device nm_float4* vector [[buffer(3)]],
+    uint gid [[thread_position_in_grid]]
+) {
+    const ulong total = ulong(dispatch.environmentCount) * dispatch.basisNodeCount;
+    if (gid >= total) return;
+    const uint environment = gid / dispatch.basisNodeCount;
+    const uint row = gid - environment * dispatch.basisNodeCount;
+    if (nodeModeRanges[row].count == 0u) return;
+    const uint node = globalNodeIndices[row];
+    if (node >= dispatch.globalNodeCount) return;
+    const ulong offset = ulong(environment) * dispatch.globalNodeCount + node;
+    const nm_float4 value = vector[offset];
+    vector[offset] = nm_float4(0.0f, 0.0f, 0.0f, value.w);
+}
+
+kernel void nm_partitioned_reduction_hybrid_pack_modes(
+    constant NMPartitionedReductionBlockDispatchGPU& dispatch [[buffer(0)]],
+    device const float* projectedRHS [[buffer(1)]],
+    device nm_float4* vector [[buffer(2)]],
+    uint gid [[thread_position_in_grid]]
+) {
+    const ulong total = ulong(dispatch.environmentCount) * dispatch.globalNodeCount;
+    if (gid >= total) return;
+    const uint environment = gid / dispatch.globalNodeCount;
+    const uint node = gid - environment * dispatch.globalNodeCount;
+    const ulong totalNodes = ulong(dispatch.environmentCount) * dispatch.globalNodeCount;
+    const ulong field = totalNodes + gid;
+    const float value = node < dispatch.modeCount
+        ? projectedRHS[ulong(environment) * dispatch.modeCount + node] : 0.0f;
+    vector[field] = nm_float4(value, 0.0f, 0.0f, 0.0f);
+}
+
