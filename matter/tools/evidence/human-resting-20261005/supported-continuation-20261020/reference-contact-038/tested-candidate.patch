+// Return a reference-mode FEM point in a caller-chosen pair-local frame.
+// The caller must have verified referenceDisplacementAndMode.w == 1.0f.
+// Keeping rest-origin subtraction compensated retains local edge detail
+// before the final FP32 projection.
+inline float3 femContactPositionRelativeTo(
+    const NMFEMNodeStateGPU state,
+    const float3 referenceOrigin
+) {
+    const MRCompensatedScalar x = mrCompensatedPositionScalar(
+        state.restAndFixed.x, state.referenceDisplacementAndMode.x,
+        0.0f, -referenceOrigin.x);
+    const MRCompensatedScalar y = mrCompensatedPositionScalar(
+        state.restAndFixed.y, state.referenceDisplacementAndMode.y,
+        0.0f, -referenceOrigin.y);
+    const MRCompensatedScalar z = mrCompensatedPositionScalar(
+        state.restAndFixed.z, state.referenceDisplacementAndMode.z,
+        0.0f, -referenceOrigin.z);
+    return float3(
+        mrCompensatedProjectionScalar(0.0f, x.high, x.low),
+        mrCompensatedProjectionScalar(0.0f, y.high, y.low),
+        mrCompensatedProjectionScalar(0.0f, z.high, z.low));
+}
