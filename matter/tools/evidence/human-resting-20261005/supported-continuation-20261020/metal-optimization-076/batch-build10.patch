+kernel void nm_fem_test_compensated_local_factor(
+    device const float2* matrices [[buffer(0)]],
+    device const float2* rightHandSides [[buffer(1)]],
+    device float2* factoredSolutions [[buffer(2)]],
+    device float2* legacySolutions [[buffer(3)]],
+    device float* localResiduals [[buffer(4)]],
+    device uint* resultMasks [[buffer(5)]],
