+// Opt-in Eisenstat-Walker forcing preparation. The partials are the full
+// production FGMRES RHS norm contributions, with the same row masks as the
+// begin measurement; this deliberately does not use the narrower Armijo norm.
+// History layout per environment: x = previous accepted base norm,
+// y = current staged base norm, z = previous norm valid, w = current staged.
+kernel void nm_fgmres_prepare_inexact_newton_forcing(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    constant NMMixedSolverGPU& solver [[buffer(1)]],
+    constant uint& restartCycle [[buffer(14)]],
+    constant float& legacyForcing [[buffer(15)]],
+    constant uint& nonlinearIteration [[buffer(16)]],
+    device const float4* partials [[buffer(24)]],
+    device float4* history [[buffer(25)]],
+    device float* eta [[buffer(26)]],
+    constant NMFGMRESLayoutGPU& layout [[buffer(30)]],
+    uint lane [[thread_index_in_threadgroup]],
+    uint group [[threadgroup_position_in_grid]]
+) {
+    if (group >= dispatch.environmentCount || lane >= 32u ||
+        restartCycle != 0u) return;
+    const uint environment = group;
+    const uint tiles = fgmresMeasurementTileCount(
+        fgmresBeginMeasurementItemCount(dispatch, layout));
+    float norm2Local = 0.0f;
+    float norm2Correction = 0.0f;
+    bool localSupportAdmissible = true;
+    for (uint tile = lane; tile < tiles; tile += 32u) {
+        const float4 partial = partials[environment * tiles + tile];
+        fgmresCompensatedAdd(norm2Local, norm2Correction, partial.x);
+        localSupportAdmissible = localSupportAdmissible && partial.z > 0.5f;
+    }
+    const float norm2 = simd_sum(norm2Local);
+    const bool supportAdmissible = simd_all(localSupportAdmissible);
+    if (lane != 0u) return;
+
+    device float4& state = history[environment];
+    if (nonlinearIteration == 0u) state = float4(0.0f);
+    const float norm = sqrt(max(norm2, 0.0f));
+    const bool currentValid = isfinite(norm2) && norm2 >= 0.0f &&
+        isfinite(norm) && supportAdmissible;
