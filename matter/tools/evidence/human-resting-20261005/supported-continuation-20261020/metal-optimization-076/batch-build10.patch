+    MRCompensatedScalar factor[16u*16u];
+    MRCompensatedScalar legacyMatrix[16u*16u];
+    unsigned pivots[16u];
+    for (uint i=0u;i<count*count;++i) {
+        const float2 value=matrices[matrixBase+i];
+        original[i]={value.x,value.y};
+        factor[i]=original[i];
