+// Commit EW history only for a real accepted Newton update. A rejected line
+// search or unhealthy environment invalidates the ratio and falls back to the
+// legacy schedule next time. An already-converged/no-column solve and a
+// no-op environment with no due FEM object do not advance the history.
+kernel void nm_fgmres_commit_inexact_newton_history(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    device const NMContinuumObjectGPU* objects [[buffer(1)]],
+    device const NMSchedulerStateGPU* schedulers [[buffer(2)]],
+    device const NMAdaptiveStateGPU* adaptive [[buffer(3)]],
+    constant NMMicrostepGPU& microstep [[buffer(4)]],
+    device const float4* objectLineSearch [[buffer(5)]],
+    device const float* environmentLineSearch [[buffer(6)]],
+    device const NMMatterStatusGPU* statuses [[buffer(7)]],
+    device const NMFGMRESStateGPU* fgmresStates [[buffer(8)]],
+    device float4* history [[buffer(9)]],
+    uint group [[threadgroup_position_in_grid]],
+    uint lane [[thread_index_in_threadgroup]]
+) {
+    if (group >= dispatch.environmentCount || lane != 0u) return;
+    const uint environment = group;
+    device float4& state = history[environment];
+    if (!environmentHealthy(statuses, environment)) {
+        state.z = 0.0f;
+        state.w = 0.0f;
+        return;
+    }
+    if (state.w <= 0.5f) return;
+    // begin_finish carries the outer nonlinear-convergence latch across
+    // restart tails. Do not advance on a base that was already complete.
+    if (fgmresStates[environment].nonlinear.w > 0.5f) {
+        state.w = 0.0f;
+        return;
+    }
+
+    const float sharedAlpha = environmentLineSearch[environment];
+    if (!isfinite(sharedAlpha) || sharedAlpha <= 0.0f) {
+        state.z = 0.0f;
+        state.w = 0.0f;
+        return;
+    }
+    bool hasDueFEM = false;
+    bool accepted = true;
+    for (uint objectIndex = 0u; objectIndex < dispatch.objectCount;
+         ++objectIndex) {
+        const NMContinuumObjectGPU object = objects[objectIndex];
+        if (object.representation != NM_REPRESENTATION_FEM) continue;
+        const uint objectGlobal = environment * dispatch.objectCount + objectIndex;
+        if (!objectDue(object, schedulers[objectGlobal],
+                       adaptive[objectGlobal], microstep)) continue;
+        hasDueFEM = true;
+        const float alpha = objectLineSearch[objectGlobal].x;
+        if (!isfinite(alpha) || alpha <= 0.0f) accepted = false;
+    }
+    if (!hasDueFEM) return;
+    if (accepted && isfinite(state.y)) {
+        state.x = state.y;
+        state.z = 1.0f;
+        state.w = 0.0f;
+    } else {
+        state.z = 0.0f;
+        state.w = 0.0f;
+    }
