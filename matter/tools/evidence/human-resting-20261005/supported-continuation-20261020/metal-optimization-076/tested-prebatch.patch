+        const Expr* item = expression(node);
+        if (item == nullptr || item->kind != ExprKind::add) return false;
+        const Expr* subtract = expression(item->arguments[0]);
+        if (subtract == nullptr || subtract->kind != ExprKind::subtract) return false;
