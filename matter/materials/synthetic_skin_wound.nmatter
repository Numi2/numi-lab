// Explicitly synthetic, homogeneous skin-like research material. All values
// are scene authoring choices. No human or animal skin calibration is claimed.
material synthetic_skin_wound {
    parameter density : kg/m^3 = 1050 in [900, 1200];
    parameter mu : kPa = 25 in [1, 500] log;
    parameter lambda : kPa = 250 in [10, 5000] log;

    model neo_hookean;
    energy = neo_hookean(mu, lambda);
    valid = J() - 0.20;
    supports fem;

    interface {
        static_friction = 0.45;
        dynamic_friction = 0.35;
        restitution = 0.0;
        adhesion = 0.0;
    }

    limits {
        minimum_J = 0.20;
        maximum_J = 5.0;
        maximum_stress = 5e6;
        maximum_energy_density = 5e6;
    }
}
