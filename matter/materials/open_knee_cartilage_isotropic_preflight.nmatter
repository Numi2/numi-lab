// Source-directed PTC/FMC isotropic cartilage preflight. The pinned
// Open Knee(s) source supplies c1=2.54 MPa, c2=0 and k=100 MPa.
// Density (1100 kg/m^3) is an explicit synthetic inertial fixture, and this
// Matter energy has not been matched against a FEBio source-material solve.
// It must not qualify loaded cartilage mechanics or clinical contact.
material open_knee_cartilage_isotropic_preflight {
    parameter density : kg/m^3 = 1100 in [900, 1300];
    parameter c1 : MPa = 2.54 in [0.01, 20];
    parameter bulk : MPa = 100 in [1, 1000];

    model generic;
    energy = c1 * (exp((-2.0 / 3.0) * log(J())) * I1() - 3)
        + 0.5 * bulk * pow(log(J()), 2);
    valid = J() - 0.50;
    supports fem;

    interface {
        static_friction = 0.05;
        dynamic_friction = 0.03;
        restitution = 0.0;
        adhesion = 0.0;
    }

    limits {
        minimum_J = 0.50;
        maximum_J = 1.75;
        maximum_stress = 5e8;
        maximum_energy_density = 2e8;
    }
}
