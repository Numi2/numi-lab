// Effective ten-percent ownership proxy for the unresolved anterior abdominal
// wall composite. Cooney et al. measured a 1.12 MPa median elastic modulus for
// human full-thickness abdominal-wall composite specimens (PMCID PMC10604332).
// The continuum owns 10% of terminal force, so this first-order proxy uses 10%
// of that modulus. With the explicit nu=0.45 numerical assumption, E=0.112 MPa
// gives mu=0.0386206897 MPa and K=0.373333333 MPa. Human abdominal wall is
// layered, nonlinear, and anisotropic; this law is bounded mechanics plumbing,
// not a subject-specific constitutive calibration.
material human_anterior_abdominal_wall_composite_effective {
    parameter density : kg/m^3 = 1000 in [900, 1150];
    parameter shear : MPa = 0.0386206897 in [0.005, 1] log identifiable;
    parameter bulk : MPa = 0.373333333 in [0.05, 5] log identifiable;
    parameter numerical_viscosity : Pa*s = 5 in [0.1, 100] log;

    model generic;
    energy = 0.5 * shear * (I1() - 3 - 2 * log(J()))
        + 0.5 * bulk * pow(log(J()), 2);
    dissipation = 0.5 * numerical_viscosity * (
        pow(Fdot(0, 0), 2) + pow(Fdot(1, 1), 2) +
        pow(Fdot(2, 2), 2) +
        0.5 * pow(Fdot(0, 1) + Fdot(1, 0), 2) +
        0.5 * pow(Fdot(0, 2) + Fdot(2, 0), 2) +
        0.5 * pow(Fdot(1, 2) + Fdot(2, 1), 2)
    );
    valid = J() - 0.35;
    supports fem;

    interface {
        static_friction = 0.05;
        dynamic_friction = 0.03;
        restitution = 0.0;
        adhesion = 0.0;
    }

    limits {
        minimum_J = 0.35;
        maximum_J = 2.5;
        maximum_stress = 5e6;
        maximum_energy_density = 5e6;
    }
}
