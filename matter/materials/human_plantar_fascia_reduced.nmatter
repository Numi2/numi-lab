// Experimental reduced plantar-aponeurosis continuum scaffold for a future
// bilateral five-ray Human promotion. It is not called by the current tensile
// preflight. The 350 MPa longitudinal modulus is a common finite-
// element starting value reported for plantar fascia; beam cross-sectional
// areas are calibrated in the owning probe to a reduced five-ray allocation
// of 60/50/50/20/20 N/mm. Its 200 N/mm aggregate approximates the published
// 203.7 +/- 50.5 N/mm intact-fascia stiffness; the ray allocation itself is
// a modeling choice, not five independently measured cadaveric values. This
// is a preconditioned, isotropic reduced-bundle law. It is not a subject-
// specific, transversely isotropic, rate-dependent, failure, or clinical
// material certificate.
material human_plantar_fascia_reduced {
    parameter density : kg/m^3 = 1000 in [900, 1150];
    // E = 350 MPa and nu = 0.45.
    parameter shear : MPa = 120.689655 in [20, 500] log identifiable;
    parameter bulk : MPa = 1166.666667 in [100, 5000] log identifiable;
    // Small numerical regularizer for the abrupt bounded MTP preflight.
    parameter numerical_viscosity : Pa*s = 25 in [0.1, 500] log;

    model generic;
    energy = 0.5 * shear * (I1() - 3 - 2 * log(J()))
        + 0.5 * bulk * pow(log(J()), 2);
    dissipation = 0.5 * numerical_viscosity * (
        pow(Fdot(0, 0), 2) + pow(Fdot(1, 1), 2) +
        pow(Fdot(2, 2), 2) +
        0.5 * pow(Fdot(0, 1) + Fdot(1, 0), 2) +
        0.5 * pow(Fdot(0, 2) + Fdot(2, 0), 2) +
        0.5 * pow(Fdot(1, 2) + Fdot(2, 1), 2)
    );
    valid = J() - 0.35;
    supports fem;

    interface {
        static_friction = 0.30;
        dynamic_friction = 0.20;
        restitution = 0.0;
        adhesion = 0.0;
    }

    limits {
        minimum_J = 0.35;
        maximum_J = 2.5;
        maximum_stress = 1e9;
        maximum_energy_density = 5e8;
    }
}
