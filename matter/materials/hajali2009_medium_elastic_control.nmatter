// Elastic numerical control for the matching Haj-Ali 2009 ideal-Hill asset.
// Identical orthotropic energy, densities and limits, with Ep fixed to zero.
// All cross-source and finite-strain assumptions of the plastic asset apply.
material hajali2009_medium_elastic_control {
    parameter density : kg/m^3 = 679;
    parameter c11 : MPa = 4524.848543681839;
    parameter c22 : MPa = 1631.0512147406462;
    parameter c33 : MPa = 17.90002997076348;
    parameter c12 : MPa = 293.59114732344125;
    parameter c13 : MPa = 0.21371636195674576;
    parameter c23 : MPa = 0.19286701249506086;
    parameter g12 : MPa = 1039;
    parameter g13 : MPa = 226.34;
    parameter g23 : MPa = 198.72;

    parameter sigma_ref : MPa = 9.391;
    parameter hill_F : one = 5.612051993569077;
    parameter hill_G : one = 2.841099191623919;
    parameter hill_H : one = -1.8410991916239194;
    parameter hill_L : one = 76554.58420138889;
    parameter hill_M : one = 76554.58420138889;
    parameter hill_N : one = 9.998966099773243;
    parameter q_floor : one = 2e-6;
    parameter fb_epsilon : one = 1e-8;

    model generic;
    energy =
        0.5 * c11 * pow(0.5 * (pow(F(0,0),2)+pow(F(1,0),2)+pow(F(2,0),2)-1) - 0, 2)
      + 0.5 * c22 * pow(0.5 * (pow(F(0,1),2)+pow(F(1,1),2)+pow(F(2,1),2)-1) - 0, 2)
      + 0.5 * c33 * pow(0.5 * (pow(F(0,2),2)+pow(F(1,2),2)+pow(F(2,2),2)-1) - 0, 2)
      + c12 * (0.5 * (pow(F(0,0),2)+pow(F(1,0),2)+pow(F(2,0),2)-1) - 0)
            * (0.5 * (pow(F(0,1),2)+pow(F(1,1),2)+pow(F(2,1),2)-1) - 0)
      + c13 * (0.5 * (pow(F(0,0),2)+pow(F(1,0),2)+pow(F(2,0),2)-1) - 0)
            * (0.5 * (pow(F(0,2),2)+pow(F(1,2),2)+pow(F(2,2),2)-1) - 0)
      + c23 * (0.5 * (pow(F(0,1),2)+pow(F(1,1),2)+pow(F(2,1),2)-1) - 0)
            * (0.5 * (pow(F(0,2),2)+pow(F(1,2),2)+pow(F(2,2),2)-1) - 0)
      + 0.5 * g12 * pow(F(0,0)*F(0,1)+F(1,0)*F(1,1)+F(2,0)*F(2,1)-2*0, 2)
      + 0.5 * g13 * pow(F(0,0)*F(0,2)+F(1,0)*F(1,2)+F(2,0)*F(2,2)-2*0, 2)
      + 0.5 * g23 * pow(F(0,1)*F(0,2)+F(1,1)*F(1,2)+F(2,1)*F(2,2)-2*0, 2);

    valid = J() - 0.20;
    supports fem;
    interface { static_friction = 0; dynamic_friction = 0; restitution = 0; adhesion = 0; }
    limits { minimum_J = 0.20; maximum_J = 2.5; maximum_stress = 1e9; maximum_energy_density = 1e9; }
}
