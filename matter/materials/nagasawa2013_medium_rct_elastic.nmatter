// The RCT medium value E=189 MPa and yield stress 4.3 MPa are Table 4, p.108
// of Nagasawa, Komiyama & Mitsomwang (2013), DOI 10.1299/jamdsm.7.103.
// Table 4 does not supply a 3-D Poisson ratio or a hardening law. This named
// elastic approximation assumes nu=0.30 and isotropic StVK response solely to
// make a fixed 3-D baseline; it does not implement the reported 4.3 MPa yield
// or the paper's isotropic-elastoplastic comparison. The paper gives medium
// basis weight 180 g/m^2 and thickness 0.25 mm (Section 2.1, printed p.104;
// Fig.8, printed p.107), yielding density=720 kg/m^3 by mass/volume. All coefficients are
// fixed/non-identifiable. `valid` and `limits` below are solver-admission
// guards, not a physical strain range, yield rule or failure criterion.
material nagasawa2013_medium_rct_elastic {
    parameter density : kg/m^3 = 720;
    parameter lambda : MPa = 109.03846153846153;
    parameter mu : MPa = 72.69230769230769;

    model generic;
    energy =
        0.5 * lambda * pow(
            0.5 * (pow(F(0,0),2) + pow(F(1,0),2) + pow(F(2,0),2) - 1)
          + 0.5 * (pow(F(0,1),2) + pow(F(1,1),2) + pow(F(2,1),2) - 1)
          + 0.5 * (pow(F(0,2),2) + pow(F(1,2),2) + pow(F(2,2),2) - 1), 2)
      + mu * pow(0.5 * (pow(F(0,0),2) + pow(F(1,0),2) + pow(F(2,0),2) - 1), 2)
      + mu * pow(0.5 * (pow(F(0,1),2) + pow(F(1,1),2) + pow(F(2,1),2) - 1), 2)
      + mu * pow(0.5 * (pow(F(0,2),2) + pow(F(1,2),2) + pow(F(2,2),2) - 1), 2)
      + 0.5 * mu * pow(F(0,0)*F(0,1) + F(1,0)*F(1,1) + F(2,0)*F(2,1), 2)
      + 0.5 * mu * pow(F(0,0)*F(0,2) + F(1,0)*F(1,2) + F(2,0)*F(2,2), 2)
      + 0.5 * mu * pow(F(0,1)*F(0,2) + F(1,1)*F(1,2) + F(2,1)*F(2,2), 2);
    valid = J() - 0.20;
    supports fem;

    interface {
        static_friction = 0.0;
        dynamic_friction = 0.0;
        restitution = 0.0;
        adhesion = 0.0;
    }

    limits {
        minimum_J = 0.20;
        maximum_J = 2.5;
        maximum_stress = 1e9;
        maximum_energy_density = 1e9;
    }
}
