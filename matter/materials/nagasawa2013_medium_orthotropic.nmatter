// Corrugated medium elastic constants from Table 3, p.105 of Nagasawa,
// Komiyama & Mitsomwang, "Finite Element Analysis of Corrugated Board on
// Rotary Creasing Process", J. Adv. Mech. Des. Syst. Manuf. 7 (2013), 103-114,
// DOI: 10.1299/jamdsm.7.103. Source values are E_M=4727 MPa, E_C=2046 MPa,
// E_T=16 MPa, nu_MT=0.20, nu_TC=0.01, nu_CM=0.20, G_MT=16 MPa,
// G_TC=16 MPa and G_CM=1250 MPa. The paper defines M as machine, C as cross
// machine and T as thickness; material axes are x=M, y=C, z=T.
// The displayed paper table lists nu subscripts but does not separately define
// their order. This asset uses the conventional axial-first interpretation,
// nu_ij=-epsilon_j/epsilon_i under uniaxial stress along i. Reciprocal values
// follow symmetric compliance (nu_ij/E_i=nu_ji/E_j), not equal reciprocal nu.
// The normal stiffnesses below invert compliance in (M,C,T) order, with
// S_MC=-nu_CM/E_C, S_MT=-nu_MT/E_M and S_CT=-nu_TC/E_T.
// The objective St. Venant-Kirchhoff energy on Green-Lagrange strain is a
// finite-rotation/small-to-moderate-strain continuation of the paper's
// orthotropic-elastic model, not a quoted strain measure or a qualified
// high-strain/crushing law. The paper's medium basis weight is 180 g/m^2 and
// thickness is 0.25 mm (Section 2.1, printed p.104; Fig.8, printed p.107),
// giving 720 kg/m^3.
// This measured-constant medium is the primary continuum law for an explicitly
// meshed flute. Do not combine it as a continuum in the same cell with the RCT
// effective modulus material: that would count flute structure twice.
// `valid` and `limits` below are solver-admission guards, not failure criteria
// or physical high-strain validity limits. All coefficients are fixed.
material nagasawa2013_medium_orthotropic {
    parameter density : kg/m^3 = 720;
    parameter c_MM : MPa = 5220.660621667361;
    parameter c_CC : MPa = 2288.632385801777;
    parameter c_TT : MPa = 16.245637605734466;
    parameter c_MC : MPa = 1062.2347966794166;
    parameter c_MT : MPa = 14.156537513935177;
    parameter c_CT : MPa = 23.605416591119983;
    parameter g_MT : MPa = 16;
    parameter g_CT : MPa = 16;
    parameter g_CM : MPa = 1250;

    model generic;
    energy =
        0.5 * c_MM * pow(0.5 * (
            pow(F(0,0),2) + pow(F(1,0),2) + pow(F(2,0),2) - 1), 2)
      + 0.5 * c_CC * pow(0.5 * (
            pow(F(0,1),2) + pow(F(1,1),2) + pow(F(2,1),2) - 1), 2)
      + 0.5 * c_TT * pow(0.5 * (
            pow(F(0,2),2) + pow(F(1,2),2) + pow(F(2,2),2) - 1), 2)
      + c_MC * 0.5 * (pow(F(0,0),2) + pow(F(1,0),2) + pow(F(2,0),2) - 1)
          * 0.5 * (pow(F(0,1),2) + pow(F(1,1),2) + pow(F(2,1),2) - 1)
      + c_MT * 0.5 * (pow(F(0,0),2) + pow(F(1,0),2) + pow(F(2,0),2) - 1)
          * 0.5 * (pow(F(0,2),2) + pow(F(1,2),2) + pow(F(2,2),2) - 1)
      + c_CT * 0.5 * (pow(F(0,1),2) + pow(F(1,1),2) + pow(F(2,1),2) - 1)
          * 0.5 * (pow(F(0,2),2) + pow(F(1,2),2) + pow(F(2,2),2) - 1)
      + 0.5 * g_MT * pow(F(0,0)*F(0,2) + F(1,0)*F(1,2) + F(2,0)*F(2,2), 2)
      + 0.5 * g_CT * pow(F(0,1)*F(0,2) + F(1,1)*F(1,2) + F(2,1)*F(2,2), 2)
      + 0.5 * g_CM * pow(F(0,0)*F(0,1) + F(1,0)*F(1,1) + F(2,0)*F(2,1), 2);
    valid = J() - 0.20;
    supports fem;

    interface {
        static_friction = 0.0;
        dynamic_friction = 0.0;
        restitution = 0.0;
        adhesion = 0.0;
    }

    limits {
        minimum_J = 0.20;
        maximum_J = 2.5;
        maximum_stress = 1e9;
        maximum_energy_density = 1e9;
    }
}
