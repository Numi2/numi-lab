#include "metalrobo/numi_human_stand_gpu.h"
#include "metalrobo/numi_human_tendon_gpu.h"
#include "numi/matter/numi_human_shared.h"

namespace numi_matter_metal {

namespace {

inline bool finite4(const float4 value) { return all(isfinite(value)); }

inline float3 humanQuaternionRotate(const float4 quaternion, const float3 value) {
    const float3 doubledCross = 2.0f * cross(quaternion.xyz, value);
    return value + quaternion.w * doubledCross +
        cross(quaternion.xyz, doubledCross);
}

inline float3 humanPointJacobian(
    const uint environment,
    const uint dof,
    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch,
    device const MRArticulatedBodyPoseGPU* bodyPoses,
    device const float* pointJacobians,
    const uint bodyIndex,
    const float3 worldPoint
) {
    const uint localBody = bodyIndex - dispatch.articulationFirstBody;
    const MRArticulatedBodyPoseGPU pose = bodyPoses[
        environment * dispatch.bodyPoseStride + localBody
    ];
    const uint bodyPoint = dispatch.bodyJacobianPointOffset + 4u * localBody;
    const uint centerBase = environment * dispatch.pointJacobianStride +
        bodyPoint * 3u * dispatch.dofCount;
    const float3 center = float3(
        pointJacobians[centerBase + dof],
        pointJacobians[centerBase + dispatch.dofCount + dof],
        pointJacobians[centerBase + 2u * dispatch.dofCount + dof]
    );
    float3 angular = float3(0.0f);
    for (uint axis = 0u; axis < 3u; ++axis) {
        const float3 localAxis = axis == 0u
            ? float3(1.0f, 0.0f, 0.0f)
            : (axis == 1u
                ? float3(0.0f, 1.0f, 0.0f)
                : float3(0.0f, 0.0f, 1.0f));
        const float3 worldAxis = humanQuaternionRotate(pose.orientation, localAxis);
        const uint axisBase = centerBase +
            (axis + 1u) * 3u * dispatch.dofCount;
        const float3 probe = float3(
            pointJacobians[axisBase + dof],
            pointJacobians[axisBase + dispatch.dofCount + dof],
            pointJacobians[axisBase + 2u * dispatch.dofCount + dof]
        );
        angular += 0.5f * cross(worldAxis, probe - center);
    }
    return center + cross(angular, worldPoint - pose.position.xyz);
}

inline bool validBody(
    const uint bodyIndex,
    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch
) {
    return bodyIndex >= dispatch.articulationFirstBody &&
        bodyIndex - dispatch.articulationFirstBody < dispatch.bodyPoseStride;
}

} // namespace

kernel void nm_numi_human_prepare_provisional_status(
    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch [[buffer(0)]],
    device const NMNumiHumanTendonFEMNodeLoadGPU* nodeLoads [[buffer(1)]],
    device const NMNumiHumanTendonFEMNodeAnchorGPU* nodeAnchors [[buffer(2)]],
    device const NMNumiHumanTendonFEMEndpointReplacementGPU* replacements [[buffer(3)]],
    device const MRNumiHumanTendonBindingGPU* bindings [[buffer(4)]],
    device const MRNumiHumanTendonTransferResultGPU* transfers [[buffer(5)]],
    device const MRArticulatedBodyPoseGPU* bodyPoses [[buffer(6)]],
    device MRMetalWorldStatusGPU* worldStatuses [[buffer(7)]],
    uint environment [[thread_position_in_grid]]
) {
    if (environment >= dispatch.environmentCount) return;
    bool accepted =
        dispatch.abiVersion == NM_NUMI_HUMAN_TENDON_FEM_LOAD_ABI_VERSION &&
        dispatch.environmentCount > 0u && dispatch.femNodeCount > 0u &&
        dispatch.endpointCount > 0u &&
        dispatch.dofCount > 0u && dispatch.transferStride >= dispatch.endpointCount &&
        dispatch.generalizedForceStride >= dispatch.dofCount &&
        dispatch.muscleCount > 0u &&
        dispatch.bodyPoseStride > 0u && dispatch.pointJacobianStride > 0u &&
        dispatch.bodyJacobianPointOffset != MR_INVALID_INDEX &&
        dispatch.reserved1 == 0u;
    for (uint node = 0u; accepted && node < dispatch.femNodeCount; ++node) {
        const NMNumiHumanTendonFEMNodeLoadGPU load = nodeLoads[node];
        const NMNumiHumanTendonFEMNodeAnchorGPU anchor = nodeAnchors[node];
        const bool anchorActive =
            (anchor.flags & NM_NUMI_HUMAN_TENDON_FEM_NODE_ANCHOR_ACTIVE) != 0u;
        accepted = finite4(load.scale) &&
            anchor.reserved0 == 0u && anchor.reserved1 == 0u &&
            (anchor.flags & ~NM_NUMI_HUMAN_TENDON_FEM_NODE_ANCHOR_ACTIVE) == 0u &&
            finite4(anchor.localPoint) && anchor.localPoint.w == 0.0f &&
            (!anchorActive || validBody(anchor.bodyIndex, dispatch)) &&
            (anchorActive || anchor.bodyIndex == MR_INVALID_INDEX);
        for (uint slot = 0u; accepted && slot < 4u; ++slot) {
            const uint endpoint = load.endpointIndex[slot];
            const float scale = load.scale[slot];
            const bool active = endpoint != NM_INVALID_INDEX;
            accepted = active == (scale != 0.0f) &&
                (!active || endpoint < dispatch.endpointCount);
            for (uint previous = 0u; accepted && previous < slot; ++previous) {
                accepted = !active || load.endpointIndex[previous] != endpoint;
            }
            if (!active) continue;
            const MRNumiHumanTendonTransferResultGPU transfer = transfers[
                environment * dispatch.transferStride + endpoint
            ];
            accepted = transfer.status == MR_NUMI_HUMAN_TENDON_TRANSFER_SUCCESS &&
                transfer.environment == environment &&
                transfer.bindingIndex == endpoint &&
                finite4(transfer.terminalWorldForce);
        }
        if (anchorActive) {
            const MRArticulatedBodyPoseGPU pose = bodyPoses[
                environment * dispatch.bodyPoseStride +
                anchor.bodyIndex - dispatch.articulationFirstBody
            ];
            accepted = accepted && finite4(pose.position) &&
                finite4(pose.orientation);
        }
    }
    for (uint index = 0u; accepted && index < dispatch.replacementCount; ++index) {
        const NMNumiHumanTendonFEMEndpointReplacementGPU replacement =
            replacements[index];
        const uint replacementFlagMask =
            NM_NUMI_HUMAN_TENDON_FEM_ENDPOINT_REPLACEMENT_ACTIVE |
            NM_NUMI_HUMAN_TENDON_FEM_ENDPOINT_REPLACEMENT_FULL_MUSCLE_ROW |
            NM_NUMI_HUMAN_TENDON_FEM_ENDPOINT_REPLACEMENT_DISTAL_FORCE_COUPLE;
        const bool fullMuscleRow = (replacement.flags &
            NM_NUMI_HUMAN_TENDON_FEM_ENDPOINT_REPLACEMENT_FULL_MUSCLE_ROW) != 0u;
        const bool distalForceCouple = (replacement.flags &
            NM_NUMI_HUMAN_TENDON_FEM_ENDPOINT_REPLACEMENT_DISTAL_FORCE_COUPLE) != 0u;
        accepted =
            (replacement.flags &
                NM_NUMI_HUMAN_TENDON_FEM_ENDPOINT_REPLACEMENT_ACTIVE) != 0u &&
            (replacement.flags & ~replacementFlagMask) == 0u &&
            (!distalForceCouple || fullMuscleRow) &&
            replacement.reserved0 == 0u &&
            replacement.loadEndpointIndex < dispatch.endpointCount &&
            replacement.anchorEndpointIndex < dispatch.endpointCount &&
            replacement.loadEndpointIndex != replacement.anchorEndpointIndex &&
            finite4(replacement.forceOwnerFraction) &&
            replacement.forceOwnerFraction.x > 0.0f &&
            replacement.forceOwnerFraction.x <= 1.0f &&
            all(replacement.forceOwnerFraction.yzw == float3(0.0f));
        if (!accepted) break;
        const MRNumiHumanTendonBindingGPU load =
            bindings[replacement.loadEndpointIndex];
        const MRNumiHumanTendonBindingGPU anchor =
            bindings[replacement.anchorEndpointIndex];
        const MRNumiHumanTendonTransferResultGPU loadTransfer = transfers[
            environment * dispatch.transferStride +
            replacement.loadEndpointIndex
        ];
        const MRNumiHumanTendonTransferResultGPU anchorTransfer = transfers[
            environment * dispatch.transferStride +
            replacement.anchorEndpointIndex
        ];
        accepted = load.muscleIndex == anchor.muscleIndex &&
            load.muscleIndex < dispatch.muscleCount &&
            load.endpointOrdinal != anchor.endpointOrdinal &&
            validBody(load.bodyIndex, dispatch) &&
            validBody(anchor.bodyIndex, dispatch) &&
            finite4(load.sourceLocalPoint) && load.sourceLocalPoint.w == 0.0f &&
            finite4(anchor.sourceLocalPoint) && anchor.sourceLocalPoint.w == 0.0f &&
            loadTransfer.status == MR_NUMI_HUMAN_TENDON_TRANSFER_SUCCESS &&
            loadTransfer.environment == environment &&
            loadTransfer.bindingIndex == replacement.loadEndpointIndex &&
            finite4(loadTransfer.terminalWorldForce) &&
            anchorTransfer.status == MR_NUMI_HUMAN_TENDON_TRANSFER_SUCCESS &&
            anchorTransfer.environment == environment &&
            anchorTransfer.bindingIndex == replacement.anchorEndpointIndex &&
            finite4(anchorTransfer.terminalWorldForce);
    }
    MRMetalWorldStatusGPU world{};
    world.code = accepted ? MR_STEP_SUCCESS : MR_STEP_DID_NOT_CONVERGE;
    world.environment = environment;
    world.controlStep = dispatch.stepIndex;
    world.successfulSubsteps = accepted ? 1u : 0u;
    world.abaCode = accepted ? MR_ABA_SUCCESS : MR_ABA_INVALID_DISPATCH;
    world.failingSubstep = accepted ? MR_INVALID_INDEX : 0u;
    world.failingIndex = accepted ? MR_INVALID_INDEX : 0u;
    worldStatuses[environment] = world;
}

kernel void nm_numi_human_adapt_stand_status(
    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch [[buffer(0)]],
    device const MRNumiHumanStandStatusGPU* standStatuses [[buffer(1)]],
    device MRMetalWorldStatusGPU* worldStatuses [[buffer(2)]],
    uint environment [[thread_position_in_grid]]
) {
    if (environment >= dispatch.environmentCount) return;
    const MRNumiHumanStandStatusGPU stand = standStatuses[environment];
    const bool accepted =
        dispatch.abiVersion == NM_NUMI_HUMAN_TENDON_FEM_LOAD_ABI_VERSION &&
        dispatch.muscleCount > 0u && dispatch.reserved1 == 0u &&
        stand.code == MR_NUMI_HUMAN_STAND_SUCCESS &&
        stand.environment == environment &&
        stand.completedSteps == dispatch.stepIndex + 1u;
    MRMetalWorldStatusGPU world{};
    world.code = accepted ? MR_STEP_SUCCESS : MR_STEP_DID_NOT_CONVERGE;
    world.environment = environment;
    world.controlStep = dispatch.stepIndex;
    world.successfulSubsteps = accepted ? 1u : 0u;
    world.abaCode = accepted ? MR_ABA_SUCCESS : MR_ABA_INVALID_DISPATCH;
    world.failingSubstep = accepted ? MR_INVALID_INDEX : 0u;
    world.failingIndex = accepted ? MR_INVALID_INDEX : stand.failingIndex;
    worldStatuses[environment] = world;
}

kernel void nm_numi_human_assemble_tendon_fem_loads(
    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch [[buffer(0)]],
    device const NMNumiHumanTendonFEMNodeLoadGPU* nodeLoads [[buffer(1)]],
    device const MRNumiHumanTendonTransferResultGPU* transfers [[buffer(2)]],
    device float4* externalForces [[buffer(3)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.femNodeCount;
    if (global >= total) return;
    const uint environment = global / dispatch.femNodeCount;
    const uint node = global - environment * dispatch.femNodeCount;
    externalForces[global] = float4(0.0f);
    const NMNumiHumanTendonFEMNodeLoadGPU load = nodeLoads[node];
    if (!all(isfinite(load.scale))) return;
    float3 force = float3(0.0f);
    for (uint slot = 0u; slot < 4u; ++slot) {
        const uint endpoint = load.endpointIndex[slot];
        const float scale = load.scale[slot];
        if (endpoint == NM_INVALID_INDEX || scale == 0.0f) continue;
        if (endpoint >= dispatch.endpointCount) return;
        const MRNumiHumanTendonTransferResultGPU transfer = transfers[
            environment * dispatch.transferStride + endpoint
        ];
        if (transfer.status != MR_NUMI_HUMAN_TENDON_TRANSFER_SUCCESS ||
            transfer.environment != environment ||
            transfer.bindingIndex != endpoint ||
            !all(isfinite(transfer.terminalWorldForce))) return;
        // terminalWorldForce is the action on the load-side bone. The
        // continuum receives its equal-and-opposite force. Endpoint mode
        // retains the body's load-side J^T reaction; full-row mode restores
        // that reaction explicitly after removing the complete source row.
        // A declared negative distal-couple scale reverses this action at the
        // opposing attachment, giving the two entheses zero net force.
        force -= scale * transfer.terminalWorldForce.xyz;
    }
    externalForces[global] = float4(force, 0.0f);
}

kernel void nm_numi_human_audit_tendon_fem_loads(
    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch [[buffer(0)]],
    device const float4* externalForces [[buffer(1)]],
    device float4* audits [[buffer(2)]],
    uint environment [[thread_position_in_grid]]
) {
    if (environment >= dispatch.environmentCount) return;
    float3 resultant = float3(0.0f);
    float magnitudeL1 = 0.0f;
    const uint base = environment * dispatch.femNodeCount;
    for (uint node = 0u; node < dispatch.femNodeCount; ++node) {
        const float3 force = externalForces[base + node].xyz;
        if (!all(isfinite(force))) {
            audits[environment] = float4(NAN);
            return;
        }
        resultant += force;
        magnitudeL1 += length(force);
    }
    audits[environment] = float4(resultant, magnitudeL1);
}

kernel void nm_numi_human_assemble_fem_kinematic_targets(
    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch [[buffer(0)]],
    device const NMNumiHumanTendonFEMNodeAnchorGPU* anchors [[buffer(1)]],
    device const MRArticulatedBodyPoseGPU* bodyPoses [[buffer(2)]],
    device float4* targets [[buffer(3)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.femNodeCount;
    if (global >= total) return;
    const uint environment = global / dispatch.femNodeCount;
    const uint node = global - environment * dispatch.femNodeCount;
    targets[global] = float4(0.0f);
    const NMNumiHumanTendonFEMNodeAnchorGPU anchor = anchors[node];
    if (anchor.flags != NM_NUMI_HUMAN_TENDON_FEM_NODE_ANCHOR_ACTIVE ||
        !validBody(anchor.bodyIndex, dispatch) ||
        !finite4(anchor.localPoint) || anchor.localPoint.w != 0.0f) return;
    const MRArticulatedBodyPoseGPU pose = bodyPoses[
        environment * dispatch.bodyPoseStride +
        anchor.bodyIndex - dispatch.articulationFirstBody
    ];
    targets[global] = float4(
        pose.position.xyz + humanQuaternionRotate(pose.orientation, anchor.localPoint.xyz),
        1.0f
    );
}

kernel void nm_numi_human_apply_fem_anchor_reactions(
    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch [[buffer(0)]],
    device const NMNumiHumanTendonFEMNodeAnchorGPU* nodeAnchors [[buffer(1)]],
    device const NMNumiHumanTendonFEMEndpointReplacementGPU* replacements [[buffer(2)]],
    device const MRNumiHumanTendonBindingGPU* bindings [[buffer(3)]],
    device const MRNumiHumanTendonTransferResultGPU* transfers [[buffer(4)]],
    device const float4* constraintReactions [[buffer(5)]],
    device const NMMatterStatusGPU* matterStatuses [[buffer(6)]],
    device const MRArticulatedBodyPoseGPU* bodyPoses [[buffer(7)]],
    device const float* pointJacobians [[buffer(8)]],
    device float* generalizedForces [[buffer(9)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.dofCount;
    if (global >= total) return;
    const uint environment = global / dispatch.dofCount;
    const uint dof = global - environment * dispatch.dofCount;
    if (matterStatuses[environment].code != NM_STATUS_SUCCESS) return;
    float correction = 0.0f;
    for (uint index = 0u; index < dispatch.replacementCount; ++index) {
        const NMNumiHumanTendonFEMEndpointReplacementGPU replacement =
            replacements[index];
        const bool fullMuscleRow = (replacement.flags &
            NM_NUMI_HUMAN_TENDON_FEM_ENDPOINT_REPLACEMENT_FULL_MUSCLE_ROW) != 0u;
        const uint endpointIndex = fullMuscleRow
            ? replacement.loadEndpointIndex
            : replacement.anchorEndpointIndex;
        const MRNumiHumanTendonBindingGPU endpoint = bindings[endpointIndex];
        const MRNumiHumanTendonTransferResultGPU transfer = transfers[
            environment * dispatch.transferStride + endpointIndex
        ];
        const uint localBody =
            endpoint.bodyIndex - dispatch.articulationFirstBody;
        const MRArticulatedBodyPoseGPU pose = bodyPoses[
            environment * dispatch.bodyPoseStride + localBody
        ];
        const float3 worldPoint = pose.position.xyz + humanQuaternionRotate(
            pose.orientation, endpoint.sourceLocalPoint.xyz
        );
        const float endpointEffort = dot(
            transfer.terminalWorldForce.xyz,
            humanPointJacobian(
                environment, dof, dispatch, bodyPoses, pointJacobians,
                endpoint.bodyIndex, worldPoint
            )
        );
        if (fullMuscleRow) {
            const uint rowIndex =
                (environment * dispatch.muscleCount + endpoint.muscleIndex) *
                    dispatch.dofCount + dof;
            correction += replacement.forceOwnerFraction.x *
                (endpointEffort - generalizedForces[rowIndex]);
        } else {
            correction -=
                replacement.forceOwnerFraction.x * endpointEffort;
        }
    }
    const uint reactionBase = environment * dispatch.femNodeCount;
    for (uint node = 0u; node < dispatch.femNodeCount; ++node) {
        const NMNumiHumanTendonFEMNodeAnchorGPU anchor = nodeAnchors[node];
        if ((anchor.flags & NM_NUMI_HUMAN_TENDON_FEM_NODE_ANCHOR_ACTIVE) == 0u)
            continue;
        const uint localBody = anchor.bodyIndex - dispatch.articulationFirstBody;
        const MRArticulatedBodyPoseGPU pose = bodyPoses[
            environment * dispatch.bodyPoseStride + localBody
        ];
        const float3 worldPoint = pose.position.xyz +
            humanQuaternionRotate(pose.orientation, anchor.localPoint.xyz);
        const float3 reaction = constraintReactions[reactionBase + node].xyz;
        correction += dot(
            reaction,
            humanPointJacobian(
                environment, dof, dispatch, bodyPoses, pointJacobians,
                anchor.bodyIndex, worldPoint
            )
        );
    }
    if (!isfinite(correction)) return;
    const uint forceIndex = environment * dispatch.generalizedForceStride +
        dispatch.generalizedForceOffset + dof;
    generalizedForces[forceIndex] += correction;
}

} // namespace numi_matter_metal
