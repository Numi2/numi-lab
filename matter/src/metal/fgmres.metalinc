namespace numi_matter_metal {

inline void fgmresCompensatedAdd(
    thread float& sum,
    thread float& correction,
    const float value
) {
    const float adjusted = value - correction;
    const float next = sum + adjusted;
    correction = (next - sum) - adjusted;
    sum = next;
}

inline uint fgmresMatrixIndex(
    const uint object,
    const uint row,
    const uint column
) {
    return (object * (NM_MIXED_FGMRES_RESTART + 1u) + row) *
        NM_MIXED_FGMRES_RESTART + column;
}

inline uint fgmresVectorIndex(const uint object, const uint row) {
    return object * (NM_MIXED_FGMRES_RESTART + 1u) + row;
}

inline uint fgmresContactRowCount(const NMMatterDispatchGPU dispatch) {
    return dispatch.contactPairCount + dispatch.deformableContactCapacity;
}

inline uint fgmresContactBase(
    const NMMatterDispatchGPU dispatch,
    const uint environment
) {
    return 2u * dispatch.environmentCount * dispatch.femNodeCount +
        dispatch.environmentCount * dispatch.gridNodeCount +
        environment * fgmresContactRowCount(dispatch);
}

inline uint fgmresMPMBase(const NMMatterDispatchGPU dispatch) {
    return 2u * dispatch.environmentCount * dispatch.femNodeCount;
}

inline uint fgmresMPMIndex(
    const NMMatterDispatchGPU dispatch,
    const uint environment,
    const uint node
) {
    return fgmresMPMBase(dispatch) +
        environment * dispatch.gridNodeCount + node;
}

inline bool fgmresDeformableActiveWork(
    const NMMatterDispatchGPU dispatch,
    constant NMKKTContactArguments& contact,
    const uint global,
    thread uint& environment,
    thread uint& slot
) {
    const uint capacity = dispatch.deformableContactCapacity;
    const uint activeTotal = contact.deformableActiveDispatch[0].reserved;
    if (capacity == 0u || global >= activeTotal) return false;
    const uint encoded = contact.deformableGlobalActiveIndices[global];
    environment = encoded / capacity;
    slot = encoded - environment * capacity;
    return environment < dispatch.environmentCount && slot < capacity;
}

inline uint fgmresUnknownCount(const NMMatterDispatchGPU dispatch) {
    return 2u * dispatch.environmentCount * dispatch.femNodeCount +
        dispatch.environmentCount * dispatch.gridNodeCount +
        dispatch.environmentCount * fgmresContactRowCount(dispatch);
}

kernel void nm_fgmres_begin(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMMixedSolverGPU& solver [[buffer(1)]],
    device const NMContinuumObjectGPU* objects [[buffer(2)]],
    device const float4* residual [[buffer(3)]],
    device float4* basis0 [[buffer(4)]],
    device float* hessenberg [[buffer(5)]],
    device float2* rotations [[buffer(6)]],
    device float* leastSquares [[buffer(7)]],
    device NMFGMRESStateGPU* states [[buffer(8)]],
    device const NMMatterStatusGPU* statuses [[buffer(9)]],
    constant NMMicrostepGPU& microstep [[buffer(10)]],
    device const NMSchedulerStateGPU* schedulers [[buffer(11)]],
    device const NMAdaptiveStateGPU* adaptive [[buffer(12)]],
    constant NMKKTContactArguments& contact [[buffer(13)]],
    constant uint& restartCycle [[buffer(14)]],
    constant float& forcing [[buffer(15)]],
    constant uint& nonlinearIteration [[buffer(16)]],
    uint lane [[thread_index_in_threadgroup]],
    uint group [[threadgroup_position_in_grid]]
) {
    if (lane >= 32u || group >= dispatch.environmentCount) return;
    const uint environment = group;
    const float4 previousDiagnostics = states[environment].diagnostics;
    const float4 previousNonlinear = states[environment].nonlinear;
    const bool completed = restartCycle > 0u &&
        previousDiagnostics.z > 0.5f;
    float norm2 = 0.0f;
    float normCorrection = 0.0f;
    const bool active = environmentHealthy(statuses, environment) &&
        !completed;
    const uint totalNodes = dispatch.environmentCount * dispatch.femNodeCount;
    const uint fieldBase = totalNodes;
    const uint mpmBase = fgmresMPMIndex(dispatch, environment, 0u);
    const uint contactBase = fgmresContactBase(dispatch, environment);
    if (active) {
        const uint base = environment * dispatch.femNodeCount;
        for (uint local = lane; local < dispatch.femNodeCount; local += 32u) {
            fgmresCompensatedAdd(
                norm2, normCorrection,
                dot(residual[base + local], residual[base + local]));
            fgmresCompensatedAdd(
                norm2, normCorrection,
                dot(residual[fieldBase + base + local],
                    residual[fieldBase + base + local]));
        }
        for (uint local = lane; local < dispatch.gridNodeCount; local += 32u)
            fgmresCompensatedAdd(
                norm2, normCorrection,
                dot(residual[mpmBase + local], residual[mpmBase + local]));
        const uint activeCount = min(
            contact.activeCounts[environment], dispatch.reservedMixed1);
        for (uint slot = lane; slot < activeCount; slot += 32u) {
            const uint pairIndex = contact.activePairs[
                environment * dispatch.reservedMixed1 + slot];
            if (pairIndex < dispatch.contactPairCount) {
                const float value = residual[contactBase + pairIndex].x;
                fgmresCompensatedAdd(
                    norm2, normCorrection, value * value);
            }
        }
        const uint deformableCount = min(
            contact.deformableActiveCounts[environment],
            dispatch.deformableContactCapacity);
        const uint deformableBase =
            environment * dispatch.deformableContactCapacity;
        for (uint activeSlot = lane; activeSlot < deformableCount;
             activeSlot += 32u) {
            const uint contactSlot = contact.deformableActiveIndices[
                deformableBase + activeSlot];
            if (contactSlot >= dispatch.deformableContactCapacity) continue;
            const uint row = contactBase + dispatch.contactPairCount +
                contactSlot;
            fgmresCompensatedAdd(
                norm2, normCorrection,
                dot(residual[row].xyz, residual[row].xyz));
        }
    }
    norm2 = simd_sum(norm2);
    for (uint index = lane; index <
         (NM_MIXED_FGMRES_RESTART + 1u) * NM_MIXED_FGMRES_RESTART;
         index += 32u)
        hessenberg[environment *
            (NM_MIXED_FGMRES_RESTART + 1u) *
            NM_MIXED_FGMRES_RESTART + index] = 0.0f;
    for (uint index = lane; index < NM_MIXED_FGMRES_RESTART; index += 32u)
            rotations[environment * NM_MIXED_FGMRES_RESTART + index] =
            float2(1.0f, 0.0f);
    for (uint index = lane; index < NM_MIXED_FGMRES_RESTART + 1u;
         index += 32u)
        leastSquares[fgmresVectorIndex(environment, index)] = 0.0f;
    threadgroup_barrier(mem_flags::mem_device);
    const float norm = sqrt(max(norm2, 0.0f));
    const float firstNewtonNorm = nonlinearIteration == 0u &&
        restartCycle == 0u ? norm : previousNonlinear.x;
    const bool correctionConverged = nonlinearIteration > 0u &&
        previousNonlinear.z <= solver.nonlinearTolerances.y;
    const bool nonlinearConverged = restartCycle == 0u &&
        correctionConverged && norm <= max(
            solver.regularization.x,
            solver.nonlinearTolerances.x *
                max(firstNewtonNorm, solver.regularization.x));
    if (lane == 0u) {
        const float initialNorm = restartCycle == 0u
            ? norm : previousDiagnostics.y;
        const float target = max(
            solver.regularization.x,
            clamp(forcing, solver.nonlinearTolerances.x, 0.5f) * initialNorm
        );
        const bool converged = completed || nonlinearConverged ||
            norm <= target;
        leastSquares[fgmresVectorIndex(environment, 0u)] =
            completed ? 0.0f : norm;
        states[environment].diagnostics = float4(
            completed ? previousDiagnostics.x : norm,
            initialNorm,
            converged ? 1.0f : 0.0f,
            0.0f
        );
        states[environment].nonlinear = float4(
            firstNewtonNorm,
            restartCycle == 0u ? norm : previousNonlinear.y,
            nonlinearIteration == 0u && restartCycle == 0u
                ? INFINITY : previousNonlinear.z,
            nonlinearConverged ? 1.0f : 0.0f
        );
    }
    if (!active || nonlinearConverged || norm <= max(
            solver.regularization.x,
            clamp(forcing, solver.nonlinearTolerances.x, 0.5f) *
                (restartCycle == 0u ? norm : previousDiagnostics.y))) return;
    const uint nodeBase = environment * dispatch.femNodeCount;
    const float inverseNorm = norm > 1.0e-30f ? 1.0f / norm : 0.0f;
    for (uint local = lane; local < dispatch.femNodeCount; local += 32u) {
        const uint node = nodeBase + local;
        basis0[node] = residual[node] * inverseNorm;
        basis0[fieldBase + node] =
            residual[fieldBase + node] * inverseNorm;
    }
    for (uint local = lane; local < dispatch.gridNodeCount; local += 32u)
        basis0[mpmBase + local] =
            residual[mpmBase + local] * inverseNorm;
    const uint activeCount = min(
        contact.activeCounts[environment], dispatch.reservedMixed1);
    const uint deformableCapacity = dispatch.deformableContactCapacity;
    const uint deformableCount = min(
        contact.deformableActiveCounts[environment], deformableCapacity);
    const uint deformableBase = environment * deformableCapacity;
    for (uint slot = lane; slot < activeCount; slot += 32u) {
        const uint pairIndex = contact.activePairs[
            environment * dispatch.reservedMixed1 + slot];
        if (pairIndex < dispatch.contactPairCount)
            basis0[contactBase + pairIndex] = float4(
                residual[contactBase + pairIndex].x * inverseNorm,
                0.0f, 0.0f, 0.0f);
    }
    for (uint activeSlot = lane; activeSlot < deformableCount;
         activeSlot += 32u) {
        const uint contactSlot = contact.deformableActiveIndices[
            deformableBase + activeSlot];
        if (contactSlot < deformableCapacity) {
            const uint row = contactBase + dispatch.contactPairCount +
                contactSlot;
            basis0[row] = float4(residual[row].xyz * inverseNorm, 0.0f);
        }
    }
    (void)objects;
    (void)schedulers;
    (void)adaptive;
    (void)microstep;
}

kernel void nm_fgmres_measure_correction(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const NMContinuumObjectGPU* objects [[buffer(1)]],
    device const NMFEMNodeStateGPU* candidate [[buffer(2)]],
    device const float4* solution [[buffer(3)]],
    device NMFGMRESStateGPU* states [[buffer(4)]],
    device const NMFEMFieldStateGPU* fields [[buffer(5)]],
    constant NMKKTContactArguments& contact [[buffer(6)]],
    uint lane [[thread_index_in_threadgroup]],
    uint group [[threadgroup_position_in_grid]]
) {
    if (lane >= 32u || group >= dispatch.environmentCount) return;
    const uint environment = group;
    const uint base = environment * dispatch.femNodeCount;
    float correctionRatio = 0.0f;
    for (uint local = lane; local < dispatch.femNodeCount; local += 32u) {
        const uint node = base + local;
        correctionRatio = max(correctionRatio,
            length(solution[node].xyz) / max(
                length(candidate[node].velocityAndInverseMass.xyz), 1.0f));
        const float4 field = float4(
            fields[node].primary.yzw, fields[node].secondary.x);
        correctionRatio = max(correctionRatio,
            length(solution[dispatch.environmentCount *
                            dispatch.femNodeCount + node]) /
                max(length(field), 1.0f));
    }
    const uint contactBase = fgmresContactBase(dispatch, environment);
    const uint activeCount = min(
        contact.activeCounts[environment], dispatch.reservedMixed1);
    for (uint activeSlot = lane; activeSlot < activeCount;
         activeSlot += 32u) {
        const uint pairIndex = contact.activePairs[
            environment * dispatch.reservedMixed1 + activeSlot];
        if (pairIndex >= dispatch.contactPairCount) continue;
        correctionRatio = max(correctionRatio,
            abs(solution[contactBase + pairIndex].x) / max(
                abs(contact.samples[
                    environment * dispatch.contactPairCount + pairIndex]
                        .impulseAndNormal.w), 1.0f));
    }
    const uint capacity = dispatch.deformableContactCapacity;
    const uint deformableCount = min(
        contact.deformableActiveCounts[environment], capacity);
    for (uint activeSlot = lane; activeSlot < deformableCount;
         activeSlot += 32u) {
        const uint slot = contact.deformableActiveIndices[
            environment * capacity + activeSlot];
        if (slot >= capacity) continue;
        correctionRatio = max(correctionRatio, length(solution[
            contactBase + dispatch.contactPairCount + slot].xyz) / max(
                length(contact.deformableContacts[
                    environment * capacity + slot].impulseAndFriction.xyz),
                1.0f));
    }
    correctionRatio = simd_max(correctionRatio);
    if (lane == 0u)
        states[environment].nonlinear.z = correctionRatio;
    (void)objects;
}

kernel void nm_fgmres_precondition(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const NMIncidenceRangeGPU* nodeRanges [[buffer(1)]],
    device const float4* inverseDiagonal [[buffer(2)]],
    device const float4* basis [[buffer(3)]],
    device float4* preconditioned [[buffer(4)]],
    device const NMFGMRESStateGPU* states [[buffer(5)]],
    constant NMMixedSolverGPU& solver [[buffer(6)]],
    device const NMContinuumObjectGPU* objects [[buffer(7)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.femNodeCount;
    if (global >= total || dispatch.femNodeCount == 0u) return;
    const uint environment = global / dispatch.femNodeCount;
    const uint objectIndex = nodeRanges[global].objectIndex;
    preconditioned[global] = float4(0.0f);
    if (objectIndex == NM_INVALID_INDEX || objectIndex >= dispatch.objectCount)
        return;
    if (states[environment].diagnostics.z > 0.5f) return;
    preconditioned[global] = float4(
        inverseDiagonal[global].xyz * basis[global].xyz,
        inverseDiagonal[global].w * basis[global].w
    );
    (void)solver;
    (void)objects;
}

// Connectivity-enhanced additive Schwarz level. Each node gathers the small
// tetrahedral patches in its cooked star, solves their componentwise lumped
// blocks, and averages the overlapping corrections. This adds an intermediate
// topology-aware level between the fine diagonal and object-wide Galerkin
// modes without assembling a global sparse matrix.
kernel void nm_fgmres_precondition_patches(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const NMTetrahedronGPU* tetrahedra [[buffer(1)]],
    device const uint* nodeIncidence [[buffer(2)]],
    device const NMIncidenceRangeGPU* nodeRanges [[buffer(3)]],
    device const float4* basis [[buffer(4)]],
    device const float4* inverseDiagonal [[buffer(5)]],
    device float4* preconditioned [[buffer(6)]],
    device const NMFGMRESStateGPU* states [[buffer(7)]],
    uint global [[thread_position_in_grid]]
) {
    const uint totalNodes = dispatch.environmentCount * dispatch.femNodeCount;
    if (global >= totalNodes || dispatch.femNodeCount == 0u) return;
    const uint environment = global / dispatch.femNodeCount;
    if (states[environment].diagnostics.z > 0.5f) return;
    const NMIncidenceRangeGPU range = nodeRanges[global];
    if (range.objectIndex == NM_INVALID_INDEX) return;
    const uint nodeBase = environment * dispatch.femNodeCount;
    const uint elementBase = environment * dispatch.tetrahedronCount;
    float4 correctionSum = float4(0.0f);
    uint patchCount = 0u;
    for (uint incidence = 0u; incidence < range.count; ++incidence) {
        const uint tetrahedronIndex = nodeIncidence[range.first + incidence];
        if (tetrahedronIndex >= dispatch.tetrahedronCount) continue;
        const NMTetrahedronGPU tetrahedron =
            tetrahedra[elementBase + tetrahedronIndex];
        if ((tetrahedron.identity.w & NM_OBJECT_ACTIVE) == 0u) continue;
        float4 residualSum = float4(0.0f);
        float4 diagonalSum = float4(0.0f);
        for (uint local = 0u; local < 4u; ++local) {
            const uint node = tetrahedron.nodes[local];
            if (node >= dispatch.femNodeCount) continue;
            const uint index = nodeBase + node;
            const float4 inverse = inverseDiagonal[index];
            const bool4 active = inverse > float4(0.0f);
            residualSum += select(float4(0.0f), basis[index], active);
            diagonalSum += select(
                float4(0.0f),
                1.0f / max(inverse, float4(1.0e-30f)),
                active);
        }
        correctionSum += residualSum /
            max(diagonalSum, float4(1.0e-30f));
        ++patchCount;
    }
    if (patchCount == 0u) return;
    constexpr float patchWeight = 0.35f;
    const float4 inverse = inverseDiagonal[global];
    const float4 patch = correctionSum / float(patchCount);
    preconditioned[global] = select(
        float4(0.0f),
        mix(preconditioned[global], patch, patchWeight),
        inverse > float4(0.0f));
}

// Object-scale Galerkin correction over the four low-frequency modes carried
// by the packed mechanics block (three translations plus mean pressure).
// The fine level is the node-star diagonal assembled above; this bounded
// SIMD32 coarse solve removes the error components that diagonal smoothing
// cannot propagate across a deformable object. One group owns one object, so
// it writes directly to the private preconditioned vector without atomics.
kernel void nm_fgmres_precondition_coarse(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const NMContinuumObjectGPU* objects [[buffer(1)]],
    device const float4* basis [[buffer(2)]],
    device const float4* inverseDiagonal [[buffer(3)]],
    device float4* preconditioned [[buffer(4)]],
    device const NMFGMRESStateGPU* states [[buffer(5)]],
    uint lane [[thread_index_in_threadgroup]],
    uint group [[threadgroup_position_in_grid]]
) {
    if (lane >= 32u || dispatch.objectCount == 0u) return;
    const uint environment = group / dispatch.objectCount;
    const uint objectIndex = group - environment * dispatch.objectCount;
    if (environment >= dispatch.environmentCount ||
        states[environment].diagnostics.z > 0.5f) return;
    const NMContinuumObjectGPU object = objects[objectIndex];
    if (object.representation != NM_REPRESENTATION_FEM) return;
    const uint base = environment * dispatch.femNodeCount +
        object.stateOffset;
    float4 residualSum = float4(0.0f);
    float4 residualCorrection = float4(0.0f);
    float4 diagonalSum = float4(0.0f);
    float4 diagonalCorrection = float4(0.0f);
    for (uint local = lane; local < object.stateCount; local += 32u) {
        const uint node = base + local;
        const float4 inverse = inverseDiagonal[node];
        const bool3 freeVelocity = inverse.xyz > float3(0.0f);
        const float4 residual = basis[node];
        const float4 selectedResidual = float4(
            select(float3(0.0f), residual.xyz, freeVelocity),
            inverse.w > 0.0f ? residual.w : 0.0f);
        const float4 diagonal = float4(
            select(float3(0.0f), 1.0f / max(inverse.xyz, float3(1.0e-30f)),
                   freeVelocity),
            inverse.w > 0.0f ? 1.0f / inverse.w : 0.0f);
        const float4 adjustedResidual = selectedResidual - residualCorrection;
        const float4 nextResidual = residualSum + adjustedResidual;
        residualCorrection =
            (nextResidual - residualSum) - adjustedResidual;
        residualSum = nextResidual;
        const float4 adjustedDiagonal = diagonal - diagonalCorrection;
        const float4 nextDiagonal = diagonalSum + adjustedDiagonal;
        diagonalCorrection =
            (nextDiagonal - diagonalSum) - adjustedDiagonal;
        diagonalSum = nextDiagonal;
    }
    residualSum = float4(
        simd_sum(residualSum.x), simd_sum(residualSum.y),
        simd_sum(residualSum.z), simd_sum(residualSum.w));
    diagonalSum = float4(
        simd_sum(diagonalSum.x), simd_sum(diagonalSum.y),
        simd_sum(diagonalSum.z), simd_sum(diagonalSum.w));
    const float4 coarse = residualSum /
        max(diagonalSum, float4(1.0e-30f));
    constexpr float coarseWeight = 0.2f;
    for (uint local = lane; local < object.stateCount; local += 32u) {
        const uint node = base + local;
        const float4 inverse = inverseDiagonal[node];
        float4 value = preconditioned[node];
        value.xyz = select(
            float3(0.0f),
            mix(value.xyz, coarse.xyz, coarseWeight),
            inverse.xyz > float3(0.0f));
        value.w = inverse.w > 0.0f
            ? mix(value.w, coarse.w, coarseWeight) : 0.0f;
        preconditioned[node] = value;
    }
}

kernel void nm_fgmres_build_preconditioner(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMMixedSolverGPU& solver [[buffer(1)]],
    device const NMContinuumObjectGPU* objects [[buffer(2)]],
    device const NMFEMNodeStateGPU* candidate [[buffer(3)]],
    device const NMTetrahedronGPU* tetrahedra [[buffer(4)]],
    device const uint* nodeIncidence [[buffer(5)]],
    device const NMIncidenceRangeGPU* nodeRanges [[buffer(6)]],
    device const NMSchedulerStateGPU* schedulers [[buffer(7)]],
    device const NMMixedMaterialGPU* mixedMaterials [[buffer(8)]],
    device float4* inverseDiagonal [[buffer(9)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.femNodeCount;
    if (global >= total || dispatch.femNodeCount == 0u) return;
    inverseDiagonal[global] = float4(0.0f);
    const uint environment = global / dispatch.femNodeCount;
    const NMIncidenceRangeGPU range = nodeRanges[global];
    if (range.objectIndex == NM_INVALID_INDEX ||
        range.objectIndex >= dispatch.objectCount) return;
    const NMContinuumObjectGPU object = objects[range.objectIndex];
    const float dt = objectTimestep(
        dispatch, schedulers[environment * dispatch.objectCount +
                             range.objectIndex]);
    const float bulk = object.materialIndex < dispatch.mixedMaterialCount
        ? max(mixedMaterials[object.materialIndex].mechanics.x, 0.0f)
        : 0.0f;
    float stiffness = 0.0f;
    for (uint local = 0u; local < range.count; ++local) {
        const uint tetrahedronIndex = nodeIncidence[range.first + local];
        if (tetrahedronIndex >= dispatch.tetrahedronCount) continue;
        const NMTetrahedronGPU tetrahedron = environmentTetrahedron(
            dispatch, tetrahedra, environment, tetrahedronIndex);
        if ((tetrahedron.identity.w & NM_OBJECT_ACTIVE) == 0u) continue;
        const float3x3 inverseRest = matrixFromRows(
            tetrahedron.inverseRestRow0, tetrahedron.inverseRestRow1,
            tetrahedron.inverseRestRow2);
        const float gradientScale = 0.25f * (
            dot(inverseRest[0], inverseRest[0]) +
            dot(inverseRest[1], inverseRest[1]) +
            dot(inverseRest[2], inverseRest[2]));
        stiffness += dt * dt * tetrahedron.inverseRestRow0.w * bulk *
            gradientScale;
    }
    const float mass = max(candidate[global].positionAndMass.w, 0.0f);
    const bool fixedVelocity = candidate[global].restAndFixed.w > 0.5f;
    const float velocityInverse = fixedVelocity ? 0.0f : 1.0f / max(
        mass + max(stiffness, 0.0f), solver.regularization.x);
    const float pressureProjection =
        0.25f + 0.75f * solver.globalization.w;
    // Local pressure Schur approximation:
    //   S ~= C_p + B diag(A_vv)^-1 B^T.
    // `stiffness` is the assembled dt^2*kappa*V*|grad N|^2 scale and
    // velocityInverse is diag(A_vv)^-1, so their product is dimensionless in
    // the normalized q = pi/kappa pressure variable.
    const float pressureSchur = pressureProjection +
        max(stiffness, 0.0f) * velocityInverse;
    const float pressureInverse = (object.flags & NM_OBJECT_MIXED_FEM) != 0u
        ? 1.0f / max(pressureSchur, solver.regularization.x)
        : 0.0f;
    inverseDiagonal[global] = float4(
        velocityInverse, velocityInverse, velocityInverse, pressureInverse);
}

kernel void nm_fgmres_precondition_contacts(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const NMContinuumObjectGPU* objects [[buffer(1)]],
    device const float4* basis [[buffer(2)]],
    device float4* preconditioned [[buffer(3)]],
    device const NMFGMRESStateGPU* states [[buffer(4)]],
    constant NMKKTContactArguments& contact [[buffer(5)]],
    uint global [[thread_position_in_grid]]
) {
    if (dispatch.reservedMixed1 == 0u) return;
    const uint environment = global / dispatch.reservedMixed1;
    const uint slot = global - environment * dispatch.reservedMixed1;
    if (environment >= dispatch.environmentCount ||
        slot >= contact.activeCounts[environment]) return;
    const uint pairIndex = contact.activePairs[global];
    if (pairIndex >= dispatch.contactPairCount) return;
    const uint objectIndex = contact.pairs[pairIndex].objectIndex;
    if (objectIndex >= dispatch.objectCount ||
        objects[objectIndex].representation != NM_REPRESENTATION_FEM) return;
    if (states[environment].diagnostics.z > 0.5f) return;
    const uint contactIndex =
        fgmresContactBase(dispatch, environment) + pairIndex;
    preconditioned[contactIndex] = float4(
        basis[contactIndex].x, 0.0f, 0.0f, 0.0f);
}

kernel void nm_fgmres_precondition_deformable_contacts(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const float4* basis [[buffer(1)]],
    device float4* preconditioned [[buffer(2)]],
    device const NMFGMRESStateGPU* states [[buffer(3)]],
    constant NMKKTContactArguments& contact [[buffer(4)]],
    uint global [[thread_position_in_grid]]
) {
    uint environment = 0u, slot = 0u;
    if (!fgmresDeformableActiveWork(
            dispatch, contact, global, environment, slot) ||
        states[environment].diagnostics.z > 0.5f) return;
    const uint row = fgmresContactBase(dispatch, environment) +
        dispatch.contactPairCount + slot;
    preconditioned[row] = float4(basis[row].xyz, 0.0f);
}

// Approximate block-triangular contact elimination. Contact-space rows are
// preconditioned first; this pass applies D_mechanics^-1 J^T to the actual
// rigid and deformable incidences, coupling separated surface patches inside
// the right preconditioner without atomics or a materialized Schur matrix.
kernel void nm_fgmres_precondition_contact_cross(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const float4* inverseDiagonal [[buffer(1)]],
    device float4* preconditioned [[buffer(2)]],
    constant NMKKTContactArguments& contact [[buffer(3)]],
    device const NMFGMRESStateGPU* states [[buffer(4)]],
    uint global [[thread_position_in_grid]]
) {
    const uint totalNodes = dispatch.environmentCount * dispatch.femNodeCount;
    if (global >= totalNodes || dispatch.femNodeCount == 0u) return;
    const uint environment = global / dispatch.femNodeCount;
    const uint node = global - environment * dispatch.femNodeCount;
    if (states[environment].diagnostics.z > 0.5f) return;
    const uint contactBase = fgmresContactBase(dispatch, environment);
    float3 lifted = float3(0.0f);
    const uint unifiedNode = dispatch.gridNodeCount + node;
    const NMIncidenceRangeGPU rigidRange = contact.nodeRanges[unifiedNode];
    for (uint incidence = 0u; incidence < rigidRange.count; ++incidence) {
        const uint pairIndex = contact.nodeIncidence[
            rigidRange.first + incidence];
        if (pairIndex >= dispatch.contactPairCount) continue;
        const NMContactSampleGPU sample = contact.samples[
            environment * dispatch.contactPairCount + pairIndex];
        if ((sample.identity.w & NM_CONTACT_VALID) == 0u) continue;
        lifted += sample.normalAndVelocity.xyz *
            preconditioned[contactBase + pairIndex].x;
    }
    const uint capacity = dispatch.deformableContactCapacity;
    const uint deformableBase = environment * capacity;
    const NMIncidenceRangeGPU deformableRange =
        contact.deformableNodeRanges[global];
    for (uint incidence = 0u; incidence < deformableRange.count;
         ++incidence) {
        const uint encoded = contact.deformableNodeIncidence[
            deformableRange.first + incidence];
        const uint slot = encoded >> 2u;
        const uint local = encoded & 3u;
        if (slot >= capacity || local >= 4u) continue;
        const NMDeformableContactGPU deformable =
            contact.deformableContacts[deformableBase + slot];
        if ((deformable.identity.w & NM_CONTACT_VALID) == 0u ||
            deformable.nodes[local] != node) continue;
        float3 tangent0, tangent1;
        deformableContactFrame(
            deformable.normalAndTOI.xyz, tangent0, tangent1);
        const float3 lambda = preconditioned[
            contactBase + dispatch.contactPairCount + slot].xyz;
        const float3 contactDirection =
            deformable.normalAndTOI.xyz * lambda.x +
            tangent0 * lambda.y + tangent1 * lambda.z;
        lifted += deformable.weights[local] * contactDirection;
    }
    constexpr float couplingWeight = 0.75f;
    preconditioned[global].xyz += couplingWeight *
        inverseDiagonal[global].xyz * lifted;
}

kernel void nm_fgmres_import_field_residual(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const float4* fieldResidual [[buffer(1)]],
    device float4* kktResidual [[buffer(2)]],
    uint global [[thread_position_in_grid]]
) {
    const uint totalNodes = dispatch.environmentCount * dispatch.femNodeCount;
    if (global < totalNodes)
        kktResidual[totalNodes + global] = fieldResidual[global];
}

kernel void nm_fgmres_field_smoother_initialize(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const NMIncidenceRangeGPU* nodeRanges [[buffer(1)]],
    device const float4* basis [[buffer(2)]],
    device const float4* inverseDiagonal [[buffer(3)]],
    device float4* solution [[buffer(4)]],
    device float4* residual [[buffer(5)]],
    device float4* preconditioned [[buffer(6)]],
    device float4* direction [[buffer(7)]],
    device const NMFGMRESStateGPU* states [[buffer(8)]],
    uint global [[thread_position_in_grid]]
) {
    const uint totalNodes = dispatch.environmentCount * dispatch.femNodeCount;
    if (global >= totalNodes) return;
    solution[global] = residual[global] = preconditioned[global] =
        direction[global] = float4(0.0f);
    const uint environment = global / dispatch.femNodeCount;
    const uint objectIndex = nodeRanges[global].objectIndex;
    if (objectIndex == NM_INVALID_INDEX || objectIndex >= dispatch.objectCount ||
        states[environment].diagnostics.z > 0.5f) return;
    const float4 r = basis[totalNodes + global];
    const float4 z = inverseDiagonal[global] * r;
    residual[global] = r;
    preconditioned[global] = z;
    direction[global] = z;
}

kernel void nm_fgmres_field_smoother_export(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const NMIncidenceRangeGPU* nodeRanges [[buffer(1)]],
    device const float4* solution [[buffer(2)]],
    device float4* preconditionedBasis [[buffer(3)]],
    device const NMFGMRESStateGPU* states [[buffer(4)]],
    uint global [[thread_position_in_grid]]
) {
    const uint totalNodes = dispatch.environmentCount * dispatch.femNodeCount;
    if (global >= totalNodes) return;
    const uint environment = global / dispatch.femNodeCount;
    const uint objectIndex = nodeRanges[global].objectIndex;
    if (objectIndex == NM_INVALID_INDEX || objectIndex >= dispatch.objectCount ||
        states[environment].diagnostics.z > 0.5f) return;
    preconditionedBasis[totalNodes + global] = solution[global];
}

kernel void nm_fgmres_field_smooth(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const NMIncidenceRangeGPU* nodeRanges [[buffer(1)]],
    device const float4* basis [[buffer(2)]],
    device const float4* inverseDiagonal [[buffer(3)]],
    device const float4* operatorValue [[buffer(4)]],
    device float4* solution [[buffer(5)]],
    device const NMFGMRESStateGPU* states [[buffer(6)]],
    constant float& damping [[buffer(7)]],
    uint global [[thread_position_in_grid]]
) {
    const uint totalNodes = dispatch.environmentCount * dispatch.femNodeCount;
    if (global >= totalNodes) return;
    const uint environment = global / dispatch.femNodeCount;
    const uint objectIndex = nodeRanges[global].objectIndex;
    if (objectIndex == NM_INVALID_INDEX || objectIndex >= dispatch.objectCount ||
        states[environment].diagnostics.z > 0.5f) return;
    const float4 defect = basis[totalNodes + global] - operatorValue[global];
    solution[global] += clamp(damping, 0.0f, 1.0f) *
        inverseDiagonal[global] * defect;
}

kernel void nm_fgmres_precondition_fields(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const NMIncidenceRangeGPU* nodeRanges [[buffer(1)]],
    device const float4* inverseDiagonal [[buffer(2)]],
    device const float4* basis [[buffer(3)]],
    device float4* preconditioned [[buffer(4)]],
    device const NMFGMRESStateGPU* states [[buffer(5)]],
    uint global [[thread_position_in_grid]]
) {
    const uint totalNodes = dispatch.environmentCount * dispatch.femNodeCount;
    if (global >= totalNodes) return;
    const uint environment = global / dispatch.femNodeCount;
    const uint objectIndex = nodeRanges[global].objectIndex;
    if (objectIndex == NM_INVALID_INDEX || objectIndex >= dispatch.objectCount)
        return;
    if (states[environment].diagnostics.z > 0.5f) return;
    const uint fieldIndex = totalNodes + global;
    // The field equations are left-equilibrated by D^-1. Their right
    // preconditioner is therefore identity at this level.
    preconditioned[fieldIndex] = basis[fieldIndex];
    (void)inverseDiagonal;
}

kernel void nm_fgmres_scale_field_operator(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const float4* inverseDiagonal [[buffer(1)]],
    device float4* work [[buffer(2)]],
    uint global [[thread_position_in_grid]]
) {
    const uint totalNodes = dispatch.environmentCount * dispatch.femNodeCount;
    if (global < totalNodes)
        work[totalNodes + global] *= inverseDiagonal[global];
}

kernel void nm_fgmres_smooth_fields(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const NMIncidenceRangeGPU* nodeRanges [[buffer(1)]],
    device const float4* inverseDiagonal [[buffer(2)]],
    device const float4* basis [[buffer(3)]],
    device const float4* operatorValue [[buffer(4)]],
    device float4* preconditioned [[buffer(5)]],
    device const NMFGMRESStateGPU* states [[buffer(6)]],
    uint global [[thread_position_in_grid]]
) {
    const uint totalNodes = dispatch.environmentCount * dispatch.femNodeCount;
    if (global >= totalNodes) return;
    const uint environment = global / dispatch.femNodeCount;
    const uint objectIndex = nodeRanges[global].objectIndex;
    if (objectIndex == NM_INVALID_INDEX || objectIndex >= dispatch.objectCount)
        return;
    if (states[environment].diagnostics.z > 0.5f) return;
    const uint fieldIndex = totalNodes + global;
    const float4 defect = basis[fieldIndex] -
        inverseDiagonal[global] * operatorValue[global];
    // Damped block Jacobi is deliberately fixed-count: it is a bounded,
    // matrix-free right preconditioner, not a second convergence authority.
    preconditioned[fieldIndex] += 0.72f * defect;
}

kernel void nm_fgmres_precondition_cross(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const NMIncidenceRangeGPU* nodeRanges [[buffer(1)]],
    device const NMContinuumObjectGPU* objects [[buffer(2)]],
    device const NMMixedMaterialGPU* mixedMaterials [[buffer(3)]],
    device const float4* inverseMechanicalDiagonal [[buffer(4)]],
    device float4* preconditioned [[buffer(5)]],
    device const NMFGMRESStateGPU* states [[buffer(6)]],
    uint global [[thread_position_in_grid]]
) {
    const uint totalNodes = dispatch.environmentCount * dispatch.femNodeCount;
    if (global >= totalNodes || dispatch.femNodeCount == 0u) return;
    const uint environment = global / dispatch.femNodeCount;
    const uint objectIndex = nodeRanges[global].objectIndex;
    if (objectIndex == NM_INVALID_INDEX || objectIndex >= dispatch.objectCount)
        return;
    if (states[environment].diagnostics.z > 0.5f) return;
    const NMContinuumObjectGPU object = objects[objectIndex];
    if ((object.flags & NM_OBJECT_MULTIPHYSICS) == 0u ||
        object.materialIndex >= dispatch.mixedMaterialCount) return;
    // Lower block-triangular elimination for
    // C_pT = -3 alpha_T. This keeps temperature-scaled directions from
    // poisoning the pressure Schur solve without materializing a global
    // matrix or synchronizing the device.
    const float temperatureCorrection = preconditioned[
        totalNodes + global].x;
    preconditioned[global].w += inverseMechanicalDiagonal[global].w *
        3.0f * mixedMaterials[object.materialIndex].mechanics.y *
        temperatureCorrection;
}

// Distributed generalized-Jacobian application. Constitutive work is one
// thread per FEM node; no object is serialized through one long-lived group.
kernel void nm_fgmres_apply_nodes(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMMicrostepGPU& microstep [[buffer(1)]],
    constant NMMixedSolverGPU& solver [[buffer(2)]],
    device const NMContinuumObjectGPU* objects [[buffer(3)]],
    device const NMMaterialGPU* materials [[buffer(4)]],
    device const NMScalarProgramGPU* programs [[buffer(5)]],
    device const NMExpressionInstructionGPU* instructions [[buffer(6)]],
    device const float* environmentParameters [[buffer(7)]],
    device const NMFEMNodeStateGPU* candidate [[buffer(8)]],
    device const NMTetrahedronGPU* tetrahedra [[buffer(9)]],
    device const float* materialState [[buffer(10)]],
    device const uint* nodeIncidence [[buffer(11)]],
    device const NMIncidenceRangeGPU* nodeRanges [[buffer(12)]],
    device const NMSchedulerStateGPU* schedulers [[buffer(13)]],
    device const NMAdaptiveStateGPU* adaptive [[buffer(14)]],
    device const NMMixedMaterialGPU* mixedMaterials [[buffer(15)]],
    device const NMFEMFieldStateGPU* fields [[buffer(16)]],
    device const NMLearnedMaterialGPU* learnedMaterials [[buffer(17)]],
    device const NMLearnedLayerGPU* learnedLayers [[buffer(18)]],
    device const float* learnedWeights [[buffer(19)]],
    device const float4* direction [[buffer(20)]],
    device float4* work [[buffer(21)]],
    constant NMKKTContactArguments& contact [[buffer(22)]],
    device const NMFGMRESStateGPU* states [[buffer(23)]],
    device NMMatterStatusGPU* statuses [[buffer(24)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.femNodeCount;
    if (global >= total || dispatch.femNodeCount == 0u) return;
    work[global] = float4(0.0f);
    const uint environment = global / dispatch.femNodeCount;
    const uint localNode = global - environment * dispatch.femNodeCount;
    const NMIncidenceRangeGPU range = nodeRanges[global];
    if (range.objectIndex == NM_INVALID_INDEX ||
        range.objectIndex >= dispatch.objectCount) return;
    const uint objectIndex = range.objectIndex;
    const uint objectGlobal = environment * dispatch.objectCount + objectIndex;
    const NMContinuumObjectGPU object = objects[objectIndex];
    if (states[environment].diagnostics.z > 0.5f ||
        object.representation != NM_REPRESENTATION_FEM ||
        !objectDue(object, schedulers[objectGlobal], adaptive[objectGlobal],
                   microstep) || !environmentHealthy(statuses, environment))
        return;
    bool valid = true;
    work[global] = fusedFEMOperatorAtNode(
        dispatch, microstep, solver, environment, objectIndex, localNode,
        objects, materials, programs, instructions, environmentParameters,
        candidate, tetrahedra, materialState, nodeIncidence, nodeRanges,
        schedulers, mixedMaterials, fields, learnedMaterials, learnedLayers,
        learnedWeights, direction, valid);
    const uint unifiedNode = dispatch.gridNodeCount + localNode;
    const NMIncidenceRangeGPU contactRange = contact.nodeRanges[unifiedNode];
    const uint sampleBase = environment * dispatch.contactPairCount;
    const uint contactBase = fgmresContactBase(dispatch, environment);
    for (uint incidence = 0u; incidence < contactRange.count; ++incidence) {
        const uint pairIndex = contact.nodeIncidence[
            contactRange.first + incidence];
        if (pairIndex >= dispatch.contactPairCount ||
            contact.pairs[pairIndex].objectIndex != objectIndex) continue;
        const NMContactSampleGPU sample =
            contact.samples[sampleBase + pairIndex];
        if ((sample.identity.w & NM_CONTACT_VALID) != 0u) {
            if ((dispatch.flags & NM_MATTER_IPC) != 0u) {
                // The contact row is an auxiliary barrier-force increment.
                // Keeping it in the generalized vector lets the eliminated
                // rigid/articulated Delassus response participate in the
                // same linearization instead of treating the rigid side as
                // fixed.
                work[global].xyz -= sample.normalAndVelocity.xyz *
                    direction[contactBase + pairIndex].x;
            } else {
                work[global].xyz -= sample.normalAndVelocity.xyz *
                    direction[contactBase + pairIndex].x;
            }
        }
    }
    const uint deformableCapacity = dispatch.deformableContactCapacity;
    const uint deformableBase = environment * deformableCapacity;
    const NMIncidenceRangeGPU deformableRange =
        contact.deformableNodeRanges[global];
    for (uint incidence = 0u; incidence < deformableRange.count;
         ++incidence) {
        const uint encoded = contact.deformableNodeIncidence[
            deformableRange.first + incidence];
        const uint slot = encoded >> 2u;
        const uint local = encoded & 3u;
        if (slot >= deformableCapacity || local >= 4u) continue;
        const NMDeformableContactGPU deformable =
            contact.deformableContacts[deformableBase + slot];
        if ((deformable.identity.w & NM_CONTACT_VALID) == 0u ||
            deformable.nodes[local] != localNode) continue;
        if ((dispatch.flags & NM_MATTER_IPC) != 0u) {
            const uint row = contactBase + dispatch.contactPairCount + slot;
            work[global].xyz -= deformable.weights[local] *
                deformable.normalAndTOI.xyz * direction[row].x;
        } else {
            const uint row = contactBase + dispatch.contactPairCount + slot;
            float3 tangent0, tangent1;
            deformableContactFrame(
                deformable.normalAndTOI.xyz, tangent0, tangent1);
            const float3 contactDirection =
                deformable.normalAndTOI.xyz * direction[row].x +
                tangent0 * direction[row].y + tangent1 * direction[row].z;
            work[global].xyz -= deformable.weights[local] * contactDirection;
        }
    }
    if (!valid) recordFailure(
        statuses[environment], NM_STATUS_LINEAR_SOLVER_FAILURE,
        objectIndex, localNode, float4(0.0f));
}

kernel void nm_fgmres_gather_nodes(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMMicrostepGPU& microstep [[buffer(1)]],
    device const NMContinuumObjectGPU* objects [[buffer(2)]],
    device const NMFEMNodeStateGPU* candidate [[buffer(3)]],
    device const NMTetrahedronGPU* tetrahedra [[buffer(4)]],
    device const NMFEMElementVectorGPU* elementOperator [[buffer(5)]],
    device const uint* nodeIncidence [[buffer(6)]],
    device const NMIncidenceRangeGPU* nodeRanges [[buffer(7)]],
    device const NMSchedulerStateGPU* schedulers [[buffer(8)]],
    device const NMAdaptiveStateGPU* adaptive [[buffer(9)]],
    device const float4* direction [[buffer(10)]],
    device float4* work [[buffer(11)]],
    constant NMKKTContactArguments& contact [[buffer(12)]],
    device const NMFGMRESStateGPU* states [[buffer(13)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.femNodeCount;
    if (global >= total || dispatch.femNodeCount == 0u) return;
    work[global] = float4(0.0f);
    const uint environment = global / dispatch.femNodeCount;
    const uint node = global - environment * dispatch.femNodeCount;
    const NMIncidenceRangeGPU range = nodeRanges[global];
    if (range.objectIndex == NM_INVALID_INDEX ||
        range.objectIndex >= dispatch.objectCount) return;
    const uint objectIndex = range.objectIndex;
    const uint objectGlobal = environment * dispatch.objectCount + objectIndex;
    const NMContinuumObjectGPU object = objects[objectIndex];
    if (states[environment].diagnostics.z > 0.5f ||
        object.representation != NM_REPRESENTATION_FEM ||
        !objectDue(object, schedulers[objectGlobal], adaptive[objectGlobal],
                   microstep))
        return;
    float3 derivativeForce = float3(0.0f);
    float pressureOperator = 0.0f;
    uint activeElements = 0u;
    const uint elementBase = environment * dispatch.tetrahedronCount;
    for (uint local = 0u; local < range.count; ++local) {
        const uint tetrahedronIndex = nodeIncidence[range.first + local];
        if (tetrahedronIndex >= dispatch.tetrahedronCount) continue;
        const NMTetrahedronGPU tetrahedron = environmentTetrahedron(
            dispatch, tetrahedra, environment, tetrahedronIndex);
        if ((tetrahedron.identity.w & NM_OBJECT_ACTIVE) == 0u) continue;
        const float4 value = elementNodeVector(
            elementOperator[elementBase + tetrahedronIndex], tetrahedron, node);
        derivativeForce += value.xyz;
        pressureOperator += value.w;
        ++activeElements;
    }
    const float dt = objectTimestep(dispatch, schedulers[objectGlobal]);
    const bool fixedVelocity = candidate[global].restAndFixed.w > 0.5f;
    work[global] = float4(
        fixedVelocity ? float3(0.0f) :
            candidate[global].positionAndMass.w * direction[global].xyz -
                dt * dt * derivativeForce,
        activeElements > 0u
            ? pressureOperator / float(activeElements) : 0.0f);
    const uint unifiedNode = dispatch.gridNodeCount + node;
    const NMIncidenceRangeGPU contactRange = contact.nodeRanges[unifiedNode];
    const uint sampleBase = environment * dispatch.contactPairCount;
    const uint contactBase = fgmresContactBase(dispatch, environment);
    for (uint incidence = 0u; incidence < contactRange.count; ++incidence) {
        const uint pairIndex = contact.nodeIncidence[
            contactRange.first + incidence];
        if (pairIndex >= dispatch.contactPairCount ||
            contact.pairs[pairIndex].objectIndex != objectIndex) continue;
        const NMContactSampleGPU sample =
            contact.samples[sampleBase + pairIndex];
        if ((sample.identity.w & NM_CONTACT_VALID) != 0u)
            work[global].xyz -= sample.normalAndVelocity.xyz *
                direction[contactBase + pairIndex].x;
    }
    const uint deformableCapacity = dispatch.deformableContactCapacity;
    const uint deformableBase = environment * deformableCapacity;
    const NMIncidenceRangeGPU deformableRange =
        contact.deformableNodeRanges[global];
    for (uint incidence = 0u; incidence < deformableRange.count;
         ++incidence) {
        const uint encoded = contact.deformableNodeIncidence[
            deformableRange.first + incidence];
        const uint slot = encoded >> 2u;
        const uint local = encoded & 3u;
        if (slot >= deformableCapacity || local >= 4u) continue;
        const NMDeformableContactGPU deformable =
            contact.deformableContacts[deformableBase + slot];
        if ((deformable.identity.w & NM_CONTACT_VALID) == 0u ||
            deformable.nodes[local] != node) continue;
        const uint row = contactBase + dispatch.contactPairCount + slot;
        float3 tangent0, tangent1;
        deformableContactFrame(
            deformable.normalAndTOI.xyz, tangent0, tangent1);
        const float3 contactDirection =
            deformable.normalAndTOI.xyz * direction[row].x +
            tangent0 * direction[row].y + tangent1 * direction[row].z;
        work[global].xyz -= deformable.weights[local] * contactDirection;
    }
}

kernel void nm_fgmres_apply_contacts(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMMixedSolverGPU& solver [[buffer(1)]],
    device const NMContinuumObjectGPU* objects [[buffer(2)]],
    device const NMMaterialGPU* materials [[buffer(3)]],
    device const NMSchedulerStateGPU* schedulers [[buffer(4)]],
    device const NMFEMNodeStateGPU* candidate [[buffer(5)]],
    device const float4* direction [[buffer(6)]],
    device float4* work [[buffer(7)]],
    constant NMKKTContactArguments& contact [[buffer(8)]],
    device const NMFGMRESStateGPU* states [[buffer(9)]],
    uint global [[thread_position_in_grid]]
) {
    if (dispatch.reservedMixed1 == 0u) return;
    const uint environment = global / dispatch.reservedMixed1;
    const uint slot = global - environment * dispatch.reservedMixed1;
    if (environment >= dispatch.environmentCount ||
        slot >= contact.activeCounts[environment]) return;
    const uint pairIndex = contact.activePairs[global];
    if (pairIndex >= dispatch.contactPairCount) return;
    const NMContactPairGPU pair = contact.pairs[pairIndex];
    const uint objectIndex = pair.objectIndex;
    if (objectIndex >= dispatch.objectCount) return;
    const uint objectGlobal = environment * dispatch.objectCount + objectIndex;
    const uint sampleBase = environment * dispatch.contactPairCount;
    const uint contactIndex =
        fgmresContactBase(dispatch, environment) + pairIndex;
    work[contactIndex] = float4(0.0f);
    if (states[environment].diagnostics.z > 0.5f) return;
    const NMContactSampleGPU sample = contact.samples[sampleBase + pairIndex];
    if ((sample.identity.w & NM_CONTACT_VALID) == 0u) return;
    const NMIncidenceRangeGPU responseRange = contact.responseRanges[slot];
    float diagonal = 0.0f;
    float gapVelocity = sample.normalAndVelocity.w;
    float directionGap = 0.0f;
    float continuumDirectionGap = 0.0f;
    const uint nodeBase = environment * dispatch.femNodeCount;
    if (pair.continuumNode < dispatch.gridNodeCount) {
        continuumDirectionGap = dot(
            sample.normalAndVelocity.xyz,
            direction[fgmresMPMIndex(
                dispatch, environment, pair.continuumNode)].xyz);
    } else {
        const uint femNode = pair.continuumNode - dispatch.gridNodeCount;
        if (femNode < dispatch.femNodeCount)
            continuumDirectionGap = dot(
                sample.normalAndVelocity.xyz,
                direction[nodeBase + femNode].xyz);
    }
    const uint activeCount = min(
        contact.activeCounts[environment], dispatch.reservedMixed1);
    for (uint local = 0u; local < responseRange.count; ++local) {
        const uint entry = responseRange.first + local;
        if (entry >= dispatch.reservedMixed0) continue;
        const uint columnSlot = contact.responseColumns[entry];
        if (columnSlot >= activeCount) continue;
        const uint columnPair = contact.activePairs[
            environment * dispatch.reservedMixed1 + columnSlot];
        if (columnPair >= dispatch.contactPairCount) continue;
        const NMContactSampleGPU other =
            contact.samples[sampleBase + columnPair];
        if ((other.identity.w & NM_CONTACT_VALID) == 0u) continue;
        const float full = contact.responseValues[
            environment * dispatch.reservedMixed0 + entry];
        if (columnSlot == slot) diagonal = full;
        float primary = 0.0f;
        const NMContactPairGPU otherPair = contact.pairs[columnPair];
        if (pair.continuumNode >= dispatch.gridNodeCount &&
            otherPair.continuumNode == pair.continuumNode) {
            const uint femNode = pair.continuumNode - dispatch.gridNodeCount;
            if (femNode < dispatch.femNodeCount)
                primary = candidate[nodeBase + femNode]
                    .velocityAndInverseMass.w * dot(
                        sample.normalAndVelocity.xyz,
                        other.normalAndVelocity.xyz);
        }
        const float reduced = full - primary;
        gapVelocity += reduced * other.impulseAndNormal.w;
        directionGap += reduced * direction[
            fgmresContactBase(dispatch, environment) + columnPair].x;
    }
    if ((dispatch.flags & NM_MATTER_IPC) != 0u) {
        // Algebraic barrier linearization with an auxiliary force row:
        //   dLambda - b''(d) (Jc dV + Wr dLambda) = 0.
        // Wr is the rigid/articulated part of the sparse Delassus response;
        // the continuum contribution is represented explicitly by its primal
        // FEM/MPM direction above.
        work[contactIndex].x = direction[contactIndex].x -
            sample.barrier.y * (continuumDirectionGap + directionGap);
        return;
    }
    const float metric = max(diagonal, solver.regularization.x);
    const NMMaterialGPU objectMaterial = materials[objects[objectIndex].materialIndex];
    const NMMaterialGPU interfaceMaterial = materials[pair.materialInterface];
    const float dt = objectTimestep(dispatch, schedulers[objectGlobal]);
    const float rawBias = (dispatch.numericalLimits.x -
        sample.pointAndSeparation.w) / max(dt, 1.0e-12f);
    const float bias = min(max(rawBias, 0.0f), dispatch.numericalLimits.y);
    const bool differentiableBias = rawBias > 0.0f &&
        rawBias < dispatch.numericalLimits.y;
    // x_candidate = x_n + dt*v, so d[(slop-separation)/dt]/dv = -J
    // on the active, unclamped bias branch. d(v_n-bias) therefore carries
    // two FEM J*dv terms. Eliminated rigid/articulated response remains in W.
    directionGap += (differentiableBias ? 2.0f : 1.0f) *
        continuumDirectionGap;
    const float restitution = max(objectMaterial.interfaceResponse.z,
                                  interfaceMaterial.interfaceResponse.z);
    const float bounce = sample.normalAndVelocity.w < -0.2f
        ? -restitution * sample.normalAndVelocity.w : 0.0f;
    const float lambda = sample.impulseAndNormal.w;
    const float projected = max(
        lambda - (gapVelocity - bias - bounce) / metric, 0.0f);
    work[contactIndex].x = (projected > 0.0f || lambda > 0.0f)
        ? directionGap / metric : direction[contactIndex].x;
}

kernel void nm_fgmres_apply_deformable_contacts(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMMixedSolverGPU& solver [[buffer(1)]],
    device const NMSchedulerStateGPU* schedulers [[buffer(2)]],
    device const float4* direction [[buffer(3)]],
    device float4* work [[buffer(4)]],
    constant NMKKTContactArguments& contact [[buffer(5)]],
    device const NMFGMRESStateGPU* states [[buffer(6)]],
    uint global [[thread_position_in_grid]]
) {
    const uint capacity = dispatch.deformableContactCapacity;
    uint environment = 0u, slot = 0u;
    if (!fgmresDeformableActiveWork(
            dispatch, contact, global, environment, slot)) return;
    const uint row = fgmresContactBase(dispatch, environment) +
        dispatch.contactPairCount + slot;
    work[row] = float4(0.0f);
    if (states[environment].diagnostics.z > 0.5f) return;
    const NMDeformableContactGPU deformable =
        contact.deformableContacts[environment * capacity + slot];
    if ((deformable.identity.w & NM_CONTACT_VALID) == 0u ||
        deformable.identity.x >= dispatch.objectCount) return;
    const uint nodeBase = environment * dispatch.femNodeCount;
    float3 relativeDirection = float3(0.0f);
    for (uint local = 0u; local < 4u; ++local)
        if (deformable.nodes[local] < dispatch.femNodeCount)
            relativeDirection += deformable.weights[local] *
                direction[nodeBase + deformable.nodes[local]].xyz;
    float3 tangent0, tangent1;
    deformableContactFrame(
        deformable.normalAndTOI.xyz, tangent0, tangent1);
    const float normalDirection = dot(
        deformable.normalAndTOI.xyz, relativeDirection);
    if ((dispatch.flags & NM_MATTER_IPC) != 0u) {
        work[row] = float4(
            direction[row].x - deformable.barrier.y * normalDirection,
            direction[row].y,
            direction[row].z,
            0.0f);
        return;
    }
    const float2 tangentDirection = float2(
        dot(tangent0, relativeDirection),
        dot(tangent1, relativeDirection));
    const float metric = max(
        deformable.velocityAndResponse.w, solver.regularization.x);
    const float normalVelocity = dot(
        deformable.normalAndTOI.xyz,
        deformable.velocityAndResponse.xyz);
    const float dt = objectTimestep(
        dispatch, schedulers[environment * dispatch.objectCount +
                             deformable.identity.x]);
    const float rawBias = (dispatch.numericalLimits.x -
        deformable.pointAndSeparation.w) / max(dt, 1.0e-12f);
    const float target = clamp(
        rawBias, 0.0f, dispatch.numericalLimits.y);
    const bool differentiableBias = rawBias > 0.0f &&
        rawBias < dispatch.numericalLimits.y;
    const float scaledNormalDirection =
        (differentiableBias ? 2.0f : 1.0f) * normalDirection;
    const float3 lambda = float3(
        max(deformable.impulseAndFriction.x, 0.0f),
        deformable.impulseAndFriction.yz);
    const float normalArgument = lambda.x -
        (normalVelocity - target) / metric;
    const float projectedNormal = max(normalArgument, 0.0f);
    const bool normalActive = normalArgument > 0.0f || lambda.x > 0.0f;
    const float3 deltaLambda = direction[row].xyz;
    const float deltaProjectedNormal = normalActive
        ? deltaLambda.x - scaledNormalDirection / metric : 0.0f;
    const float deltaNormalResidual =
        deltaLambda.x - deltaProjectedNormal;
    const float2 tangentVelocity = float2(
        dot(tangent0, deformable.velocityAndResponse.xyz),
        dot(tangent1, deformable.velocityAndResponse.xyz));
    const float2 trialTangent = lambda.yz - tangentVelocity / metric;
    const float2 deltaTrial =
        deltaLambda.yz - tangentDirection / metric;
    const float radius =
        deformable.impulseAndFriction.w * projectedNormal;
    const float deltaRadius =
        deformable.impulseAndFriction.w * deltaProjectedNormal;
    const float trialLength = length(trialTangent);
    float2 deltaProjection = float2(0.0f);
    if (trialLength <= radius) {
        deltaProjection = deltaTrial;
    } else if (trialLength > 1.0e-20f && radius > 0.0f) {
        const float2 unit = trialTangent / trialLength;
        deltaProjection = deltaRadius * unit +
            (radius / trialLength) *
                (deltaTrial - unit * dot(unit, deltaTrial));
    }
    work[row] = float4(
        deltaNormalResidual,
        deltaLambda.yz - deltaProjection,
        0.0f);
}

kernel void nm_fgmres_project(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant uint& row [[buffer(1)]],
    constant uint& column [[buffer(2)]],
    device const NMContinuumObjectGPU* objects [[buffer(3)]],
    device const float4* basis [[buffer(4)]],
    device const float4* work [[buffer(5)]],
    device float* hessenberg [[buffer(6)]],
    device const NMFGMRESStateGPU* states [[buffer(7)]],
    constant NMKKTContactArguments& contact [[buffer(8)]],
    uint lane [[thread_index_in_threadgroup]],
    uint group [[threadgroup_position_in_grid]]
) {
    if (lane >= 32u || dispatch.objectCount == 0u) return;
    const uint environment = group / dispatch.objectCount;
    const uint objectIndex = group - environment * dispatch.objectCount;
    if (environment >= dispatch.environmentCount ||
        states[environment].diagnostics.z > 0.5f) return;
    const NMContinuumObjectGPU object = objects[objectIndex];
    float value = 0.0f;
    const uint base = environment * dispatch.femNodeCount + object.stateOffset;
    for (uint local = lane; local < object.stateCount; local += 32u)
        value += dot(basis[base + local], work[base + local]);
    const uint contactBase = fgmresContactBase(dispatch, environment);
    const uint activeCount = min(
        contact.activeCounts[environment], dispatch.reservedMixed1);
    for (uint slot = lane; slot < activeCount; slot += 32u) {
        const uint pairIndex = contact.activePairs[
            environment * dispatch.reservedMixed1 + slot];
        if (pairIndex < dispatch.contactPairCount &&
            contact.pairs[pairIndex].objectIndex == objectIndex)
            value += basis[contactBase + pairIndex].x *
                work[contactBase + pairIndex].x;
    }
    value = simd_sum(value);
    if (lane == 0u)
        hessenberg[fgmresMatrixIndex(group, row, column)] = value;
}

kernel void nm_fgmres_orthogonalize(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant uint& row [[buffer(1)]],
    constant uint& column [[buffer(2)]],
    device const NMIncidenceRangeGPU* nodeRanges [[buffer(3)]],
    device const float4* basis [[buffer(4)]],
    device float4* work [[buffer(5)]],
    device const float* hessenberg [[buffer(6)]],
    device const NMFGMRESStateGPU* states [[buffer(7)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.femNodeCount;
    if (global >= total || dispatch.femNodeCount == 0u) return;
    const uint environment = global / dispatch.femNodeCount;
    const uint objectIndex = nodeRanges[global].objectIndex;
    if (objectIndex == NM_INVALID_INDEX || objectIndex >= dispatch.objectCount)
        return;
    if (states[environment].diagnostics.z > 0.5f) return;
    const float h = hessenberg[
        fgmresMatrixIndex(environment, row, column)
    ];
    work[global] -= h * basis[global];
}

kernel void nm_fgmres_orthogonalize_contacts(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant uint& row [[buffer(1)]],
    constant uint& column [[buffer(2)]],
    device const float4* basis [[buffer(3)]],
    device float4* work [[buffer(4)]],
    device const float* hessenberg [[buffer(5)]],
    device const NMFGMRESStateGPU* states [[buffer(6)]],
    constant NMKKTContactArguments& contact [[buffer(7)]],
    uint global [[thread_position_in_grid]]
) {
    if (dispatch.reservedMixed1 == 0u) return;
    const uint environment = global / dispatch.reservedMixed1;
    const uint slot = global - environment * dispatch.reservedMixed1;
    if (environment >= dispatch.environmentCount ||
        slot >= contact.activeCounts[environment]) return;
    const uint pairIndex = contact.activePairs[global];
    if (pairIndex >= dispatch.contactPairCount) return;
    const uint objectIndex = contact.pairs[pairIndex].objectIndex;
    if (objectIndex >= dispatch.objectCount) return;
    if (states[environment].diagnostics.z > 0.5f) return;
    const uint contactIndex =
        fgmresContactBase(dispatch, environment) + pairIndex;
    work[contactIndex].x -= hessenberg[
        fgmresMatrixIndex(environment, row, column)] *
        basis[contactIndex].x;
}

kernel void nm_fgmres_orthogonalize_column(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant uint& column [[buffer(1)]],
    device const NMContinuumObjectGPU* objects [[buffer(2)]],
    device const float4* basis [[buffer(3)]],
    device float4* work [[buffer(4)]],
    device float* hessenberg [[buffer(5)]],
    device const NMFGMRESStateGPU* states [[buffer(6)]],
    constant NMKKTContactArguments& contact [[buffer(7)]],
    uint lane [[thread_index_in_threadgroup]],
    uint group [[threadgroup_position_in_grid]]
) {
    if (lane >= 32u || group >= dispatch.environmentCount) return;
    const uint environment = group;
    if (states[environment].diagnostics.z > 0.5f) return;
    const uint totalNodes = dispatch.environmentCount * dispatch.femNodeCount;
    const uint fieldBase = totalNodes;
    const uint totalUnknowns = fgmresUnknownCount(dispatch);
    const uint nodeBase = environment * dispatch.femNodeCount;
    const uint contactBase = fgmresContactBase(dispatch, environment);
    const uint mpmBase = fgmresMPMIndex(dispatch, environment, 0u);
    const uint activeCount = min(
        contact.activeCounts[environment], dispatch.reservedMixed1);
    const uint deformableCapacity = dispatch.deformableContactCapacity;
    const uint deformableCount = min(
        contact.deformableActiveCounts[environment], deformableCapacity);
    const uint deformableBase = environment * deformableCapacity;
    float originalNorm2 = 0.0f;
    float originalCorrection = 0.0f;
    for (uint local = lane; local < dispatch.femNodeCount; local += 32u)
        fgmresCompensatedAdd(
            originalNorm2, originalCorrection,
            dot(work[nodeBase + local], work[nodeBase + local]));
    for (uint local = lane; local < dispatch.femNodeCount; local += 32u)
        fgmresCompensatedAdd(
            originalNorm2, originalCorrection,
            dot(work[fieldBase + nodeBase + local],
                work[fieldBase + nodeBase + local]));
    for (uint local = lane; local < dispatch.gridNodeCount; local += 32u)
        fgmresCompensatedAdd(
            originalNorm2, originalCorrection,
            dot(work[mpmBase + local], work[mpmBase + local]));
    for (uint slot = lane; slot < activeCount; slot += 32u) {
        const uint pairIndex = contact.activePairs[
            environment * dispatch.reservedMixed1 + slot];
        if (pairIndex < dispatch.contactPairCount) {
            const float value = work[contactBase + pairIndex].x;
            fgmresCompensatedAdd(
                originalNorm2, originalCorrection, value * value);
        }
    }
    for (uint activeSlot = lane; activeSlot < deformableCount;
         activeSlot += 32u) {
        const uint slot = contact.deformableActiveIndices[
            deformableBase + activeSlot];
        if (slot < deformableCapacity) {
            const uint row = contactBase + dispatch.contactPairCount + slot;
            fgmresCompensatedAdd(
                originalNorm2, originalCorrection,
                dot(work[row].xyz, work[row].xyz));
        }
    }
    originalNorm2 = simd_sum(originalNorm2);

    for (uint row = 0u; row <= column; ++row) {
        device const float4* rowBasis = basis + row * totalUnknowns;
        float projection = 0.0f;
        float projectionCorrection = 0.0f;
        for (uint local = lane; local < dispatch.femNodeCount; local += 32u)
            fgmresCompensatedAdd(
                projection, projectionCorrection,
                dot(rowBasis[nodeBase + local], work[nodeBase + local]));
        for (uint local = lane; local < dispatch.femNodeCount; local += 32u)
            fgmresCompensatedAdd(
                projection, projectionCorrection,
                dot(rowBasis[fieldBase + nodeBase + local],
                    work[fieldBase + nodeBase + local]));
        for (uint local = lane; local < dispatch.gridNodeCount; local += 32u)
            fgmresCompensatedAdd(
                projection, projectionCorrection,
                dot(rowBasis[mpmBase + local], work[mpmBase + local]));
        for (uint slot = lane; slot < activeCount; slot += 32u) {
            const uint pairIndex = contact.activePairs[
                environment * dispatch.reservedMixed1 + slot];
            if (pairIndex < dispatch.contactPairCount)
                fgmresCompensatedAdd(
                    projection, projectionCorrection,
                    rowBasis[contactBase + pairIndex].x *
                        work[contactBase + pairIndex].x);
        }
        for (uint activeSlot = lane; activeSlot < deformableCount;
             activeSlot += 32u) {
            const uint slot = contact.deformableActiveIndices[
                deformableBase + activeSlot];
            if (slot < deformableCapacity) {
                const uint contactRow = contactBase +
                    dispatch.contactPairCount + slot;
                fgmresCompensatedAdd(
                    projection, projectionCorrection,
                    dot(rowBasis[contactRow].xyz, work[contactRow].xyz));
            }
        }
        projection = simd_sum(projection);
        if (lane == 0u)
            hessenberg[fgmresMatrixIndex(environment, row, column)] =
                projection;
        simdgroup_barrier(mem_flags::mem_device);
        for (uint local = lane; local < dispatch.femNodeCount; local += 32u)
            work[nodeBase + local] -=
                projection * rowBasis[nodeBase + local];
        for (uint local = lane; local < dispatch.femNodeCount; local += 32u)
            work[fieldBase + nodeBase + local] -= projection *
                rowBasis[fieldBase + nodeBase + local];
        for (uint local = lane; local < dispatch.gridNodeCount; local += 32u)
            work[mpmBase + local] -= projection * rowBasis[mpmBase + local];
        for (uint slot = lane; slot < activeCount; slot += 32u) {
            const uint pairIndex = contact.activePairs[
                environment * dispatch.reservedMixed1 + slot];
            if (pairIndex < dispatch.contactPairCount)
                work[contactBase + pairIndex].x -= projection *
                    rowBasis[contactBase + pairIndex].x;
        }
        for (uint activeSlot = lane; activeSlot < deformableCount;
             activeSlot += 32u) {
            const uint slot = contact.deformableActiveIndices[
                deformableBase + activeSlot];
            if (slot < deformableCapacity) {
                const uint contactRow = contactBase +
                    dispatch.contactPairCount + slot;
                work[contactRow].xyz -=
                    projection * rowBasis[contactRow].xyz;
            }
        }
        simdgroup_barrier(mem_flags::mem_device);
    }

    // Selective second MGS pass. A large norm loss after the first pass is
    // the device-local signal that the new Arnoldi vector was cancellation
    // dominated. Reorthogonalize only then, retaining the compact basis and
    // avoiding a blanket second read of every unknown.
    float remainingNorm2 = 0.0f;
    float remainingCorrection = 0.0f;
    for (uint local = lane; local < dispatch.femNodeCount; local += 32u)
        fgmresCompensatedAdd(
            remainingNorm2, remainingCorrection,
            dot(work[nodeBase + local], work[nodeBase + local]));
    for (uint local = lane; local < dispatch.femNodeCount; local += 32u)
        fgmresCompensatedAdd(
            remainingNorm2, remainingCorrection,
            dot(work[fieldBase + nodeBase + local],
                work[fieldBase + nodeBase + local]));
    for (uint local = lane; local < dispatch.gridNodeCount; local += 32u)
        fgmresCompensatedAdd(
            remainingNorm2, remainingCorrection,
            dot(work[mpmBase + local], work[mpmBase + local]));
    for (uint slot = lane; slot < activeCount; slot += 32u) {
        const uint pairIndex = contact.activePairs[
            environment * dispatch.reservedMixed1 + slot];
        if (pairIndex < dispatch.contactPairCount) {
            const float value = work[contactBase + pairIndex].x;
            fgmresCompensatedAdd(
                remainingNorm2, remainingCorrection, value * value);
        }
    }
    for (uint activeSlot = lane; activeSlot < deformableCount;
         activeSlot += 32u) {
        const uint slot = contact.deformableActiveIndices[
            deformableBase + activeSlot];
        if (slot < deformableCapacity) {
            const uint row = contactBase + dispatch.contactPairCount + slot;
            fgmresCompensatedAdd(
                remainingNorm2, remainingCorrection,
                dot(work[row].xyz, work[row].xyz));
        }
    }
    remainingNorm2 = simd_sum(remainingNorm2);
    if (originalNorm2 > 1.0e-24f &&
        remainingNorm2 < 0.5f * originalNorm2) {
        for (uint row = 0u; row <= column; ++row) {
            device const float4* rowBasis = basis + row * totalUnknowns;
            float projection = 0.0f;
            float projectionCorrection = 0.0f;
            for (uint local = lane; local < dispatch.femNodeCount;
                 local += 32u)
                fgmresCompensatedAdd(
                    projection, projectionCorrection,
                    dot(rowBasis[nodeBase + local],
                        work[nodeBase + local]));
            for (uint local = lane; local < dispatch.femNodeCount;
                 local += 32u)
                fgmresCompensatedAdd(
                    projection, projectionCorrection,
                    dot(rowBasis[fieldBase + nodeBase + local],
                        work[fieldBase + nodeBase + local]));
            for (uint local = lane; local < dispatch.gridNodeCount;
                 local += 32u)
                fgmresCompensatedAdd(
                    projection, projectionCorrection,
                    dot(rowBasis[mpmBase + local], work[mpmBase + local]));
            for (uint slot = lane; slot < activeCount; slot += 32u) {
                const uint pairIndex = contact.activePairs[
                    environment * dispatch.reservedMixed1 + slot];
                if (pairIndex < dispatch.contactPairCount)
                    fgmresCompensatedAdd(
                        projection, projectionCorrection,
                        rowBasis[contactBase + pairIndex].x *
                            work[contactBase + pairIndex].x);
            }
            for (uint activeSlot = lane; activeSlot < deformableCount;
                 activeSlot += 32u) {
                const uint slot = contact.deformableActiveIndices[
                    deformableBase + activeSlot];
                if (slot < deformableCapacity) {
                    const uint contactRow = contactBase +
                        dispatch.contactPairCount + slot;
                    fgmresCompensatedAdd(
                        projection, projectionCorrection,
                        dot(rowBasis[contactRow].xyz,
                            work[contactRow].xyz));
                }
            }
            projection = simd_sum(projection);
            if (lane == 0u)
                hessenberg[fgmresMatrixIndex(environment, row, column)] +=
                    projection;
            simdgroup_barrier(mem_flags::mem_device);
            for (uint local = lane; local < dispatch.femNodeCount;
                 local += 32u)
                work[nodeBase + local] -=
                    projection * rowBasis[nodeBase + local];
            for (uint local = lane; local < dispatch.femNodeCount;
                 local += 32u)
                work[fieldBase + nodeBase + local] -= projection *
                    rowBasis[fieldBase + nodeBase + local];
            for (uint local = lane; local < dispatch.gridNodeCount;
                 local += 32u)
                work[mpmBase + local] -=
                    projection * rowBasis[mpmBase + local];
            for (uint slot = lane; slot < activeCount; slot += 32u) {
                const uint pairIndex = contact.activePairs[
                    environment * dispatch.reservedMixed1 + slot];
                if (pairIndex < dispatch.contactPairCount)
                    work[contactBase + pairIndex].x -= projection *
                        rowBasis[contactBase + pairIndex].x;
            }
            for (uint activeSlot = lane; activeSlot < deformableCount;
                 activeSlot += 32u) {
                const uint slot = contact.deformableActiveIndices[
                    deformableBase + activeSlot];
                if (slot < deformableCapacity) {
                    const uint contactRow = contactBase +
                        dispatch.contactPairCount + slot;
                    work[contactRow].xyz -=
                        projection * rowBasis[contactRow].xyz;
                }
            }
            simdgroup_barrier(mem_flags::mem_device);
        }
    }
    (void)objects;
}

kernel void nm_fgmres_finish_column(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMMixedSolverGPU& solver [[buffer(1)]],
    constant uint& column [[buffer(2)]],
    device const NMContinuumObjectGPU* objects [[buffer(3)]],
    device const float4* work [[buffer(4)]],
    device float4* nextBasis [[buffer(5)]],
    device float* hessenberg [[buffer(6)]],
    device float2* rotations [[buffer(7)]],
    device float* leastSquares [[buffer(8)]],
    device NMFGMRESStateGPU* states [[buffer(9)]],
    constant NMKKTContactArguments& contact [[buffer(10)]],
    constant float& forcing [[buffer(11)]],
    uint lane [[thread_index_in_threadgroup]],
    uint group [[threadgroup_position_in_grid]]
) {
    if (lane >= 32u || group >= dispatch.environmentCount) return;
    const uint environment = group;
    if (states[environment].diagnostics.z > 0.5f) return;
    const uint mpmBase = fgmresMPMIndex(dispatch, environment, 0u);
    const uint base = environment * dispatch.femNodeCount;
    float norm2 = 0.0f;
    float normCorrection = 0.0f;
    for (uint local = lane; local < dispatch.femNodeCount; local += 32u)
        fgmresCompensatedAdd(
            norm2, normCorrection,
            dot(work[base + local], work[base + local]));
    const uint totalNodes = dispatch.environmentCount * dispatch.femNodeCount;
    for (uint local = lane; local < dispatch.femNodeCount; local += 32u)
        fgmresCompensatedAdd(
            norm2, normCorrection,
            dot(work[totalNodes + base + local],
                work[totalNodes + base + local]));
    for (uint local = lane; local < dispatch.gridNodeCount; local += 32u)
        fgmresCompensatedAdd(
            norm2, normCorrection,
            dot(work[mpmBase + local], work[mpmBase + local]));
    const uint contactBase = fgmresContactBase(dispatch, environment);
    const uint activeCount = min(
        contact.activeCounts[environment], dispatch.reservedMixed1);
    const uint deformableCapacity = dispatch.deformableContactCapacity;
    const uint deformableCount = min(
        contact.deformableActiveCounts[environment], deformableCapacity);
    const uint deformableBase = environment * deformableCapacity;
    for (uint slot = lane; slot < activeCount; slot += 32u) {
        const uint pairIndex = contact.activePairs[
            environment * dispatch.reservedMixed1 + slot];
        if (pairIndex < dispatch.contactPairCount) {
            const float value = work[contactBase + pairIndex].x;
            fgmresCompensatedAdd(
                norm2, normCorrection, value * value);
        }
    }
    for (uint activeSlot = lane; activeSlot < deformableCount;
         activeSlot += 32u) {
        const uint slot = contact.deformableActiveIndices[
            deformableBase + activeSlot];
        if (slot < deformableCapacity) {
            const uint row = contactBase + dispatch.contactPairCount + slot;
            fgmresCompensatedAdd(
                norm2, normCorrection,
                dot(work[row].xyz, work[row].xyz));
        }
    }
    norm2 = simd_sum(norm2);
    const float norm = sqrt(max(norm2, 0.0f));
    if (lane == 0u) {
        hessenberg[fgmresMatrixIndex(environment, column + 1u, column)] = norm;
        for (uint previous = 0u; previous < column; ++previous) {
            const float2 rotation = rotations[
                environment * NM_MIXED_FGMRES_RESTART + previous
            ];
            const uint upperIndex = fgmresMatrixIndex(
                environment, previous, column
            );
            const uint lowerIndex = fgmresMatrixIndex(
                environment, previous + 1u, column
            );
            const float upper = hessenberg[upperIndex];
            const float lower = hessenberg[lowerIndex];
            hessenberg[upperIndex] = rotation.x * upper + rotation.y * lower;
            hessenberg[lowerIndex] = -rotation.y * upper + rotation.x * lower;
        }
        const uint diagonalIndex = fgmresMatrixIndex(
            environment, column, column);
        const uint subdiagonalIndex = fgmresMatrixIndex(
            environment, column + 1u, column
        );
        const float diagonal = hessenberg[diagonalIndex];
        const float subdiagonal = hessenberg[subdiagonalIndex];
        const float magnitude = sqrt(
            diagonal * diagonal + subdiagonal * subdiagonal
        );
        const float2 rotation = magnitude > 1.0e-30f
            ? float2(diagonal / magnitude, subdiagonal / magnitude)
            : float2(1.0f, 0.0f);
        rotations[environment * NM_MIXED_FGMRES_RESTART + column] = rotation;
        hessenberg[diagonalIndex] = magnitude;
        hessenberg[subdiagonalIndex] = 0.0f;
        const uint g0 = fgmresVectorIndex(environment, column);
        const uint g1 = fgmresVectorIndex(environment, column + 1u);
        const float upper = leastSquares[g0];
        const float lower = leastSquares[g1];
        leastSquares[g0] = rotation.x * upper + rotation.y * lower;
        leastSquares[g1] = -rotation.y * upper + rotation.x * lower;
        const float residual = abs(leastSquares[g1]);
        device NMFGMRESStateGPU& state = states[environment];
        state.diagnostics.x = residual;
        state.diagnostics.w = float(column + 1u);
        state.diagnostics.z = residual <= max(
            solver.regularization.x,
            clamp(forcing, solver.nonlinearTolerances.x, 0.5f) *
                state.diagnostics.y
        ) ? 1.0f : 0.0f;
    }
    const float inverseNorm = norm > 1.0e-30f ? 1.0f / norm : 0.0f;
    for (uint local = lane; local < dispatch.femNodeCount; local += 32u)
        nextBasis[base + local] = work[base + local] * inverseNorm;
    for (uint local = lane; local < dispatch.femNodeCount; local += 32u)
        nextBasis[totalNodes + base + local] =
            work[totalNodes + base + local] * inverseNorm;
    for (uint local = lane; local < dispatch.gridNodeCount; local += 32u)
        nextBasis[mpmBase + local] =
            work[mpmBase + local] * inverseNorm;
    for (uint slot = lane; slot < activeCount; slot += 32u) {
        const uint pairIndex = contact.activePairs[
            environment * dispatch.reservedMixed1 + slot];
        if (pairIndex < dispatch.contactPairCount)
            nextBasis[contactBase + pairIndex] = float4(
                work[contactBase + pairIndex].x * inverseNorm,
                0.0f, 0.0f, 0.0f);
    }
    for (uint activeSlot = lane; activeSlot < deformableCount;
         activeSlot += 32u) {
        const uint slot = contact.deformableActiveIndices[
            deformableBase + activeSlot];
        if (slot < deformableCapacity) {
            const uint row = contactBase + dispatch.contactPairCount + slot;
            nextBasis[row] = float4(work[row].xyz * inverseNorm, 0.0f);
        }
    }
    (void)objects;
}

kernel void nm_fgmres_backsolve(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMMixedSolverGPU& solver [[buffer(1)]],
    device float* hessenberg [[buffer(2)]],
    device float* leastSquares [[buffer(3)]],
    device NMFGMRESStateGPU* states [[buffer(4)]],
    device NMMatterStatusGPU* statuses [[buffer(5)]],
    device NMPCGScalarGPU* publishedIterations [[buffer(6)]],
    constant uint& iterationOffset [[buffer(7)]],
    constant uint& finalRestartCycle [[buffer(8)]],
    constant float& forcing [[buffer(9)]],
    uint global [[thread_position_in_grid]]
) {
    if (global >= dispatch.environmentCount) return;
    const uint environment = global;
    device NMFGMRESStateGPU& state = states[environment];
    const uint used = min(uint(state.diagnostics.w), min(
        solver.nonlinearIterations.y, NM_MIXED_FGMRES_RESTART
    ));
    const uint totalUsed = iterationOffset + used;
    atomic_fetch_max_explicit(
        (device atomic_uint*)&statuses[environment].pcgIterations,
        totalUsed,
        memory_order_relaxed
    );
    for (uint objectIndex = 0u; objectIndex < dispatch.objectCount;
         ++objectIndex)
        publishedIterations[environment * dispatch.objectCount + objectIndex]
            .diagnostics.w = float(max(totalUsed, 1u));
    for (int row = int(used) - 1; row >= 0; --row) {
        float value = leastSquares[fgmresVectorIndex(environment, uint(row))];
        for (uint column = uint(row) + 1u; column < used; ++column)
            value -= hessenberg[fgmresMatrixIndex(
                environment, uint(row), column
            )] * leastSquares[fgmresVectorIndex(environment, column)];
        const float diagonal = hessenberg[
            fgmresMatrixIndex(environment, uint(row), uint(row))
        ];
        leastSquares[fgmresVectorIndex(environment, uint(row))] =
            abs(diagonal) > solver.regularization.x ? value / diagonal : 0.0f;
    }
    const float relativeResidual = state.diagnostics.y > solver.regularization.x
        ? state.diagnostics.x / state.diagnostics.y : state.diagnostics.x;
    const bool converged = state.diagnostics.z > 0.5f;
    const bool finalAccepted = converged || (used > 0u &&
        relativeResidual <= clamp(
            forcing, solver.nonlinearTolerances.x, 0.5f));
    if (finalRestartCycle != 0u)
        state.diagnostics.z = finalAccepted ? 1.0f : 0.0f;
    if ((finalRestartCycle != 0u && !finalAccepted) ||
        !isfinite(state.diagnostics.x)) {
        recordFailure(
            statuses[environment], NM_STATUS_LINEAR_SOLVER_FAILURE,
            NM_INVALID_INDEX, used,
            state.diagnostics
        );
    }
}

kernel void nm_fgmres_form_restart_coefficients(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMMixedSolverGPU& solver [[buffer(1)]],
    device const float2* rotations [[buffer(2)]],
    device const float* leastSquares [[buffer(3)]],
    device const NMFGMRESStateGPU* states [[buffer(4)]],
    device float* coefficients [[buffer(5)]],
    uint global [[thread_position_in_grid]]
) {
    if (global >= dispatch.environmentCount) return;
    const uint environment = global;
    const uint used = min(uint(states[environment].diagnostics.w), min(
        solver.nonlinearIterations.y, NM_MIXED_FGMRES_RESTART));
    const uint base = environment * (NM_MIXED_FGMRES_RESTART + 1u);
    for (uint row = 0u; row < NM_MIXED_FGMRES_RESTART + 1u; ++row)
        coefficients[base + row] = 0.0f;
    coefficients[base + used] =
        leastSquares[fgmresVectorIndex(environment, used)];
    for (int row = int(used) - 1; row >= 0; --row) {
        const float2 rotation = rotations[
            environment * NM_MIXED_FGMRES_RESTART + uint(row)];
        const float upper = coefficients[base + uint(row)];
        const float lower = coefficients[base + uint(row) + 1u];
        coefficients[base + uint(row)] =
            rotation.x * upper - rotation.y * lower;
        coefficients[base + uint(row) + 1u] =
            rotation.y * upper + rotation.x * lower;
    }
}

kernel void nm_fgmres_restart_residual_nodes(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const NMIncidenceRangeGPU* nodeRanges [[buffer(1)]],
    device const float4* basis [[buffer(2)]],
    device const float* coefficients [[buffer(3)]],
    device const NMFGMRESStateGPU* states [[buffer(4)]],
    device float4* residual [[buffer(5)]],
    uint global [[thread_position_in_grid]]
) {
    const uint totalNodes = dispatch.environmentCount * dispatch.femNodeCount;
    if (global >= totalNodes || dispatch.femNodeCount == 0u) return;
    const uint environment = global / dispatch.femNodeCount;
    const uint objectIndex = nodeRanges[global].objectIndex;
    if (objectIndex == NM_INVALID_INDEX || objectIndex >= dispatch.objectCount)
        return;
    const uint used = min(uint(states[environment].diagnostics.w),
                          NM_MIXED_FGMRES_RESTART);
    const uint totalUnknowns = fgmresUnknownCount(dispatch);
    const uint coefficientBase = environment *
        (NM_MIXED_FGMRES_RESTART + 1u);
    float4 mechanical = float4(0.0f);
    float4 field = float4(0.0f);
    for (uint row = 0u; row <= used; ++row) {
        const float coefficient = coefficients[coefficientBase + row];
        mechanical += coefficient * basis[row * totalUnknowns + global];
        field += coefficient * basis[
            row * totalUnknowns + totalNodes + global];
    }
    residual[global] = mechanical;
    residual[totalNodes + global] = field;
}

kernel void nm_fgmres_restart_residual_contacts(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const float4* basis [[buffer(1)]],
    device const float* coefficients [[buffer(2)]],
    device const NMFGMRESStateGPU* states [[buffer(3)]],
    device float4* residual [[buffer(4)]],
    constant NMKKTContactArguments& contact [[buffer(5)]],
    uint global [[thread_position_in_grid]]
) {
    if (dispatch.reservedMixed1 == 0u) return;
    const uint environment = global / dispatch.reservedMixed1;
    const uint slot = global - environment * dispatch.reservedMixed1;
    if (environment >= dispatch.environmentCount ||
        slot >= contact.activeCounts[environment]) return;
    const uint pairIndex = contact.activePairs[global];
    if (pairIndex >= dispatch.contactPairCount) return;
    const uint objectIndex = contact.pairs[pairIndex].objectIndex;
    if (objectIndex >= dispatch.objectCount) return;
    const uint used = min(uint(states[environment].diagnostics.w),
                          NM_MIXED_FGMRES_RESTART);
    const uint totalUnknowns = fgmresUnknownCount(dispatch);
    const uint contactIndex =
        fgmresContactBase(dispatch, environment) + pairIndex;
    const uint coefficientBase = environment *
        (NM_MIXED_FGMRES_RESTART + 1u);
    float value = 0.0f;
    for (uint row = 0u; row <= used; ++row)
        value += coefficients[coefficientBase + row] *
            basis[row * totalUnknowns + contactIndex].x;
    residual[contactIndex] = float4(value, 0.0f, 0.0f, 0.0f);
}

kernel void nm_fgmres_restart_residual_deformable_contacts(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const float4* basis [[buffer(1)]],
    device const float* coefficients [[buffer(2)]],
    device const NMFGMRESStateGPU* states [[buffer(3)]],
    device float4* residual [[buffer(4)]],
    constant NMKKTContactArguments& contact [[buffer(5)]],
    uint global [[thread_position_in_grid]]
) {
    uint environment = 0u, slot = 0u;
    if (!fgmresDeformableActiveWork(
            dispatch, contact, global, environment, slot)) return;
    const uint used = min(
        uint(states[environment].diagnostics.w),
        NM_MIXED_FGMRES_RESTART);
    const uint totalUnknowns = fgmresUnknownCount(dispatch);
    const uint row = fgmresContactBase(dispatch, environment) +
        dispatch.contactPairCount + slot;
    const uint coefficientBase = environment *
        (NM_MIXED_FGMRES_RESTART + 1u);
    float3 value = float3(0.0f);
    for (uint basisRow = 0u; basisRow <= used; ++basisRow)
        value += coefficients[coefficientBase + basisRow] *
            basis[basisRow * totalUnknowns + row].xyz;
    residual[row] = float4(value, 0.0f);
}

kernel void nm_fgmres_accumulate(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMMixedSolverGPU& solver [[buffer(1)]],
    device const NMIncidenceRangeGPU* nodeRanges [[buffer(2)]],
    device const float4* preconditionedBasis [[buffer(3)]],
    device const float* leastSquares [[buffer(4)]],
    device const NMFGMRESStateGPU* states [[buffer(5)]],
    device float4* solution [[buffer(6)]],
    constant uint& restartCycle [[buffer(7)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.femNodeCount;
    if (global >= total || dispatch.femNodeCount == 0u) return;
    const uint environment = global / dispatch.femNodeCount;
    const uint objectIndex = nodeRanges[global].objectIndex;
    if (objectIndex == NM_INVALID_INDEX || objectIndex >= dispatch.objectCount)
        return;
    const uint used = min(uint(states[environment].diagnostics.w), min(
        solver.nonlinearIterations.y, NM_MIXED_FGMRES_RESTART
    ));
    float4 value = float4(0.0f);
    const uint totalUnknowns = fgmresUnknownCount(dispatch);
    for (uint column = 0u; column < used; ++column)
        value += preconditionedBasis[
            column * totalUnknowns + global
        ] * leastSquares[fgmresVectorIndex(environment, column)];
    if (restartCycle == 0u) solution[global] = value;
    else solution[global] += value;
}

kernel void nm_fgmres_accumulate_fields(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMMixedSolverGPU& solver [[buffer(1)]],
    device const NMIncidenceRangeGPU* nodeRanges [[buffer(2)]],
    device const float4* preconditionedBasis [[buffer(3)]],
    device const float* leastSquares [[buffer(4)]],
    device const NMFGMRESStateGPU* states [[buffer(5)]],
    device float4* solution [[buffer(6)]],
    constant uint& restartCycle [[buffer(7)]],
    uint global [[thread_position_in_grid]]
) {
    const uint totalNodes = dispatch.environmentCount * dispatch.femNodeCount;
    if (global >= totalNodes || dispatch.femNodeCount == 0u) return;
    const uint environment = global / dispatch.femNodeCount;
    const uint objectIndex = nodeRanges[global].objectIndex;
    if (objectIndex == NM_INVALID_INDEX || objectIndex >= dispatch.objectCount)
        return;
    const uint used = min(uint(states[environment].diagnostics.w), min(
        solver.nonlinearIterations.y, NM_MIXED_FGMRES_RESTART));
    const uint totalUnknowns = fgmresUnknownCount(dispatch);
    const uint fieldIndex = totalNodes + global;
    float4 value = float4(0.0f);
    for (uint column = 0u; column < used; ++column)
        value += preconditionedBasis[column * totalUnknowns + fieldIndex] *
            leastSquares[fgmresVectorIndex(environment, column)];
    if (restartCycle == 0u) solution[fieldIndex] = value;
    else solution[fieldIndex] += value;
}

kernel void nm_fgmres_accumulate_contacts(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMMixedSolverGPU& solver [[buffer(1)]],
    device const float4* preconditionedBasis [[buffer(2)]],
    device const float* leastSquares [[buffer(3)]],
    device const NMFGMRESStateGPU* states [[buffer(4)]],
    device float4* solution [[buffer(5)]],
    constant NMKKTContactArguments& contact [[buffer(6)]],
    constant uint& restartCycle [[buffer(7)]],
    uint global [[thread_position_in_grid]]
) {
    if (dispatch.reservedMixed1 == 0u) return;
    const uint environment = global / dispatch.reservedMixed1;
    const uint slot = global - environment * dispatch.reservedMixed1;
    if (environment >= dispatch.environmentCount ||
        slot >= contact.activeCounts[environment]) return;
    const uint pairIndex = contact.activePairs[global];
    if (pairIndex >= dispatch.contactPairCount) return;
    const uint objectIndex = contact.pairs[pairIndex].objectIndex;
    if (objectIndex >= dispatch.objectCount) return;
    const uint used = min(uint(states[environment].diagnostics.w), min(
        solver.nonlinearIterations.y, NM_MIXED_FGMRES_RESTART));
    const uint totalUnknowns = fgmresUnknownCount(dispatch);
    const uint contactIndex =
        fgmresContactBase(dispatch, environment) + pairIndex;
    float value = 0.0f;
    for (uint column = 0u; column < used; ++column)
        value += preconditionedBasis[column * totalUnknowns + contactIndex].x *
            leastSquares[fgmresVectorIndex(environment, column)];
    if (restartCycle == 0u)
        solution[contactIndex] = float4(value, 0.0f, 0.0f, 0.0f);
    else
        solution[contactIndex].x += value;
}

kernel void nm_fgmres_accumulate_deformable_contacts(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMMixedSolverGPU& solver [[buffer(1)]],
    device const float4* preconditionedBasis [[buffer(2)]],
    device const float* leastSquares [[buffer(3)]],
    device const NMFGMRESStateGPU* states [[buffer(4)]],
    device float4* solution [[buffer(5)]],
    constant NMKKTContactArguments& contact [[buffer(6)]],
    constant uint& restartCycle [[buffer(7)]],
    uint global [[thread_position_in_grid]]
) {
    uint environment = 0u, slot = 0u;
    if (!fgmresDeformableActiveWork(
            dispatch, contact, global, environment, slot)) return;
    const uint used = min(uint(states[environment].diagnostics.w), min(
        solver.nonlinearIterations.y, NM_MIXED_FGMRES_RESTART));
    const uint totalUnknowns = fgmresUnknownCount(dispatch);
    const uint row = fgmresContactBase(dispatch, environment) +
        dispatch.contactPairCount + slot;
    float3 value = float3(0.0f);
    for (uint column = 0u; column < used; ++column)
        value += preconditionedBasis[column * totalUnknowns + row].xyz *
            leastSquares[fgmresVectorIndex(environment, column)];
    if (restartCycle == 0u)
        solution[row] = float4(value, 0.0f);
    else
        solution[row].xyz += value;
}

// Active MPM grid velocities occupy a first-class block of the monolithic
// Newton-FGMRES vector. P2G supplies the force predictor using the owning
// object's scheduled timestep; this block solves corrections around that
// predictor and must not reconstruct it with the frame timestep.
kernel void nm_mpm_build_implicit_residual(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMMicrostepGPU& microstep [[buffer(1)]],
    device const NMGridNodeStateGPU* nodes [[buffer(2)]],
    device const uint* generations [[buffer(3)]],
    device const uint* contactIncidence [[buffer(4)]],
    device const NMIncidenceRangeGPU* contactRanges [[buffer(5)]],
    device const NMContactSampleGPU* samples [[buffer(6)]],
    device float4* residual [[buffer(7)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.gridNodeCount;
    if (global >= total || dispatch.gridNodeCount == 0u) return;
    const uint environment = global / dispatch.gridNodeCount;
    const uint nodeIndex = global - environment * dispatch.gridNodeCount;
    const uint output = fgmresMPMIndex(dispatch, environment, nodeIndex);
    residual[output] = float4(0.0f);
    if (generations[global] != microstep.reserved) return;
    const NMGridNodeStateGPU node = nodes[global];
    if (!(node.positionAndMass.w > 0.0f)) return;
    float3 rightHandSide = float3(0.0f);
    const NMIncidenceRangeGPU range = contactRanges[nodeIndex];
    const uint sampleBase = environment * dispatch.contactPairCount;
    for (uint local = 0u; local < range.count; ++local) {
        const uint pair = contactIncidence[range.first + local];
        if (pair >= dispatch.contactPairCount) continue;
        const NMContactSampleGPU sample = samples[sampleBase + pair];
        if ((sample.identity.w & NM_CONTACT_VALID) != 0u)
            rightHandSide -= sample.impulseAndNormal.xyz;
    }
    residual[output] = float4(rightHandSide, 0.0f);
}

kernel void nm_fgmres_precondition_mpm(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const NMGridNodeStateGPU* nodes [[buffer(1)]],
    device const uint* generations [[buffer(2)]],
    constant NMMicrostepGPU& microstep [[buffer(3)]],
    device const float4* basis [[buffer(4)]],
    device float4* preconditioned [[buffer(5)]],
    device const NMFGMRESStateGPU* states [[buffer(6)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.gridNodeCount;
    if (global >= total) return;
    const uint environment = global / dispatch.gridNodeCount;
    const uint nodeIndex = global - environment * dispatch.gridNodeCount;
    const uint row = fgmresMPMIndex(dispatch, environment, nodeIndex);
    preconditioned[row] = float4(0.0f);
    if (states[environment].diagnostics.z > 0.5f ||
        generations[global] != microstep.reserved) return;
    preconditioned[row] = float4(
        nodes[global].velocityAndInverseMass.w * basis[row].xyz, 0.0f);
}

kernel void nm_fgmres_apply_mpm(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const NMGridNodeStateGPU* nodes [[buffer(1)]],
    device const uint* generations [[buffer(2)]],
    constant NMMicrostepGPU& microstep [[buffer(3)]],
    device const uint* contactIncidence [[buffer(4)]],
    device const NMIncidenceRangeGPU* contactRanges [[buffer(5)]],
    device const NMContactSampleGPU* samples [[buffer(6)]],
    device const float4* direction [[buffer(7)]],
    device float4* work [[buffer(8)]],
    device const NMFGMRESStateGPU* states [[buffer(9)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.gridNodeCount;
    if (global >= total) return;
    const uint environment = global / dispatch.gridNodeCount;
    const uint nodeIndex = global - environment * dispatch.gridNodeCount;
    const uint row = fgmresMPMIndex(dispatch, environment, nodeIndex);
    work[row] = float4(0.0f);
    if (states[environment].diagnostics.z > 0.5f ||
        generations[global] != microstep.reserved) return;
    const float3 nodeDirection = direction[row].xyz;
    float3 value = nodes[global].positionAndMass.w * nodeDirection;
    const NMIncidenceRangeGPU range = contactRanges[nodeIndex];
    const uint sampleBase = environment * dispatch.contactPairCount;
    const uint contactBase = fgmresContactBase(dispatch, environment);
    for (uint local = 0u; local < range.count; ++local) {
        const uint pair = contactIncidence[range.first + local];
        if (pair >= dispatch.contactPairCount) continue;
        const NMContactSampleGPU sample = samples[sampleBase + pair];
        if ((sample.identity.w & NM_CONTACT_VALID) == 0u) continue;
        value -= sample.normalAndVelocity.xyz *
            direction[contactBase + pair].x;
    }
    work[row] = float4(value, 0.0f);
}

kernel void nm_fgmres_accumulate_mpm(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMMixedSolverGPU& solver [[buffer(1)]],
    device const float4* preconditionedBasis [[buffer(2)]],
    device const float* leastSquares [[buffer(3)]],
    device const NMFGMRESStateGPU* states [[buffer(4)]],
    device float4* solution [[buffer(5)]],
    constant uint& restartCycle [[buffer(6)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.gridNodeCount;
    if (global >= total) return;
    const uint environment = global / dispatch.gridNodeCount;
    const uint row = fgmresMPMBase(dispatch) + global;
    const uint used = min(uint(states[environment].diagnostics.w), min(
        solver.nonlinearIterations.y, NM_MIXED_FGMRES_RESTART));
    const uint totalUnknowns = fgmresUnknownCount(dispatch);
    float4 value = float4(0.0f);
    for (uint column = 0u; column < used; ++column)
        value += preconditionedBasis[column * totalUnknowns + row] *
            leastSquares[fgmresVectorIndex(environment, column)];
    if (restartCycle == 0u) solution[row] = value;
    else solution[row] += value;
}

kernel void nm_fgmres_restart_residual_mpm(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const float4* basis [[buffer(1)]],
    device const float* coefficients [[buffer(2)]],
    device const NMFGMRESStateGPU* states [[buffer(3)]],
    device float4* residual [[buffer(4)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.gridNodeCount;
    if (global >= total) return;
    const uint environment = global / dispatch.gridNodeCount;
    const uint row = fgmresMPMBase(dispatch) + global;
    const uint used = min(uint(states[environment].diagnostics.w),
                          NM_MIXED_FGMRES_RESTART);
    const uint totalUnknowns = fgmresUnknownCount(dispatch);
    const uint coefficientBase = environment *
        (NM_MIXED_FGMRES_RESTART + 1u);
    float4 value = float4(0.0f);
    for (uint basisRow = 0u; basisRow <= used; ++basisRow)
        value += coefficients[coefficientBase + basisRow] *
            basis[basisRow * totalUnknowns + row];
    residual[row] = value;
}

kernel void nm_mpm_apply_implicit_solution(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMMicrostepGPU& microstep [[buffer(1)]],
    device const uint* generations [[buffer(2)]],
    device const float4* solution [[buffer(3)]],
    device NMGridNodeStateGPU* nodes [[buffer(4)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.gridNodeCount;
    if (global >= total || generations[global] != microstep.reserved) return;
    const uint environment = global / dispatch.gridNodeCount;
    const uint nodeIndex = global - environment * dispatch.gridNodeCount;
    nodes[global].candidateVelocity.xyz +=
        solution[fgmresMPMIndex(dispatch, environment, nodeIndex)].xyz;
}

} // namespace numi_matter_metal
