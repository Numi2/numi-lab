namespace numi_matter_metal {

inline bool pointInsideTetrahedron(
    const float3 point,
    const float3 a,
    const float3 b,
    const float3 c,
    const float3 d
) {
    constexpr float tolerance = 1.0e-6f;
    const float q0 = dot(cross(c - b, d - b), point - b);
    const float r0 = dot(cross(c - b, d - b), a - b);
    const float q1 = dot(cross(d - a, c - a), point - a);
    const float r1 = dot(cross(d - a, c - a), b - a);
    const float q2 = dot(cross(b - a, d - a), point - a);
    const float r2 = dot(cross(b - a, d - a), c - a);
    const float q3 = dot(cross(c - a, b - a), point - a);
    const float r3 = dot(cross(c - a, b - a), d - a);
    return q0 * r0 >= -tolerance * r0 * r0 &&
        q1 * r1 >= -tolerance * r1 * r1 &&
        q2 * r2 >= -tolerance * r2 * r2 &&
        q3 * r3 >= -tolerance * r3 * r3;
}

inline bool mutationDeactivates(
    const NMMutationCommandGPU command,
    const NMContinuumObjectGPU object,
    const uint tetrahedronIndex,
    const NMTetrahedronGPU tetrahedron,
    device const NMFEMNodeStateGPU* nodes,
    const uint nodeBase
) {
    if ((command.identity.w & NM_MUTATION_ACTIVE) == 0u ||
        command.identity.y != tetrahedron.identity.y) return false;
    if (command.identity.x == NM_MUTATION_DEACTIVATE_TETRAHEDRON)
        return tetrahedronIndex == object.elementOffset + command.schedule.y;
    float minimumValue = INFINITY;
    float maximumValue = -INFINITY;
    const float3 direction = command.geometry0.xyz;
    const float directionLength = length(direction);
    if (!(directionLength > 1.0e-12f)) return false;
    const float3 axis = direction / directionLength;
    float3 positions[4];
    float3 centroid = float3(0.0f);
    for (uint slot = 0u; slot < 4u; ++slot) {
        const float3 point = nodes[nodeBase + tetrahedron.nodes[slot]].positionAndMass.xyz;
        positions[slot] = point;
        centroid += 0.25f * point;
        if (command.identity.x == NM_MUTATION_PLANE_EROSION) {
            const float signedDistance = dot(axis, point) - command.geometry0.w;
            minimumValue = min(minimumValue, signedDistance);
            maximumValue = max(maximumValue, signedDistance);
        }
    }
    if (command.identity.x == NM_MUTATION_CYLINDER_PUNCTURE) {
        const float3 first = command.geometry1.xyz -
            command.geometry1.w * axis;
        const float3 second = command.geometry1.xyz +
            command.geometry1.w * axis;
        // A finite centerline crossing is the conservative erosion authority.
        // Sampling includes both endpoints and avoids eroding every element
        // that merely shares a surface vertex with the needle tip.
        for (uint sample = 0u; sample <= 16u; ++sample) {
            const float t = float(sample) * (1.0f / 16.0f);
            if (pointInsideTetrahedron(
                    mix(first, second, t), positions[0], positions[1],
                    positions[2], positions[3])) return true;
        }
        const float3 relative = centroid - command.geometry1.xyz;
        const float axial = dot(relative, axis);
        const float radial = length(relative - axial * axis);
        return abs(axial) <= command.geometry1.w &&
            radial <= command.geometry0.w;
    }
    return command.identity.x == NM_MUTATION_PLANE_EROSION &&
        minimumValue <= 0.0f && maximumValue >= 0.0f;
}

kernel void nm_topology_checkpoint(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const NMTetrahedronGPU* acceptedTetrahedra [[buffer(1)]],
    device NMTetrahedronGPU* candidateTetrahedra [[buffer(2)]],
    device NMTetrahedronGPU* checkpointTetrahedra [[buffer(3)]],
    device const NMFEMTopologyNodeGPU* acceptedNodes [[buffer(4)]],
    device NMFEMTopologyNodeGPU* candidateNodes [[buffer(5)]],
    device NMFEMTopologyNodeGPU* checkpointNodes [[buffer(6)]],
    device const NMCohesiveFaceGPU* acceptedFaces [[buffer(7)]],
    device NMCohesiveFaceGPU* candidateFaces [[buffer(8)]],
    device NMCohesiveFaceGPU* checkpointFaces [[buffer(9)]],
    device const NMPunctureChannelGPU* acceptedChannels [[buffer(10)]],
    device NMPunctureChannelGPU* candidateChannels [[buffer(11)]],
    device NMPunctureChannelGPU* checkpointChannels [[buffer(12)]],
    device const NMFEMTopologyStateGPU* acceptedStates [[buffer(13)]],
    device NMFEMTopologyStateGPU* candidateStates [[buffer(14)]],
    device NMFEMTopologyStateGPU* checkpointStates [[buffer(15)]],
    device const uint* nodeIncidence [[buffer(16)]],
    device uint* checkpointIncidence [[buffer(17)]],
    device const NMIncidenceRangeGPU* nodeRanges [[buffer(18)]],
    device NMIncidenceRangeGPU* checkpointRanges [[buffer(19)]],
    uint global [[thread_position_in_grid]]
) {
    const uint width = max(max(dispatch.tetrahedronCount, dispatch.femNodeCount),
        max(max(dispatch.cohesiveFaceCount, dispatch.punctureChannelCount),
            max(dispatch.objectCount, dispatch.tetrahedronCount * 4u)));
    if (width == 0u || global >= dispatch.environmentCount * width) return;
    const uint environment = global / width;
    const uint local = global - environment * width;
    if (local < dispatch.tetrahedronCount) {
        const uint index = environment * dispatch.tetrahedronCount + local;
        candidateTetrahedra[index] = acceptedTetrahedra[index];
        checkpointTetrahedra[index] = acceptedTetrahedra[index];
    }
    if (local < dispatch.femNodeCount) {
        const uint index = environment * dispatch.femNodeCount + local;
        candidateNodes[index] = acceptedNodes[index];
        checkpointNodes[index] = acceptedNodes[index];
    }
    if (local < dispatch.cohesiveFaceCount) {
        const uint index = environment * dispatch.cohesiveFaceCount + local;
        candidateFaces[index] = acceptedFaces[index];
        checkpointFaces[index] = acceptedFaces[index];
    }
    if (local < dispatch.punctureChannelCount) {
        const uint index = environment * dispatch.punctureChannelCount + local;
        candidateChannels[index] = acceptedChannels[index];
        checkpointChannels[index] = acceptedChannels[index];
    }
    if (local < dispatch.objectCount) {
        const uint index = environment * dispatch.objectCount + local;
        candidateStates[index] = acceptedStates[index];
        checkpointStates[index] = acceptedStates[index];
    }
    if (local < dispatch.tetrahedronCount * 4u) {
        const uint index = environment * dispatch.tetrahedronCount * 4u + local;
        checkpointIncidence[index] = nodeIncidence[index];
    }
    if (local < dispatch.femNodeCount) {
        const uint index = environment * dispatch.femNodeCount + local;
        checkpointRanges[index] = nodeRanges[index];
    }
}

kernel void nm_topology_apply_mutations(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMMicrostepGPU& microstep [[buffer(1)]],
    device const NMContinuumObjectGPU* objects [[buffer(2)]],
    device const NMMutationCommandGPU* cookedCommands [[buffer(3)]],
    device const uchar* borrowedCommands [[buffer(4)]],
    constant uint& borrowedCount [[buffer(5)]],
    constant uint& borrowedStride [[buffer(6)]],
    device const NMFEMNodeStateGPU* nodes [[buffer(7)]],
    device NMTetrahedronGPU* tetrahedra [[buffer(8)]],
    device NMMatterStatusGPU* statuses [[buffer(9)]],
    uint global [[thread_position_in_grid]]
) {
    if (dispatch.tetrahedronCount == 0u ||
        global >= dispatch.environmentCount * dispatch.tetrahedronCount) return;
    const uint environment = global / dispatch.tetrahedronCount;
    const uint local = global - environment * dispatch.tetrahedronCount;
    if (!environmentHealthy(statuses, environment)) return;
    NMTetrahedronGPU tetrahedron = tetrahedra[global];
    if ((tetrahedron.identity.w & NM_OBJECT_ACTIVE) == 0u) return;
    if (tetrahedron.identity.y >= dispatch.objectCount) {
        recordFailure(statuses[environment], NM_STATUS_TOPOLOGY_FAILURE,
            tetrahedron.identity.y, local, float4(0.0f));
        return;
    }
    const NMContinuumObjectGPU object = objects[tetrahedron.identity.y];
    const uint nodeBase = environment * dispatch.femNodeCount;
    bool deactivate = false;
    for (uint commandIndex = 0u;
         commandIndex < dispatch.mutationCommandCount;
         ++commandIndex) {
        const NMMutationCommandGPU command = cookedCommands[commandIndex];
        if (command.schedule.x == microstep.controlStep)
            deactivate = deactivate || mutationDeactivates(
                command, object, local, tetrahedron, nodes, nodeBase
            );
    }
    for (uint commandIndex = 0u; commandIndex < borrowedCount; ++commandIndex) {
        const device NMMutationCommandGPU* address =
            reinterpret_cast<device const NMMutationCommandGPU*>(
                borrowedCommands + commandIndex * borrowedStride
            );
        const NMMutationCommandGPU command = *address;
        if (command.schedule.x == microstep.controlStep)
            deactivate = deactivate || mutationDeactivates(
                command, object, local, tetrahedron, nodes, nodeBase
            );
    }
    if (deactivate) {
        tetrahedron.identity.w &= ~NM_OBJECT_ACTIVE;
        tetrahedron.identity.z += 1u;
        tetrahedra[global] = tetrahedron;
    }
}

inline NMMutationCommandGPU combinedMutationCommand(
    device const NMMutationCommandGPU* cooked,
    const uint cookedCount,
    device const uchar* borrowed,
    const uint borrowedStride,
    const uint borrowedCount,
    device const NMMutationCommandGPU* triggered,
    const uint triggeredCount,
    const uint environment,
    const uint index
) {
    if (index < cookedCount) return cooked[index];
    if (index < cookedCount + borrowedCount)
        return *reinterpret_cast<device const NMMutationCommandGPU*>(
            borrowed + (index - cookedCount) * borrowedStride
        );
    const uint triggeredIndex = index - cookedCount - borrowedCount;
    if (triggeredIndex < triggeredCount)
        return triggered[environment * triggeredCount + triggeredIndex];
    return *reinterpret_cast<device const NMMutationCommandGPU*>(
        borrowed
    );
}

inline float pointSegmentDistanceSquared(
    const float3 point,
    const float3 first,
    const float3 second
) {
    const float3 edge = second - first;
    const float edgeSquared = dot(edge, edge);
    const float parameter = edgeSquared > 1.0e-18f
        ? clamp(dot(point - first, edge) / edgeSquared, 0.0f, 1.0f)
        : 0.0f;
    const float3 delta = point - (first + parameter * edge);
    return dot(delta, delta);
}

// Generate one environment-local command per FEM object. A puncture channel
// is a consequence of an accepted capsule crossing the current tissue
// geometry; it is never created merely because a control-step number arrived.
kernel void nm_topology_detect_puncture(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant uint& controlStep [[buffer(1)]],
    device const NMContinuumObjectGPU* objects [[buffer(2)]],
    device const NMFEMCapacityGPU* capacities [[buffer(3)]],
    device const NMRigidProxyGPU* proxies [[buffer(4)]],
    device const NMRigidStateGPU* rigidStates [[buffer(5)]],
    device const NMFEMNodeStateGPU* nodes [[buffer(6)]],
    device const NMTetrahedronGPU* tetrahedra [[buffer(7)]],
    device const NMPunctureChannelGPU* channels [[buffer(8)]],
    device const NMContactPairGPU* contactPairs [[buffer(9)]],
    device const float4* acceptedWarmstarts [[buffer(10)]],
    device NMMutationCommandGPU* commands [[buffer(11)]],
    uint global [[thread_position_in_grid]]
) {
    const uint count = dispatch.environmentCount * dispatch.objectCount;
    if (global >= count) return;
    const uint environment = global / dispatch.objectCount;
    const uint objectIndex = global - environment * dispatch.objectCount;
    device NMMutationCommandGPU& output = commands[global];
    output = {};

    const NMContinuumObjectGPU object = objects[objectIndex];
    if (object.representation != NM_REPRESENTATION_FEM ||
        (object.flags & NM_OBJECT_MUTABLE_TOPOLOGY) == 0u ||
        capacities[objectIndex].topology.w == 0u) return;
    const float punctureImpulseThreshold =
        as_type<float>(capacities[objectIndex].work.w);
    if (!(punctureImpulseThreshold > 0.0f) ||
        !isfinite(punctureImpulseThreshold)) return;

    uint channelOffset = 0u;
    for (uint prior = 0u; prior < objectIndex; ++prior)
        channelOffset += capacities[prior].topology.w;
    const uint channelBase = environment * dispatch.punctureChannelCount;
    for (uint local = 0u; local < capacities[objectIndex].topology.w; ++local)
        if ((channels[channelBase + channelOffset + local].identity.w &
             NM_TOPOLOGY_ACTIVE) != 0u) return;

    const uint nodeBase = environment * dispatch.femNodeCount;
    const uint tetBase = environment * dispatch.tetrahedronCount;
    const uint rigidBase = environment * dispatch.rigidProxyCount;
    for (uint proxyIndex = 0u; proxyIndex < dispatch.rigidProxyCount;
         ++proxyIndex) {
        if (proxies[proxyIndex].shapeKind != NM_RIGID_CAPSULE) continue;
        bool acceptedContact = false;
        const uint pairBase = environment * dispatch.contactPairCount;
        for (uint pairIndex = 0u; pairIndex < dispatch.contactPairCount;
             ++pairIndex) {
            const NMContactPairGPU pair = contactPairs[pairIndex];
            const NMRigidProxyGPU contactProxy =
                proxies[pair.rigidProxy];
            if (pair.objectIndex == objectIndex &&
                contactProxy.bodyIndex == proxies[proxyIndex].bodyIndex &&
                acceptedWarmstarts[pairBase + pairIndex].w >=
                    punctureImpulseThreshold) {
                acceptedContact = true;
                break;
            }
        }
        if (!acceptedContact) continue;
        const NMRigidStateGPU rigid = rigidStates[rigidBase + proxyIndex];
        const float3 first = rigid.centerAndRadius.xyz;
        const float3 second = rigid.extent.xyz;
        const float radius = rigid.centerAndRadius.w;
        if (!(radius > 0.0f) || !finite3(first) || !finite3(second)) continue;
        bool intersects = false;
        for (uint local = 0u; local < object.elementCount && !intersects;
             ++local) {
            const NMTetrahedronGPU tetrahedron = tetrahedra[
                tetBase + object.elementOffset + local
            ];
            if ((tetrahedron.identity.w & NM_OBJECT_ACTIVE) == 0u) continue;
            float3 tet[4];
            for (uint slot = 0u; slot < 4u; ++slot)
                tet[slot] = nodes[nodeBase + tetrahedron.nodes[slot]]
                    .positionAndMass.xyz;
            // Touching the surface is contact, not yet a puncture. Require an
            // interior sample of the capsule centerline before topology can
            // change or a channel can become visible.
            for (uint sample = 1u; sample < 8u; ++sample) {
                const float t = float(sample) * (1.0f / 8.0f);
                if (pointInsideTetrahedron(
                        mix(first, second, t), tet[0], tet[1], tet[2], tet[3])) {
                    intersects = true;
                    break;
                }
            }
        }
        if (!intersects) continue;
        const float3 edge = second - first;
        const float lengthEdge = length(edge);
        if (!(lengthEdge > 1.0e-12f)) continue;
        const float3 axis = edge / lengthEdge;
        const float tractLength = min(lengthEdge, 2.0f * radius);
        output.identity = {
            NM_MUTATION_CYLINDER_PUNCTURE,
            objectIndex,
            0x80000000u | proxyIndex,
            NM_MUTATION_ACTIVE,
        };
        output.schedule = {controlStep, NM_INVALID_INDEX, 0u, environment};
        output.geometry0 = float4(axis, radius);
        output.geometry1 = float4(
            first + 0.5f * tractLength * axis,
            0.5f * tractLength
        );
        return;
    }
}

inline bool mutationKeyBefore(
    const NMMutationCommandGPU left,
    const uint leftSource,
    const uint leftIndex,
    const NMMutationCommandGPU right,
    const uint rightSource,
    const uint rightIndex
) {
    if (left.identity.y != right.identity.y)
        return left.identity.y < right.identity.y;
    if (left.schedule.z != right.schedule.z)
        return left.schedule.z < right.schedule.z;
    if (left.identity.z != right.identity.z)
        return left.identity.z < right.identity.z;
    if (left.schedule.y != right.schedule.y)
        return left.schedule.y < right.schedule.y;
    if (left.identity.x != right.identity.x)
        return left.identity.x < right.identity.x;
    if (leftSource != rightSource) return leftSource < rightSource;
    return leftIndex < rightIndex;
}

inline float3 topologyTetCentroid(
    const NMTetrahedronGPU tetrahedron,
    device const NMFEMNodeStateGPU* nodes,
    const uint nodeBase
) {
    float3 result = float3(0.0f);
    for (uint slot = 0u; slot < 4u; ++slot)
        result += nodes[nodeBase + tetrahedron.nodes[slot]].positionAndMass.xyz;
    return 0.25f * result;
}

kernel void nm_topology_execute_transaction(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMMicrostepGPU& microstep [[buffer(1)]],
    device const NMContinuumObjectGPU* objects [[buffer(2)]],
    device const NMFEMCapacityGPU* capacities [[buffer(3)]],
    device const NMMaterialGPU* materials [[buffer(4)]],
    device const NMMutationCommandGPU* cookedCommands [[buffer(5)]],
    device const uchar* borrowedCommands [[buffer(6)]],
    constant uint& borrowedCount [[buffer(7)]],
    constant uint& borrowedStride [[buffer(8)]],
    device NMFEMNodeStateGPU* nodes [[buffer(9)]],
    device NMFEMFieldStateGPU* fields [[buffer(10)]],
    device NMFEMTopologyNodeGPU* topologyNodes [[buffer(11)]],
    device NMTetrahedronGPU* tetrahedra [[buffer(12)]],
    device NMCohesiveFaceGPU* faces [[buffer(13)]],
    device NMPunctureChannelGPU* channels [[buffer(14)]],
    device uint* nodeIncidence [[buffer(15)]],
    device NMIncidenceRangeGPU* nodeRanges [[buffer(16)]],
    device NMFEMTopologyStateGPU* topologyStates [[buffer(17)]],
    device NMMatterStatusGPU* statuses [[buffer(18)]],
    device const NMMutationCommandGPU* triggeredCommands [[buffer(19)]],
    constant uint& triggeredCount [[buffer(20)]],
    constant uint& cookedCount [[buffer(21)]],
    uint environment [[thread_position_in_grid]]
) {
    if (environment >= dispatch.environmentCount ||
        !environmentHealthy(statuses, environment)) return;
    const uint totalCommands = cookedCount + borrowedCount +
        triggeredCount;
    if (borrowedCount != 0u && borrowedStride < sizeof(NMMutationCommandGPU)) {
        recordFailure(statuses[environment], NM_STATUS_TOPOLOGY_FAILURE,
            NM_INVALID_INDEX, borrowedStride,
            float4(float(sizeof(NMMutationCommandGPU)), 0.0f, 0.0f, 0.0f));
        return;
    }
    const uint nodeBase = environment * dispatch.femNodeCount;
    const uint tetBase = environment * dispatch.tetrahedronCount;
    const uint faceBase = environment * dispatch.cohesiveFaceCount;
    const uint channelBase = environment * dispatch.punctureChannelCount;

    // Validate and capacity-check the complete transaction before the first
    // write. Duplicate cohesive commands consume capacity only once.
    bool hasActiveCommand = false;
    for (uint combined = 0u; combined < totalCommands; ++combined) {
        const NMMutationCommandGPU command = combinedMutationCommand(
            cookedCommands, cookedCount,
            borrowedCommands, borrowedStride, borrowedCount,
            triggeredCommands, triggeredCount, environment, combined
        );
        if ((command.identity.w & NM_MUTATION_ACTIVE) == 0u ||
            command.schedule.x != microstep.controlStep) continue;
        hasActiveCommand = true;
        if (command.identity.x > NM_MUTATION_DEACTIVATE_TETRAHEDRON ||
            command.identity.y >= dispatch.objectCount ||
            objects[command.identity.y].representation != NM_REPRESENTATION_FEM ||
            (objects[command.identity.y].flags &
             NM_OBJECT_MUTABLE_TOPOLOGY) == 0u ||
            !finite3(command.geometry0.xyz) ||
            !isfinite(command.geometry0.w) ||
            !finite3(command.geometry1.xyz) ||
            !isfinite(command.geometry1.w)) {
            recordFailure(statuses[environment], NM_STATUS_TOPOLOGY_FAILURE,
                command.identity.y, combined, float4(command.identity.x));
            return;
        }
        const NMContinuumObjectGPU object = objects[command.identity.y];
        if (command.identity.x == NM_MUTATION_DEACTIVATE_TETRAHEDRON &&
            command.schedule.y >= object.elementCount) {
            recordFailure(statuses[environment], NM_STATUS_TOPOLOGY_FAILURE,
                command.identity.y, command.schedule.y, float4(1.0f));
            return;
        }
        if ((command.identity.x == NM_MUTATION_PLANE_EROSION ||
             command.identity.x == NM_MUTATION_CYLINDER_PUNCTURE) &&
            !(length(command.geometry0.xyz) > 1.0e-12f)) {
            recordFailure(statuses[environment], NM_STATUS_TOPOLOGY_FAILURE,
                command.identity.y, combined, float4(2.0f));
            return;
        }
        if (command.identity.x == NM_MUTATION_COHESIVE_SEPARATION) {
            uint faceOffset = 0u;
            for (uint prior = 0u; prior < command.identity.y; ++prior)
                faceOffset += capacities[prior].topology.z;
            bool found = false;
            for (uint local = 0u; local < capacities[command.identity.y].topology.z;
                 ++local) {
                const NMCohesiveFaceGPU face = faces[faceBase + faceOffset + local];
                found = found || (face.adjacency.y == command.identity.y &&
                    face.adjacency.z == command.schedule.y &&
                    (face.adjacency.w & NM_TOPOLOGY_ACTIVE) != 0u);
            }
            if (!found) {
                recordFailure(statuses[environment], NM_STATUS_TOPOLOGY_FAILURE,
                    command.identity.y, command.schedule.y, float4(3.0f));
                return;
            }
            uint inactive = 0u;
            for (uint local = 0u; local < object.stateCount; ++local)
                inactive += (topologyNodes[nodeBase + object.stateOffset + local]
                    .identity.w & NM_TOPOLOGY_ACTIVE) == 0u ? 1u : 0u;
            uint required = 0u;
            for (uint other = 0u; other < totalCommands; ++other) {
                const NMMutationCommandGPU request = combinedMutationCommand(
                    cookedCommands, cookedCount,
                    borrowedCommands, borrowedStride, borrowedCount,
                    triggeredCommands, triggeredCount, environment, other
                );
                if ((request.identity.w & NM_MUTATION_ACTIVE) == 0u ||
                    request.schedule.x != microstep.controlStep ||
                    request.identity.x != NM_MUTATION_COHESIVE_SEPARATION ||
                    request.identity.y != command.identity.y) continue;
                bool earlierDuplicate = false;
                for (uint earlier = 0u; earlier < other; ++earlier) {
                    const NMMutationCommandGPU previous = combinedMutationCommand(
                        cookedCommands, cookedCount,
                        borrowedCommands, borrowedStride, borrowedCount,
                        triggeredCommands, triggeredCount, environment, earlier
                    );
                    earlierDuplicate = earlierDuplicate ||
                        (previous.identity.w & NM_MUTATION_ACTIVE) != 0u &&
                        previous.schedule.x == microstep.controlStep &&
                        previous.identity.x == NM_MUTATION_COHESIVE_SEPARATION &&
                        previous.identity.y == request.identity.y &&
                        previous.schedule.y == request.schedule.y;
                }
                if (!earlierDuplicate) required += 3u;
            }
            if (required > inactive) {
                recordFailure(statuses[environment],
                    NM_STATUS_TOPOLOGY_GROWTH_REQUIRED,
                    command.identity.y, required,
                    float4(float(inactive), float(required), 0.0f, 0.0f));
                return;
            }
        }
    }
    if (!hasActiveCommand) return;

    bool havePrevious = false;
    NMMutationCommandGPU previous{};
    uint previousSource = 0u;
    uint previousIndex = 0u;
    for (uint order = 0u; order < totalCommands; ++order) {
        bool found = false;
        NMMutationCommandGPU selected{};
        uint selectedSource = 0u;
        uint selectedIndex = 0u;
        for (uint combined = 0u; combined < totalCommands; ++combined) {
            const NMMutationCommandGPU command = combinedMutationCommand(
                cookedCommands, cookedCount,
                borrowedCommands, borrowedStride, borrowedCount,
                triggeredCommands, triggeredCount, environment, combined
            );
            if ((command.identity.w & NM_MUTATION_ACTIVE) == 0u ||
                command.schedule.x != microstep.controlStep) continue;
            const uint source = combined < cookedCount
                ? 0u
                : (combined < cookedCount + borrowedCount
                    ? 1u : 2u);
            const uint sourceIndex = source == 0u
                ? combined
                : (source == 1u
                    ? combined - cookedCount
                    : combined - cookedCount - borrowedCount);
            if (havePrevious && !mutationKeyBefore(
                    previous, previousSource, previousIndex,
                    command, source, sourceIndex)) continue;
            if (!found || mutationKeyBefore(
                    command, source, sourceIndex,
                    selected, selectedSource, selectedIndex)) {
                selected = command;
                selectedSource = source;
                selectedIndex = sourceIndex;
                found = true;
            }
        }
        if (!found) break;
        havePrevious = true;
        previous = selected;
        previousSource = selectedSource;
        previousIndex = selectedIndex;
        const uint objectIndex = selected.identity.y;
        const NMContinuumObjectGPU object = objects[objectIndex];
        device NMFEMTopologyStateGPU& topology = topologyStates[
            environment * dispatch.objectCount + objectIndex
        ];

        if (selected.identity.x == NM_MUTATION_COHESIVE_SEPARATION) {
            uint faceOffset = 0u;
            for (uint prior = 0u; prior < objectIndex; ++prior)
                faceOffset += capacities[prior].topology.z;
            device NMCohesiveFaceGPU* target = nullptr;
            for (uint local = 0u; local < capacities[objectIndex].topology.z;
                 ++local) {
                device NMCohesiveFaceGPU& face =
                    faces[faceBase + faceOffset + local];
                if (face.adjacency.y == objectIndex &&
                    face.adjacency.z == selected.schedule.y &&
                    (face.adjacency.w & NM_TOPOLOGY_ACTIVE) != 0u)
                    target = &face;
            }
            if (target == nullptr ||
                (target->adjacency.w & NM_TOPOLOGY_SEPARATED) != 0u) continue;
            uint duplicate[3] = {NM_INVALID_INDEX, NM_INVALID_INDEX, NM_INVALID_INDEX};
            for (uint slot = 0u; slot < 3u; ++slot) {
                for (uint local = 0u; local < object.stateCount; ++local) {
                    const uint node = object.stateOffset + local;
                    if ((topologyNodes[nodeBase + node].identity.w &
                         NM_TOPOLOGY_ACTIVE) == 0u) {
                        bool already = false;
                        for (uint prior = 0u; prior < slot; ++prior)
                            already = already || duplicate[prior] == node;
                        if (!already) { duplicate[slot] = node; break; }
                    }
                }
                const uint sourceNode = target->nodesAndFirst[slot];
                const uint destination = duplicate[slot];
                nodes[nodeBase + destination] = nodes[nodeBase + sourceNode];
                fields[nodeBase + destination] = fields[nodeBase + sourceNode];
                NMFEMTopologyNodeGPU copy = topologyNodes[nodeBase + sourceNode];
                copy.identity.z += 1u;
                copy.identity.w |= NM_TOPOLOGY_ACTIVE | NM_TOPOLOGY_SEPARATED;
                topologyNodes[nodeBase + destination] = copy;
            }
            target->separatedNodes = {
                duplicate[0], duplicate[1], duplicate[2], 0u
            };
            const float3 facePoint = (
                nodes[nodeBase + target->nodesAndFirst.x].positionAndMass.xyz +
                nodes[nodeBase + target->nodesAndFirst.y].positionAndMass.xyz +
                nodes[nodeBase + target->nodesAndFirst.z].positionAndMass.xyz
            ) / 3.0f;
            const NMTetrahedronGPU second = tetrahedra[
                tetBase + target->adjacency.x
            ];
            const float secondSide = dot(
                topologyTetCentroid(second, nodes, nodeBase) - facePoint,
                target->geometry.xyz
            );
            for (uint local = 0u; local < object.elementCount; ++local) {
                device NMTetrahedronGPU& tetrahedron =
                    tetrahedra[tetBase + object.elementOffset + local];
                if ((tetrahedron.identity.w & NM_OBJECT_ACTIVE) == 0u) continue;
                const float side = dot(
                    topologyTetCentroid(tetrahedron, nodes, nodeBase) - facePoint,
                    target->geometry.xyz
                );
                if (side * secondSide < -1.0e-12f) continue;
                for (uint tetSlot = 0u; tetSlot < 4u; ++tetSlot)
                    for (uint faceSlot = 0u; faceSlot < 3u; ++faceSlot)
                        if (tetrahedron.nodes[tetSlot] ==
                            target->nodesAndFirst[faceSlot])
                            tetrahedron.nodes[tetSlot] = duplicate[faceSlot];
                tetrahedron.identity.z += 1u;
            }
            target->state.x = 1.0f;
            target->adjacency.w |= NM_TOPOLOGY_SEPARATED;
            topology.counts.x += 3u;
            topology.accounting.w += target->geometry.w;
            topology.roles.w += 1u;
            continue;
        }

        for (uint local = 0u; local < object.elementCount; ++local) {
            const uint tetIndex = object.elementOffset + local;
            device NMTetrahedronGPU& tetrahedron = tetrahedra[tetBase + tetIndex];
            if ((tetrahedron.identity.w & NM_OBJECT_ACTIVE) == 0u ||
                !mutationDeactivates(selected, object, tetIndex, tetrahedron,
                    nodes, nodeBase)) continue;
            const float mass = materials[tetrahedron.identity.x].bulk.x *
                tetrahedron.inverseRestRow0.w;
            float kinetic = 0.0f;
            for (uint slot = 0u; slot < 4u; ++slot)
                kinetic += dot(
                    nodes[nodeBase + tetrahedron.nodes[slot]]
                        .velocityAndInverseMass.xyz,
                    nodes[nodeBase + tetrahedron.nodes[slot]]
                        .velocityAndInverseMass.xyz
                );
            topology.accounting.y += mass;
            topology.accounting.z += 0.125f * mass * kinetic;
            topology.counts.y -= topology.counts.y > 0u ? 1u : 0u;
            tetrahedron.identity.w &= ~NM_OBJECT_ACTIVE;
            tetrahedron.identity.w |= NM_TOPOLOGY_ERODED;
            tetrahedron.identity.z += 1u;
            topology.roles.w += 1u;
        }
        if (selected.identity.x == NM_MUTATION_CYLINDER_PUNCTURE) {
            uint channelOffset = 0u;
            for (uint prior = 0u; prior < objectIndex; ++prior)
                channelOffset += capacities[prior].topology.w;
            bool stored = false;
            for (uint local = 0u; local < capacities[objectIndex].topology.w;
                 ++local) {
                device NMPunctureChannelGPU& channel =
                    channels[channelBase + channelOffset + local];
                if ((channel.identity.w & NM_TOPOLOGY_ACTIVE) != 0u) continue;
                const float3 axis = normalize(selected.geometry0.xyz);
                channel.identity = {objectIndex, selected.identity.z,
                    topology.roles.w, NM_TOPOLOGY_ACTIVE};
                channel.originAndRadius = float4(
                    selected.geometry1.xyz, selected.geometry0.w
                );
                channel.axisAndHalfLength = float4(
                    axis, selected.geometry1.w
                );
                topology.counts.w += 1u;
                stored = true;
                break;
            }
            if (!stored) {
                recordFailure(statuses[environment],
                    NM_STATUS_TOPOLOGY_GROWTH_REQUIRED,
                    objectIndex, selected.identity.z, float4(4.0f));
                return;
            }
        }
    }

}

kernel void nm_topology_rebuild_clear(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device NMFEMNodeStateGPU* nodes [[buffer(1)]],
    device NMIncidenceRangeGPU* ranges [[buffer(2)]],
    device uint* cursors [[buffer(3)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.femNodeCount;
    if (global >= total) return;
    nodes[global].positionAndMass.w = 0.0f;
    nodes[global].velocityAndInverseMass.w = 0.0f;
    ranges[global].first = 0u;
    ranges[global].count = 0u;
    cursors[global] = 0u;
}

kernel void nm_topology_rebuild_count_mass(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const NMMaterialGPU* materials [[buffer(1)]],
    device const NMTetrahedronGPU* tetrahedra [[buffer(2)]],
    device NMFEMNodeStateGPU* nodes [[buffer(3)]],
    device NMIncidenceRangeGPU* ranges [[buffer(4)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.femNodeCount;
    if (global >= total || dispatch.femNodeCount == 0u) return;
    const uint environment = global / dispatch.femNodeCount;
    const uint localNode = global - environment * dispatch.femNodeCount;
    const uint nodeBase = environment * dispatch.femNodeCount;
    const uint tetBase = environment * dispatch.tetrahedronCount;
    uint count = 0u;
    float mass = 0.0f;
    for (uint localTet = 0u; localTet < dispatch.tetrahedronCount; ++localTet) {
        const NMTetrahedronGPU tetrahedron = tetrahedra[tetBase + localTet];
        if ((tetrahedron.identity.w & NM_OBJECT_ACTIVE) == 0u) continue;
        bool incident = false;
        for (uint slot = 0u; slot < 4u; ++slot)
            incident = incident || tetrahedron.nodes[slot] == localNode;
        if (!incident) continue;
        ++count;
        mass += materials[tetrahedron.identity.x].bulk.x *
            tetrahedron.inverseRestRow0.w * 0.25f;
    }
    nodes[nodeBase + localNode].positionAndMass.w = mass;
    ranges[nodeBase + localNode].count = count;
}

kernel void nm_topology_rebuild_prefix(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device NMIncidenceRangeGPU* ranges [[buffer(1)]],
    device uint* cursors [[buffer(2)]],
    device NMMatterStatusGPU* statuses [[buffer(3)]],
    uint lane [[thread_index_in_threadgroup]],
    uint environment [[threadgroup_position_in_grid]]
) {
    if (lane >= 32u || environment >= dispatch.environmentCount) return;
    const uint nodeBase = environment * dispatch.femNodeCount;
    const uint incidenceBase = environment * dispatch.tetrahedronCount * 4u;
    uint running = 0u;
    for (uint chunk = 0u; chunk < dispatch.femNodeCount; chunk += 32u) {
        const uint local = chunk + lane;
        const uint count = local < dispatch.femNodeCount
            ? ranges[nodeBase + local].count : 0u;
        const uint prefix = simd_prefix_exclusive_sum(count);
        if (local < dispatch.femNodeCount) {
            ranges[nodeBase + local].first = incidenceBase + running + prefix;
            cursors[nodeBase + local] = 0u;
        }
        running += simd_sum(count);
    }
    if (lane == 0u && running > dispatch.tetrahedronCount * 4u)
        recordFailure(statuses[environment],
            NM_STATUS_TOPOLOGY_GROWTH_REQUIRED,
            NM_INVALID_INDEX, running,
            float4(float(dispatch.tetrahedronCount * 4u), 0.0f, 0.0f, 0.0f));
}

inline uint topologyGeometricCapacity(const uint current, const uint needed) {
    uint capacity = max(current, 1u);
    while (capacity < needed && capacity <= 0x7fffffffu)
        capacity = min(capacity << 1u, 0xffffffffu);
    return capacity;
}

kernel void nm_topology_publish_growth_request(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const NMFEMCapacityGPU* capacities [[buffer(1)]],
    device const NMFEMTopologyStateGPU* topologyStates [[buffer(2)]],
    device const NMMatterStatusGPU* statuses [[buffer(3)]],
    device NMTopologyGrowthRequestGPU* request [[buffer(4)]],
    uint global [[thread_position_in_grid]]
) {
    if (global != 0u) return;
    NMTopologyGrowthRequestGPU output{};
    output.identity.z = NM_INVALID_INDEX;
    uint nodes = 0u, tetrahedra = 0u, faces = 0u, channels = 0u;
    uint mutations = 0u, contacts = 0u;
    uint generation = 0u;
    for (uint object = 0u; object < dispatch.objectCount; ++object) {
        const NMFEMCapacityGPU capacity = capacities[object];
        uint neededNodes = capacity.topology.x;
        uint neededTetrahedra = capacity.topology.y;
        uint neededFaces = capacity.topology.z;
        uint neededChannels = capacity.topology.w;
        for (uint environment = 0u; environment < dispatch.environmentCount;
             ++environment) {
            const NMFEMTopologyStateGPU topology = topologyStates[
                environment * dispatch.objectCount + object];
            generation = max(generation, topology.roles.w);
            const NMMatterStatusGPU status = statuses[environment];
            if (status.code == NM_STATUS_TOPOLOGY_GROWTH_REQUIRED &&
                (status.objectIndex == object ||
                 status.objectIndex == NM_INVALID_INDEX)) {
                output.identity.x = 1u;
                if (output.identity.z == NM_INVALID_INDEX) {
                    output.identity.z = object;
                    output.identity.w = status.code;
                }
                neededNodes = max(neededNodes,
                    topology.counts.x + max(uint(status.diagnostics.y), 1u));
                neededTetrahedra = max(neededTetrahedra,
                    topology.counts.y + 1u);
                neededFaces = max(neededFaces, topology.counts.z + 1u);
                neededChannels = max(neededChannels, topology.counts.w + 1u);
            }
        }
        if (output.identity.x != 0u) {
            neededNodes = topologyGeometricCapacity(
                capacity.topology.x, neededNodes);
            neededTetrahedra = topologyGeometricCapacity(
                capacity.topology.y, neededTetrahedra);
            neededFaces = topologyGeometricCapacity(
                capacity.topology.z, neededFaces);
            neededChannels = topologyGeometricCapacity(
                capacity.topology.w, neededChannels);
        }
        nodes += neededNodes;
        tetrahedra += neededTetrahedra;
        faces += neededFaces;
        channels += neededChannels;
        mutations += capacity.work.x;
        contacts += capacity.work.z;
    }
    output.identity.y = generation + (output.identity.x != 0u ? 1u : 0u);
    output.topology = {nodes, tetrahedra, faces, channels};
    output.work = {
        4u * tetrahedra,
        output.identity.x != 0u ? topologyGeometricCapacity(
            max(mutations, 1u), mutations + 1u) : mutations,
        output.identity.x != 0u ? topologyGeometricCapacity(
            max(contacts, 1u), contacts + 1u) : contacts,
        output.identity.x != 0u ? topologyGeometricCapacity(
            max(dispatch.deformableContactCapacity, 1u),
            dispatch.deformableContactCapacity + 1u)
            : dispatch.deformableContactCapacity,
    };
    request[0] = output;
}

kernel void nm_topology_rebuild_scatter(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const NMTetrahedronGPU* tetrahedra [[buffer(1)]],
    device const NMIncidenceRangeGPU* ranges [[buffer(2)]],
    device uint* cursors [[buffer(3)]],
    device uint* incidence [[buffer(4)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.femNodeCount;
    if (global >= total || dispatch.femNodeCount == 0u) return;
    const uint environment = global / dispatch.femNodeCount;
    const uint localNode = global - environment * dispatch.femNodeCount;
    const uint nodeBase = environment * dispatch.femNodeCount;
    const uint tetBase = environment * dispatch.tetrahedronCount;
    const NMIncidenceRangeGPU range = ranges[nodeBase + localNode];
    uint cursor = 0u;
    for (uint localTet = 0u; localTet < dispatch.tetrahedronCount; ++localTet) {
        const NMTetrahedronGPU tetrahedron = tetrahedra[tetBase + localTet];
        if ((tetrahedron.identity.w & NM_OBJECT_ACTIVE) == 0u) continue;
        bool incident = false;
        for (uint slot = 0u; slot < 4u; ++slot)
            incident = incident || tetrahedron.nodes[slot] == localNode;
        if (incident && cursor < range.count)
            incidence[range.first + cursor++] = localTet;
    }
    cursors[nodeBase + localNode] = cursor;
}

kernel void nm_topology_rebuild_finalize(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device NMFEMNodeStateGPU* nodes [[buffer(1)]],
    device NMFEMTopologyNodeGPU* topologyNodes [[buffer(2)]],
    device NMIncidenceRangeGPU* ranges [[buffer(3)]],
    device NMFEMTopologyStateGPU* topologyStates [[buffer(4)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.femNodeCount;
    if (global >= total || dispatch.femNodeCount == 0u) return;
    const uint environment = global / dispatch.femNodeCount;
    device NMIncidenceRangeGPU& range = ranges[global];
    device NMFEMTopologyNodeGPU& topologyNode = topologyNodes[global];
    range.objectIndex = range.count > 0u
        ? topologyNode.identity.y : NM_INVALID_INDEX;
    if (range.count == 0u &&
        (topologyNode.identity.w & NM_TOPOLOGY_ACTIVE) != 0u) {
        topologyNode.identity.w &= ~NM_TOPOLOGY_ACTIVE;
        topologyNode.identity.z += 1u;
        const uint objectIndex = topologyNode.identity.y;
        if (objectIndex < dispatch.objectCount) {
            device atomic_uint* activeNodeCount =
                reinterpret_cast<device atomic_uint*>(
                    &topologyStates[
                        environment * dispatch.objectCount + objectIndex]
                         .counts);
            atomic_fetch_sub_explicit(
                activeNodeCount, 1u, memory_order_relaxed);
        }
    }
    device NMFEMNodeStateGPU& state = nodes[global];
    state.velocityAndInverseMass.w =
        state.restAndFixed.w <= 0.5f && state.positionAndMass.w > 0.0f
        ? 1.0f / state.positionAndMass.w : 0.0f;
}

kernel void nm_topology_commit(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const NMMatterStatusGPU* statuses [[buffer(1)]],
    device NMTetrahedronGPU* acceptedTetrahedra [[buffer(2)]],
    device const NMTetrahedronGPU* candidateTetrahedra [[buffer(3)]],
    device NMFEMTopologyNodeGPU* acceptedNodes [[buffer(4)]],
    device const NMFEMTopologyNodeGPU* candidateNodes [[buffer(5)]],
    device NMCohesiveFaceGPU* acceptedFaces [[buffer(6)]],
    device const NMCohesiveFaceGPU* candidateFaces [[buffer(7)]],
    device NMPunctureChannelGPU* acceptedChannels [[buffer(8)]],
    device const NMPunctureChannelGPU* candidateChannels [[buffer(9)]],
    device NMFEMTopologyStateGPU* acceptedStates [[buffer(10)]],
    device const NMFEMTopologyStateGPU* candidateStates [[buffer(11)]],
    uint global [[thread_position_in_grid]]
) {
    const uint width = max(max(dispatch.tetrahedronCount, dispatch.femNodeCount),
        max(max(dispatch.cohesiveFaceCount, dispatch.punctureChannelCount),
            dispatch.objectCount));
    if (width == 0u || global >= dispatch.environmentCount * width) return;
    const uint environment = global / width;
    const uint local = global - environment * width;
    if (!environmentHealthy(statuses, environment)) return;
    if (local < dispatch.tetrahedronCount) {
        const uint index = environment * dispatch.tetrahedronCount + local;
        acceptedTetrahedra[index] = candidateTetrahedra[index];
    }
    if (local < dispatch.femNodeCount) {
        const uint index = environment * dispatch.femNodeCount + local;
        acceptedNodes[index] = candidateNodes[index];
    }
    if (local < dispatch.cohesiveFaceCount) {
        const uint index = environment * dispatch.cohesiveFaceCount + local;
        acceptedFaces[index] = candidateFaces[index];
    }
    if (local < dispatch.punctureChannelCount) {
        const uint index = environment * dispatch.punctureChannelCount + local;
        acceptedChannels[index] = candidateChannels[index];
    }
    if (local < dispatch.objectCount) {
        const uint index = environment * dispatch.objectCount + local;
        acceptedStates[index] = candidateStates[index];
    }
}

kernel void nm_topology_rollback(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const NMMatterStatusGPU* statuses [[buffer(1)]],
    device NMTetrahedronGPU* acceptedTetrahedra [[buffer(2)]],
    device const NMTetrahedronGPU* checkpointTetrahedra [[buffer(3)]],
    device NMFEMTopologyNodeGPU* acceptedNodes [[buffer(4)]],
    device const NMFEMTopologyNodeGPU* checkpointNodes [[buffer(5)]],
    device NMCohesiveFaceGPU* acceptedFaces [[buffer(6)]],
    device const NMCohesiveFaceGPU* checkpointFaces [[buffer(7)]],
    device NMPunctureChannelGPU* acceptedChannels [[buffer(8)]],
    device const NMPunctureChannelGPU* checkpointChannels [[buffer(9)]],
    device NMFEMTopologyStateGPU* acceptedStates [[buffer(10)]],
    device const NMFEMTopologyStateGPU* checkpointStates [[buffer(11)]],
    device uint* nodeIncidence [[buffer(12)]],
    device const uint* checkpointIncidence [[buffer(13)]],
    device NMIncidenceRangeGPU* nodeRanges [[buffer(14)]],
    device const NMIncidenceRangeGPU* checkpointRanges [[buffer(15)]],
    uint global [[thread_position_in_grid]]
) {
    const uint width = max(max(dispatch.tetrahedronCount, dispatch.femNodeCount),
        max(max(dispatch.cohesiveFaceCount, dispatch.punctureChannelCount),
            max(dispatch.objectCount, dispatch.tetrahedronCount * 4u)));
    if (width == 0u || global >= dispatch.environmentCount * width) return;
    const uint environment = global / width;
    const uint local = global - environment * width;
    if (environmentHealthy(statuses, environment)) return;
    if (local < dispatch.tetrahedronCount) {
        const uint index = environment * dispatch.tetrahedronCount + local;
        acceptedTetrahedra[index] = checkpointTetrahedra[index];
    }
    if (local < dispatch.femNodeCount) {
        const uint index = environment * dispatch.femNodeCount + local;
        acceptedNodes[index] = checkpointNodes[index];
    }
    if (local < dispatch.cohesiveFaceCount) {
        const uint index = environment * dispatch.cohesiveFaceCount + local;
        acceptedFaces[index] = checkpointFaces[index];
    }
    if (local < dispatch.punctureChannelCount) {
        const uint index = environment * dispatch.punctureChannelCount + local;
        acceptedChannels[index] = checkpointChannels[index];
    }
    if (local < dispatch.objectCount) {
        const uint index = environment * dispatch.objectCount + local;
        acceptedStates[index] = checkpointStates[index];
    }
    if (local < dispatch.tetrahedronCount * 4u) {
        const uint index = environment * dispatch.tetrahedronCount * 4u + local;
        nodeIncidence[index] = checkpointIncidence[index];
    }
    if (local < dispatch.femNodeCount) {
        const uint index = environment * dispatch.femNodeCount + local;
        nodeRanges[index] = checkpointRanges[index];
    }
}

} // namespace numi_matter_metal
