#pragma once

#include <metal_stdlib>

#include "numi/matter/sha256_gpu.h"

using namespace metal;

namespace numi_matter_metal {
namespace sha256 {

constant uint kInitialState[8] = {
    0x6a09e667u, 0xbb67ae85u, 0x3c6ef372u, 0xa54ff53au,
    0x510e527fu, 0x9b05688cu, 0x1f83d9abu, 0x5be0cd19u,
};

constant uint kRoundConstants[64] = {
    0x428a2f98u, 0x71374491u, 0xb5c0fbcfu, 0xe9b5dba5u,
    0x3956c25bu, 0x59f111f1u, 0x923f82a4u, 0xab1c5ed5u,
    0xd807aa98u, 0x12835b01u, 0x243185beu, 0x550c7dc3u,
    0x72be5d74u, 0x80deb1feu, 0x9bdc06a7u, 0xc19bf174u,
    0xe49b69c1u, 0xefbe4786u, 0x0fc19dc6u, 0x240ca1ccu,
    0x2de92c6fu, 0x4a7484aau, 0x5cb0a9dcu, 0x76f988dau,
    0x983e5152u, 0xa831c66du, 0xb00327c8u, 0xbf597fc7u,
    0xc6e00bf3u, 0xd5a79147u, 0x06ca6351u, 0x14292967u,
    0x27b70a85u, 0x2e1b2138u, 0x4d2c6dfcu, 0x53380d13u,
    0x650a7354u, 0x766a0abbu, 0x81c2c92eu, 0x92722c85u,
    0xa2bfe8a1u, 0xa81a664bu, 0xc24b8b70u, 0xc76c51a3u,
    0xd192e819u, 0xd6990624u, 0xf40e3585u, 0x106aa070u,
    0x19a4c116u, 0x1e376c08u, 0x2748774cu, 0x34b0bcb5u,
    0x391c0cb3u, 0x4ed8aa4au, 0x5b9cca4fu, 0x682e6ff3u,
    0x748f82eeu, 0x78a5636fu, 0x84c87814u, 0x8cc70208u,
    0x90befffau, 0xa4506cebu, 0xbef9a3f7u, 0xc67178f2u,
};

constant ulong kMaximumMessageBytes = (~0ul) >> 3u;

inline uint rotateRight(const uint value, const uint bits) {
    return (value >> bits) | (value << (32u - bits));
}

inline void clearBlock(thread NMSHA256ContextGPU& context) {
    for (uint index = 0u; index < 16u; ++index) {
        context.blockWords[index] = 0u;
    }
    context.blockBytes = 0u;
}

inline void initialize(thread NMSHA256ContextGPU& context) {
    for (uint index = 0u; index < 8u; ++index) {
        context.state[index] = kInitialState[index];
    }
    clearBlock(context);
    context.totalBytes = 0ul;
    context.status = NM_SHA256_CONTEXT_READY;
}

inline bool structurallyValid(thread const NMSHA256ContextGPU& context) {
    return context.status == NM_SHA256_CONTEXT_READY &&
        context.blockBytes < 64u &&
        context.totalBytes <= kMaximumMessageBytes &&
        ulong(context.blockBytes) == (context.totalBytes & 63ul);
}

inline void compress(
    thread NMSHA256ContextGPU& context,
    thread const uint* block
) {
    uint schedule[64];
    for (uint index = 0u; index < 16u; ++index) {
        schedule[index] = block[index];
    }
    for (uint index = 16u; index < 64u; ++index) {
        const uint x = schedule[index - 15u];
        const uint y = schedule[index - 2u];
        const uint sigma0 = rotateRight(x, 7u) ^ rotateRight(x, 18u) ^
            (x >> 3u);
        const uint sigma1 = rotateRight(y, 17u) ^ rotateRight(y, 19u) ^
            (y >> 10u);
        schedule[index] = schedule[index - 16u] + sigma0 +
            schedule[index - 7u] + sigma1;
    }

    uint a = context.state[0];
    uint b = context.state[1];
    uint c = context.state[2];
    uint d = context.state[3];
    uint e = context.state[4];
    uint f = context.state[5];
    uint g = context.state[6];
    uint h = context.state[7];
    for (uint index = 0u; index < 64u; ++index) {
        const uint sum1 = rotateRight(e, 6u) ^ rotateRight(e, 11u) ^
            rotateRight(e, 25u);
        const uint choice = (e & f) ^ ((~e) & g);
        const uint temporary1 = h + sum1 + choice +
            kRoundConstants[index] + schedule[index];
        const uint sum0 = rotateRight(a, 2u) ^ rotateRight(a, 13u) ^
            rotateRight(a, 22u);
        const uint majority = (a & b) ^ (a & c) ^ (b & c);
        const uint temporary2 = sum0 + majority;
        h = g;
        g = f;
        f = e;
        e = d + temporary1;
        d = c;
        c = b;
        b = a;
        a = temporary1 + temporary2;
    }
    context.state[0] += a;
    context.state[1] += b;
    context.state[2] += c;
    context.state[3] += d;
    context.state[4] += e;
    context.state[5] += f;
    context.state[6] += g;
    context.state[7] += h;
}

inline void appendRawByte(
    thread NMSHA256ContextGPU& context,
    const uchar value
) {
    const uint word = context.blockBytes >> 2u;
    const uint shift = 24u - ((context.blockBytes & 3u) << 3u);
    context.blockWords[word] |= uint(value) << shift;
    ++context.blockBytes;
    if (context.blockBytes == 64u) {
        compress(context, context.blockWords);
        clearBlock(context);
    }
}

inline bool reserveBytes(
    thread NMSHA256ContextGPU& context,
    const ulong byteCount
) {
    if (!structurallyValid(context) ||
        byteCount > kMaximumMessageBytes - context.totalBytes) {
        context.status = NM_SHA256_CONTEXT_INVALID;
        return false;
    }
    return true;
}

inline bool updateByte(
    thread NMSHA256ContextGPU& context,
    const uchar value
) {
    if (!reserveBytes(context, 1ul)) return false;
    appendRawByte(context, value);
    ++context.totalBytes;
    return true;
}

// Canonical scalar encoders used by state-domain schemas. These deliberately
// use little-endian bytes to match the existing Numi exact-state writers; the
// SHA-256 compression and final digest remain standard big-endian SHA-256.
inline bool updateU32LE(
    thread NMSHA256ContextGPU& context,
    const uint value
) {
    if (!reserveBytes(context, 4ul)) return false;
    for (uint index = 0u; index < 4u; ++index) {
        appendRawByte(context, uchar((value >> (index * 8u)) & 0xffu));
    }
    context.totalBytes += 4ul;
    return true;
}

inline bool updateU64LE(
    thread NMSHA256ContextGPU& context,
    const ulong value
) {
    if (!reserveBytes(context, 8ul)) return false;
    for (uint index = 0u; index < 8u; ++index) {
        appendRawByte(context, uchar((value >> (index * 8u)) & 0xfful));
    }
    context.totalBytes += 8ul;
    return true;
}

inline uint loadBigEndianWord(
    const device uchar* bytes,
    const ulong offset
) {
    return (uint(bytes[offset]) << 24u) |
        (uint(bytes[offset + 1ul]) << 16u) |
        (uint(bytes[offset + 2ul]) << 8u) |
        uint(bytes[offset + 3ul]);
}

inline bool updateDeviceBytes(
    thread NMSHA256ContextGPU& context,
    const device uchar* bytes,
    ulong byteCount
) {
    if (!reserveBytes(context, byteCount)) return false;
    const ulong originalByteCount = byteCount;
    ulong offset = 0ul;

    while (context.blockBytes != 0u && byteCount != 0ul) {
        appendRawByte(context, bytes[offset]);
        ++offset;
        --byteCount;
    }
    while (byteCount >= 64ul) {
        uint block[16];
        for (uint word = 0u; word < 16u; ++word) {
            block[word] = loadBigEndianWord(
                bytes, offset + ulong(word) * 4ul);
        }
        compress(context, block);
        offset += 64ul;
        byteCount -= 64ul;
    }
    while (byteCount != 0ul) {
        appendRawByte(context, bytes[offset]);
        ++offset;
        --byteCount;
    }
    context.totalBytes += originalByteCount;
    return true;
}

inline uint loadBigEndianThreadWord(
    const thread uchar* bytes,
    const ulong offset
) {
    return (uint(bytes[offset]) << 24u) |
        (uint(bytes[offset + 1ul]) << 16u) |
        (uint(bytes[offset + 2ul]) << 8u) |
        uint(bytes[offset + 3ul]);
}

// Thread-local canonical metadata uses the same incremental engine as device
// state bytes without expanding dozens of scalar append calls into one
// oversized production pipeline.
inline bool updateThreadBytes(
    thread NMSHA256ContextGPU& context,
    const thread uchar* bytes,
    ulong byteCount
) {
    if (!reserveBytes(context, byteCount)) return false;
    const ulong originalByteCount = byteCount;
    ulong offset = 0ul;
    while (context.blockBytes != 0u && byteCount != 0ul) {
        appendRawByte(context, bytes[offset]);
        ++offset;
        --byteCount;
    }
    while (byteCount >= 64ul) {
        uint block[16];
        for (uint word = 0u; word < 16u; ++word) {
            block[word] = loadBigEndianThreadWord(
                bytes, offset + ulong(word) * 4ul);
        }
        compress(context, block);
        offset += 64ul;
        byteCount -= 64ul;
    }
    while (byteCount != 0ul) {
        appendRawByte(context, bytes[offset]);
        ++offset;
        --byteCount;
    }
    context.totalBytes += originalByteCount;
    return true;
}

inline bool finalize(
    thread NMSHA256ContextGPU& context,
    thread NMSHA256DigestGPU& digest
) {
    for (uint index = 0u; index < NM_MATTER_SHA256_DIGEST_BYTES; ++index) {
        digest.bytes[index] = 0u;
    }
    if (!structurallyValid(context)) {
        context.status = NM_SHA256_CONTEXT_INVALID;
        return false;
    }
    const ulong bitCount = context.totalBytes << 3u;
    appendRawByte(context, uchar(0x80u));
    while (context.blockBytes != 56u) {
        appendRawByte(context, uchar(0u));
    }
    for (uint index = 0u; index < 8u; ++index) {
        const uint shift = 56u - index * 8u;
        appendRawByte(context, uchar((bitCount >> shift) & 0xfful));
    }
    if (context.blockBytes != 0u) {
        context.status = NM_SHA256_CONTEXT_INVALID;
        return false;
    }
    for (uint word = 0u; word < 8u; ++word) {
        for (uint byte = 0u; byte < 4u; ++byte) {
            digest.bytes[word * 4u + byte] = uchar(
                (context.state[word] >> (24u - byte * 8u)) & 0xffu);
        }
    }
    context.status = NM_SHA256_CONTEXT_FINALIZED;
    return true;
}

} // namespace sha256
} // namespace numi_matter_metal
