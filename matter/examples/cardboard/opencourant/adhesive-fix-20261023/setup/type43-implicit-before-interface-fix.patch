 C
       RETURN
       END
+
+C=======================================================================
+C     LAW117 / TYPE43 initial-stiffness iteration matrix.
+C     PM(32) is PARMAT(1)=max(EN,ET)/3 from HM_READ_MAT117.
+C     The isotropic upper stiffness avoids adding a second material law.
+C     It is exact for a fixed flat elastic interface with EN=ET, and an
+C     approximation otherwise. It changes Newton conditioning ONLY;
+C     SIGEPS117 and SUSER43 still define forces and accepted history.
+C     No consistent damage/geometric tangent claim is made here.
+      SUBROUTINE S43KE117(PM,IXS,X,ELBUF_STR,NEL,
+     .                   IDDL,NDOF,K_DIAG,K_LT,IADK,JDIK)
+      USE ELBUFDEF_MOD
+      USE ELEMENT_MOD, ONLY : NIXS
+#include "implicit_f.inc"
+#include "mvsiz_p.inc"
+#include "param_c.inc"
+      INTEGER NEL,IXS(NIXS,*),IDDL(*),NDOF(*),IADK(*),JDIK(*)
+      my_real PM(NPROPM,*),X(3,*),K_DIAG(*),K_LT(*)
+      TYPE(ELBUF_STRUCT_), TARGET :: ELBUF_STR
+      my_real BK(3,3,MVSIZ,36),OFF(MVSIZ),P(3,4),
+     .   R(3),S(3),CROSS(3),H(4,4),DR(4),DS(4),
+     .   PG,XI,ETA,SX(4),SY(4),AREA,EK,COEF,SGN
+      INTEGER I,A,B,Q,D,L,IA,IB,MID
+      DATA SX/-1.,1.,1.,-1./, SY/-1.,-1.,1.,1./
+      PG=ONE/SQRT(THREE)
+      BK=ZERO
+      DO Q=1,4
+        XI=SX(Q)*PG
+        ETA=SY(Q)*PG
+        DO A=1,4
+          H(A,Q)=FOURTH*(ONE+SX(A)*XI)*(ONE+SY(A)*ETA)
+        ENDDO
+      ENDDO
+      DO I=1,NEL
+        OFF(I)=MIN(ONE,MAX(ZERO,ELBUF_STR%GBUF%OFF(I)))
+        IF (OFF(I)==ZERO) CYCLE
+        MID=IXS(1,I)
+        EK=THREE*PM(32,MID)
+        DO A=1,4
+          P(:,A)=HALF*(X(:,IXS(A+1,I))+X(:,IXS(A+5,I)))
+        ENDDO
+        DO Q=1,4
+          XI=SX(Q)*PG
+          ETA=SY(Q)*PG
+          DO A=1,4
+            DR(A)=FOURTH*SX(A)*(ONE+SY(A)*ETA)
+            DS(A)=FOURTH*SY(A)*(ONE+SX(A)*XI)
+          ENDDO
+          R=MATMUL(P,DR)
+          S=MATMUL(P,DS)
+          CROSS(1)=R(2)*S(3)-R(3)*S(2)
+          CROSS(2)=R(3)*S(1)-R(1)*S(3)
+          CROSS(3)=R(1)*S(2)-R(2)*S(1)
+          AREA=SQRT(SUM(CROSS*CROSS))
+          L=0
+          DO A=1,8
+            IA=MOD(A-1,4)+1
+            DO B=A,8
+              IB=MOD(B-1,4)+1
+              L=L+1
+              SGN=ONE
+              IF (A<=4 .AND. B>4) SGN=-ONE
+              COEF=SGN*EK*AREA*H(IA,Q)*H(IB,Q)
+              DO D=1,3
+                BK(D,D,I,L)=BK(D,D,I,L)+COEF
+              ENDDO
+            ENDDO
+          ENDDO
+        ENDDO
+      ENDDO
+      CALL ASSEM_S8(IXS,NEL,IDDL,NDOF,K_DIAG,K_LT,IADK,JDIK,
+     1 BK(1,1,1,1), BK(1,1,1,2), BK(1,1,1,3), BK(1,1,1,4),
+     2 BK(1,1,1,5), BK(1,1,1,6), BK(1,1,1,7), BK(1,1,1,8),
+     3 BK(1,1,1,9), BK(1,1,1,10),BK(1,1,1,11),BK(1,1,1,12),
+     4 BK(1,1,1,13),BK(1,1,1,14),BK(1,1,1,15),BK(1,1,1,16),
+     5 BK(1,1,1,17),BK(1,1,1,18),BK(1,1,1,19),BK(1,1,1,20),
+     6 BK(1,1,1,21),BK(1,1,1,22),BK(1,1,1,23),BK(1,1,1,24),
+     7 BK(1,1,1,25),BK(1,1,1,26),BK(1,1,1,27),BK(1,1,1,28),
+     8 BK(1,1,1,29),BK(1,1,1,30),BK(1,1,1,31),BK(1,1,1,32),
+     9 BK(1,1,1,33),BK(1,1,1,34),BK(1,1,1,35),BK(1,1,1,36),
+     A OFF)
+      END
