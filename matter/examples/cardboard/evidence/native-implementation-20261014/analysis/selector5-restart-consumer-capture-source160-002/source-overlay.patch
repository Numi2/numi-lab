+[[nodiscard]] inline bool singleTickScope(
+    const std::uint32_t maximumRateExponent,
+    const std::uint32_t microtick,
+    const std::uint32_t microtickCount) noexcept {
+    return maximumRateExponent == 0u && microtick == 0u &&
+        microtickCount == 1u;
+}
