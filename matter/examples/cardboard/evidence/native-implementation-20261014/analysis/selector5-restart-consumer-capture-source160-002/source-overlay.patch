+[[nodiscard]] inline bool checkedAppendBytes(
+    const std::uint64_t current,
+    const std::uint64_t append,
+    const std::uint64_t cap,
+    std::uint64_t& out) noexcept {
+    if (current > cap || append > cap - current) return false;
+    out = current + append;
+    return true;
+}
