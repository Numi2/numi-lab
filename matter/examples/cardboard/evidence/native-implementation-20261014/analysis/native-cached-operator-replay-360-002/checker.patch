+std::string floatWords(const float* values, std::size_t count) {
+    std::ostringstream stream;
+    stream << std::hex << std::setfill('0');
+    for (std::size_t i = 0; i < count; ++i) {
+        if (i != 0) stream << ',';
+        stream << std::setw(8) << std::bit_cast<std::uint32_t>(values[i]);
+    }
+    return stream.str();
+}
+
+bool exactNumericFloatArray(const float* left, const float* right, std::size_t count) {
+    for (std::size_t i = 0; i < count; ++i) {
+        if (!std::isfinite(left[i]) || !std::isfinite(right[i]) || left[i] != right[i]) {
+            return false;
+        }
+    }
+    return true;
+}
 
+void testExactNumericFloatArray() {
+    const float positiveZero[3] = {0.0f, 1.0f, -0.0f};
+    const float signedZero[3] = {-0.0f, 1.0f, 0.0f};
+    need(exactNumericFloatArray(positiveZero, signedZero, 3u),
+         "exact numeric comparison must equate signed-zero encodings");
+    const float adjacent[3] = {0.0f, std::nextafter(1.0f, 2.0f), -0.0f};
+    need(!exactNumericFloatArray(positiveZero, adjacent, 3u),
+         "exact numeric comparison must reject any changed nonzero float");
+    const float nonfinite[3] = {0.0f, 1.0f,
+                                std::numeric_limits<float>::quiet_NaN()};
+    need(!exactNumericFloatArray(positiveZero, nonfinite, 3u),
+         "exact numeric comparison must reject nonfinite immutable fields");
+}
