+            const float3 rightStartPoint = mortarBaryPoint(rightBaryPoint, rightStart);
+            const float3 rightFinishPoint = mortarBaryPoint(rightBaryPoint, rightFinish);
+            leftCells[index].start[vertexIndex] = {
+                leftStartPoint.x, leftStartPoint.y, leftStartPoint.z};
+            leftCells[index].finish[vertexIndex] = {
+                leftFinishPoint.x, leftFinishPoint.y, leftFinishPoint.z};
+            rightCells[index].start[vertexIndex] = {
+                rightStartPoint.x, rightStartPoint.y, rightStartPoint.z};
+            rightCells[index].finish[vertexIndex] = {
+                rightFinishPoint.x, rightFinishPoint.y, rightFinishPoint.z};
