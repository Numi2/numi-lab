+inline float mortarPolygonArea2(thread const float3* polygon,
+                                const uint polygonCount) {
+    float twiceArea = 0.0f;
+    for (uint index = 0u; index < polygonCount; ++index)
+        twiceArea += crossMortarBary2(
+            polygon[index], polygon[(index + 1u) % polygonCount]);
+    return twiceArea;
+}
