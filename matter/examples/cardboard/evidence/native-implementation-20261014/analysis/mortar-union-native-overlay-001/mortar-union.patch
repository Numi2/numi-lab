+inline float mortarTriangleIntersectionArea(
+    thread const float3* triangleA,
+    thread const float3* triangleB
+) {
+    const float signedAreaB = crossMortarBary2(
+        triangleB[1] - triangleB[0], triangleB[2] - triangleB[0]);
+    if (!isfinite(signedAreaB) || abs(signedAreaB) <= 1.0e-10f)
+        return INFINITY;
+    const float orientation = signedAreaB > 0.0f ? 1.0f : -1.0f;
+    float3 polygonA[6], polygonB[6];
+    for (uint vertexIndex = 0u; vertexIndex < 3u; ++vertexIndex)
+        polygonA[vertexIndex] = triangleA[vertexIndex];
+    uint polygonCount = 3u;
+    for (uint edge = 0u; edge < 3u; ++edge) {
+        const uint clipped = clipMortarBaryPolygon(
+            polygonA, polygonCount, triangleB[edge], triangleB[(edge + 1u) % 3u],
+            orientation, true, polygonB);
+        if (clipped > 6u) return INFINITY;
+        polygonCount = clipped;
+        for (uint vertexIndex = 0u; vertexIndex < polygonCount; ++vertexIndex)
+            polygonA[vertexIndex] = polygonB[vertexIndex];
+        if (polygonCount < 3u) return 0.0f;
+    }
+    const float twiceArea = abs(mortarPolygonArea2(polygonA, polygonCount));
+    return isfinite(twiceArea) ? 0.5f * twiceArea : INFINITY;
+}
