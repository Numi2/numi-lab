+inline bool prefixByteCountMatches(const bool prefixOnly,
+                                   const std::uint64_t capturedBytes,
+                                   const std::uint64_t currentBytes) noexcept {
+    return prefixOnly ? currentBytes >= capturedBytes
+                      : currentBytes == capturedBytes;
+}
