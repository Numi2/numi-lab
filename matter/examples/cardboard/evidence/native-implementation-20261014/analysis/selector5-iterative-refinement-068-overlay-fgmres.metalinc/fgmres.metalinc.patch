+// Add one signed product to a two-word float accumulator. fma captures the
+// product roundoff and TwoSum-style renormalization captures addition loss.
+// This is used only for the residual and the single correction solve; it does
+// not alter the assembled operator or the first LU solve.
+inline float2 fgmresGraphAccumulateProduct(
+    const float2 accumulator,
+    const float left,
+    const float right,
+    const float sign
+) {
+    const float product = left * right;
+    const float productError = fma(left, right, -product);
+    const float term = sign * product;
+    const float termError = sign * productError;
+    const float high = accumulator.x + term;
+    const float virtualTerm = high - accumulator.x;
+    const float sumError = (accumulator.x - (high - virtualTerm)) +
+        (term - virtualTerm);
+    const float tail = accumulator.y + sumError + termError;
+    const float normalizedHigh = high + tail;
+    const float normalizedLow = tail - (normalizedHigh - high);
+    return float2(normalizedHigh, normalizedLow);
+}
