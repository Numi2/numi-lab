+NSString* resolveAdjacentPayloadPath(NSString* manifestPath,
+                                     const std::string& payloadValue) {
+    NSString* manifestInput = [manifestPath stringByStandardizingPath];
+    NSURL* manifestURL = [NSURL fileURLWithPath:manifestInput];
+    NSURL* resolvedManifestURL = [manifestURL URLByResolvingSymlinksInPath];
+    require(resolvedManifestURL != nil,
+        "capture manifest path cannot be resolved");
+    NSString* manifestDirectory = [[resolvedManifestURL.URLByDeletingLastPathComponent
+        path] stringByStandardizingPath];
+    NSString* payloadInput = [NSString stringWithUTF8String:payloadValue.c_str()];
+    require(payloadInput != nil && payloadValue.size() > 0u,
+        "capture payload path is empty or invalid UTF-8");
+
+    NSString* candidatePath = nil;
+    if ([payloadInput isAbsolutePath]) {
+        candidatePath = payloadInput;
+    } else {
+        require(payloadValue.find('/') == std::string::npos &&
+                    payloadValue.find('\\') == std::string::npos,
+            "relative capture payload must be an adjacent basename");
+        candidatePath = [manifestDirectory stringByAppendingPathComponent:payloadInput];
+    }
+    NSURL* resolvedPayloadURL = [[NSURL fileURLWithPath:candidatePath]
+        URLByResolvingSymlinksInPath];
+    require(resolvedPayloadURL != nil,
+        "capture payload path cannot be resolved");
+    NSString* resolvedPayloadParent = [[resolvedPayloadURL.URLByDeletingLastPathComponent
+        path] stringByStandardizingPath];
+    require([resolvedPayloadParent isEqualToString:manifestDirectory],
+        "capture payload must resolve to a sibling of its manifest");
+    return resolvedPayloadURL.path;
 }
 
