+
+// Preserve the assembled, free-node base residual before FGMRES repurposes its
+// residual arena for restart vectors. This scratch is consumed only by the
+// opt-in base-state Cauchy fallback after the ordinary Newton Armijo search
+// has exhausted healthy trials.
+kernel void nm_fgmres_capture_base_cauchy_rhs(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    constant NMFGMRESLayoutGPU& layout [[buffer(30)]],
+    device const float4* residual [[buffer(1)]],
+    device const NMFEMNodeStateGPU* candidate [[buffer(2)]],
+    device float4* baseRHS [[buffer(3)]],
+    uint global [[thread_position_in_grid]]) {
+    if (global >= layout.unknownCount) return;
+    const uint totalNodes = dispatch.environmentCount * dispatch.femNodeCount;
+    if (global < totalNodes) {
+        const NMFEMNodeStateGPU node = candidate[global];
+        const bool freeMassRow = !femStaticConstraint(node.restAndFixed.w) &&
+            isfinite(node.positionAndMass.w) && node.positionAndMass.w > 0.0f;
+        const float4 value = residual[global];
+        baseRHS[global] = freeMassRow
+            ? float4(value.xyz, 0.0f) : float4(0.0f);
+    } else {
+        // The pure-FEM layout still reserves a second E*N field backing
+        // block. Preserve it so the Cauchy builder can reject any nonzero
+        // generalized RHS instead of silently dropping those equations.
+        baseRHS[global] = residual[global];
+    }
+}
+
+// Select either the preserved base right-hand side or a just-computed
+// gradient into the ordinary element-operator input arena. Nonselected
+// environments are zeroed so their primary Newton corrections and statuses
+// remain untouched by the fallback's per-environment operator dispatches.
+kernel void nm_fgmres_prepare_base_cauchy_action(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    device const float4* metrics [[buffer(1)]],
+    device const float4* baseRHS [[buffer(2)]],
+    device const float4* gradient [[buffer(3)]],
+    device const NMFEMNodeStateGPU* candidate [[buffer(4)]],
+    device float4* direction [[buffer(5)]],
+    constant uint& useGradient [[buffer(6)]],
+    uint global [[thread_position_in_grid]]) {
+    const uint total = dispatch.environmentCount * dispatch.femNodeCount;
+    if (global >= total) return;
+    const uint environment = global / dispatch.femNodeCount;
+    const bool selected = metrics[environment].w == 3.0f;
+    const NMFEMNodeStateGPU node = candidate[global];
+    const bool freeMassRow = !femStaticConstraint(node.restAndFixed.w) &&
+        isfinite(node.positionAndMass.w) && node.positionAndMass.w > 0.0f;
+    const float4 value = useGradient != 0u
+        ? gradient[global] : baseRHS[global];
+    direction[global] = selected && freeMassRow && all(isfinite(value.xyz))
+        ? float4(value.xyz, 0.0f) : float4(0.0f);
+}
+
+// Form the raw unpreconditioned Cauchy direction p=tau*A^T*b. The primary
+// FGMRES true-residual test remains associated with its original Newton
+// delta; this direction is admitted only by the subsequent ordinary nonlinear
+// Armijo and final residual/correction certificates.
+kernel void nm_fgmres_build_base_cauchy_direction(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    constant NMFGMRESLayoutGPU& layout [[buffer(30)]],
+    constant NMMixedSolverGPU& solver [[buffer(1)]],
+    device float4* metrics [[buffer(2)]],
+    device const NMFEMNodeStateGPU* candidate [[buffer(3)]],
+    device const float4* gradient [[buffer(4)]],
+    device const float4* gradientAction [[buffer(5)]],
+    device float4* solution [[buffer(6)]],
+    device float4* lineSearch [[buffer(7)]],
+    device float* environmentLineSearch [[buffer(8)]],
+    device float4* fallbackTrace [[buffer(9)]],
+    device NMFGMRESStateGPU* states [[buffer(10)]],
+    device NMMatterStatusGPU* statuses [[buffer(11)]],
+    device NMMatterStatusGPU* trialStatuses [[buffer(12)]],
+    constant uint& solverIteration [[buffer(13)]],
+    device const float4* baseRHS [[buffer(14)]],
+    uint environment [[thread_position_in_grid]]) {
+    if (environment >= dispatch.environmentCount ||
+        dispatch.femNodeCount == 0u || dispatch.objectCount != 1u)
+        return;
+    float4 state = metrics[environment];
+    if (state.w != 3.0f) {
+        fallbackTrace[environment] = float4(0.0f);
+        return;
+    }
+
+    float gradientNorm2 = 0.0f;
+    float gradientCorrection = 0.0f;
+    float actionNorm2 = 0.0f;
+    float actionCorrection = 0.0f;
+    bool valid = environmentHealthy(statuses, environment) &&
+        states[environment].diagnostics.z > 0.5f;
+    const uint nodeBase = environment * dispatch.femNodeCount;
+    const uint fieldBase = dispatch.environmentCount * dispatch.femNodeCount;
+    for (uint node = 0u; node < dispatch.femNodeCount; ++node) {
+        const float4 fieldResidual = baseRHS[fieldBase + nodeBase + node];
+        valid = valid && all(isfinite(fieldResidual)) &&
+            all(fieldResidual == float4(0.0f));
+    }
+    for (uint node = 0u; node < dispatch.femNodeCount; ++node) {
+        const uint global = nodeBase + node;
+        const NMFEMNodeStateGPU candidateNode = candidate[global];
+        if (femStaticConstraint(candidateNode.restAndFixed.w) ||
+            !isfinite(candidateNode.positionAndMass.w) ||
+            candidateNode.positionAndMass.w <= 0.0f)
+            continue;
+        const float3 b = baseRHS[global].xyz;
+        const float3 g = gradient[global].xyz;
+        const float3 ag = gradientAction[global].xyz;
+        valid = valid && all(isfinite(b)) &&
+            all(isfinite(g)) && all(isfinite(ag));
+        fgmresCompensatedAdd(gradientNorm2, gradientCorrection, dot(g, g));
+        fgmresCompensatedAdd(actionNorm2, actionCorrection, dot(ag, ag));
+    }
+    const float tau = gradientNorm2 / actionNorm2;
+    valid = valid && isfinite(gradientNorm2) && gradientNorm2 > 0.0f &&
+        isfinite(actionNorm2) && actionNorm2 > 0.0f && isfinite(tau) &&
+        tau > 0.0f;
+    float4 trace = float4(
+        valid ? sqrt(gradientNorm2) : INFINITY,
+        valid ? sqrt(actionNorm2) : INFINITY,
+        valid ? tau : INFINITY,
+        states[environment].diagnostics.z > 0.5f ? 1.0f : 0.0f);
+    fallbackTrace[environment] = trace;
+    if (!valid) {
+        state.w = 4.0f;
+        metrics[environment] = state;
+        recordFailure(statuses[environment],
+            NM_STATUS_NONLINEAR_SOLVER_FAILURE, NM_INVALID_INDEX,
+            solverIteration,
+            float4(trace.x, trace.y, tau, gradientCorrection + actionCorrection));
+        return;
+    }
+
+    for (uint node = 0u; node < dispatch.femNodeCount; ++node) {
+        const uint global = nodeBase + node;
+        const NMFEMNodeStateGPU candidateNode = candidate[global];
+        const bool freeMassRow = !femStaticConstraint(candidateNode.restAndFixed.w) &&
+            isfinite(candidateNode.positionAndMass.w) &&
+            candidateNode.positionAndMass.w > 0.0f;
+        solution[global] = freeMassRow
+            ? float4(tau * gradient[global].xyz, 0.0f)
+            : float4(0.0f);
+        // The admitted mode has no field unknowns; clear its inactive backing
+        // rows so no earlier Newton solution can leak into candidate build.
+        const uint fieldGlobal = dispatch.environmentCount *
+            dispatch.femNodeCount + global;
+        if (fieldGlobal < layout.unknownCount)
+            solution[fieldGlobal] = float4(0.0f);
+    }
+    // Preserve the fact that FGMRES certified the original Newton delta, but
+    // clear its convergence latch now that the applied direction is p instead.
+    states[environment].diagnostics.z = 0.0f;
+    state.w = 0.0f;
+    state.y = INFINITY;
+    state.z = 0.0f;
+    metrics[environment] = state;
+    lineSearch[environment] = float4(
+        0.0f, INFINITY, 0.0f, float(solverIteration));
+    environmentLineSearch[environment] = 0.0f;
+    trialStatuses[environment] = {};
+    (void)solver;
 }
 
