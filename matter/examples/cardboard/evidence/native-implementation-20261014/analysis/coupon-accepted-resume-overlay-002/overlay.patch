+inline const std::string& property(
+    const std::map<std::string, std::string>& values, const char* name) {
+    const auto found = values.find(name);
+    if (found == values.end())
+        throw std::invalid_argument(std::string("coupon resume is missing '") + name + "'");
+    return found->second;
+}
