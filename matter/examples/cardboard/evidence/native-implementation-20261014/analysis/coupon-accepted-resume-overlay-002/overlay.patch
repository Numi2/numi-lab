+std::uint64_t fileBytesOrThrow(const std::filesystem::path& path) {
+    std::error_code error;
+    const auto size = std::filesystem::file_size(path, error);
+    require(!error, "cannot measure coupon checkpoint artifact: " + path.string());
+    return size;
+}
