        "text": [
          "// Stackless left-first traversal emits right leaves in ascending Morton",
          "// order. Prefixing by left order therefore preserves the old candidate order",
          "// exactly. Bounds reject only disjoint subtrees; pair eligibility and swept",
          "// AABB semantics are unchanged. Stop after capacity+1 matches when counting:",
          "// that is sufficient to prove overflow without scanning an unbounded output.",
          "template <bool scatter>",
          "inline uint surfaceBVHPairs(",
          "const NMMatterDispatchGPU dispatch,",
          "const uint leafCount,",
          "const uint environment,",
          "const uint leftOrder,",
          "const uint activeCount,",
          "device const NMContinuumSurfacePrimitiveGPU* primitives,",
          "device const uint* sortedIndices,",
          "device const float4* bounds,",
          "device const NMFEMTopologyNodeGPU* topologyNodes,",
          "device const NMContinuumObjectGPU* objects,",
          "device const NMIncidenceRangeGPU* cohesiveSurfaceFaceRanges,",
          "device const nm_uint4* cohesiveSurfaceFaceRefs,",
          "device const NMCohesiveFaceGPU* cohesiveFaces,",
          "device NMDeformableContactCandidateGPU* candidates,",
          "const uint outputOffset",
          ") {",
          "if (leftOrder + 1u >= activeCount || leafCount == 0u) return 0u;",
          "const uint primitiveCount = continuumSurfacePrimitiveCount(dispatch);",
          "const uint primitiveBase = environment * primitiveCount;",
          "const uint leftIndex = sortedIndices[primitiveBase + leftOrder];",
          "const auto left = primitives[primitiveBase + leftIndex];",
          "const uint treeBase = environment * 2u * leafCount;",
          "const uint leafDepth = 31u - clz(leafCount);",
          "const uint capacity = dispatch.deformableContactCapacity;",
          "uint node = 1u, count = 0u;",
          "while (node != 0u) {",
          "const uint depth = 31u - clz(node);",
          "const uint span = leafCount >> depth;",
          "const uint first = (node - (1u << depth)) * span;",
          "const float3 minimum = bounds[2u * (treeBase + node)].xyz;",
          "const float3 maximum = bounds[2u * (treeBase + node) + 1u].xyz;",
          "const bool overlaps = first + span > leftOrder + 1u &&",
          "first < activeCount &&",
          "all(left.boundsMinimum.xyz <= maximum) &&",
          "all(minimum <= left.boundsMaximum.xyz);",
          "if (overlaps && depth < leafDepth) {",
          "node *= 2u;",
          "continue;",
          "}",
          "if (overlaps && depth == leafDepth) {",
          "const uint rightIndex = sortedIndices[primitiveBase + first];",
          "const auto right = primitives[primitiveBase + rightIndex];",
          "if ((right.identity.w & NM_TOPOLOGY_ACTIVE) != 0u &&",
          "surfacePairEligible(dispatch, left, right, objects,",
          "topologyNodes, environment, cohesiveSurfaceFaceRanges,",
          "cohesiveSurfaceFaceRefs, cohesiveFaces)) {",
          "if (scatter) {",
          "const uint output = outputOffset + count;",
          "if (output < capacity) {",
          "NMDeformableContactCandidateGPU candidate{};",
          "candidate.identity = uint4(leftIndex, rightIndex, output, NM_TOPOLOGY_ACTIVE);",
          "candidates[environment * capacity + output] = candidate;",
          "}",
          "}",
          "++count;",
          "if (count > capacity) return count;",
          "}",
          "}",
          "// Ascend past completed right subtrees, then visit the next sibling.",
          "while ((node & 1u) != 0u) node >>= 1u;",
          "if (node != 0u) ++node;",
          "}",
          "return count;"
        ]
