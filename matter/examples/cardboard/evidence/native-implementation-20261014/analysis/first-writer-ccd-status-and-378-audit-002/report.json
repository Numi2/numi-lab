          "const uint objectIndex,",
          "const uint failingIndex,",
          "const float4 diagnostics",
          ") {",
          "device atomic_uint* atomicCode =",
          "reinterpret_cast<device atomic_uint*>(&status.code);",
          "uint expected = NM_STATUS_SUCCESS;",
          "while (!atomic_compare_exchange_weak_explicit(",
          "atomicCode,",
          "&expected,",
          "code,",
          "memory_order_relaxed,",
          "memory_order_relaxed",
          ")) {",
          "if (expected != NM_STATUS_SUCCESS) {",
          "return;",
          "}",
