+    float fraction = 0.0f;
+    gap = startGap;
+    constexpr uint maximumAdvancementSteps = 256u;
+    constexpr float minimumFractionStep = 5.960464477539063e-8f;
+    for (uint iteration = 0u; iteration < maximumAdvancementSteps; ++iteration) {
+        const float remaining = 1.0f - fraction;
+        if (!(remaining > 0.0f)) return true;
+        const float step = 0.8f * (gap - floor) / lipschitz;
+        if (!isfinite(step) || !(step > minimumFractionStep)) return false;
+        const float nextFraction = min(1.0f, fraction + step);
+        if (!(nextFraction > fraction)) return false;
+        float nextGap = -INFINITY;
