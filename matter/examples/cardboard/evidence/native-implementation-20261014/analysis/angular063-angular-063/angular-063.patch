+        ? sourceBody.position.xyz : base.bodyCenter.xyz;
+    const float3 lastCenter = trial.bodyCenter.xyz;
+    const float3 firstAngular = physicalSweep
+        ? trial.angularVelocity.xyz : base.angularVelocity.xyz;
+    const float3 lastAngular = trial.angularVelocity.xyz;
+    const float3 relativeFirst = firstPoint - firstCenter;
+    const float3 relativeLast = lastPoint - lastCenter;
+    const float3 relativeDelta = relativeLast - relativeFirst;
+    const float rotationRate = timestep * (physicalSweep
+        ? length(lastAngular) : length(lastAngular - firstAngular));
