+    const float centerScale = max(maximumAbsoluteCoordinate(firstCenter),
+        maximumAbsoluteCoordinate(lastCenter));
+    const float pointScale = max(maximumAbsoluteCoordinate(firstPoint),
+        maximumAbsoluteCoordinate(lastPoint));
+    const float roundoff = 16.0f * kEpsilon * max(
+        max(centerScale, pointScale), 1.0e-12f);
+    const float relativeClosest = segmentPointDistance(
+        relativeFirst, relativeLast, float3(0.0f));
