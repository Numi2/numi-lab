+    minimumSampledGap = gap;
+    float endGap = -INFINITY;
+    if (!freeBoxArmijoGapAt(proxy, sourceBody, base, trial,
+                            firstPoint, lastPoint, timestep, 1.0f,
+                            physicalSweep, endGap) || !(endGap > floor)) {
+        minimumSampledGap = min(minimumSampledGap, endGap);
+        return false;
+    }
+    minimumSampledGap = min(minimumSampledGap, endGap);
