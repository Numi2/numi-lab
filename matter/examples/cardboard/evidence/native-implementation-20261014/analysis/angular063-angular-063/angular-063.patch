+// Differential of Exp(phi) with a world-frame angular-velocity perturbation.
+// Free rigid candidates are materialized as Exp(dt*omega)*q0, so using the
+// raw angular direction is only correct at zero angular velocity.
+inline float3 coupledSO3LeftJacobianApply(
+    const float3 phi,
+    const float3 value
+) {
+    const float angleSquared = dot(phi, phi);
+    float first;
+    float second;
+    if (angleSquared < 1.0e-6f) {
+        const float fourth = angleSquared * angleSquared;
+        first = 0.5f - angleSquared / 24.0f + fourth / 720.0f;
+        second = 1.0f / 6.0f - angleSquared / 120.0f +
+            fourth / 5040.0f;
+    } else {
+        const float angle = sqrt(angleSquared);
+        first = (1.0f - cos(angle)) / angleSquared;
+        second = (angle - sin(angle)) / (angleSquared * angle);
+    }
+    const float3 firstCross = cross(phi, value);
+    return value + first * firstCross +
+        second * cross(phi, firstCross);
+}
+
+inline float3 coupledSO3LeftJacobianTransposeApply(
+    const float3 phi,
+    const float3 value
+) {
+    const float angleSquared = dot(phi, phi);
+    float first;
+    float second;
+    if (angleSquared < 1.0e-6f) {
+        const float fourth = angleSquared * angleSquared;
+        first = 0.5f - angleSquared / 24.0f + fourth / 720.0f;
+        second = 1.0f / 6.0f - angleSquared / 120.0f +
+            fourth / 5040.0f;
+    } else {
+        const float angle = sqrt(angleSquared);
+        first = (1.0f - cos(angle)) / angleSquared;
+        second = (angle - sin(angle)) / (angleSquared * angle);
+    }
+    const float3 firstCross = cross(phi, value);
+    return value - first * firstCross +
+        second * cross(phi, firstCross);
+}
