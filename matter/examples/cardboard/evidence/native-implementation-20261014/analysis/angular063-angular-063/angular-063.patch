+
+inline bool freeBoxArmijoRigidAt(
+    const NMRigidProxyGPU proxy,
+    const MRBodyStateGPU sourceBody,
+    const NMRigidStateGPU base,
+    const NMRigidStateGPU trial,
+    const float timestep,
+    const float fraction,
+    const bool physicalSweep,
+    thread NMRigidStateGPU& rigid
+) {
+    if (!isfinite(fraction) || fraction < 0.0f || fraction > 1.0f ||
+        !(timestep > 0.0f) || !isfinite(timestep)) return false;
+    if (physicalSweep && fraction == 0.0f) {
+        projectProxy(proxy, sourceBody, true, rigid);
+        return finiteStationaryBoxRigidRecord(rigid);
+    }
+    if (fraction == 1.0f) {
+        rigid = trial;
+        return finiteStationaryBoxRigidRecord(rigid);
+    }
+    if (!physicalSweep && fraction == 0.0f) {
+        rigid = base;
+        return finiteStationaryBoxRigidRecord(rigid);
