+        environment * dispatch.femNodeCount + femNode].xyz;
+    const float3 deltaCenter = timestep * linearDirection;
+    const float3 normal = sample.normalAndVelocity.xyz;
+    const float3 point = sample.pointAndSeparation.xyz +
+        sample.pointAndSeparation.w * normal;
