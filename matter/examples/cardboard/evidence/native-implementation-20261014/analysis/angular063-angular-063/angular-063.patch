+// Match MetalWorld's scene-body integrator exactly, including its small-angle
+// series. The free-BOX candidate, alpha path, and physical CCD sweep must use
+// the same pose map as the body that will be committed after Matter accepts.
+inline float4 integrateFreeBoxSceneQuaternion(
+    const float4 source,
+    const float3 angularVelocity,
+    const float timestep
+) {
+    const float3 rotationVector = timestep * angularVelocity;
+    const float angle = length(rotationVector);
+    const float halfAngle = 0.5f * angle;
+    const float scale = angle > 1.0e-6f
+        ? sin(halfAngle) / angle
+        : 0.5f - angle * angle / 48.0f;
+    const float4 delta = float4(rotationVector * scale, cos(halfAngle));
+    return quaternionNormalize(quaternionMultiply(
+        delta, quaternionNormalize(source)));
+}
