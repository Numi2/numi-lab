+    const float3 signedOutside = abs(localPoint) - rigid.extent.xyz;
+    const float3 outside = max(signedOutside, float3(0.0f));
+    const float localDistance = length(outside);
+    if (!(localDistance > 0.0f) || !isfinite(localDistance))
+        return float3(NAN);
+    const float3 activeAxes = float3(
+        signedOutside.x > 0.0f ? 1.0f : 0.0f,
+        signedOutside.y > 0.0f ? 1.0f : 0.0f,
+        signedOutside.z > 0.0f ? 1.0f : 0.0f);
+    const float3 localNormal = quaternionRotate(inverseOrientation, normal);
+    const float3x3 localActive = float3x3(
+        float3(activeAxes.x, 0.0f, 0.0f),
+        float3(0.0f, activeAxes.y, 0.0f),
+        float3(0.0f, 0.0f, activeAxes.z));
