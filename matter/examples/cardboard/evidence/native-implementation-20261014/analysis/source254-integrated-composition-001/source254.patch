--- a/matter/tools/cardboard_constituent_volume_damage.hpp
+++ b/matter/tools/cardboard_constituent_volume_damage.hpp
@@ -0,0 +1,86 @@
+#pragma once
+
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+
+namespace numi::cardboard::damage_volume {
+
+inline constexpr double kPaperDamageVolumeThreshold = 0.5;
+
+struct PaperConstituentDamageVolume {
+    double damageVolumeIntegral = 0.0;
+    double referenceVolumeM3 = 0.0;
+    double volumeAtOrAboveThresholdM3 = 0.0;
+    std::uint64_t tetrahedronCount = 0u;
+
+    bool addTetrahedron(double referenceVolume,
+                        const std::array<double, 4>& planeAreas,
+                        const std::array<double, 4>& planeDamage,
+                        double threshold) {
+        if (!(std::isfinite(referenceVolume) && referenceVolume > 0.0 &&
+              std::isfinite(threshold) && threshold >= 0.0 && threshold <= 1.0) ||
+            tetrahedronCount == std::numeric_limits<std::uint64_t>::max()) {
+            return false;
+        }
+        double totalArea = 0.0;
+        double areaWeightedDamage = 0.0;
+        for (std::size_t plane = 0u; plane < planeAreas.size(); ++plane) {
+            const double area = planeAreas[plane];
+            const double damage = planeDamage[plane];
+            if (!(std::isfinite(area) && area > 0.0 &&
+                  std::isfinite(damage) && damage >= 0.0 && damage <= 1.0)) {
+                return false;
+            }
+            totalArea += area;
+            areaWeightedDamage += area * damage;
+            if (!(std::isfinite(totalArea) && std::isfinite(areaWeightedDamage))) {
+                return false;
+            }
+        }
+        if (!(totalArea > 0.0)) return false;
+        const double tetrahedronIndex = areaWeightedDamage / totalArea;
+        const double nextDamageVolume =
+            damageVolumeIntegral + referenceVolume * tetrahedronIndex;
+        const double nextReferenceVolume = referenceVolumeM3 + referenceVolume;
+        const double nextThresholdVolume = volumeAtOrAboveThresholdM3 +
+            (tetrahedronIndex >= threshold ? referenceVolume : 0.0);
+        if (!(std::isfinite(tetrahedronIndex) && tetrahedronIndex >= 0.0 &&
+              tetrahedronIndex <= 1.0 &&
+              std::isfinite(nextDamageVolume) &&
+              std::isfinite(nextReferenceVolume) &&
+              std::isfinite(nextThresholdVolume))) {
+            return false;
+        }
+        damageVolumeIntegral = nextDamageVolume;
+        referenceVolumeM3 = nextReferenceVolume;
+        volumeAtOrAboveThresholdM3 = nextThresholdVolume;
+        ++tetrahedronCount;
+        return true;
+    }
+
+    bool finish(double& volumeWeightedDamageIndex,
+                double& volumeFractionAtOrAboveThreshold) const {
+        if (tetrahedronCount == 0u ||
+            !(std::isfinite(damageVolumeIntegral) &&
+              std::isfinite(referenceVolumeM3) && referenceVolumeM3 > 0.0 &&
+              std::isfinite(volumeAtOrAboveThresholdM3) &&
+              volumeAtOrAboveThresholdM3 >= 0.0 &&
+              volumeAtOrAboveThresholdM3 <= referenceVolumeM3)) {
+            return false;
+        }
+        volumeWeightedDamageIndex = damageVolumeIntegral / referenceVolumeM3;
+        volumeFractionAtOrAboveThreshold =
+            volumeAtOrAboveThresholdM3 / referenceVolumeM3;
+        return std::isfinite(volumeWeightedDamageIndex) &&
+            volumeWeightedDamageIndex >= 0.0 &&
+            volumeWeightedDamageIndex <= 1.0 &&
+            std::isfinite(volumeFractionAtOrAboveThreshold) &&
+            volumeFractionAtOrAboveThreshold >= 0.0 &&
+            volumeFractionAtOrAboveThreshold <= 1.0;
+    }
+};
+
+} // namespace numi::cardboard::damage_volume
--- a/matter/tools/cardboard_constituent_volume_damage_check.cpp
+++ b/matter/tools/cardboard_constituent_volume_damage_check.cpp
@@ -0,0 +1,88 @@
+#include "cardboard_constituent_volume_damage.hpp"
+
+#include <array>
+#include <cmath>
+#include <iostream>
+#include <limits>
+#include <stdexcept>
+
+using numi::cardboard::damage_volume::PaperConstituentDamageVolume;
+
+namespace {
+void require(bool condition, const char* message) {
+    if (!condition) throw std::runtime_error(message);
+}
+void near(double actual, double expected, double tolerance = 1e-14) {
+    require(std::isfinite(actual) && std::abs(actual - expected) <= tolerance,
+            "unexpected volume-damage result");
+}
+}
+
+int main() {
+    try {
+        const std::array<double, 4> areasA{1.0, 3.0, 2.0, 2.0};
+        const std::array<double, 4> damageA{0.0, 0.5, 1.0, 0.0};
+        const std::array<double, 4> equalAreas{1.0, 1.0, 1.0, 1.0};
+        const std::array<double, 4> damageB{0.75, 0.75, 0.75, 0.75};
+
+        PaperConstituentDamageVolume coarse;
+        require(coarse.addTetrahedron(1.0, areasA, damageA, 0.5),
+                "valid heterogeneous tet rejected");
+        require(coarse.addTetrahedron(3.0, equalAreas, damageB, 0.5),
+                "valid second tet rejected");
+        double index = -1.0;
+        double thresholdFraction = -1.0;
+        require(coarse.finish(index, thresholdFraction), "valid aggregate rejected");
+        near(index, 0.671875);
+        near(thresholdFraction, 0.75);
+        near(coarse.referenceVolumeM3, 4.0);
+        require(coarse.tetrahedronCount == 2u, "tetrahedron count mismatch");
+
+        // Subdivide the uniform volume-3 constituent into three equal reference
+        // volume cells. Both the volume-weighted index and thresholded volume
+        // fraction must remain invariant.
+        PaperConstituentDamageVolume refined;
+        require(refined.addTetrahedron(1.0, areasA, damageA, 0.5),
+                "refined heterogeneous tet rejected");
+        for (int i = 0; i < 3; ++i)
+            require(refined.addTetrahedron(1.0, equalAreas, damageB, 0.5),
+                    "subdivided uniform tet rejected");
+        double refinedIndex = -1.0;
+        double refinedThresholdFraction = -1.0;
+        require(refined.finish(refinedIndex, refinedThresholdFraction),
+                "refined aggregate rejected");
+        near(refinedIndex, index);
+        near(refinedThresholdFraction, thresholdFraction);
+
+        const std::array<double, 4> boundaryDamage{0.5, 0.5, 0.5, 0.5};
+        PaperConstituentDamageVolume boundary;
+        require(boundary.addTetrahedron(2.0, equalAreas, boundaryDamage, 0.5),
+                "threshold-boundary tet rejected");
+        double boundaryIndex = -1.0;
+        double boundaryFraction = -1.0;
+        require(boundary.finish(boundaryIndex, boundaryFraction),
+                "threshold-boundary aggregate rejected");
+        near(boundaryIndex, 0.5);
+        near(boundaryFraction, 1.0);
+
+        PaperConstituentDamageVolume empty;
+        require(!empty.finish(index, thresholdFraction), "empty aggregate admitted");
+        const std::array<double, 4> badArea{1.0, 0.0, 1.0, 1.0};
+        const std::array<double, 4> badDamage{0.0, 0.1, 1.0001, 0.0};
+        PaperConstituentDamageVolume invalid;
+        require(!invalid.addTetrahedron(1.0, badArea, damageA, 0.5),
+                "zero plane area admitted");
+        require(!invalid.addTetrahedron(1.0, equalAreas, badDamage, 0.5),
+                "out-of-range plane damage admitted");
+        require(!invalid.addTetrahedron(
+                    std::numeric_limits<double>::quiet_NaN(), equalAreas, damageA, 0.5),
+                "nonfinite reference volume admitted");
+        require(!invalid.addTetrahedron(1.0, equalAreas, damageA, 1.1),
+                "invalid threshold admitted");
+        std::cout << "constituent volume damage index: heterogeneous weighting, subdivision invariance, threshold boundary, and invalid-input checks passed; CPU observer only\n";
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
--- a/matter/tools/cardboard_free_force_residual.hpp
+++ b/matter/tools/cardboard_free_force_residual.hpp
@@ -0,0 +1,66 @@
+#pragma once
+
+#include "numi/matter/shared.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <limits>
+#include <optional>
+#include <span>
+
+namespace numi::cardboard {
+
+struct FreeForceResidualBounds {
+    double l2Newtons = 0.0;
+    double maximumNodeNewtons = 0.0;
+    std::size_t freeNodeCount = 0u;
+};
+
+// The native FEM residual is an impulse (N s). Divide by this accepted step's
+// dt and include only currently free nodes. This is a measured residual, not
+// an estimate of force error.
+inline std::optional<FreeForceResidualBounds>
+calculateFreeForceResidualBounds(
+    const std::span<const nm_float4> residuals,
+    const std::span<const NMFEMNodeStateGPU> nodes,
+    const std::size_t environmentCount,
+    const std::size_t nodeCount,
+    const std::size_t environment,
+    const double dtSeconds) noexcept {
+    if (!std::isfinite(dtSeconds) || dtSeconds <= 0.0 ||
+        environmentCount == 0u || nodeCount == 0u ||
+        environment >= environmentCount ||
+        nodeCount > std::numeric_limits<std::size_t>::max() / environmentCount)
+        return std::nullopt;
+    const std::size_t total = environmentCount * nodeCount;
+    if (residuals.size() < total || nodes.size() < total)
+        return std::nullopt;
+    const std::size_t base = environment * nodeCount;
+    double sumSquared = 0.0;
+    FreeForceResidualBounds result;
+    for (std::size_t node = 0u; node < nodeCount; ++node) {
+        const float fixed = nodes[base + node].restAndFixed.w;
+        if (!std::isfinite(fixed)) return std::nullopt;
+        if (fixed != 0.0f) continue;
+        const nm_float4 residual = residuals[base + node];
+        if (!std::isfinite(residual.x) || !std::isfinite(residual.y) ||
+            !std::isfinite(residual.z))
+            return std::nullopt;
+        const double fx = static_cast<double>(residual.x) / dtSeconds;
+        const double fy = static_cast<double>(residual.y) / dtSeconds;
+        const double fz = static_cast<double>(residual.z) / dtSeconds;
+        const double magnitude = std::hypot(std::hypot(fx, fy), fz);
+        if (!std::isfinite(magnitude)) return std::nullopt;
+        sumSquared += magnitude * magnitude;
+        if (!std::isfinite(sumSquared)) return std::nullopt;
+        result.maximumNodeNewtons = std::max(result.maximumNodeNewtons, magnitude);
+        ++result.freeNodeCount;
+    }
+    if (result.freeNodeCount == 0u) return std::nullopt;
+    result.l2Newtons = std::sqrt(sumSquared);
+    if (!std::isfinite(result.l2Newtons)) return std::nullopt;
+    return result;
+}
