+            {{ea,sizeof(std::uint32_t)}},
+            {{input.contactPairCount,sizeof(std::uint32_t)}},
+            {{ep,sizeof(nm_float4)}},{{ep,sizeof(nm_float4)}},{{ep,sizeof(nm_float4)}},
+            {{input.environmentCount,sizeof(std::uint32_t)}},
+            {{input.environmentCount,sizeof(std::uint32_t)}},
+            {{2u,sizeof(std::uint32_t)}}
