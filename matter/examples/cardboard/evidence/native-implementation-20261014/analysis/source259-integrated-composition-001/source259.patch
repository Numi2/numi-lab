+inline NMMortarComplementAuditGPU makeMortarComplementAudit(
+    const uint environment,
+    const uint slot,
+    const uint queryKind,
+    const uint4 candidateIdentity,
+    const uint4 cells,
+    const uint4 feature,
+    thread const float3* leftStart,
