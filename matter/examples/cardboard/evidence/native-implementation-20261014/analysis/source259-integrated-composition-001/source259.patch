+            observed.rightBary[local] = float4(rightTriangle.bary[local], 0.0f);
+        }
+    }
+    observed.result = float4(hit ? 1.0f : 0.0f,
+                            certified ? 1.0f : 0.0f, toi, separation);
+    observed.parameters = float4(thickness, leftDt, rightDt,
+                                  float(iteration));
+    return observed;
+}
