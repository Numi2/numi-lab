+    const bool hit,
+    const bool certified,
+    const float toi,
+    const float separation
+) {
+    NMMortarComplementAuditGPU observed{};
+    observed.attempt = uint4(1u, environment, slot, queryKind);
+    observed.candidateIdentity = candidateIdentity;
+    observed.cells = cells;
+    observed.feature = feature;
+    for (uint local = 0u; local < 3u; ++local) {
+        observed.start[local] = float4(leftStart[local], 0.0f);
+        observed.start[local + 3u] = float4(rightStart[local], 0.0f);
+        observed.finish[local] = float4(leftFinish[local], 0.0f);
+        observed.finish[local + 3u] = float4(rightFinish[local], 0.0f);
