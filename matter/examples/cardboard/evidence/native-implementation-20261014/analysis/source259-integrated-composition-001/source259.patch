+        input.rigidIncidenceCount!=input.contactPairCount||
+        input.contactNodeRangeCount!=expectedNodeRangeCount||
+        input.rigidRangeCount!=input.rigidProxyCount||
+        input.bodyProxyIncidenceCount>input.rigidProxyCount||
