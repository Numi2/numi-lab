+// Equilibrate the Newton system in dimensionless state coordinates.  With
+// deltaState = stateScale * y, each row is divided by its weighted L1 norm;
+// this leaves the root unchanged while making the correction test comparable
+// across the mixed strain/stress-history state units in the 15-state law.
+inline bool solveScaledLocalMaterialSystem(
+    thread float* matrix,
+    thread float* rightHandSide,
+    device const float* acceptedState,
+    const thread float* candidateState,
+    const uint count,
+    const float scaleFloor,
+    thread float& scaledCorrectionNorm
+) {
+    if (!(scaleFloor > 0.0f) || !isfinite(scaleFloor) ||
+        count == 0u || count > NM_MAX_MATERIAL_STATE) return false;
+    float stateScale[NM_MAX_MATERIAL_STATE];
+    float rowScale[NM_MAX_MATERIAL_STATE];
+    for (uint column = 0u; column < count; ++column) {
+        if (!isfinite(acceptedState[column]) || !isfinite(candidateState[column]))
+            return false;
+        stateScale[column] = max(max(abs(acceptedState[column]),
+                                     abs(candidateState[column])), scaleFloor);
+        if (!(stateScale[column] > 0.0f) || !isfinite(stateScale[column]))
+            return false;
+    }
+    for (uint row = 0u; row < count; ++row) {
+        float weightedRowNorm = 0.0f;
+        for (uint column = 0u; column < count; ++column) {
+            const float entry = matrix[row * count + column];
+            if (!isfinite(entry)) return false;
+            weightedRowNorm += abs(entry) * stateScale[column];
+        }
+        if (!(weightedRowNorm > 0.0f) || !isfinite(weightedRowNorm) ||
+            !isfinite(rightHandSide[row])) return false;
+        rowScale[row] = weightedRowNorm;
+    }
+    for (uint row = 0u; row < count; ++row) {
+        for (uint column = 0u; column < count; ++column) {
+            matrix[row * count + column] =
+                matrix[row * count + column] * stateScale[column] / rowScale[row];
+        }
+        rightHandSide[row] /= rowScale[row];
+    }
+    if (!solveLocalMaterialSystem(matrix, rightHandSide, count)) return false;
+    scaledCorrectionNorm = 0.0f;
+    for (uint state = 0u; state < count; ++state) {
+        const float scaledCorrection = rightHandSide[state];
+        if (!isfinite(scaledCorrection)) return false;
+        scaledCorrectionNorm = max(scaledCorrectionNorm, abs(scaledCorrection));
+        rightHandSide[state] = scaledCorrection * stateScale[state];
+        if (!isfinite(rightHandSide[state])) return false;
+    }
+    return isfinite(scaledCorrectionNorm);
