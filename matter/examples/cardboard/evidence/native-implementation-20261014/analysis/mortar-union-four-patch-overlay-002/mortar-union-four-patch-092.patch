+inline bool mortarPairedBoundaryForFaceIDs(
+    const NMMortarPatchSet patchSet,
+    const uint faceA,
+    const uint faceB,
+    const NMContinuumSurfacePrimitiveGPU leftPrimitive,
+    const NMContinuumSurfacePrimitiveGPU rightPrimitive,
