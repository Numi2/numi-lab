+            leftB[0], leftB[1], leftB[2]) ||
+        !mortarPatchInPrimitiveCoordinates(sourceB,
+            refB.leftIsSideB == 0u, rightPrimitive, gridNodeCount,
+            rightB[0], rightB[1], rightB[2])) return false;
+    return mortarBuildPairedBoundary(
+        leftA, rightA, leftB, rightB, boundary);
+}
