+// A zero-area shared edge between two distinct mortar pages is not an
+// uncovered contact region when both page maps pair the same material edge.
+// Keep this exemption at the individual CCD witness: the surrounding cell
+// pair remains active so off-edge or sliding collisions are still tested.
+constant float kMortarPairedBoundaryBaryTolerance = 8.0e-6f;
+
+struct NMMortarPairedBoundary {
+    float2 left0;
+    float2 left1;
+    float2 right0;
+    float2 right1;
+    uint valid;
+};
+
+inline bool mortarBuildPairedBoundary(
+    thread const float3* leftA,
+    thread const float3* rightA,
+    thread const float3* leftB,
+    thread const float3* rightB,
+    thread NMMortarPairedBoundary& boundary
+) {
+    boundary.valid = 0u;
+    uint commonCount = 0u;
+    uint matchedA[2] = {NM_INVALID_INDEX, NM_INVALID_INDEX};
+    uint matchedB[2] = {NM_INVALID_INDEX, NM_INVALID_INDEX};
+    const float tolerance2 =
+        kMortarPairedBoundaryBaryTolerance *
+        kMortarPairedBoundaryBaryTolerance;
+    for (uint a = 0u; a < 3u; ++a) {
+        for (uint b = 0u; b < 3u; ++b) {
+            if (dot(leftA[a].xy - leftB[b].xy,
+                    leftA[a].xy - leftB[b].xy) > tolerance2 ||
+                dot(rightA[a].xy - rightB[b].xy,
+                    rightA[a].xy - rightB[b].xy) > tolerance2) continue;
+            bool duplicate = false;
+            for (uint prior = 0u; prior < commonCount; ++prior)
+                duplicate = duplicate ||
+                    (matchedA[prior] == a && matchedB[prior] == b);
+            if (duplicate) continue;
+            if (commonCount >= 2u) return true;
+            matchedA[commonCount] = a;
+            matchedB[commonCount] = b;
+            ++commonCount;
+        }
+    }
+    if (commonCount != 2u) return true;
+    const uint a0 = matchedA[0], a1 = matchedA[1];
+    const uint b0 = matchedB[0], b1 = matchedB[1];
+    if (dot(leftA[a1].xy - leftA[a0].xy,
+            leftA[a1].xy - leftA[a0].xy) <= tolerance2 ||
+        dot(rightA[a1].xy - rightA[a0].xy,
+            rightA[a1].xy - rightA[a0].xy) <= tolerance2 ||
+        dot(leftB[b1].xy - leftB[b0].xy,
+            leftB[b1].xy - leftB[b0].xy) <= tolerance2 ||
+        dot(rightB[b1].xy - rightB[b0].xy,
+            rightB[b1].xy - rightB[b0].xy) <= tolerance2) return true;
+    boundary.left0 = leftA[a0].xy;
+    boundary.left1 = leftA[a1].xy;
+    boundary.right0 = rightA[a0].xy;
+    boundary.right1 = rightA[a1].xy;
+    boundary.valid = 1u;
+    return true;
+}
+
+inline bool mortarBoundaryParameter(
+    const float2 point,
+    const float2 edge0,
+    const float2 edge1,
+    thread float& parameter
+) {
+    const float2 edge = edge1 - edge0;
+    const float edgeLength2 = dot(edge, edge);
+    const float tolerance = kMortarPairedBoundaryBaryTolerance;
+    if (!(edgeLength2 > tolerance * tolerance) || !isfinite(edgeLength2))
+        return false;
+    parameter = dot(point - edge0, edge) / edgeLength2;
+    if (!isfinite(parameter) || parameter < -tolerance ||
+        parameter > 1.0f + tolerance) return false;
+    const float2 nearest = edge0 + clamp(parameter, 0.0f, 1.0f) * edge;
+    const float2 error = point - nearest;
+    return dot(error, error) <= tolerance * tolerance;
+}
+
+inline bool mortarFeatureIsPairedBoundary(
+    const NMMortarPairedBoundary boundary,
+    const float3 leftBarycentric,
+    const float3 rightBarycentric
+) {
+    if (boundary.valid == 0u) return false;
+    float leftParameter, rightParameter;
+    if (!mortarBoundaryParameter(leftBarycentric.xy,
+            boundary.left0, boundary.left1, leftParameter) ||
+        !mortarBoundaryParameter(rightBarycentric.xy,
+            boundary.right0, boundary.right1, rightParameter)) return false;
+    return abs(leftParameter - rightParameter) <=
+        kMortarPairedBoundaryBaryTolerance;
+}
+
+inline bool mortarBoundaryWitnessIsNonApproaching(
+    const float3 relativeDisplacement,
+    const float3 normal
+) {
+    const float displacementLength = length(relativeDisplacement);
+    if (!isfinite(displacementLength) || !finite3(normal)) return false;
+    const float approachTolerance =
+        8.0f * kEpsilon * max(displacementLength, kGeometryFloor);
+    return dot(relativeDisplacement, normal) >= -approachTolerance;
+}
