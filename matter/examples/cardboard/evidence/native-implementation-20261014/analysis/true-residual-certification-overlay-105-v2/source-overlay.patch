+            // production status, but never overwrites an existing failure.
+            NMMatterStatusGPU diagnosticFailure = healthy;
+            diagnosticFailure.code = NM_STATUS_CONTACT_FAILURE;
+            diagnosticFailure.failingIndex = 9u;
