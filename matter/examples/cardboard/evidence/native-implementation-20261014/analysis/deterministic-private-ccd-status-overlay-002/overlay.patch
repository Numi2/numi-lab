+inline void recordDeformableNarrowphaseFailure(
+    const uint deterministicSelection,
+    device NMMatterStatusGPU* environmentStatuses,
+    device NMMatterStatusGPU* candidateStatuses,
+    const uint environment,
+    const uint global,
+    const uint code,
+    const uint objectIndex,
+    const uint failingIndex,
+    const float4 diagnostics
+) {
+    if (deterministicSelection != 0u) {
+        // One invocation owns this slot, so its failure tuple has no writer race.
+        recordFailure(candidateStatuses[global], code, objectIndex,
+                      failingIndex, diagnostics);
+    } else {
+        // Preserve the established first-writer behavior for ordinary contact.
+        recordFailure(environmentStatuses[environment], code, objectIndex,
+                      failingIndex, diagnostics);
+    }
+}
