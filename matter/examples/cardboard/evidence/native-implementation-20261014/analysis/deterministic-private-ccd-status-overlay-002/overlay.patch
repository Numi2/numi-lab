 // Stable device compaction keeps the dynamic rows dense for every downstream
 // primal solve while preserving candidate order and therefore deterministic
 // history ownership.
+kernel void nm_contact_reduce_deformable_narrowphase_failures(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    device const uint* candidateCounts [[buffer(1)]],
+    device const NMMatterStatusGPU* candidateStatuses [[buffer(2)]],
+    device NMMatterStatusGPU* statuses [[buffer(3)]],
+    uint environment [[thread_position_in_grid]]
+) {
+    if (environment >= dispatch.environmentCount ||
+        dispatch.deformableContactCapacity == 0u ||
+        statuses[environment].code != NM_STATUS_SUCCESS) return;
+    const uint capacity = dispatch.deformableContactCapacity;
+    const uint count = min(candidateCounts[environment], capacity);
+    const uint base = environment * capacity;
+    // Candidate slots are emitted in deterministic source traversal order.
+    // Selecting the first failing slot makes the reported status independent
+    // of Metal thread arrival order without changing contact acceptance.
+    for (uint slot = 0u; slot < count; ++slot) {
+        const NMMatterStatusGPU failure = candidateStatuses[base + slot];
+        if (failure.code == NM_STATUS_SUCCESS) continue;
+        recordFailure(statuses[environment], failure.code,
+                      failure.objectIndex, failure.failingIndex,
+                      failure.diagnostics);
+        return;
+    }
+}
