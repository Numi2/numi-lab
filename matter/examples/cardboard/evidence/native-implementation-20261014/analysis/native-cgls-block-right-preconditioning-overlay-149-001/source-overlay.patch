+            !baseCGLSFinite4(row0) || !baseCGLSFinite4(row1) ||
+            !baseCGLSFinite4(row2) || row0.w != 1.0f ||
+            row1.w != 0.0f || row2.w != 0.0f) {
+            baseCGLSMarkError(errors, environment,
+                kBaseCGLSErrorInvalidRightScale | kBaseCGLSErrorBadMask);
+        }
+    } else if (any(mask != float4(0.0f)) ||
+               any(row0 != float4(0.0f)) ||
+               any(row1 != float4(0.0f)) ||
+               any(row2 != float4(0.0f))) {
+        baseCGLSMarkError(errors, environment,
+            kBaseCGLSErrorInvalidRightScale | kBaseCGLSErrorBadMask);
+    }
+}
+
+// Apply S or S^T to a full CGLS vector. The mechanical block is the first
+// E*N float4 rows; the second E*N field backing rows are required to stay
+// zero. The input/output buffers may alias because each thread reads only
+// its own row before writing it.
+kernel void nm_fgmres_base_cgls_apply_right_scale(
+    constant uint& unknownCount [[buffer(0)]],
+    constant uint& environmentCount [[buffer(1)]],
+    constant uint& transpose [[buffer(2)]],
+    device const float4* rowMask [[buffer(3)]],
+    device const uint* rowEnvironment [[buffer(4)]],
+    device const uint* selected [[buffer(5)]],
+    device const float4* rightScaleRows [[buffer(6)]],
+    device const float4* input [[buffer(7)]],
+    device float4* output [[buffer(8)]],
+    device atomic_uint* errors [[buffer(9)]],
+    uint index [[thread_position_in_grid]]) {
+    if (index >= unknownCount) return;
+    if (!baseCGLSVectorLayoutValid(unknownCount, environmentCount) ||
+        transpose > 1u) {
+        if (environmentCount > 0u)
+            baseCGLSMarkError(errors, 0u, kBaseCGLSErrorBadShape);
+        output[index] = float4(0.0f);
+        return;
+    }
+    const uint mechanicalRows = unknownCount / 2u;
+    const uint nodeCount = mechanicalRows / environmentCount;
+    const uint localIndex = index < mechanicalRows
+        ? index : index - mechanicalRows;
+    const uint environment = localIndex / nodeCount;
+    if (environment >= environmentCount || selected[environment] > 1u ||
+        rowEnvironment[index] != environment) {
+        if (environment < environmentCount)
+            baseCGLSMarkError(errors, environment,
+                kBaseCGLSErrorBadSelection | kBaseCGLSErrorBadShape);
+        output[index] = float4(0.0f);
+        return;
+    }
+    if (atomic_load_explicit(&errors[environment], memory_order_relaxed) != 0u) {
+        output[index] = float4(0.0f);
+        return;
+    }
+    const float4 value = input[index];
+    const float4 mask = rowMask[index];
+    if (!baseCGLSFinite4(value) || !baseCGLSFinite4(mask) ||
+        value.w != 0.0f || mask.w != 0.0f) {
+        baseCGLSMarkError(errors, environment,
+            kBaseCGLSErrorNonfinite | kBaseCGLSErrorBadMask);
+        output[index] = float4(0.0f);
+        return;
+    }
+    if (selected[environment] == 0u || index >= mechanicalRows ||
+        all(mask.xyz == float3(0.0f))) {
+        if (any(value != float4(0.0f)))
+            baseCGLSMarkError(errors, environment,
+                kBaseCGLSErrorNonzeroConstrainedRow);
+        output[index] = float4(0.0f);
+        return;
+    }
+    if (any(mask.xyz != float3(1.0f))) {
+        baseCGLSMarkError(errors, environment, kBaseCGLSErrorBadMask);
+        output[index] = float4(0.0f);
+        return;
+    }
+    const uint localNode = localIndex - environment * nodeCount;
+    const uint base = (environment * nodeCount + localNode) * 3u;
+    const float4 row0 = rightScaleRows[base];
+    const float4 row1 = rightScaleRows[base + 1u];
+    const float4 row2 = rightScaleRows[base + 2u];
+    const float3 result = transpose == 0u
+        ? float3(dot(row0.xyz, value.xyz), dot(row1.xyz, value.xyz),
+                 dot(row2.xyz, value.xyz))
+        : float3(row0.x * value.x + row1.x * value.y + row2.x * value.z,
+                 row0.y * value.x + row1.y * value.y + row2.y * value.z,
+                 row0.z * value.x + row1.z * value.y + row2.z * value.z);
+    const float4 result4 = float4(result, 0.0f);
+    if (!baseCGLSFinite4(row0) || !baseCGLSFinite4(row1) ||
+        !baseCGLSFinite4(row2) || row0.w != 1.0f || row1.w != 0.0f ||
+        row2.w != 0.0f || !baseCGLSFinite4(result4)) {
+        baseCGLSMarkError(errors, environment,
+            kBaseCGLSErrorInvalidRightScale);
+        output[index] = float4(0.0f);
+        return;
+    }
+    output[index] = result4;
+}
+
 } // namespace numi_matter_metal
