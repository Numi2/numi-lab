+inline int contactCompensatedSign(const MRCompensatedScalar value) {
+    if (value.high < 0.0f) return -1;
+    if (value.high > 0.0f) return 1;
+    if (value.low < 0.0f) return -1;
+    if (value.low > 0.0f) return 1;
