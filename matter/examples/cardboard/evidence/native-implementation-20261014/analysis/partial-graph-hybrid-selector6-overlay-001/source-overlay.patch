+// Selector 6 permits partial graph coverage only when the same candidate's
+// free, uncovered rows have a finite, valid 3x3 inverse block. Fixed rows do
+// not consume that block. This runs after the per-Newton block builder, so a
+// dynamic release cannot reuse a stale validity marker.
+kernel void nm_fgmres_graph_validate_hybrid_mask(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    device const NMFEMNodeStateGPU* candidate [[buffer(1)]],
+    device const uint* nodeCoverage [[buffer(2)]],
+    device const float4* inverseBlockRows [[buffer(3)]],
+    device NMMatterStatusGPU* statuses [[buffer(4)]],
+    uint global [[thread_position_in_grid]]) {
+    const uint total = dispatch.environmentCount * dispatch.femNodeCount;
+    if (global >= total || dispatch.femNodeCount == 0u) return;
+    const uint node = global % dispatch.femNodeCount;
+    const uint environment = global / dispatch.femNodeCount;
+    const NMFEMNodeStateGPU state = candidate[global];
+    if (!fgmresGraphCandidateNodeConsistent(state)) {
+        recordFailure(statuses[environment], NM_STATUS_UNSUPPORTED,
+            0u, NM_INVALID_INDEX,
+            float4(float(node), float(nodeCoverage[node]),
+                   state.restAndFixed.w, state.velocityAndInverseMass.w));
+        return;
+    }
+    if (state.restAndFixed.w != 0.0f || nodeCoverage[node] != 0u) return;
+    const uint block = global * 3u;
+    const float4 row0 = inverseBlockRows[block];
+    const float4 row1 = inverseBlockRows[block + 1u];
+    const float4 row2 = inverseBlockRows[block + 2u];
+    if (row0.w != 1.0f) {
+        recordFailure(statuses[environment], NM_STATUS_UNSUPPORTED,
+            0u, NM_INVALID_INDEX,
+            float4(float(node), float(nodeCoverage[node]),
+                   row0.w, state.velocityAndInverseMass.w));
+        return;
+    }
+    if (!all(isfinite(row0.xyz)) || !all(isfinite(row1.xyz)) ||
+        !all(isfinite(row2.xyz))) {
+        recordFailure(statuses[environment], NM_STATUS_NONFINITE_RESULT,
+            0u, NM_INVALID_INDEX,
+            float4(float(node), maximumAbsoluteCoordinate(row0.xyz),
+                   maximumAbsoluteCoordinate(row1.xyz), maximumAbsoluteCoordinate(row2.xyz)));
