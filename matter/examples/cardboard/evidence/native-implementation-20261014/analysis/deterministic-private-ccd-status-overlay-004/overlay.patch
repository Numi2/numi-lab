+    [reduceCommand waitUntilCompleted];
+    require(reduceCommand.status == MTLCommandBufferStatusCompleted,
+        reduceCommand.error != nil
+            ? std::string("geometric reducer command failed: ") +
+                [[reduceCommand.error localizedDescription] UTF8String]
