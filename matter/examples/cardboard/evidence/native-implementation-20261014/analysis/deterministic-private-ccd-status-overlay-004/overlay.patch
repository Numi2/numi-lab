+    const auto* ordinaryCandidate =
+        static_cast<const NMMatterStatusGPU*>(candidateStatusBuffer.contents);
+    require(byteIdenticalStatus(ordinaryCandidate[0], staleCandidate),
+            "ordinary geometric failure wrote or cleared private candidate status");
 }
 
