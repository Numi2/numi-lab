 // matches the in-place LU swaps. The residual-refinement path preserves the
 // initial solution in bounded threadgroup memory, recomputes b-A*x from the
 // original source matrix, solves L/U once more, and publishes x+delta.
+constant uint kFGMRESGraphCGLSError = 0x80000000u;
+
+inline void fgmresGraphPatchFailure(
+    const uint cglsMode,
+    device atomic_uint* cglsErrors,
+    device NMMatterStatusGPU* statuses,
+    const uint environment,
+    const uint statusCode,
+    const uint objectIndex,
+    const uint primitiveIndex,
+    const float4 diagnostic) {
+    if (cglsMode == 0u) {
+        recordFailure(statuses[environment], statusCode, objectIndex,
+            primitiveIndex, diagnostic);
+    } else {
+        // CGLS uses this selector-5 map privately after FGMRES has completed.
+        // A bad map invalidates the private direction, never production status.
+        atomic_fetch_or_explicit(cglsErrors + environment,
+            kFGMRESGraphCGLSError, memory_order_relaxed);
+    }
+}
