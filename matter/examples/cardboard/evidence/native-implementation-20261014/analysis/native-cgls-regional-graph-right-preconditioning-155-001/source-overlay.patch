+inline bool baseCGLSRegionalSolveTranspose(
+    const uint n,
+    const uint matrixBase,
+    const uint pivotBase,
+    device const float* matrices,
+    device const uint* pivots,
+    threadgroup float* rhs,
+    threadgroup float* upperSolve,
+    threadgroup float* lowerSolve) {
+    if (n == 0u || n > 768u) return false;
+    for (uint i = 0u; i < n; ++i) {
+        float2 accumulated = float2(rhs[i], 0.0f);
+        for (uint j = 0u; j < i; ++j)
+            accumulated = fgmresGraphAccumulateProduct(accumulated,
+                matrices[matrixBase + j * n + i], upperSolve[j], -1.0f);
+        const float diagonal = matrices[matrixBase + i * n + i];
+        const float value = accumulated.x + accumulated.y;
+        if (!isfinite(accumulated.x) || !isfinite(accumulated.y) ||
+            !isfinite(value) || !isfinite(diagonal) ||
+            !(abs(diagonal) > 1.0e-30f)) return false;
+        upperSolve[i] = value / diagonal;
+        if (!isfinite(upperSolve[i])) return false;
+    }
+    for (int reverse = int(n) - 1; reverse >= 0; --reverse) {
+        const uint i = uint(reverse);
+        float2 accumulated = float2(upperSolve[i], 0.0f);
+        for (uint j = i + 1u; j < n; ++j)
+            accumulated = fgmresGraphAccumulateProduct(accumulated,
+                matrices[matrixBase + j * n + i], lowerSolve[j], -1.0f);
+        lowerSolve[i] = accumulated.x + accumulated.y;
+        if (!isfinite(accumulated.x) || !isfinite(accumulated.y) ||
+            !isfinite(lowerSolve[i])) return false;
+    }
+    for (uint i = 0u; i < n; ++i) {
+        const uint originalRow = pivots[pivotBase + i];
+        if (originalRow >= n) return false;
+        upperSolve[i] = lowerSolve[i];
+    }
+    // Scatter through the final row permutation. Read the complete solved
+    // vector from upperSolve so arbitrary pivot cycles are safe.
+    for (uint i = 0u; i < n; ++i)
+        rhs[pivots[pivotBase + i]] = upperSolve[i];
+    for (uint i = 0u; i < n; ++i)
+        if (!isfinite(rhs[i])) return false;
+    return true;
+}
