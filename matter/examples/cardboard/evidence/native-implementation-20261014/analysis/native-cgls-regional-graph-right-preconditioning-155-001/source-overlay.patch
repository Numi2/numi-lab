+
+// CGLS cannot use the ordinary FGMRES RAP solve's silent zero-coefficient
+// fallback: an invalid right map would change B=A*S while leaving the
+// recurrence apparently healthy. This selected-only solve mirrors the
+// existing pivoted-LU order and turns every bad pivot, nonfinite intermediate,
+// or unusable diagonal into a private CGLS error before graph application.
+kernel void nm_fgmres_base_cgls_solve_regional_rap(
+    constant uint& environmentCount [[buffer(0)]],
+    device const float* coarseMatrix [[buffer(1)]],
+    device const uint* pivots [[buffer(2)]],
+    device const uint* valid [[buffer(3)]],
+    device const float* coarseRHS [[buffer(4)]],
+    device float* coefficients [[buffer(5)]],
+    constant uint& modeCount [[buffer(6)]],
+    device const uint* selected [[buffer(7)]],
+    device atomic_uint* errors [[buffer(8)]],
+    uint lane [[thread_index_in_threadgroup]],
+    uint environment [[threadgroup_position_in_grid]]) {
+    if (lane != 0u || environment >= environmentCount) return;
+    if (modeCount == 0u || modeCount > 32u) {
+        baseCGLSMarkError(errors, environment,
+            kBaseCGLSErrorBadShape | kBaseCGLSErrorInvalidRegionalMap);
+        return;
+    }
+    const uint base = environment * modeCount;
+    if (selected[environment] == 0u) {
+        for (uint i = 0u; i < modeCount; ++i) coefficients[base + i] = 0.0f;
+        return;
+    }
+    if (selected[environment] != 1u || valid[environment] == 0u) {
+        baseCGLSMarkError(errors, environment,
+            kBaseCGLSErrorBadSelection | kBaseCGLSErrorInvalidRegionalMap);
+        for (uint i = 0u; i < modeCount; ++i) coefficients[base + i] = 0.0f;
+        return;
+    }
+    const uint matrixBase = environment * modeCount * modeCount;
+    uint seen = 0u;
+    float values[32];
+    for (uint row = 0u; row < modeCount; ++row) {
+        const uint source = pivots[base + row];
+        if (source >= modeCount || (seen & (1u << source)) != 0u) {
+            baseCGLSMarkError(errors, environment,
+                kBaseCGLSErrorInvalidRegionalMap);
+            for (uint i = 0u; i < modeCount; ++i) coefficients[base + i] = 0.0f;
+            return;
+        }
+        seen |= 1u << source;
+        float value = coarseRHS[base + source];
+        if (!isfinite(value)) {
+            baseCGLSMarkError(errors, environment,
+                kBaseCGLSErrorNonfinite | kBaseCGLSErrorInvalidRegionalMap);
+            for (uint i = 0u; i < modeCount; ++i) coefficients[base + i] = 0.0f;
+            return;
+        }
+        for (uint column = 0u; column < row; ++column) {
+            value -= coarseMatrix[matrixBase + row * modeCount + column] *
+                values[column];
+            if (!isfinite(value)) {
+                baseCGLSMarkError(errors, environment,
+                    kBaseCGLSErrorNonfinite | kBaseCGLSErrorInvalidRegionalMap);
+                for (uint i = 0u; i < modeCount; ++i) coefficients[base + i] = 0.0f;
+                return;
+            }
+        }
+        values[row] = value;
+    }
+    for (int reverse = int(modeCount) - 1; reverse >= 0; --reverse) {
+        const uint row = uint(reverse);
+        float value = values[row];
+        for (uint column = row + 1u; column < modeCount; ++column) {
+            value -= coarseMatrix[matrixBase + row * modeCount + column] *
+                coefficients[base + column];
+            if (!isfinite(value)) {
+                baseCGLSMarkError(errors, environment,
+                    kBaseCGLSErrorNonfinite | kBaseCGLSErrorInvalidRegionalMap);
+                for (uint i = 0u; i < modeCount; ++i) coefficients[base + i] = 0.0f;
+                return;
+            }
+        }
+        const float diagonal = coarseMatrix[matrixBase + row * modeCount + row];
+        if (!isfinite(diagonal) || !(abs(diagonal) > 1.0e-30f) ||
+            !isfinite(value)) {
+            baseCGLSMarkError(errors, environment,
+                kBaseCGLSErrorInvalidRegionalMap | kBaseCGLSErrorNonfinite);
+            for (uint i = 0u; i < modeCount; ++i) coefficients[base + i] = 0.0f;
+            return;
+        }
+        coefficients[base + row] = value / diagonal;
+        if (!isfinite(coefficients[base + row])) {
+            baseCGLSMarkError(errors, environment,
+                kBaseCGLSErrorInvalidRegionalMap | kBaseCGLSErrorNonfinite);
+            for (uint i = 0u; i < modeCount; ++i) coefficients[base + i] = 0.0f;
+            return;
+        }
+    }
