+kernel void nm_fgmres_base_cgls_validate_regional_graph(
+    constant uint& environmentCount [[buffer(0)]],
+    device const uint* selected [[buffer(1)]],
+    device const uint* coarseValid [[buffer(2)]],
+    device const uint* graphValid [[buffer(3)]],
+    constant uint& modeCount [[buffer(4)]],
+    constant uint& patchCount [[buffer(5)]],
+    device atomic_uint* errors [[buffer(6)]],
+    uint environment [[thread_position_in_grid]]) {
+    if (environment >= environmentCount) return;
+    if (selected[environment] > 1u) {
+        baseCGLSMarkError(errors, environment, kBaseCGLSErrorBadSelection);
+        return;
+    }
+    if (selected[environment] == 0u) return;
+    bool valid = modeCount > 0u && modeCount <= 32u && patchCount > 0u &&
+        coarseValid[environment] != 0u;
+    for (uint patch = 0u; patch < patchCount; ++patch)
+        valid = valid && graphValid[environment * patchCount + patch] != 0u;
+    if (!valid)
+        baseCGLSMarkError(errors, environment,
+            kBaseCGLSErrorInvalidRegionalMap);
