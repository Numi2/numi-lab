+[[nodiscard]] inline bool regionalGraphSchwarzCheckedAdd(
+    const std::uint64_t a, const std::uint64_t b,
+    std::uint64_t& result) noexcept {
+    if (a > std::numeric_limits<std::uint64_t>::max() - b) return false;
+    result = a + b;
+    return true;
