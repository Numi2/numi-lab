+
+// Pivoted in-place dense LU, one threadgroup per environment/patch. The
+// arithmetic is partitioned over group lanes, with uniform barriers around
+// each pivot stage; a bad pivot is fatal to selector 5 rather than silently
+// replaced with a different preconditioner.
+kernel void nm_fgmres_graph_factor_patches(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    device const uint4* patches [[buffer(1)]],
+    device float* matrices [[buffer(2)]],
+    device uint* pivots [[buffer(3)]],
+    device uint* factorValid [[buffer(4)]],
+    device NMMatterStatusGPU* statuses [[buffer(5)]],
+    constant uint& patchCount [[buffer(6)]],
+    constant uint& matrixFloatCount [[buffer(7)]],
+    constant uint& pivotCount [[buffer(8)]],
+    uint lane [[thread_index_in_threadgroup]],
+    uint group [[threadgroup_position_in_grid]]) {
+    const uint totalGroups = dispatch.environmentCount * patchCount;
+    if (group >= totalGroups || patchCount == 0u) return;
+    const uint environment = group / patchCount;
+    const uint patchIndex = group - environment * patchCount;
+    const uint4 patch = patches[patchIndex];
+    const uint n = patch.y * 3u;
+    const uint matrixBase = environment * matrixFloatCount + patch.z;
+    const uint pivotBase = environment * pivotCount + patch.w;
+    const uint validIndex = group;
+    threadgroup uint sharedPivotRow;
+    threadgroup uint sharedValid;
+    threadgroup float sharedScale;
+    threadgroup float sharedPivotMagnitude;
+    threadgroup float sharedDiagonal;
+    threadgroup atomic_uint sharedError;
+    if (lane == 0u) {
+        factorValid[validIndex] = 0u;
+        sharedValid = patch.y > 0u && patch.y <= 256u && n <= 768u;
+        sharedScale = 0.0f;
+        atomic_store_explicit(&sharedError, 0u, memory_order_relaxed);
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (sharedValid == 0u) return;
+    for (uint row = lane; row < n; row += 256u) {
+        pivots[pivotBase + row] = row;
+    }
+    threadgroup_barrier(mem_flags::mem_device);
+    if (lane == 0u) {
+        for (uint index = 0u; index < n * n; ++index) {
+            const float value = matrices[matrixBase + index];
+            if (!isfinite(value)) {
+                sharedValid = 0u;
+                break;
+            }
+            sharedScale = max(sharedScale, abs(value));
+        }
+        if (!(sharedScale > 0.0f) || !isfinite(sharedScale))
+            sharedValid = 0u;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (sharedValid == 0u) {
+        if (lane == 0u)
+            recordFailure(statuses[environment],
+                NM_STATUS_LINEAR_SOLVER_FAILURE, 0u, NM_INVALID_INDEX,
+                float4(float(patchIndex), float(n), sharedScale, 5.0f));
+        return;
+    }
+    const float pivotFloor = max(sharedScale * 1.0e-10f, 1.0e-30f);
+    for (uint k = 0u; k < n; ++k) {
+        if (lane == 0u) {
+            sharedPivotRow = k;
+            sharedPivotMagnitude = 0.0f;
+            for (uint row = k; row < n; ++row) {
+                const float magnitude = abs(matrices[
+                    matrixBase + row * n + k]);
+                if (!isfinite(magnitude)) {
+                    sharedValid = 0u;
+                    break;
+                }
+                if (magnitude > sharedPivotMagnitude) {
+                    sharedPivotMagnitude = magnitude;
+                    sharedPivotRow = row;
+                }
+            }
+            if (!(sharedPivotMagnitude > pivotFloor)) sharedValid = 0u;
+            if (sharedValid != 0u && sharedPivotRow != k) {
+                const uint other = sharedPivotRow;
+                for (uint column = 0u; column < n; ++column) {
+                    const uint a = matrixBase + k * n + column;
+                    const uint b = matrixBase + other * n + column;
+                    const float temporary = matrices[a];
+                    matrices[a] = matrices[b];
+                    matrices[b] = temporary;
+                }
+                const uint a = pivotBase + k;
+                const uint b = pivotBase + other;
+                const uint temporary = pivots[a];
+                pivots[a] = pivots[b];
+                pivots[b] = temporary;
+            }
+        }
+        // Publish the pivot row/global matrix swap and lane-0 control words
+        // before any lane consumes them in this pivot stage.
+        threadgroup_barrier(mem_flags::mem_device | mem_flags::mem_threadgroup);
+        if (sharedValid == 0u) break;
+        if (lane == 0u) {
+            sharedDiagonal = matrices[matrixBase + k * n + k];
+            if (!isfinite(sharedDiagonal) ||
+                !(abs(sharedDiagonal) > pivotFloor)) sharedValid = 0u;
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (sharedValid == 0u) break;
+        const uint lowerCount = n - k - 1u;
+        if (lane == 0u)
+            atomic_store_explicit(&sharedError, 0u, memory_order_relaxed);
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        for (uint offset = lane; offset < lowerCount; offset += 256u) {
+            const uint row = k + 1u + offset;
+            const uint index = matrixBase + row * n + k;
+            matrices[index] /= sharedDiagonal;
+            if (!isfinite(matrices[index]))
+                atomic_store_explicit(&sharedError, 1u,
+                                      memory_order_relaxed);
+        }
+        // Publish both lower-column matrix writes and the shared error flag.
+        threadgroup_barrier(mem_flags::mem_device | mem_flags::mem_threadgroup);
+        if (lane == 0u &&
+            atomic_load_explicit(&sharedError, memory_order_relaxed) != 0u)
+            sharedValid = 0u;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (sharedValid == 0u) break;
+        const uint width = lowerCount;
+        const uint updateCount = width * width;
+        if (lane == 0u)
+            atomic_store_explicit(&sharedError, 0u, memory_order_relaxed);
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        for (uint offset = lane; offset < updateCount; offset += 256u) {
+            const uint row = k + 1u + offset / width;
+            const uint column = k + 1u + offset % width;
+            const uint index = matrixBase + row * n + column;
+            matrices[index] -= matrices[matrixBase + row * n + k] *
+                matrices[matrixBase + k * n + column];
+            if (!isfinite(matrices[index]))
+                atomic_store_explicit(&sharedError, 1u,
+                                      memory_order_relaxed);
+        }
+        // Trailing updates write the global matrix and lane 0 consumes the
+        // shared error flag/control state after the update.
+        threadgroup_barrier(mem_flags::mem_device | mem_flags::mem_threadgroup);
+        if (lane == 0u &&
+            atomic_load_explicit(&sharedError, memory_order_relaxed) != 0u)
+            sharedValid = 0u;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (sharedValid == 0u) break;
+    }
+    if (lane == 0u) {
+        factorValid[validIndex] = sharedValid;
+        if (sharedValid == 0u)
+            recordFailure(statuses[environment],
+                NM_STATUS_LINEAR_SOLVER_FAILURE, 0u, NM_INVALID_INDEX,
+                float4(float(patchIndex), sharedPivotMagnitude,
+                       pivotFloor, 6.0f));
+    }
+}
+
+// Solve one local right-preconditioner system per patch. The row permutation
+// matches the in-place LU swaps. Two bounded threadgroup vectors hold the
+// permuted right-hand side and solution; the scalar triangular recurrences
+// are uniform across the group and never inspect a Krylov-dependent branch.
+kernel void nm_fgmres_graph_solve_patches(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    device const uint4* patches [[buffer(1)]],
+    device const uint* patchNodes [[buffer(2)]],
+    device const float4* basis [[buffer(3)]],
+    device const float4* regionalBasis [[buffer(4)]],
+    device const float4* regionalAP [[buffer(5)]],
+    device const float* coefficients [[buffer(6)]],
+    device const float* matrices [[buffer(7)]],
+    device const uint* pivots [[buffer(8)]],
+    device const uint* factorValid [[buffer(9)]],
+    device float4* patchCorrections [[buffer(10)]],
+    device NMMatterStatusGPU* statuses [[buffer(11)]],
+    constant uint& patchCount [[buffer(12)]],
+    constant uint& patchNodeCount [[buffer(13)]],
+    constant uint& matrixFloatCount [[buffer(14)]],
+    constant uint& pivotCount [[buffer(15)]],
+    constant uint& modeCount [[buffer(16)]],
+    uint lane [[thread_index_in_threadgroup]],
+    uint group [[threadgroup_position_in_grid]]) {
+    const uint totalGroups = dispatch.environmentCount * patchCount;
+    if (group >= totalGroups || patchCount == 0u || modeCount == 0u ||
+        modeCount > 32u) return;
+    const uint environment = group / patchCount;
+    const uint patchIndex = group - environment * patchCount;
+    const uint4 patch = patches[patchIndex];
+    const uint n = patch.y * 3u;
+    const uint nodeBase = environment * dispatch.femNodeCount;
+    const uint patchCorrectionBase = environment * patchNodeCount + patch.x;
+    const uint matrixBase = environment * matrixFloatCount + patch.z;
+    const uint pivotBase = environment * pivotCount + patch.w;
+    threadgroup float rhs[768];
+    threadgroup float values[768];
+    if (factorValid[group] == 0u || n == 0u || n > 768u) {
+        if (lane == 0u)
+            recordFailure(statuses[environment],
+                NM_STATUS_LINEAR_SOLVER_FAILURE, 0u, NM_INVALID_INDEX,
+                float4(float(patchIndex), float(n), 0.0f, 8.0f));
+        for (uint local = lane; local < patch.y; local += 256u)
+            patchCorrections[patchCorrectionBase + local] = float4(0.0f);
+        return;
+    }
+    for (uint scalar = lane; scalar < n; scalar += 256u) {
+        const uint localNode = scalar / 3u;
+        const uint axis = scalar % 3u;
+        const uint globalNode = patchNodes[patch.x + localNode];
+        float value = basis[nodeBase + globalNode][axis];
+        const uint coefficientBase = environment * modeCount;
+        for (uint mode = 0u; mode < modeCount; ++mode) {
+            const uint modeNodeBase =
+                (environment * modeCount + mode) * dispatch.femNodeCount;
+            value -= coefficients[coefficientBase + mode] *
+                regionalAP[modeNodeBase + globalNode][axis];
+        }
+        rhs[scalar] = value;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (uint scalar = lane; scalar < n; scalar += 256u)
+        values[scalar] = rhs[pivots[pivotBase + scalar]];
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (uint row = 0u; row < n; ++row) {
+        if (lane == 0u) {
+            float value = values[row];
+            for (uint column = 0u; column < row; ++column)
+                value -= matrices[matrixBase + row * n + column] *
+                    values[column];
+            values[row] = value;
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    for (int reverse = int(n) - 1; reverse >= 0; --reverse) {
+        if (lane == 0u) {
+            const uint row = uint(reverse);
+            float value = values[row];
+            for (uint column = row + 1u; column < n; ++column)
+                value -= matrices[matrixBase + row * n + column] *
+                    values[column];
+            const float diagonal = matrices[matrixBase + row * n + row];
+            if (!isfinite(value) || !isfinite(diagonal) ||
+                !(abs(diagonal) > 1.0e-30f)) {
+                recordFailure(statuses[environment],
+                    NM_STATUS_LINEAR_SOLVER_FAILURE, 0u, NM_INVALID_INDEX,
+                    float4(float(patchIndex), float(row), diagonal, 9.0f));
+                values[row] = 0.0f;
+            } else {
+                values[row] = value / diagonal;
+                if (!isfinite(values[row])) {
+                    recordFailure(statuses[environment],
+                        NM_STATUS_LINEAR_SOLVER_FAILURE, 0u,
+                        NM_INVALID_INDEX,
+                        float4(float(patchIndex), float(row), value, 10.0f));
+                    values[row] = 0.0f;
+                }
+            }
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    for (uint local = lane; local < patch.y; local += 256u) {
+        patchCorrections[patchCorrectionBase + local] = float4(
+            values[local * 3u], values[local * 3u + 1u],
+            values[local * 3u + 2u], 0.0f);
+    }
+}
+
+kernel void nm_fgmres_graph_apply_patches(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    device const uint* patchNodes [[buffer(1)]],
+    device const uint* nodePatchOffsets [[buffer(2)]],
+    device const uint* nodePatchValues [[buffer(3)]],
+    device const uint* nodeCoverage [[buffer(4)]],
+    device const float4* regionalBasis [[buffer(5)]],
+    device const float* coefficients [[buffer(6)]],
+    device const float4* patchCorrections [[buffer(7)]],
+    device float4* preconditioned [[buffer(8)]],
+    device const NMFGMRESStateGPU* states [[buffer(9)]],
+    constant uint& patchNodeCount [[buffer(10)]],
+    constant uint& modeCount [[buffer(11)]],
+    uint global [[thread_position_in_grid]]) {
+    const uint total = dispatch.environmentCount * dispatch.femNodeCount;
+    if (global >= total || dispatch.femNodeCount == 0u ||
+        modeCount == 0u || modeCount > 32u) return;
+    const uint environment = global / dispatch.femNodeCount;
+    const uint node = global - environment * dispatch.femNodeCount;
+    if (states[environment].diagnostics.z > 0.5f) {
+        preconditioned[global] = float4(0.0f);
+        return;
+    }
+    float3 coarseCorrection = float3(0.0f);
+    const uint coefficientBase = environment * modeCount;
+    for (uint mode = 0u; mode < modeCount; ++mode) {
+        const float coefficient = coefficients[coefficientBase + mode];
+        const uint basisBase =
+            (environment * modeCount + mode) * dispatch.femNodeCount;
+        coarseCorrection += coefficient * regionalBasis[basisBase + node].xyz;
+    }
+    float3 graphCorrection = float3(0.0f);
+    const uint coverage = nodeCoverage[node];
+    if (coverage != 0u) {
+        for (uint item = nodePatchOffsets[node];
+             item < nodePatchOffsets[node + 1u]; ++item) {
+            const uint patchNode = nodePatchValues[item];
+            if (patchNode >= patchNodeCount || patchNodes[patchNode] != node)
+                continue;
+            graphCorrection += patchCorrections[
+                environment * patchNodeCount + patchNode].xyz;
+        }
+        graphCorrection /= float(coverage);
+    }
+    preconditioned[global] = float4(
+        coarseCorrection + graphCorrection, 0.0f);
 }
 
