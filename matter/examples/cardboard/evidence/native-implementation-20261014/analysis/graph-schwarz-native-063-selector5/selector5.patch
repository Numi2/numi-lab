+// Assemble each dense graph-patch principal submatrix from the same local
+// production FEM tangent used by the matrix-free operator. One thread owns a
+// complete scalar row, so overlapping patches never race while accumulating
+// their independent principal matrices. The layout is immutable and contains
+// only currently free nodes; a changed Dirichlet mask is a hard failure.
+kernel void nm_fgmres_graph_build_patch_matrices(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    device const NMContinuumObjectGPU* objects [[buffer(1)]],
+    device const NMFEMNodeStateGPU* candidate [[buffer(2)]],
+    device const NMTetrahedronGPU* tetrahedra [[buffer(3)]],
+    device const uint* nodeIncidence [[buffer(4)]],
+    device const NMIncidenceRangeGPU* nodeRanges [[buffer(5)]],
+    device const NMSchedulerStateGPU* schedulers [[buffer(6)]],
+    device const NMMaterialGPU* materials [[buffer(7)]],
+    device const NMScalarProgramGPU* programs [[buffer(8)]],
+    device const NMExpressionInstructionGPU* instructions [[buffer(9)]],
+    device const float* environmentParameters [[buffer(10)]],
+    device const float* acceptedMaterialState [[buffer(11)]],
+    device const float* tangentCache [[buffer(12)]],
+    device const uint* tangentCacheValid [[buffer(13)]],
+    constant uint& useTangentCache [[buffer(14)]],
+    device const uint4* patches [[buffer(15)]],
+    device const uint* patchNodes [[buffer(16)]],
+    device const uint4* rows [[buffer(17)]],
+    device const uint* nodeCoverage [[buffer(18)]],
+    device float* patchMatrices [[buffer(19)]],
+    device NMMatterStatusGPU* statuses [[buffer(20)]],
