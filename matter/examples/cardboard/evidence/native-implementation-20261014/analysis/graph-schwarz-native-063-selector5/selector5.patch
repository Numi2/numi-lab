+                const float3x3 dRate = df / max(dt, 1.0e-12f);
+                const float3x3 localDirection = femMaterialInput(
+                    object, tetrahedron, df);
+                bool valid = true;
+                float3x3 analytic;
+                float3x3 tangent;
+                if (useTangentCache != 0u &&
+                    tangentCacheValid[globalTet] == 1u) {
+                    tangent = fgmresApplyCachedTangent(
+                        tangentCache, globalTet, localDirection, valid);
+                } else {
+                    evaluateAlgorithmicStressTangent(
+                        material, programs, instructions, parameters,
+                        internalState, preciseLocalF, localDirection,
+                        femMaterialInput(object, tetrahedron,
+                                         deformationRate),
+                        femMaterialInput(object, tetrahedron, dRate), dt,
+                        material.bulk.y, analytic, tangent, valid,
+                        nullptr, nullptr, nullptr, nullptr, nullptr, nullptr,
+                        deformationLow);
+                }
+                const bool finiteTangent = all(isfinite(tangent[0])) &&
+                    all(isfinite(tangent[1])) && all(isfinite(tangent[2]));
+                if (!valid || !finiteTangent) {
+                    recordFailure(statuses[environment],
+                        NM_STATUS_NONFINITE_RESULT, range.objectIndex,
+                        tetrahedronIndex,
+                        float4(float(axisIndex), dt,
+                               maximumAbs(tangent), 4.0f));
+                    return;
+                }
+                tangent = femMaterialOutput(object, tetrahedron, tangent);
+                const NMFEMElementVectorGPU forceDirection =
+                    tetrahedronForce(tetrahedron, tangent);
+                const float3 nodalForce = elementNodeVector(
+                    forceDirection, tetrahedron, row.w).xyz;
+                const uint columnScalar = low * 3u + axisIndex;
+                patchMatrices[matrixRowBase + columnScalar] +=
+                    -dt * dt * nodalForce[row.z];
+            }
+        }
+    }
+    patchMatrices[matrixRowBase + rowScalar] +=
+        max(candidate[globalNode].positionAndMass.w, 0.0f);
+}
+
+kernel void nm_fgmres_graph_validate_mask(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    device const NMFEMNodeStateGPU* candidate [[buffer(1)]],
+    device const uint* nodeCoverage [[buffer(2)]],
+    device NMMatterStatusGPU* statuses [[buffer(3)]],
+    uint global [[thread_position_in_grid]]) {
+    const uint total = dispatch.environmentCount * dispatch.femNodeCount;
+    if (global >= total || dispatch.femNodeCount == 0u) return;
+    const uint node = global % dispatch.femNodeCount;
+    const bool expectedFree = nodeCoverage[node] != 0u;
+    const bool candidateFree = candidate[global].restAndFixed.w <= 0.5f;
+    if (expectedFree != candidateFree)
+        recordFailure(statuses[global / dispatch.femNodeCount],
+            NM_STATUS_UNSUPPORTED, 0u, NM_INVALID_INDEX,
+            float4(float(node), float(nodeCoverage[node]),
+                   candidate[global].restAndFixed.w, 7.0f));
