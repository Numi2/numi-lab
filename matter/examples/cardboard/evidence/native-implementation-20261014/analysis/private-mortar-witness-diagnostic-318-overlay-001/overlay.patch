+
+// Bounded diagnostic twin of the private mortar sweep. It consumes the same
+// uploaded inputs and calls the same production partition/CCD helpers, but
+// returns the selected witness identity for fixture diagnosis. Production
+// runtime never dispatches this kernel and its output cannot alter status or
+// histories.
+kernel void nm_contact_debug_armijo_mortar_sweep(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    constant NMMixedSolverGPU& solver [[buffer(1)]],
+    device const NMContinuumSurfacePrimitiveGPU* primitives [[buffer(2)]],
+    device const NMDeformableContactCandidateGPU* candidates [[buffer(3)]],
+    device const uint* candidateCounts [[buffer(4)]],
+    device const NMFEMNodeStateGPU* baseNodes [[buffer(5)]],
+    device const NMFEMNodeStateGPU* trialNodes [[buffer(6)]],
+    device const NMIncidenceRangeGPU* cohesiveSurfaceFaceRanges [[buffer(7)]],
+    device const nm_uint4* cohesiveSurfaceFaceRefs [[buffer(8)]],
+    device const NMCohesiveFaceGPU* cohesiveFaces [[buffer(9)]],
+    device const NMMatterStatusGPU* statuses [[buffer(10)]],
+    device const NMContinuumObjectGPU* objects [[buffer(11)]],
+    device float4* auditRows [[buffer(12)]],
+    uint global [[thread_position_in_grid]]
+) {
+    const uint capacity = dispatch.deformableContactCapacity;
+    const uint total = dispatch.environmentCount * capacity;
+    if (global >= total || capacity == 0u) return;
+    const uint environment = global / capacity;
+    const uint slot = global - environment * capacity;
+    device float4* const output = auditRows + 8u * global;
+    for (uint row = 0u; row < 8u; ++row) output[row] = float4(0.0f);
+    output[1] = float4(-1.0f);
+    output[2] = float4(-1.0f);
+    output[3] = float4(-1.0f);
+    if (slot >= candidateCounts[environment]) return;
+
+    const uint primitiveCount = continuumSurfacePrimitiveCount(dispatch);
+    const NMDeformableContactCandidateGPU candidate =
+        candidates[environment * capacity + slot];
+    if (candidate.identity.x >= primitiveCount ||
+        candidate.identity.y >= primitiveCount) return;
+    const uint primitiveBase = environment * primitiveCount;
+    const NMContinuumSurfacePrimitiveGPU left =
+        primitives[primitiveBase + candidate.identity.x];
+    const NMContinuumSurfacePrimitiveGPU right =
+        primitives[primitiveBase + candidate.identity.y];
+    const uint3 leftUnified = uint3(
+        left.nodesAndObject.x, left.nodesAndObject.y, left.nodesAndObject.z);
+    const uint3 rightUnified = uint3(
+        right.nodesAndObject.x, right.nodesAndObject.y, right.nodesAndObject.z);
+    float3 start[6], finish[6];
+    const uint femNodeBase = environment * dispatch.femNodeCount;
+    for (uint corner = 0u; corner < 3u; ++corner) {
+        if (leftUnified[corner] < dispatch.gridNodeCount ||
+            rightUnified[corner] < dispatch.gridNodeCount) return;
+        const uint li = leftUnified[corner] - dispatch.gridNodeCount;
+        const uint ri = rightUnified[corner] - dispatch.gridNodeCount;
+        if (li >= dispatch.femNodeCount || ri >= dispatch.femNodeCount) return;
+        start[corner] = baseNodes[femNodeBase + li].positionAndMass.xyz;
+        finish[corner] = trialNodes[femNodeBase + li].positionAndMass.xyz;
+        start[corner + 3u] = baseNodes[femNodeBase + ri].positionAndMass.xyz;
+        finish[corner + 3u] = trialNodes[femNodeBase + ri].positionAndMass.xyz;
     }
+    float coordinateScale = dispatch.numericalLimits.x;
+    for (uint feature = 0u; feature < 6u; ++feature) {
+        coordinateScale = max(coordinateScale,
+            maximumAbsoluteCoordinate(start[feature]));
+        coordinateScale = max(coordinateScale,
+            maximumAbsoluteCoordinate(finish[feature]));
+    }
+
+    NMMortarPatchSet patches{};
+    const bool validPatchSet = activeMixedCohesivePatchesForPrimitivePair(
+        dispatch, left, right, environment, cohesiveSurfaceFaceRanges,
+        cohesiveSurfaceFaceRefs, cohesiveFaces, patches);
+    NMMortarContactPartition leftPartition{}, rightPartition{};
+    bool validPartitions = validPatchSet;
+    uint leftPartitionFailureStage = 0u;
+    uint rightPartitionFailureStage = 0u;
+    if (validPartitions && patches.count > 0u) {
+        const uint faceBase = environment * dispatch.cohesiveFaceCount;
+        validPartitions = buildMortarContactPartition(
+                patches, true, left, dispatch.gridNodeCount,
+                cohesiveFaces, faceBase, leftPartition,
+                leftPartitionFailureStage) &&
+            buildMortarContactPartition(
+                patches, false, right, dispatch.gridNodeCount,
+                cohesiveFaces, faceBase, rightPartition,
+                rightPartitionFailureStage);
+    } else if (validPartitions) {
+        const float2 parent[3] = {
+            float2(1.0f, 0.0f), float2(0.0f, 1.0f), float2(0.0f, 0.0f)
+        };
+        leftPartition.count = rightPartition.count = 1u;
+        for (uint corner = 0u; corner < 3u; ++corner) {
+            leftPartition.triangle[0].bary[corner] = parent[corner];
+            rightPartition.triangle[0].bary[corner] = parent[corner];
+        }
+        leftPartition.triangle[0].coveredByCohesive = 0u;
+        leftPartition.triangle[0].coveredPatchIndex = NM_INVALID_INDEX;
+        rightPartition.triangle[0].coveredByCohesive = 0u;
+        rightPartition.triangle[0].coveredPatchIndex = NM_INVALID_INDEX;
+    }
+    NMMortarContactData sweep{};
+    const float thickness = max(
+        solver.contactAcceptance.x * dispatch.numericalLimits.x,
+        16.0f * kEpsilon * max(coordinateScale, 1.0e-12f));
+    const bool certified = validPartitions && findMortarComplementContact(
+        leftPartition, rightPartition, patches, left, right,
+        dispatch.gridNodeCount, cohesiveFaces,
+        environment * dispatch.cohesiveFaceCount,
+        start, finish, start + 3u, finish + 3u, thickness, sweep);
+    output[0] = float4(float(leftPartition.count),
+                       float(rightPartition.count),
+                       validPartitions ? 1.0f : 0.0f,
+                       certified ? 1.0f : 0.0f);
+    if (!validPartitions) {
+        output[7] = float4(float(leftPartitionFailureStage),
+                           float(rightPartitionFailureStage),
+                           float(patches.count), -1.0f);
+        return;
+    }
+    if (!certified || sweep.found == 0u) return;
+    output[1] = float4(float(sweep.auditLeftCell),
+                       float(sweep.auditRightCell),
+                       sweep.auditLeftCoverage == NM_INVALID_INDEX
+                           ? -1.0f : float(sweep.auditLeftCoverage),
+                       sweep.auditRightCoverage == NM_INVALID_INDEX
+                           ? -1.0f : float(sweep.auditRightCoverage));
+    output[2] = float4(float(sweep.auditKind),
+                       float(sweep.auditBoundaryValid),
+                       float(sweep.auditWitnessOnBoundary),
+                       float(sweep.auditCommonTranslation));
+    output[3] = float4(float(sweep.auditNonApproaching), sweep.toi,
+                       sweep.separation, float(patches.count));
+    output[4] = float4(sweep.auditLeftBarycentric, 0.0f);
+    output[5] = float4(sweep.auditRightBarycentric, 0.0f);
+    output[6] = float4(sweep.normal, 0.0f);
+    output[7] = float4(sweep.point, 0.0f);
 }
 
