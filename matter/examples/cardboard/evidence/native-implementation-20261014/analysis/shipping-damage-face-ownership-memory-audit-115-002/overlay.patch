+inline bool tetCrackPlaneClearsEveryFullFace(
+    const TetCrackPlaneClassification& classification) {
+    constexpr std::array<std::array<std::size_t, 3>, 4> faces{{
+        {{1, 2, 3}}, {{0, 3, 2}}, {{0, 1, 3}}, {{0, 2, 1}},
+    }};
