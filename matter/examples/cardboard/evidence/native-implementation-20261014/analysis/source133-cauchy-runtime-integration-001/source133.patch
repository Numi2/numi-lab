+    device const float4* metrics [[buffer(1)]],
+    device const float4* baseRHS [[buffer(2)]],
+    device const float4* gradient [[buffer(3)]],
+    device const NMFEMNodeStateGPU* candidate [[buffer(4)]],
+    device float4* direction [[buffer(5)]],
+    constant uint& useGradient [[buffer(6)]],
+    uint global [[thread_position_in_grid]]) {
+    const uint total = dispatch.environmentCount * dispatch.femNodeCount;
+    if (global >= total) return;
+    const uint environment = global / dispatch.femNodeCount;
+    const bool selected = metrics[environment].w == 3.0f;
+    const NMFEMNodeStateGPU node = candidate[global];
+    const bool freeMassRow = !femStaticConstraint(node.restAndFixed.w) &&
+        isfinite(node.positionAndMass.w) && node.positionAndMass.w > 0.0f;
+    const float4 value = useGradient != 0u
+        ? gradient[global] : baseRHS[global];
+    direction[global] = selected && freeMassRow && all(isfinite(value.xyz))
+        ? float4(value.xyz, 0.0f) : float4(0.0f);
+}
