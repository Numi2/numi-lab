+            baseModeCount);
+        return;
+    }
+
+    for (uint pass = 0u; pass < 2u; ++pass) {
+        for (uint mode = 0u; mode < baseModeCount; ++mode) {
+            const uint sourceBase = orthogonalBase + mode * nodes;
+            float projection = 0.0f;
+            for (uint node = lane; node < nodes; node += 32u)
+                projection += dot(orthogonalBasis[sourceBase + node].xyz,
+                    effectiveBasis[targetBase + node].xyz);
+            projection = simd_sum(projection);
+            if (!isfinite(projection)) {
+                finite = false;
+                break;
+            }
+            for (uint node = lane; node < nodes; node += 32u)
+                effectiveBasis[targetBase + node].xyz -=
+                    projection * orthogonalBasis[sourceBase + node].xyz;
+            simdgroup_barrier(mem_flags::mem_device);
+        }
+        if (!finite) break;
+    }
+
+    float projectedNorm2 = 0.0f;
+    bool residualFinite = true;
+    for (uint node = lane; node < nodes; node += 32u) {
+        const float3 value = effectiveBasis[targetBase + node].xyz;
+        residualFinite = residualFinite && all(isfinite(value));
+        projectedNorm2 += dot(value, value);
+    }
+    projectedNorm2 = simd_sum(projectedNorm2);
+    residualFinite = simd_all(residualFinite);
+    bool orthogonalToSource = residualFinite && isfinite(projectedNorm2) &&
+        projectedNorm2 > 0.0f;
+    // The relative test protects against a near-dependent projected row being
+    // discarded by the rank cutoff and then falsely admitting a vector that
+    // still lies in the original effective source span.
+    if (orthogonalToSource) {
+        const float inverseResidualNorm = rsqrt(projectedNorm2);
+        if (!(inverseResidualNorm > 0.0f) || !isfinite(inverseResidualNorm)) {
+            orthogonalToSource = false;
+        } else {
+            for (uint mode = 0u; mode < baseModeCount; ++mode) {
+                const uint sourceBase = basisBase + mode * nodes;
+                float sourceNorm2 = 0.0f;
+                float sourceDotResidual = 0.0f;
+                bool sourceFinite = true;
+                for (uint node = lane; node < nodes; node += 32u) {
+                    const float3 source = effectiveBasis[sourceBase + node].xyz;
+                    const float3 residual = effectiveBasis[targetBase + node].xyz;
+                    sourceFinite = sourceFinite && all(isfinite(source));
+                    sourceNorm2 += dot(source, source);
+                    sourceDotResidual += dot(source, residual);
+                }
+                sourceNorm2 = simd_sum(sourceNorm2);
+                sourceDotResidual = simd_sum(sourceDotResidual);
+                sourceFinite = simd_all(sourceFinite);
+                if (!sourceFinite || !isfinite(sourceNorm2) ||
+                    !isfinite(sourceDotResidual)) {
+                    orthogonalToSource = false;
+                    break;
+                }
+                if (sourceNorm2 > 0.0f) {
+                    const float relativeCorrelation =
+                        abs(sourceDotResidual) * rsqrt(sourceNorm2) *
+                        inverseResidualNorm;
+                    if (!isfinite(relativeCorrelation) ||
+                        relativeCorrelation > 1.0e-4f) {
+                        orthogonalToSource = false;
+                        break;
+                    }
+                }
+            }
+        }
+    }
+    const bool independent = finite && orthogonalToSource &&
+        projectedNorm2 > rawNorm2 * 1.0e-10f;
+    if (!independent) {
+        nm_fgmres_restore_regional_recycle_fallback(authoredBasis,
+            candidate, effectiveBasis, environment, lane, nodes, targetBase,
+            baseModeCount);
+        return;
+    }
+    const float inverseNorm = rsqrt(projectedNorm2);
+    if (!(inverseNorm > 0.0f) || !isfinite(inverseNorm)) {
+        nm_fgmres_restore_regional_recycle_fallback(authoredBasis,
+            candidate, effectiveBasis, environment, lane, nodes, targetBase,
+            baseModeCount);
+        return;
+    }
+    for (uint node = lane; node < nodes; node += 32u)
+        effectiveBasis[targetBase + node] *= inverseNorm;
+    if (lane == 0u) selectedMode[environment] = 1u;
 }
 
