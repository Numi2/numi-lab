+     <<",\"tangent_projection_valid\":"<<(trace[8]==1.0f?"true":"false")<<",\"tangent_failure\":";numberJSON(f,trace[13]);
+    f<<",\"trace_status\":";numberJSON(f,trace[80]);f<<"},\"raw_input_f32_bits\":";bitsArrayJSON(f,row.input.data(),row.input.size());
