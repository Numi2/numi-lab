+// Zero the global node accumulator before a sequence of ordered cohesive
+// pages. This is separate from the existing trial accumulator lifecycle.
+kernel void nm_fem_clear_cohesive_force_accumulator(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    device float4* forceAccumulator [[buffer(1)]],
+    uint global [[thread_position_in_grid]]
+) {
+    const uint total = dispatch.environmentCount * dispatch.femNodeCount;
+    if (global < total) forceAccumulator[global] = float4(0.0f);
+}
+
+// Apply the completed ordered cohesive operator gather once, at the same
+// point as nm_fgmres_add_cohesive_operator. This keeps the original dt^2
+// scale and final subtraction outside the per-page accumulation.
+kernel void nm_fem_apply_cohesive_operator_accumulator(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    constant NMMicrostepGPU& microstep [[buffer(1)]],
+    device const NMContinuumObjectGPU* objects [[buffer(2)]],
+    device const NMFEMNodeStateGPU* candidateNodes [[buffer(3)]],
+    device const NMIncidenceRangeGPU* ranges [[buffer(4)]],
+    device const NMSchedulerStateGPU* schedulers [[buffer(5)]],
+    device const NMAdaptiveStateGPU* adaptive [[buffer(6)]],
+    device const float4* forceAccumulator [[buffer(7)]],
+    device float4* work [[buffer(8)]],
+    device NMMatterStatusGPU* statuses [[buffer(9)]],
+    uint global [[thread_position_in_grid]]
+) {
+    const uint total = dispatch.environmentCount * dispatch.femNodeCount;
+    if (global >= total || dispatch.femNodeCount == 0u) return;
+    const uint environment = global / dispatch.femNodeCount;
+    if (!environmentHealthy(statuses, environment)) return;
+    const NMIncidenceRangeGPU range = ranges[global];
+    if (range.objectIndex == NM_INVALID_INDEX ||
+        range.objectIndex >= dispatch.objectCount || range.count == 0u) return;
+    const uint objectGlobal = environment * dispatch.objectCount + range.objectIndex;
+    const NMContinuumObjectGPU object = objects[range.objectIndex];
+    const NMSchedulerStateGPU scheduler = schedulers[objectGlobal];
+    if (!objectDue(object, scheduler, adaptive[objectGlobal], microstep) ||
+        femStaticConstraint(candidateNodes[global].restAndFixed.w) ||
+        candidateNodes[global].positionAndMass.w <= 0.0f) return;
+    const float3 derivativeForce = forceAccumulator[global].xyz;
+    const float dt = objectTimestep(dispatch, scheduler);
+    work[global].xyz -= dt * dt * derivativeForce;
+}
