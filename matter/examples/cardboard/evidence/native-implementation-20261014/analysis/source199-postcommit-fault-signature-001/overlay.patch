+static_assert(NM_STATUS_INVALID_DISPATCH == 1u,
+    "post-commit motion-type fault depends on NM_STATUS_INVALID_DISPATCH=1");
+static_assert(NM_STATUS_NONLINEAR_SOLVER_FAILURE == 10u,
+    "the earlier nonlinear rejection remains a distinct negative control");
+
+// contact.metalinc:nm_contact_validate_prescribed_motion records this exact
+// signature when the prescribed kinematic capsule arrives as dynamic:
+// recordFailure(INVALID_DISPATCH, NM_INVALID_INDEX, proxyIndex, float4(-3)).
+bool isExpectedPostCommitMotionTypeFault(
+        const NMMatterStatusGPU& status,
+        const std::uint32_t environment,
+        const std::uint32_t proxyIndex) {
+    return status.code == NM_STATUS_INVALID_DISPATCH &&
+        status.environment == environment &&
+        status.objectIndex == NM_INVALID_INDEX &&
+        status.failingIndex == proxyIndex &&
+        status.diagnostics.x == -3.0f &&
+        status.diagnostics.y == -3.0f &&
+        status.diagnostics.z == -3.0f &&
+        status.diagnostics.w == -3.0f;
+}
+
+void verifyPostCommitFaultSignaturePolicy() {
+    NMMatterStatusGPU expected{};
+    expected.code = NM_STATUS_INVALID_DISPATCH;
+    expected.environment = 0u;
+    expected.objectIndex = NM_INVALID_INDEX;
+    expected.failingIndex = 0u;
+    expected.diagnostics = {-3.0f, -3.0f, -3.0f, -3.0f};
+    require(isExpectedPostCommitMotionTypeFault(expected, 0u, 0u),
+        "exact prescribed-motion postCommit fault signature was rejected");
+
+    NMMatterStatusGPU earlierNonlinear{};
+    earlierNonlinear.code = NM_STATUS_NONLINEAR_SOLVER_FAILURE;
+    earlierNonlinear.environment = 0u;
+    earlierNonlinear.objectIndex = 0u;
+    earlierNonlinear.failingIndex = 331u;
+    earlierNonlinear.diagnostics = {1.17e-7f, 1.39e-7f, 7.8e-3f, 8.0f};
+    require(!isExpectedPostCommitMotionTypeFault(
+                earlierNonlinear, 0u, 0u),
+        "earlier Newton status-10 rejection falsely matched postCommit fault");
+
+    NMMatterStatusGPU wrongProxy = expected;
+    wrongProxy.failingIndex = 1u;
+    require(!isExpectedPostCommitMotionTypeFault(wrongProxy, 0u, 0u),
+        "wrong prescribed proxy index matched postCommit fault");
+    NMMatterStatusGPU wrongDiagnostics = expected;
+    wrongDiagnostics.diagnostics.z = 0.0f;
+    require(!isExpectedPostCommitMotionTypeFault(
+                wrongDiagnostics, 0u, 0u),
+        "wrong source diagnostic tuple matched postCommit fault");
+    NMMatterStatusGPU wrongEnvironment = expected;
+    wrongEnvironment.environment = 1u;
+    require(!isExpectedPostCommitMotionTypeFault(
+                wrongEnvironment, 0u, 0u),
+        "wrong environment matched postCommit fault");
+    std::cout << "PASS exact postCommit motion-type fault policy"
+              << " code=NM_STATUS_INVALID_DISPATCH(1)"
+              << " proxy=0 diagnostics=(-3,-3,-3,-3)"
+              << " status10_negative_control=true
+";
 }
 
