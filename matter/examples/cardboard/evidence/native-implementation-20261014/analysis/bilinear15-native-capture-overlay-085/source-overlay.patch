+void runCase(MetalInstrument& metal,const CompiledWorld& defaultWorld,
+             const CompiledWorld& accurateWorld,const Case& c) {
+    const Response offA=metal.evaluate(defaultWorld,c,false);
+    const Response offB=metal.evaluate(defaultWorld,c,false);
+    const Response onA=metal.evaluate(accurateWorld,c,true);
+    const Response onB=metal.evaluate(accurateWorld,c,true);
+    need(offA.valid&&offA.projectionValid&&offB.valid&&offB.projectionValid,
+         c.id+" default projection/stress failed");
+    need(onA.valid&&onA.projectionValid&&onB.valid&&onB.projectionValid,
+         c.id+" opt-in projection/stress failed");
+    const Metric offP=metric(offA.p,c.capturedP), offT=metric(offA.tangent,c.capturedTangent);
+    const Metric offS=metric(offA.state,c.capturedState);
+    const Metric onP=metric(onA.p,c.referenceP), onT=metric(onA.tangent,c.referenceTangent);
+    const Metric onS=metric(onA.state,c.referenceState);
+    const double offNoiseP=repeatNoise(offA.p,offB.p), offNoiseT=repeatNoise(offA.tangent,offB.tangent);
+    const double offNoiseS=repeatNoise(offA.state,offB.state);
+    const double onNoiseP=repeatNoise(onA.p,onB.p), onNoiseT=repeatNoise(onA.tangent,onB.tangent);
+    const double onNoiseS=repeatNoise(onA.state,onB.state);
+    // Relative comparison is used only when the reference action resolves
+    // above the measured repeated-run absolute noise. Near-zero actions use
+    // that measured floor directly and are labeled separately below.
+    const auto passes=[](const Metric& m,const double noise){
+        if(m.referenceNorm>10.0*noise) return m.relative<=kRelativeGate;
+        return m.maxAbs<=8.0*noise;
+    };
+    const bool offParity=passes(offP,offNoiseP)&&passes(offT,offNoiseT)&&passes(offS,offNoiseS);
+    const bool onGate=passes(onP,onNoiseP)&&passes(onT,onNoiseT)&&passes(onS,onNoiseS);
+    std::cout<<std::setprecision(17)
+      <<"{\"record\":\"case\",\"id\":\""<<escape(c.id)<<"\",\"capture\":\""<<c.captureLabel
+      <<"\",\"tet_id\":"<<c.tet<<",\"branch_indicator\":\""<<escape(c.branchIndicator)
+      <<"\",\"reference_source\":\""<<escape(c.referenceSource)<<"\",\"multiplier_increment\":"<<c.multiplierIncrement
+      <<",\"reference_branch_details\":"<<jsonString(c.branchDetails,"branch details")
+      <<",\"captured_projection_report\":"<<jsonString(c.captureProjection,"projection report")
+      <<",\"compiled_local_iterations_default\":"<<defaultWorld.materials[0].localNewtonIterations
+      <<",\"compiled_local_iterations_optin\":"<<accurateWorld.materials[0].localNewtonIterations
+      <<",\"default\":{\"status\":\""<<(offParity?"pass_capture_parity":"fail_capture_parity")
+      <<"\",\"iterations\":"<<offA.iterations<<",\"residual\":"<<offA.residual
+      <<",\"flags\":"<<offA.flags<<",\"failure\":"<<offA.failure
+      <<",\"stress_capture_relative_l2\":"<<offP.relative<<",\"stress_capture_abs_l2\":"<<offP.norm
+      <<",\"tangent_capture_relative_l2\":"<<offT.relative<<",\"tangent_capture_abs_l2\":"<<offT.norm
+      <<",\"state_capture_abs_l2\":"<<offS.norm<<",\"state_capture_relative_l2\":"<<offS.relative
+      <<",\"state_capture_comparison\":\""<<(offS.referenceNorm>10.0*offNoiseS?"resolved_relative":"absolute_noise_floor")
+      <<"\",\"noise_max_abs\":{\"stress\":"<<offNoiseP
+      <<",\"tangent\":"<<offNoiseT<<",\"state\":"<<offNoiseS<<"},\"state\":";
+    jsonArray(std::cout,offA.state);
+    std::cout<<",\"stress\":";jsonArray9(std::cout,offA.p);
+    std::cout<<",\"tangent\":";jsonArray9(std::cout,offA.tangent);
+    std::cout<<"},\"optin\":{\"status\":\""<<(onGate?"pass_fp64_reference":"fail_fp64_reference")
+      <<"\",\"iterations\":"<<onA.iterations<<",\"residual\":"<<onA.residual
+      <<",\"flags\":"<<onA.flags<<",\"failure\":"<<onA.failure
+      <<",\"stress_reference_relative_l2\":"<<onP.relative<<",\"stress_reference_abs_l2\":"<<onP.norm
+      <<",\"tangent_reference_relative_l2\":"<<onT.relative<<",\"tangent_reference_abs_l2\":"<<onT.norm
+      <<",\"state_reference_abs_l2\":"<<onS.norm<<",\"state_reference_relative_l2\":"<<onS.relative
+      <<",\"state_reference_comparison\":\""<<(onS.referenceNorm>10.0*onNoiseS?"resolved_relative":"absolute_noise_floor")
+      <<"\",\"noise_max_abs\":{\"stress\":"<<onNoiseP
+      <<",\"tangent\":"<<onNoiseT<<",\"state\":"<<onNoiseS<<"},\"state\":";
+    jsonArray(std::cout,onA.state);
+    std::cout<<",\"stress\":";jsonArray9(std::cout,onA.p);
+    std::cout<<",\"tangent\":";jsonArray9(std::cout,onA.tangent);
+    std::cout<<"}}\n";
+    need(offParity,c.id+" unchanged/default evaluator does not reproduce the captured production point");
+    need(onGate,c.id+" opt-in evaluator fails its bounded independent-reference gate");
+}
+}
+
+int main(int argc,char** argv) {
+    @autoreleasepool {
+        try {
+            const bool cpuAdmission=argc==4&&std::string(argv[1])=="--cpu-admission";
+            need(cpuAdmission||argc==3,
+                 "usage: captured-point-check [--cpu-admission] INPUTS.json MEDIUM_ASSET.nmatter");
+            const std::filesystem::path inputsPath=argv[cpuAdmission?2:1];
+            const std::filesystem::path materialPath=argv[cpuAdmission?3:2];
+            const std::string sourceSHA=sha256(materialPath);
+            need(sourceSHA==kMediumSHA,"medium source material hash differs from captured asset");
+            NSDictionary* document=dict(readJSON(inputsPath),"input document");
+            need(stringValue(field(document,"schema"),"schema")==
+                 "numi.cardboard.bilinear15-native-captured-point-inputs.v1",
+                 "unsupported captured-point input schema");
+            NSDictionary* source=dict(field(document,"source_material"),"source_material");
+            need(stringValue(field(source,"sha256"),"source material sha") == sourceSHA &&
+                 stringValue(field(source,"name"),"source material name")==
+                    "hajali2009_medium_hill_bilinear_fit",
+                 "input document source material binding mismatch");
+            NSArray* cases=(NSArray*)field(document,"cases");
+            need(cases.count==16u,"expected exactly 8 captured N0 and 8 captured N63 test points");
+            const CompiledWorld defaultWorld=compileMedium(materialPath,false);
+            const CompiledWorld accurateWorld=compileMedium(materialPath,true);
+            std::vector<Case> parsed; parsed.reserve(cases.count);
+            for(id value in cases) parsed.push_back(readCase(dict(value,"case")));
+            for(const Case& c:parsed) {
+                verifyCapturedParameters(defaultWorld,c);
+                verifyCapturedParameters(accurateWorld,c);
+            }
+            if(cpuAdmission) {
+                std::cout<<"{\"record\":\"cpu_admission\",\"status\":\"pass\","
+                  <<"\"input_sha256\":\""<<sha256(inputsPath)<<"\",\"source_material_sha256\":\""
+                  <<sourceSHA<<"\",\"case_count\":"<<parsed.size()
+                  <<",\"default_local_iterations\":"<<defaultWorld.materials[0].localNewtonIterations
+                  <<",\"optin_local_iterations\":"<<accurateWorld.materials[0].localNewtonIterations
+                  <<",\"native_metal_execution\":false}\n";
+                return 0;
+            }
+            MetalInstrument metal;
+            std::cout<<std::setprecision(17)
+              <<"{\"record\":\"header\",\"schema\":\"numi.cardboard.bilinear15-native-captured-point-result.v1\","
+              <<"\"base_snapshot_manifest_sha256\":\""<<NUMI_CARDBOARD_BASE_SNAPSHOT_SHA256<<"\","
+              <<"\"source_material_sha256\":\""<<sourceSHA<<"\",\"input_sha256\":\""<<sha256(inputsPath)
+              <<"\",\"physical_steps\":0,\"physical_validation\":false,\"relative_gate\":"<<kRelativeGate
+              <<",\"noise_floor\":\"maximum absolute difference across two identical native evaluations per policy/case\","
+              <<"\"default_policy\":\"both captured source flags enabled, accurate local projection flag disabled, explicit material iteration option 32\","
+              <<"\"optin_policy\":\"same captured source flags, accurate 15-state policy enabled, compiled local budget 16\"}\n";
+            for(const Case& c:parsed) runCase(metal,defaultWorld,accurateWorld,c);
+            std::cout<<"{\"record\":\"end\",\"cases\":"<<parsed.size()
+                     <<",\"status\":\"pass\",\"scope\":\"pointwise native projection/stress/tangent only\"}\n";
+            return 0;
+        } catch(const std::exception& error) {
+            std::cerr<<"FAIL captured bilinear-15 native point replay: "<<error.what()<<'\n';
+            return 1;
+        }
+    }
+}
