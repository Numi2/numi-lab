// Numerically conservative, explicitly uncalibrated passive skeletal-muscle
// specimen material.  These values make the source-derived Human FEM slice
// executable while a specimen-specific parameter-identification path is still
// required before any physiological claim.
material passive_skeletal_muscle_unqualified {
    parameter density : kg/m^3 = 1060 in [900, 1200];
    parameter mu : kPa = 12 in [1, 100] log identifiable;
    parameter lambda : kPa = 120 in [20, 1000] log identifiable;

    model neo_hookean;
    energy = neo_hookean(mu, lambda);
    valid = J() - 0.20;
    supports fem;

    interface {
        static_friction = 0.45;
        dynamic_friction = 0.35;
        restitution = 0.0;
        adhesion = 0.0;
    }

    limits {
        minimum_J = 0.20;
        maximum_J = 5.0;
        maximum_stress = 5e6;
        maximum_energy_density = 5e6;
    }
}
