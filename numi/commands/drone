#!/bin/sh
set -eu

if [ "${1:-}" = "--numi-describe" ]; then
    printf '%s\n' "Acquire the pinned PX4 X500 source, qualify its native Metal hover task, or apply policy-format flight actions."
    exit 0
fi
drone_workspace=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
if [ "${1:-}" = "--help" ]; then
    printf '%s\n' "usage: numi drone source --output DIR | flight [--trace FILE] | control collective roll pitch yaw | maneuvers --trace FILE"
    exit 0
fi
if [ "${1:-}" = "control" ]; then
    shift
    if [ "$#" -ne 4 ]; then
        printf '%s\n' "usage: numi drone control <collective> <roll> <pitch> <yaw>" >&2
        exit 2
    fi
    drone_build=${NUMI_BUILD_DIR:-"$drone_workspace/build"}
    cmake -S "$drone_workspace" -B "$drone_build" -DCMAKE_BUILD_TYPE=Release >/dev/null
    cmake --build "$drone_build" --target metalrobo_px4_x500_gpu_probe -j 4 >/dev/null
    PX4_X500_ACTION="$1 $2 $3 $4" exec "$drone_build/bin/metalrobo_px4_x500_gpu_probe"
fi
if [ "${1:-}" = "maneuvers" ]; then
    shift
    if [ "${1:-}" != "--trace" ] || [ "$#" -ne 2 ]; then
        printf '%s\n' "usage: numi drone maneuvers --trace trace.csv" >&2
        exit 2
    fi
    drone_build=${NUMI_BUILD_DIR:-"$drone_workspace/build"}
    cmake -S "$drone_workspace" -B "$drone_build" -DCMAKE_BUILD_TYPE=Release >/dev/null
    cmake --build "$drone_build" --target metalrobo_px4_x500_gpu_probe -j 4 >/dev/null
    PX4_X500_MANEUVER_TRACE="$2" exec "$drone_build/bin/metalrobo_px4_x500_gpu_probe"
fi
if [ "${1:-}" = "flight" ]; then
    shift
    if [ "${1:-}" = "--trace" ] && [ "$#" -eq 2 ]; then
        drone_trace=$2
    elif [ "$#" -eq 0 ]; then
        drone_trace=
    else
        printf '%s\n' "usage: numi drone flight [--trace trace.csv]" >&2
        exit 2
    fi
    drone_build=${NUMI_BUILD_DIR:-"$drone_workspace/build"}
    cmake -S "$drone_workspace" -B "$drone_build" -DCMAKE_BUILD_TYPE=Release >/dev/null
    cmake --build "$drone_build" --target metalrobo_px4_x500_gpu_probe -j 4 >/dev/null
    if [ -n "$drone_trace" ]; then
        PX4_X500_TRACE="$drone_trace" exec "$drone_build/bin/metalrobo_px4_x500_gpu_probe"
    fi
    exec "$drone_build/bin/metalrobo_px4_x500_gpu_probe"
fi
if [ "${1:-}" = "source" ]; then
    shift
fi
exec python3 "$drone_workspace/tools/import_px4_x500.py" "$@"
