#!/bin/sh

set -eu

if [ "${1:-}" = "--numi-describe" ]; then
    printf 'Inspect or run a foundation model as a fingerprinted action-chunk proposer.\n'
    exit 0
fi

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    cat <<'EOF'
Usage: numi foundation inspect --model-directory PATH [--verify-hashes]
       numi foundation fetch --model-directory PATH \
           [--repository ID] [--revision REVISION]
       numi foundation adapter --native-library PATH --output adapter.json
       numi foundation infer --model-directory PATH --output-directory PATH \
           (--observation observation.npz | --synthetic-observation) \
           [--provider auto|coreml|cpu] [--seed N] [--verify-hashes]
       numi foundation observation --camera-frame frame.ppm \
           --state-trace state.tsv --output observation.npz --evidence FILE \
           [--adapter adapter.json]
       numi foundation compile-actions --action-chunk action_chunk.npz \
           --observation observation.npz --native-library PATH \
           --output actions.f32 --evidence FILE [--adapter adapter.json]
       numi foundation compile-interaction --action-chunk action_chunk.npz \
           --observation observation.npz --native-library PATH \
           --output teacher.interactionpack --evidence FILE --id ID \
           --desired-outcome TEXT [--adapter adapter.json] \
           [--base-interaction-pack motion.interactionpack \
            --base-interaction-clip ID --proposal-blend 0.0...1.0]

The versioned adapter owns robot state layout, model tensor mapping, controller
limits, and interaction contacts. The initial adapter executes NVIDIA's staged
GR00T N1.7 G1 ONNX export; the compiler path itself is robot-neutral.
Core ML is preferred on Apple when available and CPU is retained as an
operator-coverage fallback. Inference emits action_chunk.npz and evidence.json.

This capability proposes action chunks only. Native Metal simulation remains
the authority for dynamics, contacts, safety, rollout, and physical evidence.
compile-interaction converts a proposal into the existing InteractionPack
teacher path; only successful native trajectories receive distillation weight.
An optional motion base preserves its root, lower-body, contact confidence, and
validity fields while the adapter applies bounded named GR00T joint guidance.
Set NUMI_FOUNDATION_PYTHON to choose an isolated ONNX Runtime environment.
The fetch command additionally requires huggingface_hub and records the exact
resolved repository revision beside the downloaded artifact.
EOF
    exit 0
fi

numi_root=${NUMI_LAB_ROOT:?Run this capability through the numi dispatcher.}
if [ -f "$numi_root/python/metalrobo/foundation_policy.py" ]; then
    numi_python_root=$numi_root/python
else
    numi_python_root=$numi_root/share/numi/python
fi

numi_path_python=$(command -v python3 2>/dev/null || true)
numi_python=
for numi_candidate_python in \
    "${NUMI_FOUNDATION_PYTHON:-}" \
    "$numi_root/python/.foundation-venv/bin/python" \
    "$numi_path_python"; do
    [ -x "$numi_candidate_python" ] || continue
    if "$numi_candidate_python" -c 'import numpy, onnxruntime, yaml' >/dev/null 2>&1; then
        numi_python=$numi_candidate_python
        break
    fi
done
if [ "$numi_python" = "" ]; then
    printf 'numi foundation: Python needs numpy, onnxruntime, and PyYAML\n' >&2
    exit 1
fi

numi_foundation_driver=$numi_python_root/metalrobo/foundation_policy.py
[ -f "$numi_foundation_driver" ] || {
    printf 'numi foundation: missing %s\n' "$numi_foundation_driver" >&2
    exit 1
}
"$numi_python" "$numi_foundation_driver" "$@"
