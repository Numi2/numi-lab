#!/bin/sh

set -u

if [ "${1:-}" = "--numi-describe" ]; then
    printf 'Train or continue a robot policy with the native Metal/MLX runtime.\n'
    exit 0
fi

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    cat <<'EOF'
Usage: numi train [metalrobo_task_train arguments...]

Numi supplies fresh artifact paths and local runtime paths when they are not
provided. Every native trainer option passes through unchanged. Common options:

  --task velocity|disturbance-recovery|supine-get-up|ball-recovery|ball-dodge
  --minimum-difficulty-band N --maximum-difficulty-band N
  --interaction-pack PATH --interaction-clip ID
  --interaction-reset-phase-probability F  Fraction of noncanonical resets
  --interaction-reset-maximum-phase F      Latest normalized clip reset phase
  --visual-observation-config PATH       Authored camera and visual bindings
  --envs N --steps N --updates N --chunk N
  --policy-pack PATH                 Resume or use an existing PolicyPack
  --initialize-policy ID            Initialize a new policy
  --checkpoint-directory PATH --checkpoint-interval N

Every run retains its post-update candidate. Numi evaluates that candidate and
the immutable pre-training incumbent on the same held-out physical rollout;
only the better non-regressing policy advances deployment.policypack.

Use NUMI_RUNS_DIR, NUMI_RUN_DIR, NUMI_BUILD_DIR, or NUMI_MLX_PYTHON to change
the generated locations without changing the command. NUMI_SELECTION_ENVS
sets the held-out comparison width (default 256); NUMI_SELECTION_SEED changes
its shared deterministic seed.
EOF
    exit 0
fi

numi_has_option() {
    numi_sought_option=$1
    shift
    for numi_argument do
        [ "$numi_argument" = "$numi_sought_option" ] && return 0
    done
    return 1
}

numi_option_value() {
    numi_sought_option=$1
    shift
    numi_take_next=0
    for numi_argument do
        if [ "$numi_take_next" -eq 1 ]; then
            printf '%s\n' "$numi_argument"
            return 0
        fi
        [ "$numi_argument" = "$numi_sought_option" ] && numi_take_next=1
    done
    return 1
}

numi_root=${NUMI_LAB_ROOT:?Run this capability through the numi dispatcher.}
numi_workspace=${NUMI_WORKSPACE_ROOT:-$numi_root}
numi_build=${NUMI_BUILD_DIR:-$numi_root/build}
if [ -x "$numi_build/bin/metalrobo_task_train" ]; then
    numi_trainer=$numi_build/bin/metalrobo_task_train
else
    numi_trainer=$numi_root/bin/metalrobo_task_train
fi
[ -x "$numi_trainer" ] || {
    printf 'numi train: missing %s; run numi doctor\n' "$numi_trainer" >&2
    exit 1
}

numi_run_stamp=$(date -u '+%Y%m%dT%H%M%SZ')
numi_runs_root=${NUMI_RUNS_DIR:-$numi_workspace/.numi/runs}
numi_run=${NUMI_RUN_DIR:-$numi_runs_root/train-$numi_run_stamp-$$}
mkdir -p "$numi_run"

if [ -f "$numi_root/python/metalrobo/mlx_policy_worker.py" ]; then
    numi_python_root=$numi_root/python
else
    numi_python_root=$numi_root/share/numi/python
fi

if [ -f "$numi_build/shaders/MetalRobo.metallib" ]; then
    numi_metallib=$numi_build/shaders/MetalRobo.metallib
else
    numi_metallib=$numi_root/lib/metalrobo/MetalRobo.metallib
fi

if [ -f "$numi_build/lib/libmetalrobo.dylib" ]; then
    numi_native_library=$numi_build/lib/libmetalrobo.dylib
else
    numi_native_library=$numi_root/lib/libmetalrobo.dylib
fi

numi_path_python=$(command -v python3 2>/dev/null || true)
numi_python=
for numi_candidate_python in \
    "${NUMI_MLX_PYTHON:-}" \
    "$numi_root/python/.venv/bin/python" \
    "$numi_path_python" \
    "${HOME:-}/.pyenv/versions/"*/bin/python3 \
    "${HOME:-}/.pyenv/versions/"*/bin/python; do
    [ -x "$numi_candidate_python" ] || continue
    if "$numi_candidate_python" -c 'import mlx' >/dev/null 2>&1; then
        numi_python=$numi_candidate_python
        break
    fi
done
if [ "$numi_python" = "" ]; then
    printf 'numi train: no Python interpreter with MLX found; run numi doctor\n' >&2
    exit 1
fi

numi_has_option --metallib "$@" || set -- --metallib "$numi_metallib" "$@"
numi_has_option --native-library "$@" || set -- --native-library "$numi_native_library" "$@"
numi_has_option --python-root "$@" || set -- --python-root "$numi_python_root" "$@"
numi_has_option --mlx-python "$@" || set -- --mlx-python "$numi_python" "$@"

if ! numi_has_option --policy-pack "$@"; then
    set -- --policy-pack "$numi_run/initial.policypack" "$@"
    numi_has_option --initialize-policy "$@" ||
        set -- --initialize-policy unitree_g1_native_locomotion "$@"
fi
numi_has_option --updated-policy-pack "$@" ||
    set -- --updated-policy-pack "$numi_run/candidate.policypack" "$@"
numi_requested_deployment=$(
    numi_option_value --deployment-policy-pack "$@" || true
)
numi_protected_deployment=${numi_requested_deployment:-$numi_run/deployment.policypack}
numi_candidate_deployment=$numi_run/candidate.deployment.policypack
numi_incumbent_deployment=$numi_run/incumbent.deployment.policypack
[ "$numi_protected_deployment" != "$numi_candidate_deployment" ] &&
[ "$numi_protected_deployment" != "$numi_incumbent_deployment" ] || {
    printf 'numi train: protected deployment path collides with a reserved selection artifact\n' >&2
    exit 2
}
# These are appended deliberately: the native parser's last value wins, so an
# explicitly requested deployment path is protected from learner writes too.
set -- "$@" \
    --deployment-policy-pack "$numi_candidate_deployment" \
    --incumbent-policy-pack "$numi_incumbent_deployment"
numi_has_option --rollout-pack "$@" ||
    set -- --rollout-pack "$numi_run/rollout.rolloutpack" "$@"
numi_has_option --learner-state "$@" ||
    set -- --learner-state "$numi_run/learner.safetensors" "$@"
numi_has_option --output-learner-state "$@" ||
    set -- --output-learner-state "$numi_run/learner.safetensors" "$@"

printf '%s\n' "$@" > "$numi_run/arguments.txt"
if command -v git >/dev/null 2>&1 && git -C "$numi_root" rev-parse HEAD >/dev/null 2>&1; then
    git -C "$numi_root" rev-parse HEAD > "$numi_run/revision.txt"
    git -C "$numi_root" status --short > "$numi_run/worktree-status.txt"
elif [ -f "$numi_root/share/numi/REVISION" ]; then
    cp "$numi_root/share/numi/REVISION" "$numi_run/revision.txt"
fi
if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$numi_trainer" "$numi_metallib" "$numi_native_library" \
        > "$numi_run/runtime.sha256"
fi
printf 'numi train: artifacts %s\n' "$numi_run" >&2

numi_stdout_pipe=$numi_run/stdout.pipe
numi_stderr_pipe=$numi_run/stderr.pipe
mkfifo "$numi_stdout_pipe" "$numi_stderr_pipe"
trap 'rm -f "$numi_stdout_pipe" "$numi_stderr_pipe"' EXIT
tee "$numi_run/stdout.log" < "$numi_stdout_pipe" &
numi_stdout_tee=$!
tee "$numi_run/stderr.log" < "$numi_stderr_pipe" >&2 &
numi_stderr_tee=$!
"$numi_trainer" "$@" > "$numi_stdout_pipe" 2> "$numi_stderr_pipe"
numi_status=$?
wait "$numi_stdout_tee"
wait "$numi_stderr_tee"
rm -f "$numi_stdout_pipe" "$numi_stderr_pipe"
trap - EXIT
if [ "$numi_status" -eq 0 ] && [ -s "$numi_run/stdout.log" ]; then
    cp "$numi_run/stdout.log" "$numi_run/evidence.json"
fi
if [ "$numi_status" -eq 0 ]; then
    if [ -x "$numi_build/bin/metalrobo_task_rollout" ]; then
        numi_evaluator=$numi_build/bin/metalrobo_task_rollout
    else
        numi_evaluator=$numi_root/bin/metalrobo_task_rollout
    fi
    [ -x "$numi_evaluator" ] || {
        printf 'numi train: missing evaluator %s; deployment remains unselected\n' \
            "$numi_evaluator" >&2
        numi_status=1
    }
fi
if [ "$numi_status" -eq 0 ]; then
    printf 'numi train: matched incumbent/candidate selection\n' >&2
    numi_training_steps=$(numi_option_value --steps "$@" || printf '1\n')
    numi_selection_steps=$(
        "$numi_python" -c \
            'import json,sys; evidence=json.load(open(sys.argv[1])); print(int(evidence.get("maximum_episode_steps", sys.argv[2])))' \
            "$numi_run/evidence.json" "$numi_training_steps"
    )
    numi_checkpoint_directory=$(
        numi_option_value --checkpoint-directory "$@" || true
    )
    "$numi_python" "$numi_python_root/metalrobo/policy_selection.py" \
        --evaluator "$numi_evaluator" \
        --metallib "$numi_metallib" \
        --incumbent "$numi_incumbent_deployment" \
        --candidate "$numi_candidate_deployment" \
        --checkpoint-directory \
            "${numi_checkpoint_directory:-$numi_run/no-checkpoints}" \
        --deployment "$numi_protected_deployment" \
        --evidence-directory "$numi_run/selection" \
        --maximum-environments "${NUMI_SELECTION_ENVS:-256}" \
        --held-out-seed "${NUMI_SELECTION_SEED:-2650443581}" \
        --evaluation-steps "$numi_selection_steps" \
        -- "$@" > "$numi_run/selection.log"
    numi_status=$?
    cat "$numi_run/selection.log"
fi
if command -v shasum >/dev/null 2>&1; then
    find "$numi_run" -type f ! -name artifacts.sha256 \
        -exec shasum -a 256 {} \; > "$numi_run/artifacts.sha256"
fi
exit "$numi_status"
