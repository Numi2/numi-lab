+    if (env>=d.environmentCount) return;
+    float4 value=float4(0.0f);
+    bool selected=node<d.femNodeCount;
+    if (selected && reactionMode!=0u)
+        selected=statuses[env].code==NM_STATUS_SUCCESS &&
+            (anchors[node].flags & NM_NUMI_HUMAN_TENDON_FEM_NODE_ANCHOR_ACTIVE)!=0u;
+    if (selected) {
+        const float3 force=forces[env*d.femNodeCount+node].xyz;
+        value=finite3(force)?float4(force,length(force)):float4(NAN);
+    }
+    threadgroup float4 scratch[8];
+    value=humanNodeSum256(value,lane,scratch);
+    if (lane==0u) partials[group]=value;
+}
+kernel void nm_numi_human_finish_node_force_audit(
+    constant NMNumiHumanTendonFEMLoadDispatchGPU& d [[buffer(0)]],
+    device const float4* partials [[buffer(1)]],
+    device float4* audits [[buffer(2)]],
+    uint lane [[thread_index_in_threadgroup]],
