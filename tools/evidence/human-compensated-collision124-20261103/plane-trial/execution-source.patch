+kernel void nm_numi_human_add_fem_anchor_reactions_to_pending_load_sparse(
+    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch [[buffer(0)]],
+    device const NMNumiHumanTendonFEMNodeAnchorGPU* nodeAnchors [[buffer(1)]],
+    device const float4* constraintReactions [[buffer(2)]],
+    device const MRArticulatedBodyPoseGPU* bodyPoses [[buffer(3)]],
+    device const float* pointJacobians [[buffer(4)]],
+    device float* pendingGeneralizedLoad [[buffer(5)]],
+    device const NMMatterStatusGPU* matterStatuses [[buffer(6)]],
+    device const uint* anchorIndices [[buffer(7)]],
+    constant uint& anchorCount [[buffer(8)]],
+    uint dof [[thread_position_in_grid]]
+) {
+    if (dof >= dispatch.dofCount || dispatch.environmentCount != 1u ||
+        dispatch.abiVersion != NM_NUMI_HUMAN_TENDON_FEM_LOAD_ABI_VERSION ||
+        matterStatuses[0u].code != NM_STATUS_SUCCESS) return;
+    float generalizedForce = pendingGeneralizedLoad[dof];
+    if (!isfinite(generalizedForce)) return;
+    bool valid = true;
+    const uint environment = 0u;
+    const uint reactionBase = environment * dispatch.femNodeCount;
+    for (uint ordinal = 0u; ordinal < anchorCount; ++ordinal) {
+        const uint node = anchorIndices[ordinal];
+        const NMNumiHumanTendonFEMNodeAnchorGPU anchor = nodeAnchors[node];
+        if ((anchor.flags & NM_NUMI_HUMAN_TENDON_FEM_NODE_ANCHOR_ACTIVE) == 0u)
+            continue;
+        if (!validBody(anchor.bodyIndex, dispatch) ||
+            !finite4(anchor.localPoint) || anchor.localPoint.w != 0.0f) {
+            valid = false;
+            break;
+        }
+        const uint localBody = anchor.bodyIndex - dispatch.articulationFirstBody;
+        const MRArticulatedBodyPoseGPU pose = bodyPoses[localBody];
+        const float4 reaction4 = constraintReactions[reactionBase + node];
+        if (!finite4(pose.position) || !finite4(pose.orientation) ||
+            !finite4(reaction4)) {
+            valid = false;
+            break;
+        }
+        const float3 worldPoint = pose.position.xyz +
+            humanQuaternionRotate(pose.orientation, anchor.localPoint.xyz);
+        generalizedForce += dot(
+            reaction4.xyz,
+            humanPointJacobian(
+                environment, dof, dispatch, bodyPoses, pointJacobians,
+                anchor.bodyIndex, worldPoint));
+    }
+    pendingGeneralizedLoad[dof] =
+        valid && isfinite(generalizedForce) ? generalizedForce : NAN;
+}
