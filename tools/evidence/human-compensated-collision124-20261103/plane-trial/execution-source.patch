+kernel void nm_fgmres_clear_changed_direction_rows(
+    constant NMMatterDispatchGPU& d [[buffer(0)]],
+    constant NMFGMRESLayoutGPU& layout [[buffer(30)]],
+    device float4* solution [[buffer(1)]],
+    device const uint* changed [[buffer(2)]],
+    device NMMatterStatusGPU* statuses [[buffer(3)]],
+    uint global [[thread_position_in_grid]]) {
+    const uint mechanical=2u*d.femNodeCount;
+    const uint rigidEnd=mechanical+d.rigidGeneralizedCapacity;
+    const uint mpmEnd=rigidEnd+d.mpmActiveNodeCapacity;
+    const uint supportEnd=mpmEnd+layout.supportContactCount;
+    const uint width=supportEnd+layout.vascularUnknownCount;
+    if (width==0u || global>=d.environmentCount*width) return;
+    const uint env=global/width, local=global%width;
+    if (changed[env]==0u) return;
+    uint row=0u;
+    if (local<d.femNodeCount) row=env*d.femNodeCount+local;
+    else if (local<mechanical)
+        row=d.environmentCount*d.femNodeCount+env*d.femNodeCount+local-d.femNodeCount;
+    else if (local<rigidEnd) row=fgmresRigidIndex(d,env,local-mechanical);
+    else if (local<mpmEnd) row=fgmresMPMIndex(d,env,local-rigidEnd);
+    else if (local<supportEnd) row=layout.supportBase+env*layout.supportContactCount+local-mpmEnd;
+    else row=layout.vascularBase+env*layout.vascularUnknownCount+local-supportEnd;
+    const bool finite=all(isfinite(solution[row]));
+    solution[row]=float4(0.0f);
+    if (!finite)
+        recordFailure(statuses[env],NM_STATUS_LINEAR_SOLVER_FAILURE,
+            NM_INVALID_INDEX,NM_INVALID_INDEX,float4(INFINITY,0.0f,0.0f,0.0f));
