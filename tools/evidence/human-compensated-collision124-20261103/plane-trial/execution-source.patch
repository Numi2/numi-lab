+    a.momentResidualAndMaximumPressure = float4(
+        a.momentResidualAndMaximumPressure.xyz+b.momentResidualAndMaximumPressure.xyz,
+        max(a.momentResidualAndMaximumPressure.w,b.momentResidualAndMaximumPressure.w));
+    a.normalForceAreaAndCounts += b.normalForceAreaAndCounts;
+    a.energyStrainClosureAndAccepted = float4(
