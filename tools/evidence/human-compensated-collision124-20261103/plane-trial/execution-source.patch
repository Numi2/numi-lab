+// One audit row per lane, followed by two-level SIMD/threadgroup reductions.
+// Point/contact evaluation and all finite checks match the serial owner oracle.
+inline NMNumiHumanArticularContactAuditGPU humanContactAuditMerge(
+    NMNumiHumanArticularContactAuditGPU a,
+    const NMNumiHumanArticularContactAuditGPU b) {
+    const bool valid = finite4(a.forceResidualAndL1) &&
+        finite4(a.momentResidualAndMaximumPressure) &&
+        finite4(a.normalForceAreaAndCounts) && finite4(a.energyStrainClosureAndAccepted) &&
+        finite4(b.forceResidualAndL1) && finite4(b.momentResidualAndMaximumPressure) &&
+        finite4(b.normalForceAreaAndCounts) && finite4(b.energyStrainClosureAndAccepted);
