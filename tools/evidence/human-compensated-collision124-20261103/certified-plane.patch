+// Outward-rounded intervals are certificates, not contact regularization.
+// Each input high/low coordinate and axis component is an exact Float32 datum.
+// nextafter encloses every rounded operation; the normal-minimum guard also
+// encloses underflow on devices that flush subnormal results. Invalid/overflow
+// intervals never certify a sweep. Keep this path under strict FP arithmetic.
+struct NMContactInterval { float lower; float upper; };
+inline float nmContactIntervalDown(float x) {
+    constexpr float minimumNormal=1.1754943508222875e-38f;
+    return abs(x)<minimumNormal ? -minimumNormal : nextafter(x,-INFINITY);
+}
+inline float nmContactIntervalUp(float x) {
+    constexpr float minimumNormal=1.1754943508222875e-38f;
+    return abs(x)<minimumNormal ? minimumNormal : nextafter(x,INFINITY);
+}
+inline NMContactInterval nmContactIntervalAdd(NMContactInterval a,NMContactInterval b) {
+    if (a.lower==0.0f && a.upper==0.0f) return b;
+    if (b.lower==0.0f && b.upper==0.0f) return a;
+    return {nmContactIntervalDown(a.lower+b.lower),nmContactIntervalUp(a.upper+b.upper)};
+}
+inline NMContactInterval nmContactIntervalNegate(NMContactInterval a) {
+    return {-a.upper,-a.lower};
+}
+inline NMContactInterval nmContactIntervalScale(NMContactInterval a,float b) {
+    if (b==0.0f || (a.lower==0.0f && a.upper==0.0f)) return {0.0f,0.0f};
+    return b>0.0f
+        ? NMContactInterval{nmContactIntervalDown(a.lower*b),nmContactIntervalUp(a.upper*b)}
+        : NMContactInterval{nmContactIntervalDown(a.upper*b),nmContactIntervalUp(a.lower*b)};
+}
+inline NMContactInterval nmContactProjectionInterval(
+    MRCompensatedPositionGPU a,MRCompensatedPositionGPU b,float3 axis) {
+    NMContactInterval sum{0.0f,0.0f};
+    for (uint i=0u;i<3u;++i) {
+        auto difference=nmContactIntervalAdd({a.high[i],a.high[i]},
+            {-b.high[i],-b.high[i]});
+        difference=nmContactIntervalAdd(difference,{a.low[i],a.low[i]});
+        difference=nmContactIntervalAdd(difference,{-b.low[i],-b.low[i]});
+        sum=nmContactIntervalAdd(sum,nmContactIntervalScale(difference,axis[i]));
+    }
+    return sum;
+}
+// A fixed plane separates two convex features throughout a linear sweep if
+// every pairwise projected difference stays above clearance*|axis|. Bounds at
+// both endpoints enclose their affine interpolation. A shorter certified
+// prefix is returned when an endpoint approaches the plane; all other cases
+// fall back to the existing CCD. This includes mapped reference-mode features.
+inline float nmReferenceContactPlaneFraction(
+    uint kind,thread const MRCompensatedPositionGPU* start,
+    thread const MRCompensatedPositionGPU* finish,float3 axis,float clearance) {
+    if (!all(isfinite(axis)) || !isfinite(clearance) || !(clearance>=0.0f)) return 0.0f;
+    uint firstCount=1u,secondBegin=1u,secondCount=1u;
+    if (kind==NM_DEFORMABLE_CONTACT_VERTEX_TRIANGLE) secondCount=3u;
+    else if (kind==NM_DEFORMABLE_CONTACT_EDGE_EDGE) {
+        firstCount=2u;secondBegin=2u;secondCount=2u;
+    } else if (kind!=NM_DEFORMABLE_CONTACT_POINT_POINT) return 0.0f;
+    NMContactInterval normSquared{0.0f,0.0f};
+    for (uint i=0u;i<3u;++i)
+        normSquared=nmContactIntervalAdd(normSquared,
+            nmContactIntervalScale({axis[i],axis[i]},axis[i]));
+    if (!(normSquared.lower>0.0f) || !isfinite(normSquared.upper)) return 0.0f;
+    const float normUpper=nmContactIntervalUp(sqrt(normSquared.upper));
+    const float threshold=nmContactIntervalScale({clearance,clearance},normUpper).upper;
+    if (!isfinite(threshold)) return 0.0f;
+    float fraction=1.0f;
+    for (uint a=0u;a<firstCount;++a) for (uint b=secondBegin;b<secondBegin+secondCount;++b) {
+        if (!all(isfinite(start[a].high.xyz)) || !all(isfinite(start[a].low.xyz)) ||
+            !all(isfinite(start[b].high.xyz)) || !all(isfinite(start[b].low.xyz)) ||
+            !all(isfinite(finish[a].high.xyz)) || !all(isfinite(finish[a].low.xyz)) ||
+            !all(isfinite(finish[b].high.xyz)) || !all(isfinite(finish[b].low.xyz))) return 0.0f;
+        const auto lo=nmContactProjectionInterval(start[a],start[b],axis);
+        const auto hi=nmContactProjectionInterval(finish[a],finish[b],axis);
+        if (!isfinite(lo.lower) || !isfinite(lo.upper) ||
+            !isfinite(hi.lower) || !isfinite(hi.upper) || !(lo.lower>threshold)) return 0.0f;
+        if (!(hi.lower>threshold)) {
+            const float numerator=nmContactIntervalDown(lo.lower-threshold);
+            const float denominator=nmContactIntervalUp(lo.lower-hi.lower);
+            if (!(numerator>0.0f) || !(denominator>0.0f) || !isfinite(denominator)) return 0.0f;
+            const float prefix=nmContactIntervalDown(0.9f*
+                nmContactIntervalDown(numerator/denominator));
+            if (!(prefix>0.0f) || !isfinite(prefix)) return 0.0f;
+            fraction=min(fraction,prefix);
+        }
+    }
+    return fraction;
+}
