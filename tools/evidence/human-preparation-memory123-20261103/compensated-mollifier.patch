+// Preserve the compensated edges through the nearly parallel cross product.
+// Rounding each edge first can change the mollifier even when the exact trial
+// displacement tends to zero. The value and gradients below differentiate the
+// same dimensionless sin^2 angle as the legacy path; no barrier is softened.
+inline float ipcFeatureMollifierDifferential(
+    const MRCompensatedPositionGPU first,
+    const MRCompensatedPositionGPU second,
+    thread float3& firstGradient,
+    thread float3& secondGradient
+) {
+    firstGradient = float3(0.0f);
+    secondGradient = float3(0.0f);
+    if (!all(isfinite(first.high.xyz)) || !all(isfinite(first.low.xyz)) ||
+        !all(isfinite(second.high.xyz)) || !all(isfinite(second.low.xyz))) {
+        firstGradient = secondGradient = float3(NAN);
+        return NAN;
+    }
+    const float3 fp=contactCompensatedPositionProjection(first);
+    const float3 sp=contactCompensatedPositionProjection(second);
+    const float fs=max(max(abs(fp.x),abs(fp.y)),abs(fp.z));
+    const float ss=max(max(abs(sp.x),abs(sp.y)),abs(sp.z));
+    if (!(fs>0.0f) || !(ss>0.0f)) return 0.0f;
+    const auto a=mrCompensatedVectorScale(first,{1.0f/fs,0.0f});
+    const auto b=mrCompensatedVectorScale(second,{1.0f/ss,0.0f});
+    const auto aa=mrCompensatedVectorDot(a,a);
+    const auto bb=mrCompensatedVectorDot(b,b);
+    const auto c=mrCompensatedVectorCross(a,b);
+    const auto denominator=mrCompensatedMultiply(aa,bb);
+    const auto sine=mrCompensatedDivide(mrCompensatedVectorDot(c,c),denominator);
+    const float sinSquared=max(sine.high+sine.low,0.0f);
+    constexpr float relativeThreshold=1.0e-3f;
+    const float ratio=clamp(sinSquared/relativeThreshold,0.0f,1.0f);
+    const float value=ratio*(2.0f-ratio);
+    if (!isfinite(value)) {
+        firstGradient=secondGradient=float3(NAN);
+        return NAN;
+    }
+    if (!(ratio>0.0f && ratio<1.0f)) return value;
+    const auto inverseDenominator=mrCompensatedDivide({2.0f,0.0f},denominator);
+    const auto firstRadial=mrCompensatedVectorScale(a,
+        mrCompensatedDivide(mrCompensatedMultiply({2.0f,0.0f},sine),aa));
+    const auto secondRadial=mrCompensatedVectorScale(b,
+        mrCompensatedDivide(mrCompensatedMultiply({2.0f,0.0f},sine),bb));
+    const auto ga=mrCompensatedVectorAdd(mrCompensatedVectorScale(
+        mrCompensatedVectorCross(b,c),inverseDenominator),
+        mrCompensatedVectorNegate(firstRadial));
+    const auto gb=mrCompensatedVectorAdd(mrCompensatedVectorScale(
+        mrCompensatedVectorCross(c,a),inverseDenominator),
+        mrCompensatedVectorNegate(secondRadial));
+    const float derivative=2.0f*(1.0f-ratio)/relativeThreshold;
+    firstGradient=(derivative/fs)*contactCompensatedPositionProjection(ga);
+    secondGradient=(derivative/ss)*contactCompensatedPositionProjection(gb);
+    if (!all(isfinite(firstGradient)) || !all(isfinite(secondGradient))) {
+        firstGradient=secondGradient=float3(NAN);
+        return NAN;
+    }
+    return value;
+}
