+                    line += f",initial_rest_{axis}={fields['rest_' + axis]}"
+                    line += f",initial_reference_u_hi_{axis}=0"
+                    line += f",initial_reference_u_lo_{axis}=0.0000000001"
+            lines.append(line)
+        with tempfile.TemporaryDirectory() as directory:
