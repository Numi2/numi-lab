+// Enclose the represented reference-mode point, not only its rounded world
+// projection. AABB construction is conservative geometry, never a force floor.
+inline void nmContactEncloseExpansion(MRCompensatedPositionGPU value,
+    thread float3& minimumPoint,thread float3& maximumPoint) {
+    const float3 projected=femContactPositionRelativeProjection(value);
+    constexpr float minimumNormal=1.1754943508222875e-38f;
+    const float3 lower=select(nextafter(projected,float3(-INFINITY)),
+        float3(-minimumNormal),abs(projected)<minimumNormal);
+    const float3 upper=select(nextafter(projected,float3(INFINITY)),
+        float3(minimumNormal),abs(projected)<minimumNormal);
+    minimumPoint=min(minimumPoint,lower);maximumPoint=max(maximumPoint,upper);
+}
