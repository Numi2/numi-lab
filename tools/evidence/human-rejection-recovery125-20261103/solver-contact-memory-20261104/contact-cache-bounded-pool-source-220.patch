+    device const uint* activeIndices [[buffer(5)]],
+    device NMMixedContactCertificateEntryGPU* entries [[buffer(6)]],
+    device uint* ownerMasks [[buffer(7)]],
+    device const NMContinuumObjectGPU* objects [[buffer(8)]],
+    uint localThread [[thread_index_in_threadgroup]],
+    uint group [[threadgroup_position_in_grid]],
+    uint lane [[thread_index_in_simdgroup]]) {
+    const uint capacity = dispatch.deformableContactCapacity;
+    if (capacity == 0u) return;
+    const uint tilesPerEnvironment = (capacity+255u)/256u;
+    const uint environment = group / tilesPerEnvironment;
+    if (environment >= dispatch.environmentCount) return;
+    const uint local = (group % tilesPerEnvironment)*256u+localThread;
+    const uint count = min(contact.deformableActiveCounts[environment],capacity);
+    uint owners = 0u;
+    if (local < count) {
+        const uint slot = activeIndices[environment*capacity+local];
+        NMMixedContactCertificateEntryGPU entry;
+        entry.identity = uint4(NM_INVALID_INDEX,NM_INVALID_INDEX,0u,slot);
+        entry.metrics = float4(0.0f);
+        if (slot >= capacity) {
+            entry.identity.z = 4u; // preserve every object's malformed-slot rejection
+            owners = 0xffffffffu;
+        } else {
+            const NMDeformableContactGPU deformable =
+                contact.deformableContacts[environment*capacity+slot];
+            const bool owner0 = deformable.identity.x < dispatch.objectCount &&
+                (objects[deformable.identity.x].representation == NM_REPRESENTATION_FEM ||
+                 objects[deformable.identity.x].representation == NM_REPRESENTATION_MPM);
+            const bool owner1 = deformable.identity.y < dispatch.objectCount &&
+                (objects[deformable.identity.y].representation == NM_REPRESENTATION_FEM ||
+                 objects[deformable.identity.y].representation == NM_REPRESENTATION_MPM);
+            if ((deformable.identity.w & NM_CONTACT_VALID) != 0u && (owner0 || owner1)) {
+                entry.identity.xy = deformable.identity.xy;
+                const float separation = deformable.pointAndSeparation.w;
+                const float clearance =
+                    solver.contactAcceptance.x*dispatch.numericalLimits.x;
+                const float legacyFloor = max(clearance,16.0f*kEpsilon*
+                    max(maximumAbsoluteCoordinate(
+                        deformable.pointAndSeparation.xyz),1.0e-12f));
+                const bool separated = isfinite(separation) &&
+                    (separation > legacyFloor ||
+                     nmMixedReferenceContactClearance(dispatch,deformable,
+                        candidateNodes,environment,clearance) ||
+                     nmMixedReferenceRestContactClearance(dispatch,deformable,
+                        candidateNodes,environment,clearance) ||
+                     nmMixedReferenceInitialContactNonclosing(dispatch,deformable,
+                        acceptedNodes,candidateNodes,environment,clearance));
+                entry.identity.z = 1u | (separated ? 2u : 0u);
+                entry.metrics = float4(max(deformable.barrier.x,0.0f),separation,
+                    length(deformable.impulseAndFriction.yz),
+                    nmMixedDeformableContactEnergy(deformable));
+                if (owner0 && deformable.identity.x < 32u) owners |= 1u<<deformable.identity.x;
+                if (owner1 && deformable.identity.y < 32u) owners |= 1u<<deformable.identity.y;
+            }
+        }
+        entries[environment*capacity+local] = entry;
+    }
+    owners = simd_or(owners);
+    if (lane == 0u && local < count)
+        ownerMasks[environment*((capacity+31u)/32u)+local/32u] = owners;
+}
