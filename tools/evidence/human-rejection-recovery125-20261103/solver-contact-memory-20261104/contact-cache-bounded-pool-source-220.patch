+kernel void nm_mixed_prepare_contact_certificate_cache_dispatch(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    device const uint* activeCounts [[buffer(1)]],
+    device NMIndirectDispatchGPU* output [[buffer(2)]],
+    uint global [[thread_position_in_grid]]) {
+    if (global != 0u || dispatch.environmentCount != 1u) return;
