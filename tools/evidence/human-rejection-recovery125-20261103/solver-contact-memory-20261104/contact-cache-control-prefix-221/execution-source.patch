+// Static source topology is immutable; dynamic transfers and poses are still
+// checked on every attempted step. One tile covers 256 distinct node rows.
+inline bool humanNodeLoadValid(
+    constant NMNumiHumanTendonFEMLoadDispatchGPU& d,
+    device const NMNumiHumanTendonFEMNodeLoadGPU* loads,
+    device const NMNumiHumanTendonFEMNodeAnchorGPU* anchors,
+    device const MRNumiHumanTendonTransferResultGPU* transfers,
+    device const MRArticulatedBodyPoseGPU* poses, uint env, uint node) {
+    if (!(d.abiVersion == NM_NUMI_HUMAN_TENDON_FEM_LOAD_ABI_VERSION &&
+          d.environmentCount > 0u && d.femNodeCount > 0u &&
+          d.endpointCount > 0u && d.dofCount > 0u &&
+          d.transferStride >= d.endpointCount &&
+          d.generalizedForceStride >= d.dofCount && d.muscleCount > 0u &&
+          d.bodyPoseStride > 0u && d.pointJacobianStride > 0u &&
+          d.bodyJacobianPointOffset != MR_INVALID_INDEX &&
+          d.stepIndex < NM_NUMI_HUMAN_ARTICULAR_CONTACT_AUDIT_MAX_STEPS))
+        return false;
+    const auto load = loads[node];
+    const auto anchor = anchors[node];
+    const bool active = (anchor.flags & NM_NUMI_HUMAN_TENDON_FEM_NODE_ANCHOR_ACTIVE) != 0u;
+    bool valid = finite4(load.scale) && anchor.reserved0 == 0u &&
+        anchor.reserved1 == 0u &&
+        (anchor.flags & ~NM_NUMI_HUMAN_TENDON_FEM_NODE_ANCHOR_ACTIVE) == 0u &&
+        finite4(anchor.localPoint) && anchor.localPoint.w == 0.0f &&
+        (!active || validBody(anchor.bodyIndex, d)) &&
+        (active || anchor.bodyIndex == MR_INVALID_INDEX);
+    for (uint slot=0u; valid && slot<4u; ++slot) {
+        const uint endpoint=load.endpointIndex[slot];
+        const bool used=endpoint != NM_INVALID_INDEX;
+        valid=used == (load.scale[slot] != 0.0f) &&
+            (!used || endpoint<d.endpointCount);
+        for (uint prev=0u; valid && prev<slot; ++prev)
+            valid=!used || load.endpointIndex[prev] != endpoint;
+        if (!valid || !used) continue;
+        const auto t=transfers[env*d.transferStride+endpoint];
+        valid=t.status==MR_NUMI_HUMAN_TENDON_TRANSFER_SUCCESS &&
+            t.environment==env && t.bindingIndex==endpoint &&
+            finite4(t.terminalWorldForce);
+    }
+    if (valid && active) {
+        const auto pose=poses[env*d.bodyPoseStride+anchor.bodyIndex-d.articulationFirstBody];
+        valid=finite4(pose.position) && finite4(pose.orientation);
+    }
+    return valid;
+}
+inline uint humanNodeMin256(uint value, uint lane,
+                           threadgroup uint* scratch) {
+    value=simd_min(value);
+    if ((lane&31u)==0u) scratch[lane>>5u]=value;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    value=lane<8u?scratch[lane]:NM_INVALID_INDEX;
+    return simd_min(value);
+}
+inline float4 humanNodeSum256(float4 value, uint lane,
+                             threadgroup float4* scratch) {
+    value=simd_sum(value);
+    if ((lane&31u)==0u) scratch[lane>>5u]=value;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    value=lane<8u?scratch[lane]:float4(0.0f);
+    return simd_sum(value);
+}
