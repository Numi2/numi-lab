+
+// This is a numerical separation margin, not material thickness. Some
+// registered reference features start below the ordinary numerical margin.
+// Choose a positive dyadic margin certified on IMMUTABLE REST geometry; never
+// derive it from the last accepted iterate, so repeated steps cannot erode it.
+// No proof (including a source intersection) returns zero and remains rejected.
+inline float nmReferenceContactRestClearance(
+    uint kind,thread const MRCompensatedPositionGPU* rest,float3 normal,float clearance) {
+    if(!isfinite(clearance)||!(clearance>0.0f))return 0.0f;
+    float margin=clearance;
+    for(uint pass=0u;pass<17u;++pass) {
+        if(nmReferenceContactStaticClearance(kind,rest,normal,margin)||
+           nmReferenceContactStaticClearance(kind,rest,-normal,margin))return margin;
+        margin*=0.5f;
+    }
+    return 0.0f;
+}
+
+// Preserve the existing initial-touch rule without relaxing ordinary clearance.
+// An initial convex-feature witness gives an upper bound on the initial distance;
+// a strict separating-plane lower bound at the candidate must exceed that upper
+// bound. Thus an initially sub-clearance contact cannot close or cross. Exact
+// unchanged features are handled separately to avoid interval-width false failures.
+inline bool nmReferenceInitialContactNonclosing(
+    uint kind,thread const MRCompensatedPositionGPU* initial,
+    thread const MRCompensatedPositionGPU* candidate,float4 weights,float3 normal,
+    float clearance) {
+    if(!isfinite(clearance)||!(clearance>0.0f)||!all(isfinite(weights)))return false;
+    if(!nmReferenceContactStaticClearance(kind,initial,normal,0.0f))return false;
+    const uint count=kind==NM_DEFORMABLE_CONTACT_POINT_POINT?2u:4u;
+    bool unchanged=true;
+    for(uint i=0u;i<count;++i)unchanged=unchanged&&
+        all(initial[i].high==candidate[i].high)&&all(initial[i].low==candidate[i].low);
+    float upperSquared=0.0f;
+    for(uint j=0u;j<3u;++j) {
+        float3 axis=float3(0.0f);axis[j]=1.0f;
+        NMContactInterval delta;
+        if(kind==NM_DEFORMABLE_CONTACT_POINT_POINT)
+            delta=nmContactProjectionInterval(initial[0],initial[1],axis);
+        else if(kind==NM_DEFORMABLE_CONTACT_VERTEX_TRIANGLE) {
+            const float u=clamp(-weights.z,0.0f,1.0f);
+            const float v=clamp(-weights.w,0.0f,max(0.0f,nmContactIntervalDown(1.0f-u)));
+            delta=nmContactProjectionInterval(initial[0],initial[1],axis);
+            delta=nmContactIntervalAdd(delta,nmContactIntervalScale(
+                nmContactProjectionInterval(initial[2],initial[1],axis),-u));
+            delta=nmContactIntervalAdd(delta,nmContactIntervalScale(
+                nmContactProjectionInterval(initial[3],initial[1],axis),-v));
+        } else if(kind==NM_DEFORMABLE_CONTACT_EDGE_EDGE) {
+            const float u=clamp(weights.y,0.0f,1.0f),v=clamp(-weights.w,0.0f,1.0f);
+            delta=nmContactProjectionInterval(initial[0],initial[2],axis);
+            delta=nmContactIntervalAdd(delta,nmContactIntervalScale(
+                nmContactProjectionInterval(initial[1],initial[0],axis),u));
+            delta=nmContactIntervalAdd(delta,nmContactIntervalScale(
+                nmContactProjectionInterval(initial[3],initial[2],axis),-v));
+        } else return false;
+        const float m=max(abs(delta.lower),abs(delta.upper));
+        upperSquared=nmContactIntervalUp(upperSquared+nmContactIntervalUp(m*m));
+    }
+    const float initialUpper=nmContactIntervalUp(sqrt(upperSquared));
+    if(!isfinite(initialUpper)||!(initialUpper>0.0f)||initialUpper>clearance)return false;
+    return unchanged||nmReferenceContactStaticClearance(
+        kind,candidate,normal,initialUpper);
+}
