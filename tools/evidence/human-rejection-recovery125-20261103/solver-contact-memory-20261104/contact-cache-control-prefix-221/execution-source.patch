+
+kernel void nm_contact_reference_rest_sweep_check(
+    device const MRCompensatedPositionGPU* positions [[buffer(0)]],
+    device const float4* parameters [[buffer(1)]],
+    device float2* results [[buffer(2)]],
+    constant uint& count [[buffer(3)]],
+    uint index [[thread_position_in_grid]]) {
+    if(index>=count)return;
+    MRCompensatedPositionGPU rest[4],start[4],finish[4];
+    for(uint i=0u;i<4u;++i) {
+        rest[i]=positions[12u*index+i];
+        start[i]=positions[12u*index+4u+i];
+        finish[i]=positions[12u*index+8u+i];
+    }
+    const auto axis=parameters[2u*index];
+    const float margin=nmReferenceContactRestClearance(
+        uint(axis.w),rest,axis.xyz,parameters[2u*index+1u].x);
+    results[index]=float2(margin,margin>0.0f?
+        nmReferenceContactSweepFraction(uint(axis.w),start,finish,axis.xyz,margin):0.0f);
+}
