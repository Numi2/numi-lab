+    device const NMMatterStatusGPU* statuses [[buffer(3)]],
+    device float4* partials [[buffer(4)]],
+    constant uint& reactionMode [[buffer(5)]],
+    uint lane [[thread_index_in_threadgroup]],
+    uint group [[threadgroup_position_in_grid]]) {
+    const uint tiles=(d.femNodeCount+255u)/256u;
+    if (tiles==0u) return;
