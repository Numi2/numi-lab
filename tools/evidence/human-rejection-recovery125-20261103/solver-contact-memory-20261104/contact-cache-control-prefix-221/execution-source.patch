+        float3 value = float3(0.0f);
+        uint live = 0u;
+        do {
+            if (incidence >= contactRange.count) break;
+            const uint pairIndex = contact.nodeIncidence[
+                contactRange.first + incidence];
+            if (pairIndex >= dispatch.contactPairCount ||
+                contact.pairs[pairIndex].objectIndex != objectIndex) break;
+            const NMContactSampleGPU sample = primalContactSample(
+                dispatch, contact, environment, pairIndex);
+            if ((sample.identity.w & NM_CONTACT_VALID) != 0u) {
+                const float3 rigidDirection = coupledRigidPointDirection(
+                    dispatch, contact, coupledPointJacobians,
+                    environment, pairIndex,
+                    articulatedNv, direction);
+                value = coupledBarrierDirectionalForce(
+                    sample, direction[global].xyz - rigidDirection) +
