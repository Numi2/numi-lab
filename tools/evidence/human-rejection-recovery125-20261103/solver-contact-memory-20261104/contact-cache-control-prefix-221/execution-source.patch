+    device const uint* anchorIndices [[buffer(7)]],
+    constant uint& anchorCount [[buffer(8)]],
+    uint dof [[thread_position_in_grid]]
+) {
+    if (dof >= dispatch.dofCount || dispatch.environmentCount != 1u ||
+        dispatch.abiVersion != NM_NUMI_HUMAN_TENDON_FEM_LOAD_ABI_VERSION ||
+        matterStatuses[0u].code != NM_STATUS_SUCCESS) return;
