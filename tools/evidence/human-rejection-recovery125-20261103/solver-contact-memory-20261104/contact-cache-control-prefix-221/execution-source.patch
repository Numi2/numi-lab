+kernel void nm_contact_reference_unresolved_sweep_check(
+    device const MRCompensatedPositionGPU* positions [[buffer(0)]],
+    device const float4* parameters [[buffer(1)]],
+    device uint* results [[buffer(2)]],
+    constant uint& count [[buffer(3)]],uint index [[thread_position_in_grid]]) {
+    if(index>=count)return;
+    MRCompensatedPositionGPU start[4],finish[4];
+    for(uint i=0u;i<4u;++i){start[i]=positions[8u*index+i];finish[i]=positions[8u*index+4u+i];}
+    results[index]=nmReferenceUnresolvedSweepSeparated(
+        uint(parameters[index].y),start,finish,parameters[index].x)?1u:0u;
