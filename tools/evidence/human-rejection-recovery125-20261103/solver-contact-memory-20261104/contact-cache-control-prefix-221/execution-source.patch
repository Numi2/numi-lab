+    for(uint j=0u;j<3u;++j)for(uint k=0u;k<4u;++k) {
+        const float v=k==0u?a.high[j]:k==1u?-b.high[j]:k==2u?a.low[j]:-b.low[j];
+        if(v==0.0f||axis[j]==0.0f)continue;
+        const float high=v*axis[j],low=fma(v,axis[j],-high);
+        // A 24x24-bit product has at most 48 significant bits. Above
+        // 2^-78 even its least nonzero residual bit is normal on Float32.
+        if(!isfinite(high)||!isfinite(low))return {-INFINITY,INFINITY};
+        if(abs(high)<0x1p-78f||(low!=0.0f&&abs(low)<minimumNormal)) {
+            smallProducts=nmContactIntervalAdd(smallProducts,
+                nmContactIntervalScale({v,v},axis[j]));
+            continue;
+        }
+        if(!nmContactExpansionAppend(expansion,count,high)||
+           !nmContactExpansionAppend(expansion,count,low))
+            return {-INFINITY,INFINITY};
+    }
+    NMContactInterval result{0.0f,0.0f};
+    for(uint i=0u;i<count;++i)
+        result=nmContactIntervalAdd(result,{expansion[i],expansion[i]});
+    return nmContactIntervalAdd(result,smallProducts);
+}
+// A fixed plane separates two convex features throughout a linear sweep if
+// every pairwise projected difference stays above clearance*|axis|. Bounds at
+// both endpoints enclose their affine interpolation. A shorter certified
+// prefix is returned when an endpoint approaches the plane; all other cases
+// fall back to the existing CCD. This includes mapped reference-mode features.
+inline float nmReferenceContactPlaneFraction(
+    uint kind,thread const MRCompensatedPositionGPU* start,
+    thread const MRCompensatedPositionGPU* finish,float3 axis,float clearance) {
+    if (!all(isfinite(axis)) || !isfinite(clearance) || !(clearance>=0.0f)) return 0.0f;
+    uint firstCount=1u,secondBegin=1u,secondCount=1u;
+    if (kind==NM_DEFORMABLE_CONTACT_VERTEX_TRIANGLE) secondCount=3u;
+    else if (kind==NM_DEFORMABLE_CONTACT_EDGE_EDGE) {
+        firstCount=2u;secondBegin=2u;secondCount=2u;
+    } else if (kind!=NM_DEFORMABLE_CONTACT_POINT_POINT) return 0.0f;
+    NMContactInterval normSquared{0.0f,0.0f};
+    for (uint i=0u;i<3u;++i)
+        normSquared=nmContactIntervalAdd(normSquared,
+            nmContactIntervalScale({axis[i],axis[i]},axis[i]));
+    if (!(normSquared.lower>0.0f) || !isfinite(normSquared.upper)) return 0.0f;
+    const float normUpper=nmContactIntervalUp(sqrt(normSquared.upper));
+    const float threshold=nmContactIntervalScale({clearance,clearance},normUpper).upper;
+    if (!isfinite(threshold)) return 0.0f;
+    float fraction=1.0f;
+    for (uint a=0u;a<firstCount;++a) for (uint b=secondBegin;b<secondBegin+secondCount;++b) {
+        if (!all(isfinite(start[a].high.xyz)) || !all(isfinite(start[a].low.xyz)) ||
+            !all(isfinite(start[b].high.xyz)) || !all(isfinite(start[b].low.xyz)) ||
+            !all(isfinite(finish[a].high.xyz)) || !all(isfinite(finish[a].low.xyz)) ||
+            !all(isfinite(finish[b].high.xyz)) || !all(isfinite(finish[b].low.xyz))) return 0.0f;
+        auto lo=nmContactProjectionInterval(start[a],start[b],axis);
+        auto hi=nmContactProjectionInterval(finish[a],finish[b],axis);
+        if(lo.lower<=threshold&&lo.upper>threshold)
+            lo=nmContactProjectionIntervalRefined(start[a],start[b],axis);
+        if(hi.lower<=threshold&&hi.upper>threshold)
+            hi=nmContactProjectionIntervalRefined(finish[a],finish[b],axis);
+        if (!isfinite(lo.lower) || !isfinite(lo.upper) ||
+            !isfinite(hi.lower) || !isfinite(hi.upper) || !(lo.lower>threshold)) return 0.0f;
+        if (!(hi.lower>threshold)) {
+            const float numerator=nmContactIntervalDown(lo.lower-threshold);
+            const float denominator=nmContactIntervalUp(lo.lower-hi.lower);
+            if (!(numerator>0.0f) || !(denominator>0.0f) || !isfinite(denominator)) return 0.0f;
+            const float prefix=nmContactIntervalDown(0.9f*
+                nmContactIntervalDown(numerator/denominator));
+            if (!(prefix>0.0f) || !isfinite(prefix)) return 0.0f;
+            fraction=min(fraction,prefix);
+        }
+    }
+    return fraction;
+}
+
+// A single fixed axis certifies the entire affine sweep. A compensated axis
+// avoids an angular Float32 error becoming a distance floor on long features.
+inline float nmReferenceContactCompensatedPlaneFraction(
+    uint kind,thread const MRCompensatedPositionGPU* start,
+    thread const MRCompensatedPositionGPU* finish,MRCompensatedPositionGPU axis,
+    float3 referenceNormal,float clearance) {
+    if(!isfinite(clearance)||clearance<0.0f)return 0.0f;
+    const float alignment=dot(axis.high.xyz+axis.low.xyz,referenceNormal);
+    if(!isfinite(alignment)||alignment==0.0f)return 0.0f;
+    if(alignment<0.0f){axis.high=-axis.high;axis.low=-axis.low;}
+    float normSquaredUpper=0.0f;
+    for(uint i=0u;i<3u;++i) {
+        const float bound=nmContactIntervalUp(abs(axis.high[i])+abs(axis.low[i]));
+        normSquaredUpper=nmContactIntervalUp(normSquaredUpper+nmContactIntervalUp(bound*bound));
+    }
+    const float normUpper=nmContactIntervalUp(sqrt(normSquaredUpper));
+    const float threshold=nmContactIntervalUp(clearance*normUpper);
+    if(!isfinite(normUpper)||!(normUpper>0.0f)||!isfinite(threshold))return 0.0f;
+    uint firstCount=1u,secondBegin=1u,secondCount=1u;
+    if(kind==NM_DEFORMABLE_CONTACT_VERTEX_TRIANGLE)secondCount=3u;
+    else if(kind==NM_DEFORMABLE_CONTACT_EDGE_EDGE){firstCount=2u;secondBegin=2u;secondCount=2u;}
+    else if(kind!=NM_DEFORMABLE_CONTACT_POINT_POINT)return 0.0f;
+    float fraction=1.0f;
+    for(uint a=0u;a<firstCount;++a)for(uint b=secondBegin;b<secondBegin+secondCount;++b) {
+        const auto lo=nmContactIntervalAdd(
+            nmContactProjectionIntervalRefined(start[a],start[b],axis.high.xyz),
+            nmContactProjectionInterval(start[a],start[b],axis.low.xyz));
+        const auto hi=nmContactIntervalAdd(
+            nmContactProjectionIntervalRefined(finish[a],finish[b],axis.high.xyz),
+            nmContactProjectionInterval(finish[a],finish[b],axis.low.xyz));
+        if(!isfinite(lo.lower)||!isfinite(hi.lower)||!(lo.lower>threshold))return 0.0f;
+        if(!(hi.lower>threshold)) {
+            const float numerator=nmContactIntervalDown(lo.lower-threshold);
+            const float denominator=nmContactIntervalUp(lo.lower-hi.lower);
+            if(!(numerator>0.0f)||!(denominator>0.0f)||!isfinite(denominator))return 0.0f;
+            const float prefix=nmContactIntervalDown(0.9f*
+                nmContactIntervalDown(numerator/denominator));
+            if(!(prefix>0.0f)||!isfinite(prefix))return 0.0f;
+            fraction=min(fraction,prefix);
+        }
+    }
+    return fraction;
+}
+inline MRCompensatedPositionGPU nmReferenceContactFeatureAxis(
+    uint kind,thread const MRCompensatedPositionGPU* feature) {
+    if(kind==NM_DEFORMABLE_CONTACT_VERTEX_TRIANGLE)
+        return mrCompensatedVectorCross(
+            mrCompensatedVectorAdd(feature[2],mrCompensatedVectorNegate(feature[1])),
+            mrCompensatedVectorAdd(feature[3],mrCompensatedVectorNegate(feature[1])));
+    if(kind==NM_DEFORMABLE_CONTACT_EDGE_EDGE)
+        return mrCompensatedVectorCross(
+            mrCompensatedVectorAdd(feature[1],mrCompensatedVectorNegate(feature[0])),
+            mrCompensatedVectorAdd(feature[3],mrCompensatedVectorNegate(feature[2])));
+    if(kind==NM_DEFORMABLE_CONTACT_POINT_POINT)
+        return mrCompensatedVectorAdd(feature[0],mrCompensatedVectorNegate(feature[1]));
+    return mrCompensatedVector(float4(0.0f));
+}
+inline bool nmReferenceContactPreciseFeatureAxis(
+    uint kind,thread const MRCompensatedPositionGPU* feature,float3 normal,float clearance) {
+    return nmReferenceContactCompensatedPlaneFraction(kind,feature,feature,
+        nmReferenceContactFeatureAxis(kind,feature),normal,clearance)==1.0f;
+}
+// A quadratic Bernstein axis is an arbitrary separating-plane candidate,
+// not an assertion that the computed cross product is exact. Project ORIGINAL
+// affine endpoints onto its stored high/low coefficients with outward intervals.
+// Their cubic Bernstein coefficients enclose every pairwise projection for the
+// entire sweep. Norm convexity bounds the axis length by its three control norms.
+// Strict lower bounds for all coefficients therefore certify the SAME clearance,
+// while allowing the separating plane to rotate with deforming thin features.
+inline bool nmReferenceContactPolynomialPrefixSeparated(
+    uint kind,thread const MRCompensatedPositionGPU* start,
+    thread const MRCompensatedPositionGPU* finish,float3 normal,float clearance,float endFraction) {
+    if(!isfinite(clearance)||!(clearance>0.0f)||!(endFraction>0.0f)||
+       !(endFraction<=1.0f))return false;
+    // Approximate interpolation chooses an arbitrary axis only. The proof
+    // below projects the ORIGINAL endpoints and bounds their exact affine
+    // interpolation, so no represented position is silently rounded away.
+    MRCompensatedPositionGPU chosenFinish[4];
+    const uint featureCount=kind==NM_DEFORMABLE_CONTACT_POINT_POINT?2u:4u;
+    for(uint i=0u;i<featureCount;++i)
+        chosenFinish[i]=endFraction==1.0f?finish[i]:mrCompensatedVectorAdd(
+            mrCompensatedVectorScale(start[i],{1.0f-endFraction,0.0f}),
+            mrCompensatedVectorScale(finish[i],{endFraction,0.0f}));
+    uint firstCount=1u,secondBegin=1u,secondCount=1u;
+    MRCompensatedPositionGPU axis[3];
+    if(kind==NM_DEFORMABLE_CONTACT_VERTEX_TRIANGLE ||
+       kind==NM_DEFORMABLE_CONTACT_EDGE_EDGE) {
+        if(kind==NM_DEFORMABLE_CONTACT_VERTEX_TRIANGLE)secondCount=3u;
+        else {firstCount=2u;secondBegin=2u;secondCount=2u;}
+        const uint a0=kind==NM_DEFORMABLE_CONTACT_VERTEX_TRIANGLE?1u:0u;
+        const uint a1=kind==NM_DEFORMABLE_CONTACT_VERTEX_TRIANGLE?2u:1u;
+        const uint b0=kind==NM_DEFORMABLE_CONTACT_VERTEX_TRIANGLE?1u:2u;
+        const uint b1=3u;
+        const auto u0=mrCompensatedVectorAdd(start[a1],mrCompensatedVectorNegate(start[a0]));
+        const auto u1=mrCompensatedVectorAdd(chosenFinish[a1],mrCompensatedVectorNegate(chosenFinish[a0]));
+        const auto v0=mrCompensatedVectorAdd(start[b1],mrCompensatedVectorNegate(start[b0]));
+        const auto v1=mrCompensatedVectorAdd(chosenFinish[b1],mrCompensatedVectorNegate(chosenFinish[b0]));
+        axis[0]=mrCompensatedVectorCross(u0,v0);
+        axis[1]=mrCompensatedVectorScale(mrCompensatedVectorAdd(
+            mrCompensatedVectorCross(u0,v1),mrCompensatedVectorCross(u1,v0)),{0.5f,0.0f});
+        axis[2]=mrCompensatedVectorCross(u1,v1);
+    } else if(kind==NM_DEFORMABLE_CONTACT_POINT_POINT) {
+        axis[0]=mrCompensatedVectorAdd(start[0],mrCompensatedVectorNegate(start[1]));
+        axis[2]=mrCompensatedVectorAdd(chosenFinish[0],mrCompensatedVectorNegate(chosenFinish[1]));
+        axis[1]=mrCompensatedVectorScale(mrCompensatedVectorAdd(axis[0],axis[2]),{0.5f,0.0f});
+    } else return false;
+    const float alignment=dot(axis[0].high.xyz+axis[0].low.xyz,normal);
+    if(!isfinite(alignment)||alignment==0.0f)return false;
+    float normUpper=0.0f;
+    for(uint c=0u;c<3u;++c) {
+        if(alignment<0.0f){axis[c].high=-axis[c].high;axis[c].low=-axis[c].low;}
+        float squaredUpper=0.0f;
+        for(uint k=0u;k<3u;++k) {
+            if(!isfinite(axis[c].high[k])||!isfinite(axis[c].low[k]))return false;
+            const float magnitude=nmContactIntervalUp(abs(axis[c].high[k])+abs(axis[c].low[k]));
+            squaredUpper=nmContactIntervalUp(squaredUpper+nmContactIntervalUp(magnitude*magnitude));
+        }
+        normUpper=max(normUpper,nmContactIntervalUp(sqrt(squaredUpper)));
+    }
+    const float threshold=nmContactIntervalUp(clearance*normUpper);
+    if(!(normUpper>0.0f)||!isfinite(normUpper)||!isfinite(threshold))return false;
+    for(uint a=0u;a<firstCount;++a)for(uint b=secondBegin;b<secondBegin+secondCount;++b) {
+        NMContactInterval projection[3][2];
+        for(uint c=0u;c<3u;++c)for(uint e=0u;e<2u;++e) {
+            const auto pa=e==0u?start[a]:finish[a],pb=e==0u?start[b]:finish[b];
+            projection[c][e]=nmContactIntervalAdd(
+                nmContactProjectionIntervalRefined(pa,pb,axis[c].high.xyz),
+                nmContactProjectionIntervalRefined(pa,pb,axis[c].low.xyz));
+            if(!isfinite(projection[c][e].lower)||!isfinite(projection[c][e].upper))return false;
+        }
+        if(endFraction<1.0f)for(uint c=0u;c<3u;++c)
+            projection[c][1]=nmContactIntervalAdd(
+                nmContactIntervalScale(projection[c][0],1.0f-endFraction),
+                nmContactIntervalScale(projection[c][1],endFraction));
+        // Division by exact3 is rounded outward; stored1/3 coefficients would
+        // not enclose the exact cubic and are deliberately avoided.
+        const auto sum1=nmContactIntervalAdd(projection[0][1],
+            nmContactIntervalScale(projection[1][0],2.0f));
+        const auto sum2=nmContactIntervalAdd(projection[2][0],
+            nmContactIntervalScale(projection[1][1],2.0f));
+        const float lower[4]={projection[0][0].lower,
+            nmContactIntervalDown(sum1.lower/3.0f),
+            nmContactIntervalDown(sum2.lower/3.0f),projection[2][1].lower};
+        for(uint c=0u;c<4u;++c)
+            if(!isfinite(lower[c])||!(lower[c]>threshold))return false;
+    }
+    return true;
+}
+
+inline float nmReferenceContactSweepFraction(
+    uint kind,thread const MRCompensatedPositionGPU* start,
+    thread const MRCompensatedPositionGPU* finish,float3 normal,float clearance) {
+    float fraction=nmReferenceContactPlaneFraction(kind,start,finish,normal,clearance);
+    if(fraction==1.0f)return fraction;
+    fraction=max(fraction,nmReferenceContactCompensatedPlaneFraction(kind,start,finish,
+        nmReferenceContactFeatureAxis(kind,start),normal,clearance));
+    if(fraction==1.0f)return fraction;
+    fraction=max(fraction,nmReferenceContactCompensatedPlaneFraction(kind,start,finish,
+        nmReferenceContactFeatureAxis(kind,finish),normal,clearance));
+    if(fraction>0.0f && fraction<1.0f) {
+        if(nmReferenceContactPolynomialPrefixSeparated(kind,start,finish,normal,clearance,1.0f))
+            return 1.0f;
+        // A real closing sweep must not force a needlessly tiny global step
+        // merely because no fixed plane tracks its rotating feature. Each
+        // returned dyadic prefix is certified over its ENTIRE time interval.
+        // Four bounded attempts; unchanged fallback if none proves separation.
+        float prefix=0.5f;
+        for(uint attempt=0u;attempt<4u&&prefix>fraction;++attempt,prefix*=0.5f)
+            if(nmReferenceContactPolynomialPrefixSeparated(kind,start,finish,normal,clearance,prefix))
+                return prefix;
+    }
+    return fraction;
+}
+
+// Project ORIGINAL endpoint expansions, then interpolate their outward
+// intervals. Interpolated positions are used only to choose an arbitrary axis,
+// never as proof inputs. This avoids losing the low words at subdivision cuts.
+inline bool nmReferenceContactIntervalPlaneSeparated(
+    uint kind,thread const MRCompensatedPositionGPU* start,
+    thread const MRCompensatedPositionGPU* finish,
+    MRCompensatedPositionGPU axis,float thickness,float lo,float hi) {
+    uint firstCount=1u,secondBegin=1u,secondCount=1u;
+    if(kind==NM_DEFORMABLE_CONTACT_VERTEX_TRIANGLE)secondCount=3u;
+    else if(kind==NM_DEFORMABLE_CONTACT_EDGE_EDGE){firstCount=2u;secondBegin=2u;secondCount=2u;}
+    else if(kind!=NM_DEFORMABLE_CONTACT_POINT_POINT)return false;
+    float normSquaredUpper=0.0f;
+    for(uint j=0u;j<3u;++j) {
+        if(!isfinite(axis.high[j])||!isfinite(axis.low[j]))return false;
+        const float bound=nmContactIntervalUp(abs(axis.high[j])+abs(axis.low[j]));
+        normSquaredUpper=nmContactIntervalUp(normSquaredUpper+nmContactIntervalUp(bound*bound));
+    }
+    const float normUpper=nmContactIntervalUp(sqrt(normSquaredUpper));
+    const float threshold=nmContactIntervalUp(thickness*normUpper);
+    if(!(normUpper>0.0f)||!isfinite(normUpper)||!isfinite(threshold))return false;
+    for(uint a=0u;a<firstCount;++a)for(uint b=secondBegin;b<secondBegin+secondCount;++b) {
+        const auto p=nmContactIntervalAdd(
+            nmContactProjectionIntervalRefined(start[a],start[b],axis.high.xyz),
+            nmContactProjectionInterval(start[a],start[b],axis.low.xyz));
+        const auto q=nmContactIntervalAdd(
+            nmContactProjectionIntervalRefined(finish[a],finish[b],axis.high.xyz),
+            nmContactProjectionInterval(finish[a],finish[b],axis.low.xyz));
+        if(!isfinite(p.lower)||!isfinite(p.upper)||!isfinite(q.lower)||!isfinite(q.upper))
+            return false;
+        for(uint endpoint=0u;endpoint<2u;++endpoint) {
+            // lo/hi are exactly represented dyadic fractions; so is 1-t.
+            const float t=endpoint==0u?lo:hi;
+            const auto value=nmContactIntervalAdd(nmContactIntervalScale(p,1.0f-t),
+                                                  nmContactIntervalScale(q,t));
+            if(!isfinite(value.lower)||!(value.lower>threshold))return false;
+        }
+    }
+    return true;
+}
+
+// Only legacy-uncertified sweeps reach this bounded refinement. Every accepted
+// leaf proves full activation-thickness separation over its whole time interval.
+// A crossing, nonfinite input or exhausted depth stays uncertified. No sampled
+// distance is used to accept a miss; the final residual/contact gates are intact.
+inline bool nmReferenceContactSubdividedSweepSeparated(
+    uint kind,thread const MRCompensatedPositionGPU* start,
+    thread const MRCompensatedPositionGPU* finish,float thickness) {
+    constexpr uint maximumDepth=4u;
+    float2 intervals[maximumDepth+1u];
+    uint depths[maximumDepth+1u];
+    intervals[0]=float2(0.0f,1.0f);depths[0]=0u;
+    uint size=1u;
+    for(uint visit=0u;size>0u&&visit<31u;++visit) {
+        --size;const float2 interval=intervals[size];const uint depth=depths[size];
+        const float t=0.5f*(interval.x+interval.y);
+        MRCompensatedPositionGPU midpoint[4];
+        const uint count=kind==NM_DEFORMABLE_CONTACT_POINT_POINT?2u:4u;
+        for(uint i=0u;i<count;++i)
+            midpoint[i]=mrCompensatedVectorAdd(
+                mrCompensatedVectorScale(start[i],{1.0f-t,0.0f}),
+                mrCompensatedVectorScale(finish[i],{t,0.0f}));
+        MRCompensatedPositionGPU axis=mrCompensatedVector(float4(0.0f));
+        if(kind==NM_DEFORMABLE_CONTACT_VERTEX_TRIANGLE) {
+            float3 barycentric,point;float distance;
+            if(!contactCompensatedVertexTriangleWitness(midpoint[0],midpoint[1],
+                    midpoint[2],midpoint[3],barycentric,point,axis,distance))return false;
+        } else if(kind==NM_DEFORMABLE_CONTACT_EDGE_EDGE) {
+            float u,v;float3 a,b;
+            closestPointsOnSegments(midpoint[0].high.xyz+midpoint[0].low.xyz,
+                midpoint[1].high.xyz+midpoint[1].low.xyz,
+                midpoint[2].high.xyz+midpoint[2].low.xyz,
+                midpoint[3].high.xyz+midpoint[3].low.xyz,u,v,a,b);
+            axis=mrCompensatedVector(float4(a-b,0.0f));
+        } else if(kind==NM_DEFORMABLE_CONTACT_POINT_POINT)
+            axis=mrCompensatedVectorAdd(midpoint[0],mrCompensatedVectorNegate(midpoint[1]));
+        else return false;
+        if(nmReferenceContactIntervalPlaneSeparated(kind,start,finish,axis,thickness,
+                interval.x,interval.y))continue;
+        if(depth>=maximumDepth||size+2u>maximumDepth+1u)return false;
+        intervals[size]=float2(t,interval.y);depths[size++]=depth+1u;
+        intervals[size]=float2(interval.x,t);depths[size++]=depth+1u;
+    }
+    return size==0u;
+}
+
+inline bool nmReferenceUnresolvedSweepSeparated(
+    uint kind,thread const MRCompensatedPositionGPU* start,
+    thread const MRCompensatedPositionGPU* finish,float thickness) {
+    if(!isfinite(thickness)||thickness<0.0f)return false;
+    for(uint endpoint=0u;endpoint<2u;++endpoint) {
+        float3 p[4];
+        for(uint i=0u;i<4u;++i) {
+            const auto value=endpoint==0u?start[i]:finish[i];
+            if(!all(isfinite(value.high.xyz))||!all(isfinite(value.low.xyz)))return false;
+            p[i]=value.high.xyz+value.low.xyz;
+        }
+        float3 direction;
+        if(kind==NM_DEFORMABLE_CONTACT_VERTEX_TRIANGLE) {
+            float3 bary;
+            direction=p[0]-closestPointOnTriangle(p[0],p[1],p[2],p[3],bary);
+        } else if(kind==NM_DEFORMABLE_CONTACT_EDGE_EDGE) {
+            float u,v;float3 a,b;
+            closestPointsOnSegments(p[0],p[1],p[2],p[3],u,v,a,b);direction=a-b;
+        } else if(kind==NM_DEFORMABLE_CONTACT_POINT_POINT)direction=p[0]-p[1];
+        else return false;
+        if(nmReferenceContactSweepFraction(kind,start,finish,direction,thickness)==1.0f)
+            return true;
+    }
+    return nmReferenceContactSubdividedSweepSeparated(kind,start,finish,thickness);
+}
+
+// Candidate axes need not be exact: every success is certified against the
+// full compensated features, including a norm bound for unchanged clearance.
+inline bool nmReferenceContactStaticAxis(
+    uint kind,thread const MRCompensatedPositionGPU* feature,float3 axis,
+    float clearance,float3 referenceNormal) {
+    const float alignment=dot(axis,referenceNormal);
+    if(!isfinite(alignment)||alignment==0.0f)return false;
+    if(alignment<0.0f)axis=-axis;
+    return nmReferenceContactPlaneFraction(kind,feature,feature,axis,clearance)==1.0f;
+}
+inline bool nmReferenceContactStaticClearance(
+    uint kind,thread const MRCompensatedPositionGPU* feature,float3 normal,float clearance) {
+    if(nmReferenceContactStaticAxis(kind,feature,normal,clearance,normal))return true;
+    float3 p[4];
+    for(uint i=0u;i<4u;++i)p[i]=feature[i].high.xyz+feature[i].low.xyz;
+    if(kind==NM_DEFORMABLE_CONTACT_POINT_POINT)
+        return nmReferenceContactStaticAxis(kind,feature,p[0]-p[1],clearance,normal)||
+            nmReferenceContactPreciseFeatureAxis(kind,feature,normal,clearance);
+    if(kind==NM_DEFORMABLE_CONTACT_EDGE_EDGE) {
+        const float3 a=p[1]-p[0],b=p[3]-p[2];
+        if(nmReferenceContactStaticAxis(kind,feature,cross(a,b),clearance,normal))return true;
+        for(uint i=0u;i<2u;++i)for(uint j=2u;j<4u;++j) {
+            const float3 delta=p[i]-p[j];
+            if(nmReferenceContactStaticAxis(kind,feature,delta,clearance,normal)||
+               nmReferenceContactStaticAxis(kind,feature,cross(a,cross(delta,a)),clearance,normal)||
+               nmReferenceContactStaticAxis(kind,feature,cross(b,cross(delta,b)),clearance,normal))return true;
+        }
+    } else if(kind==NM_DEFORMABLE_CONTACT_VERTEX_TRIANGLE) {
+        if(nmReferenceContactStaticAxis(kind,feature,
+            cross(p[2]-p[1],p[3]-p[1]),clearance,normal))return true;
+        for(uint i=1u;i<4u;++i) {
+            const float3 edge=p[1u+i%3u]-p[i],delta=p[0]-p[i];
+            if(nmReferenceContactStaticAxis(kind,feature,delta,clearance,normal)||
