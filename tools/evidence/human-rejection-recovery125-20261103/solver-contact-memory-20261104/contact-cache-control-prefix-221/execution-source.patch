+        valid[shared] = live;
+        simdgroup_barrier(mem_flags::mem_threadgroup);
+        if (lane == 0u)
+            for (uint i = 0u; i < min(32u,contactRange.count-tile); ++i)
+                if (valid[simdGroup*32u+i] != 0u)
+                    work[global].xyz += values[simdGroup*32u+i].xyz;
+        simdgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    const uint deformableCapacity = dispatch.deformableContactCapacity;
+    const uint deformableBase = environment * deformableCapacity;
+    const uint unifiedCount = dispatch.gridNodeCount + dispatch.femNodeCount;
+    const NMIncidenceRangeGPU deformableRange =
+        contact.deformableNodeRanges[
+            environment * unifiedCount + unifiedNode];
