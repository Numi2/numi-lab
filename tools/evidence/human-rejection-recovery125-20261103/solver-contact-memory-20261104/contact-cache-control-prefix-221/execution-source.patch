+                const ulong localPair = leftLocalMode * 12u + rightLocalMode;
+                const ulong output = (((ulong(environment) * tangent.regionCount +
+                    region) * 144u + localPair) * tangent.tileCount) + tile;
+                partials[output] = 0.0f;
+            }
