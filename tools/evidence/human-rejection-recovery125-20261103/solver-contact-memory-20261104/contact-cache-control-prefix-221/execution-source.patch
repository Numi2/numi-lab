+// Offset only the numerical geometry boundary, retaining the existing FEM
+// IPC law down to the positive boundary. Metadata keeps the world activation width.
+inline float4 nmFEMClearanceAlignedResponseAtGap(float gap,float thickness,
+    float inverseResponse,float dt,float closing,float offset) {
+    const float width=thickness-offset;
+    if(gap>=width)return float4(0.0f,0.0f,thickness,0.0f);
+    const float distance=gap; // Positive-gap IPC: retain force and curvature below the old cutoff.
+    // Cancel width^2 before evaluating the coefficient. A fixed dimensioned
+    // denominator floor made narrow contact bands artificially weak even when
+    // the true coefficient was finite and representable. Successive divisions
+    // also avoid underflowing the product inverseResponse*dt^2*width^2.
+    const float inertialScale=((10.0f/inverseResponse)/dt)/dt;
+    const float remaining=max(width-distance,1.0e-3f*width);
+    const float impactScale=((max(closing,0.0f)/inverseResponse)/dt)/remaining;
+    const float scale=max(inertialScale,impactScale);
+    const float k=(scale/width)/width;
+    if(!isfinite(k)||!(k>0.0f))return float4(NAN);
+    // Dimensionless derivatives of the identical IPC polynomial avoid d^4
+    // underflow for nanometre gaps. Do not reduce precision or clamp curvature.
+    const float u=distance/width,r2=u*u,v=r2-1.0f,l=log(r2);
+    const float force=2.0f*scale*width*(2.0f*u*v*l+v*v/u);
+    const float radial=max(-scale*((12.0f*r2-4.0f)*l+16.0f*v-2.0f*v*v/r2),0.0f);
+    return float4(max(force,0.0f)*dt,
+        radial*dt*dt,thickness,k);
+}
+inline float4 nmFEMClearanceAlignedResponse(float separation,float thickness,
+    float inverseResponse,float dt,float closing,float offset) {
+    if(offset==0.0f)
+        return ipcBarrierResponse(separation,thickness,inverseResponse,dt,closing,false,0.0f,0.0f);
+    if(!isfinite(offset)||offset<0.0f||!(thickness>offset)||!(separation>offset))
+        return float4(NAN);
+    if(!(inverseResponse>0.0f)||!(dt>0.0f))return float4(0.0f,0.0f,thickness,0.0f);
+    return nmFEMClearanceAlignedResponseAtGap(separation-offset,thickness,
+        inverseResponse,dt,closing,offset);
+}
+// Subtract the clearance before projecting to Float32. Rounding the world
+// distance first loses the small gap that the paired Armijo energy retains.
+inline float4 nmFEMClearanceAlignedResponse(MRCompensatedScalar separation,
+    float thickness,float inverseResponse,float dt,float closing,float offset) {
+    if(offset==0.0f)return nmFEMClearanceAlignedResponse(
+        separation.high+separation.low,thickness,inverseResponse,dt,closing,offset);
+    const auto gapWords=mrCompensatedAdd(separation,{-offset,0.0f});
+    const float gap=gapWords.high+gapWords.low;
+    if(!isfinite(offset)||offset<0.0f||!(thickness>offset)||
+       !isfinite(gap)||!(gap>0.0f))return float4(NAN);
+    if(!(inverseResponse>0.0f)||!(dt>0.0f))return float4(0.0f,0.0f,thickness,0.0f);
+    return nmFEMClearanceAlignedResponseAtGap(gap,thickness,
+        inverseResponse,dt,closing,offset);
+}
