+            const NMDeformableContactGPU deformable =
+                contact.deformableContacts[deformableBase + slot];
+            if ((deformable.identity.w & NM_CONTACT_VALID) == 0u ||
+                deformableContactNode(deformable, local) != unifiedNode) break;
+            float3 exactContactAction = float3(0.0f);
+            const float contactTimestep = deformable.identity.x <
+                    dispatch.objectCount
+                ? objectTimestep(dispatch, schedulers[
+                    environment * dispatch.objectCount + deformable.identity.x])
+                : 0.0f;
+            if (deformableExactVertexTriangleDirectionalForce(
+                    dispatch, deformable, candidate, direction, environment,
+                    unifiedNode, contactTimestep, exactContactAction, false)) {
+                value = exactContactAction;
+                live = 1u;
+                break;
+            }
+            float3 relativeDirection = float3(0.0f);
+            float mollifierDirection = 0.0f;
+            for (uint other = 0u; other < 6u; ++other) {
+                const uint otherNode = deformableContactNode(deformable, other);
+                float3 otherDirection = float3(0.0f);
+                if (otherNode >= dispatch.gridNodeCount &&
+                    otherNode - dispatch.gridNodeCount < dispatch.femNodeCount) {
+                    otherDirection = direction[
+                        environment * dispatch.femNodeCount +
+                        otherNode - dispatch.gridNodeCount].xyz;
+                    relativeDirection += deformableContactWeight(deformable, other) *
+                        deformableContactTimeScale(deformable, other) * otherDirection;
+                } else if (otherNode < dispatch.gridNodeCount) {
+                    const uint activeSlot = contact.mpmNodeToActive[
+                        environment * dispatch.gridNodeCount + otherNode];
+                    if (activeSlot < contact.mpmActiveNodeCounts[environment]) {
+                        otherDirection = direction[fgmresMPMIndex(
+                            dispatch, environment, activeSlot)].xyz;
+                        relativeDirection += deformableContactWeight(deformable, other) *
+                            deformableContactTimeScale(deformable, other) * otherDirection;
+                    }
+                }
+                mollifierDirection += dot(
+                    deformableMollifierGradient(deformable, other),
+                    deformableContactTimeScale(deformable, other) * otherDirection);
+            }
+            value = deformableContactTimeScale(deformable, local) * (
+                deformableContactWeight(deformable, local) *
+                    deformableBarrierDirectionalForce(
+                        deformable, relativeDirection) +
+                deformableMollifierGradient(deformable, local) *
+                    (deformable.mollifier.z * mollifierDirection));
+            live = 1u;
+        } while (false);
+        values[shared] = float4(value,0.0f);
+        valid[shared] = live;
+        simdgroup_barrier(mem_flags::mem_threadgroup);
+        if (lane == 0u)
+            for (uint i = 0u; i < min(32u,deformableRange.count-tile); ++i)
+                if (valid[simdGroup*32u+i] != 0u)
+                    work[global].xyz += values[simdGroup*32u+i].xyz;
+        simdgroup_barrier(mem_flags::mem_threadgroup);
     }
 }
 
+// Translate an existing GPU-selected node range, preserving its zero-work
+// decision. Canonical node groups are not inferred from allocation capacity.
+kernel void nm_fgmres_prepare_simd_gather_dispatch(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    device const NMIndirectDispatchGPU* source [[buffer(1)]],
+    device NMIndirectDispatchGPU* output [[buffer(2)]],
+    uint global [[thread_position_in_grid]]) {
+    if (global != 0u) return;
+    const ulong sourceNodeGroups = ulong(source[0].threadgroupsX);
+    const ulong boundedGroups = (ulong(dispatch.femNodeCount)+7ul)/8ul;
+    output[0] = {uint(min(sourceNodeGroups*32ul,boundedGroups)),1u,1u,0u};
+}
