+    // One SIMD per node, eight independent nodes per 256-thread group.
+    // Evaluate incidences in lanes; lane0 folds the original CSR order.
+    // Skipped records are not added as zeros. No floating-point atomics.
+    threadgroup float4 values[256u];
+    threadgroup uint valid[256u];
