+kernel void nm_contact_reference_initial_nonclosing_check(
+    device const MRCompensatedPositionGPU* positions [[buffer(0)]],
+    device const float4* parameters [[buffer(1)]],
+    device const float4* weights [[buffer(2)]],device uint* results [[buffer(3)]],
+    constant uint& count [[buffer(4)]],uint index [[thread_position_in_grid]]) {
+    if(index>=count)return;
