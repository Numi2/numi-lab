+    id<MTLBuffer> args=[device newBufferWithLength:ae.encodedLength
+        options:MTLResourceStorageModeShared];
+    [ae setArgumentBuffer:args offset:0u];
+    for(NSUInteger i=0u;i<20u;++i) [ae setBuffer:dummy offset:0u atIndex:i];
