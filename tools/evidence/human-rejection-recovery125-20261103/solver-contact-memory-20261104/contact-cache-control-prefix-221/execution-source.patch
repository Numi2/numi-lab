+                        dot(nmPartitionedKnownRegionalCoefficient(basisValues,basisLookup,leftMode,row1,tangent.basisNodeCount,supportRow1).xyz,
+                            action.full.node1.xyz - action.selfDiagonal[1].xyz) +
+                        dot(nmPartitionedKnownRegionalCoefficient(basisValues,basisLookup,leftMode,row2,tangent.basisNodeCount,supportRow2).xyz,
+                            action.full.node2.xyz - action.selfDiagonal[2].xyz) +
+                        dot(nmPartitionedKnownRegionalCoefficient(basisValues,basisLookup,leftMode,row3,tangent.basisNodeCount,supportRow3).xyz,
