+                threadgroup_barrier(mem_flags::mem_threadgroup);
+            }
+            const uint bestA=candidatesA[0],bestB=candidatesB[0];
+            if(bestA==NM_INVALID_INDEX||bestB==NM_INVALID_INDEX) break;
