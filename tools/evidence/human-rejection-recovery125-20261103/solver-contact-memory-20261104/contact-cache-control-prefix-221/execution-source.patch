+    for (uint tile = 0u; tile < range.count; tile += 32u) {
+        const uint local = tile + lane;
+        float4 value = float4(0.0f);
+        uint live = 0u;
+        if (local < range.count) {
+            const uint index = nodeIncidence[range.first + local];
+            if (index < dispatch.tetrahedronCount) {
+                const NMTetrahedronGPU tet = environmentTetrahedron(
+                    dispatch,tetrahedra,environment,index);
+                if ((tet.identity.w & NM_OBJECT_ACTIVE) != 0u) {
+                    value = elementNodeVector(elementOperator[elementBase+index],tet,node);
+                    live = 1u;
+                }
