+template <bool certifiedInactiveAABB, bool exactMotionCache, bool compactQueryWork>
+kernel void nm_numi_human_validate_fem_body_contact_samples_cached_impl(
+    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch [[buffer(0)]],
+    device const NMNumiHumanFEMBodyContactSampleGPU* samples [[buffer(1)]],
+    device const NMNumiHumanFEMBodyContactNeighborhoodRangeGPU* ranges
+        [[buffer(2)]],
+    device const NMNumiHumanFEMBodyContactNeighborhoodTriangleGPU* triangles
+        [[buffer(3)]],
+    device const NMNumiHumanFEMBodyContactBVHNodeGPU* bvhNodes [[buffer(4)]],
+    device const NMFEMNodeStateGPU* acceptedNodes [[buffer(5)]],
+    device const MRArticulatedBodyPoseGPU* bodyPoses [[buffer(6)]],
+    device uint* sampleValid [[buffer(7)]],
+    device float4* rowCache [[buffer(8)]],
+    device const uint* motionFlags [[buffer(9)]],
+    device const uint* queryIndices [[buffer(10)]],
+    device const NMIndirectDispatchGPU* queryWork [[buffer(11)]],
+    uint global [[thread_position_in_grid]]
+) {
+    if (compactQueryWork) {
+        if (global>=queryWork[0].reserved) return;
+        global=queryIndices[global];
+    }
+    const uint sampleCount = dispatch.femBodyContactSampleCount;
+    if (sampleCount == 0u || dispatch.environmentCount == 0u) return;
+    const uint totalCount = dispatch.environmentCount * sampleCount;
+    if (global >= totalCount) return;
+    const uint environment = global / sampleCount;
+    const uint sampleIndex = global - environment * sampleCount;
+    if (dispatch.abiVersion != NM_NUMI_HUMAN_TENDON_FEM_LOAD_ABI_VERSION) {
+        sampleValid[global] = 0u;
+        return;
+    }
+    const NMNumiHumanFEMBodyContactSampleGPU sample = samples[sampleIndex];
+    bool valid = dispatch.femNodeCount > 0u &&
+        dispatch.bodyPoseStride > 0u &&
+        sample.slaveNode < dispatch.femNodeCount &&
+        validBody(sample.bodyIndex, dispatch);
+    if (valid && exactMotionCache && !compactQueryWork &&
+        motionFlags[environment * dispatch.femNodeCount + sample.slaveNode] == 3u &&
+        motionFlags[dispatch.environmentCount * dispatch.femNodeCount +
+            environment * dispatch.bodyPoseStride +
+            sample.bodyIndex - dispatch.articulationFirstBody] == 3u) {
+        // Preserve both the prior finite row and its validation result.
+        // An invalid row remains invalid and still fails closed downstream.
+        return;
+    }
+    rowCache[global] = float4(NAN);
+    if (valid) {
+        const MRArticulatedBodyPoseGPU pose = bodyPoses[
+            environment * dispatch.bodyPoseStride +
+            sample.bodyIndex - dispatch.articulationFirstBody];
+        float3 slavePoint;
+        float3 bodyPoint;
+        float3 normal;
+        float closure;
+        float contactArea;
+        float3x3 contactTangent;
+        float tangentialSlip;
+        valid = humanFEMBodyContactStateForSample(
+            sampleIndex, dispatch, sample, ranges, triangles, bvhNodes,
+            acceptedNodes[environment * dispatch.femNodeCount + sample.slaveNode],
+            pose, slavePoint, bodyPoint, normal, closure, contactArea,
+            contactTangent, tangentialSlip, certifiedInactiveAABB);
+        if(valid) {
+            const bool triangle=sample.flags==(NM_NUMI_HUMAN_FEM_BODY_CONTACT_ACTIVE|
+                NM_NUMI_HUMAN_FEM_BODY_CONTACT_TRIANGLE_CONTACT);
+            const float stiffness=triangle?sample.bodyLocalNormalAndReferenceSeparation.w:
+                sample.stiffnessAndNormalStrainPerPressure.x;
+            const float pressure=stiffness*closure;
+            rowCache[global]=float4(normal*(pressure*contactArea),closure);
+        }
+    }
+    sampleValid[global] = valid ? 1u : 0u;
+}
