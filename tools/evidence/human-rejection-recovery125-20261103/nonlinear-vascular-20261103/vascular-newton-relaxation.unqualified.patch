+// Exercise the production scratch gate without compiling an unrelated runtime.
+// A converged outer Newton state must survive local hydraulic smoothing; an
+// accepted inner linear solve alone must not suppress the next local sweep.
+void newtonBlockRelaxationGates() {
+    id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+    need(device != nil, "Metal device unavailable for Newton block gate");
+    NSError* error = nil;
+    id<MTLLibrary> library = [device newLibraryWithURL:
+        [NSURL fileURLWithPath:@NUMI_MATTER_METALLIB] error:&error];
+    need(library != nil, "Newton block gate metallib unavailable");
+    auto pipe = pipeline(device, library, @"numi_matter_metal::nm_vascular_predictor_prepare");
+    auto queue = [device newCommandQueue];
+    NMMatterDispatchGPU dispatch{};
+    dispatch.environmentCount = 3u;
+    dispatch.objectCount = 2u;
+    NMFGMRESLayoutGPU layout{};
+    layout.vascularBase = 12u;
+    layout.vascularUnknownCount = 2u;
+    layout.unknownCount = 18u;
+    std::vector<nm_float4> input(18u), zeros(18u), seeded(18u);
+    for (unsigned i = 0; i < input.size(); ++i) {
+        input[i] = {float(i + 1), 0, 0, 0};
+        seeded[i] = {float(100 + i), 0, 0, 0};
+    }
+    std::vector<NMFGMRESStateGPU> states(3u);
+    for (auto& state : states) {
+        state.diagnostics = {7, 8, 1, 9};
+        state.nonlinear = {10, 11, 12, 0};
+    }
+    states[1].nonlinear.w = 1.0f;
+    const auto initialStates = states;
+    auto rhs = gpuBuffer(device, input);
+    auto basis = gpuBuffer(device, seeded);
+    auto preconditioned = gpuBuffer(device, seeded);
+    auto solution = gpuBuffer(device, seeded);
+    auto gpuStates = gpuBuffer(device, states);
+    auto alpha = gpuBuffer(device, std::vector<float>(3u, 0.125f));
+    auto changed = gpuBuffer(device, std::vector<unsigned>(3u, 99u));
+    auto valid = gpuBuffer(device, std::vector<unsigned>{1u, 1u, 0u});
+    auto lines = gpuBuffer(device, std::vector<nm_float4>(6u, {0.25f, 2, 3, 4}));
+    auto encode = [&](unsigned phase) {
+        auto command = [queue commandBuffer];
+        auto encoder = [command computeCommandEncoder];
+        [encoder setComputePipelineState:pipe];
+        [encoder setBytes:&dispatch length:sizeof(dispatch) atIndex:0u];
+        [encoder setBytes:&layout length:sizeof(layout) atIndex:1u];
+        id<MTLBuffer> buffers[] = {rhs, basis, preconditioned, solution,
+                                  gpuStates, alpha, changed, valid};
+        for (unsigned i = 0; i < 8u; ++i)
+            [encoder setBuffer:buffers[i] offset:0 atIndex:2u + i];
+        [encoder setBytes:&phase length:sizeof(phase) atIndex:10u];
+        [encoder setBuffer:lines offset:0 atIndex:11u];
+        [encoder dispatchThreads:MTLSizeMake(32, 1, 1)
+            threadsPerThreadgroup:MTLSizeMake(32, 1, 1)];
+        [encoder endEncoding];
+        [command commit]; [command waitUntilCompleted];
+        need(command.status == MTLCommandBufferStatusCompleted,
+             "Newton block gate GPU execution failed");
+    };
+    encode(0x80000000u);
+    auto* after = static_cast<NMFGMRESStateGPU*>(gpuStates.contents);
+    need(after[0].diagnostics.z == 0 && after[1].diagnostics.z == 1 &&
+         after[2].diagnostics.z == 0,
+         "outer gate confused inner and nonlinear convergence");
+    for (unsigned e = 0; e < 3u; ++e)
+        need(std::memcmp(&after[e].nonlinear, &initialStates[e].nonlinear,
+                         sizeof(nm_float4)) == 0, "outer Newton history changed");
+    need(std::memcmp(solution.contents, zeros.data(), zeros.size()*sizeof(nm_float4)) == 0,
+         "predictor scratch did not clear all correction domains");
+    std::memcpy(preconditioned.contents, seeded.data(), seeded.size()*sizeof(nm_float4));
+    encode(0x80000001u);
+    auto* correction = static_cast<nm_float4*>(solution.contents);
+    need(correction[12].x == seeded[12].x && correction[13].x == seeded[13].x,
+         "active local block direction was suppressed");
+    for (unsigned i = 14; i < 18; ++i)
+        need(correction[i].x == 0, "completed or invalid block correction leaked");
+    encode(0x80000002u);
+    auto* gates = static_cast<unsigned*>(changed.contents);
+    need(gates[0] == 0 && gates[1] == 2 && gates[2] == 2,
+         "completed/invalid local block was not deferred");
+    encode(0x80000003u);
+    auto* alphas = static_cast<float*>(alpha.contents);
+    auto* objectLines = static_cast<nm_float4*>(lines.contents);
+    for (unsigned e = 0; e < 3; ++e) need(alphas[e] == 1, "shared alpha not reset");
+    for (unsigned i = 0; i < 6; ++i)
+        need(objectLines[i].x == 1 && objectLines[i].y == 2 &&
+             objectLines[i].z == 3 && objectLines[i].w == 4,
+             "object alpha reset changed line-search diagnostics");
+    encode(0u);
+    need(after[1].diagnostics.z == 0,
+         "legacy initial predictor unexpectedly inherited an outer latch");
+    std::cout << "vascular_newton_block_relaxation_gates=pass "
+        "inner_vs_outer_latch=pass invalid_factor=pass all_domain_clear=pass "
+        "history=bitwise legacy_initial_predictor=unchanged\n";
+}
