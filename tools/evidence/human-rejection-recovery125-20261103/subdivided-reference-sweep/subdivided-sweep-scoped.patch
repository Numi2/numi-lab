+// Project ORIGINAL endpoint expansions, then interpolate their outward
+// intervals. Interpolated positions are used only to choose an arbitrary axis,
+// never as proof inputs. This avoids losing the low words at subdivision cuts.
+inline bool nmReferenceContactIntervalPlaneSeparated(
+    uint kind,thread const MRCompensatedPositionGPU* start,
+    thread const MRCompensatedPositionGPU* finish,
+    MRCompensatedPositionGPU axis,float thickness,float lo,float hi) {
+    uint firstCount=1u,secondBegin=1u,secondCount=1u;
+    if(kind==NM_DEFORMABLE_CONTACT_VERTEX_TRIANGLE)secondCount=3u;
+    else if(kind==NM_DEFORMABLE_CONTACT_EDGE_EDGE){firstCount=2u;secondBegin=2u;secondCount=2u;}
+    else if(kind!=NM_DEFORMABLE_CONTACT_POINT_POINT)return false;
+    float normSquaredUpper=0.0f;
+    for(uint j=0u;j<3u;++j) {
+        if(!isfinite(axis.high[j])||!isfinite(axis.low[j]))return false;
+        const float bound=nmContactIntervalUp(abs(axis.high[j])+abs(axis.low[j]));
+        normSquaredUpper=nmContactIntervalUp(normSquaredUpper+nmContactIntervalUp(bound*bound));
+    }
+    const float normUpper=nmContactIntervalUp(sqrt(normSquaredUpper));
+    const float threshold=nmContactIntervalUp(thickness*normUpper);
+    if(!(normUpper>0.0f)||!isfinite(normUpper)||!isfinite(threshold))return false;
+    for(uint a=0u;a<firstCount;++a)for(uint b=secondBegin;b<secondBegin+secondCount;++b) {
+        const auto p=nmContactIntervalAdd(
+            nmContactProjectionIntervalRefined(start[a],start[b],axis.high.xyz),
+            nmContactProjectionInterval(start[a],start[b],axis.low.xyz));
+        const auto q=nmContactIntervalAdd(
+            nmContactProjectionIntervalRefined(finish[a],finish[b],axis.high.xyz),
+            nmContactProjectionInterval(finish[a],finish[b],axis.low.xyz));
+        if(!isfinite(p.lower)||!isfinite(p.upper)||!isfinite(q.lower)||!isfinite(q.upper))
+            return false;
+        for(uint endpoint=0u;endpoint<2u;++endpoint) {
+            // lo/hi are exactly represented dyadic fractions; so is 1-t.
+            const float t=endpoint==0u?lo:hi;
+            const auto value=nmContactIntervalAdd(nmContactIntervalScale(p,1.0f-t),
+                                                  nmContactIntervalScale(q,t));
+            if(!isfinite(value.lower)||!(value.lower>threshold))return false;
+        }
+    }
+    return true;
+}
