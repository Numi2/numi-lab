+// First use, any motion, reset or nonfinite input takes the full query.
+kernel void nm_numi_human_prepare_contact_motion_cache(
+    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch [[buffer(0)]],
+    device const NMFEMNodeStateGPU* nodes [[buffer(1)]],
+    device const MRArticulatedBodyPoseGPU* poses [[buffer(2)]],
+    device float4* oldPositions [[buffer(3)]],
+    device float4* oldPoseWords [[buffer(4)]],
+    device uint* flags [[buffer(5)]],
+    uint global [[thread_position_in_grid]]
+) {
+    const uint nodeCount = dispatch.environmentCount * dispatch.femNodeCount;
+    const uint poseCount = dispatch.environmentCount * dispatch.bodyPoseStride;
+    if (global < nodeCount) {
+        const float4 current = nodes[global].positionAndMass;
+        const bool same = (flags[global] & 1u) != 0u &&
+            all(as_type<uint4>(current) == as_type<uint4>(oldPositions[global])) &&
+            finite4(current);
+        oldPositions[global] = current;
+        flags[global] = same ? 3u : 1u;
+    } else if (global - nodeCount < poseCount) {
+        const uint pose = global - nodeCount;
+        const auto current = poses[pose];
+        const bool same = (flags[global] & 1u) != 0u &&
+            all(as_type<uint4>(current.position) == as_type<uint4>(oldPoseWords[2u*pose])) &&
+            all(as_type<uint4>(current.orientation) == as_type<uint4>(oldPoseWords[2u*pose+1u])) &&
+            finite4(current.position) && finite4(current.orientation);
+        oldPoseWords[2u*pose] = current.position;
+        oldPoseWords[2u*pose+1u] = current.orientation;
+        flags[global] = same ? 3u : 1u;
+    }
+}
