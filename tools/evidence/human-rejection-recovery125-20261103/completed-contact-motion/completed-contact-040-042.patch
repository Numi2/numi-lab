+inline bool humanBodyContactCertifiedZeroRow(
+    const uint global,
+    constant NMNumiHumanTendonFEMLoadDispatchGPU& d,
+    device const NMNumiHumanFEMBodyContactSampleGPU* samples,
+    device const NMNumiHumanFEMBodyContactNeighborhoodRangeGPU* ranges,
+    device const NMNumiHumanFEMBodyContactBVHNodeGPU* trees,
+    device const NMFEMNodeStateGPU* nodes,
+    device const MRArticulatedBodyPoseGPU* poses,
+    thread float4& row
+) {
+    if (d.abiVersion!=NM_NUMI_HUMAN_TENDON_FEM_LOAD_ABI_VERSION ||
+        d.femBodyContactSampleCount==0u ||
+        d.femBodyContactCandidateTriangleCount==0u) return false;
+    const uint env=global/d.femBodyContactSampleCount;
+    const uint i=global-env*d.femBodyContactSampleCount;
+    const auto sample=samples[i];
+    if (sample.slaveNode>=d.femNodeCount || !validBody(sample.bodyIndex,d) ||
+        sample.flags!=(NM_NUMI_HUMAN_FEM_BODY_CONTACT_ACTIVE |
+            NM_NUMI_HUMAN_FEM_BODY_CONTACT_TRIANGLE_CONTACT) ||
+        sample.reserved0!=0u || !finite4(sample.bodyLocalPointAndArea) ||
+        !finite4(sample.bodyLocalNormalAndReferenceSeparation) ||
+        !finite4(sample.stiffnessAndNormalStrainPerPressure)) return false;
+    const auto range=ranges[i];
+    if (range.reserved0!=NM_NUMI_HUMAN_FEM_BODY_CONTACT_NEIGHBORHOOD_STATIC_CLOSED_ORIENTED_BVH ||
+        range.triangleCount==0u || range.firstTriangle>NM_INVALID_INDEX-range.triangleCount ||
+        any(range.restPointAndMotionRadius!=float4(0.0f)) ||
+        !isfinite(range.maximumDistanceMeters) ||
+        range.maximumDistanceMeters<=0.0f || range.maximumDistanceMeters>0.05f)
+        return false;
+    const auto node=nodes[env*d.femNodeCount+sample.slaveNode];
+    const auto pose=poses[env*d.bodyPoseStride+sample.bodyIndex-d.articulationFirstBody];
+    if (!finite4(node.positionAndMass) || !finite4(pose.position) ||
+        !finite4(pose.orientation) || abs(length(pose.orientation)-1.0f)>1.0e-5f)
+        return false;
+    const float3 query=humanQuaternionRotate(humanQuaternionConjugate(pose.orientation),
+        node.positionAndMass.xyz-pose.position.xyz);
+    if (!finite4(float4(query,0.0f))) return false;
+    const auto root=trees[range.firstTriangle];
+    const uint end=range.firstTriangle+range.triangleCount;
+    if (!finite4(root.boundsMinimum) || !finite4(root.boundsMaximum) ||
+        root.boundsMinimum.w!=0.0f || root.boundsMaximum.w!=0.0f ||
+        any(root.boundsMinimum.xyz>root.boundsMaximum.xyz) ||
+        root.escapeIndex!=end || root.reserved0!=0u ||
+        (root.flags!=NM_NUMI_HUMAN_FEM_BODY_CONTACT_BVH_NODE_LEAF && root.flags!=0u) ||
+        (root.flags==0u ? root.triangleIndex!=NM_INVALID_INDEX || range.triangleCount<3u
+            : root.triangleIndex>=d.femBodyContactCandidateTriangleCount || range.triangleCount!=1u))
+        return false;
+    const float3 delta=max(max(root.boundsMinimum.xyz-query,
+        query-root.boundsMaximum.xyz),float3(0.0f));
+    const float distanceSquared=dot(delta,delta);
+    const float guard=32.0f*1.1920928955078125e-7f*max(1.0f,dot(query,query));
+    if (!isfinite(distanceSquared) || !isfinite(guard) ||
+        !(distanceSquared>guard) || sample.bodyLocalPointAndArea.w<0.0f)
+        return false;
+    // Retain the original arithmetic, including signed zero components.
+    const float3 normal=humanQuaternionRotate(pose.orientation,delta*rsqrt(distanceSquared));
+    const float pressure=sample.bodyLocalNormalAndReferenceSeparation.w*0.0f;
+    row=float4(normal*(pressure*sample.bodyLocalPointAndArea.w),0.0f);
+    return finite4(row);
+}
