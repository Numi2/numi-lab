+void checkCompactedHumanContactQueries(
+    id<MTLDevice> device,id<MTLCommandQueue> queue,id<MTLLibrary> library) {
+    auto classify=pipeline(device,library,"numi_matter_metal::nm_numi_human_classify_contact_queries");
