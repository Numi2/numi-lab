+inline uint humanContactTileSum(uint value,uint lane,threadgroup uint* groupSums) {
+    const uint sum=simd_sum(value);
+    if ((lane&31u)==0u) groupSums[lane>>5u]=sum;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    return simd_sum(lane<8u ? groupSums[lane] : 0u);
+}
+inline uint humanContactTilePrefix(uint value,uint lane,threadgroup uint* groupSums) {
+    const uint prefix=simd_prefix_exclusive_sum(value);
+    const uint sum=simd_sum(value);
+    if ((lane&31u)==0u) groupSums[lane>>5u]=sum;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    uint groupPrefix=0u;
+    for (uint g=0u;g<(lane>>5u);++g) groupPrefix+=groupSums[g];
+    return groupPrefix+prefix;
+}
+// Validation tag 2 is private pending-query scratch. Every pending row is
+// consumed by the exact validator before the ordinary validation reduction.
+kernel void nm_numi_human_classify_contact_queries(
+    constant NMNumiHumanTendonFEMLoadDispatchGPU& d [[buffer(0)]],
+    device const NMNumiHumanFEMBodyContactSampleGPU* samples [[buffer(1)]],
+    device const NMNumiHumanFEMBodyContactNeighborhoodRangeGPU* ranges [[buffer(2)]],
+    device const NMNumiHumanFEMBodyContactBVHNodeGPU* trees [[buffer(3)]],
+    device const NMFEMNodeStateGPU* nodes [[buffer(4)]],
+    device const MRArticulatedBodyPoseGPU* poses [[buffer(5)]],
+    device const uint* motionFlags [[buffer(6)]],
+    device uint* valid [[buffer(7)]],
+    device float4* rows [[buffer(8)]],
+    device uint2* tileRanges [[buffer(9)]],
+    uint global [[thread_position_in_grid]],uint lane [[thread_index_in_threadgroup]],
+    uint tile [[threadgroup_position_in_grid]]
+) {
+    const uint total=d.environmentCount*d.femBodyContactSampleCount;
+    uint pending=0u;
+    if (global<total) {
+        const uint env=global/d.femBodyContactSampleCount;
+        const auto sample=samples[global%d.femBodyContactSampleCount];
+        const bool reuse=d.abiVersion==NM_NUMI_HUMAN_TENDON_FEM_LOAD_ABI_VERSION &&
+            sample.slaveNode<d.femNodeCount && validBody(sample.bodyIndex,d) &&
+            motionFlags[env*d.femNodeCount+sample.slaveNode]==3u &&
+            motionFlags[d.environmentCount*d.femNodeCount+env*d.bodyPoseStride+
+                sample.bodyIndex-d.articulationFirstBody]==3u;
+        float4 zeroRow;
+        if (reuse) {
+            // An already invalid row stays invalid; no failed state is hidden.
+        } else if (humanBodyContactCertifiedZeroRow(global,d,samples,ranges,trees,nodes,poses,zeroRow)) {
+            rows[global]=zeroRow;valid[global]=1u;
+        } else {
+            pending=1u;valid[global]=2u;
+        }
+    }
+    threadgroup uint sums[8];
+    const uint count=humanContactTileSum(pending,lane,sums);
+    if(lane==0u)tileRanges[tile]=uint2(count,0u);
+}
+kernel void nm_numi_human_scan_contact_query_tiles(
+    constant NMNumiHumanTendonFEMLoadDispatchGPU& d [[buffer(0)]],
+    device uint2* tiles [[buffer(1)]],device uint* blockSums [[buffer(2)]],
+    uint global [[thread_position_in_grid]],uint lane [[thread_index_in_threadgroup]],
+    uint block [[threadgroup_position_in_grid]]
+) {
+    const uint total=d.environmentCount*d.femBodyContactSampleCount;
+    const uint tileCount=(total+255u)/256u;
+    const uint value=global<tileCount?tiles[global].x:0u;
+    threadgroup uint sums[8];
+    const uint prefix=humanContactTilePrefix(value,lane,sums);
+    if(global<tileCount)tiles[global].y=prefix;
+    if(lane==255u)blockSums[block]=prefix+value;
+}
+kernel void nm_numi_human_scan_contact_query_blocks(
+    constant NMNumiHumanTendonFEMLoadDispatchGPU& d [[buffer(0)]],
+    device const uint* blockSums [[buffer(1)]],device uint* blockOffsets [[buffer(2)]],
+    device NMIndirectDispatchGPU* work [[buffer(3)]],
+    uint lane [[thread_index_in_threadgroup]]
+) {
+    const uint total=d.environmentCount*d.femBodyContactSampleCount;
+    const uint blocks=(((total+255u)/256u)+255u)/256u;
+    // At most UINT32_MAX rows => at most 65536 blocks. Scan them in
+    // cooperative 256-block batches; no per-row or per-tetrahedron serial scan.
+    threadgroup uint sums[8];
+    threadgroup uint carry;
+    if(lane==0u)carry=0u;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for(uint first=0u;first<blocks;first+=256u) {
+        const uint index=first+lane;
+        const uint value=index<blocks?blockSums[index]:0u;
+        const uint prefix=humanContactTilePrefix(value,lane,sums);
+        const uint base=carry;
+        if(index<blocks)blockOffsets[index]=base+prefix;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if(lane==255u)carry=base+prefix+value;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    if(lane==0u)work[0]={carry/256u+uint(carry%256u!=0u),1u,1u,carry};
+}
+kernel void nm_numi_human_scatter_contact_queries(
+    constant NMNumiHumanTendonFEMLoadDispatchGPU& d [[buffer(0)]],
+    device const uint* valid [[buffer(1)]],device const uint2* tiles [[buffer(2)]],
+    device const uint* blockOffsets [[buffer(3)]],device uint* indices [[buffer(4)]],
