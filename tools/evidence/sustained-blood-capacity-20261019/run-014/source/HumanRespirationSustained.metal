    mr_u32 qualityLineSearchBacktracks;
    mr_u32 qualitySolvePath;

    // impulse delta, normal residual, cone violation, factor residual.
    mr_float4 residuals;
    // manifold retention, maximum penetration, minimum pivot, maximum pivot.
