static_assert(sizeof(MRHumanRestingVolumeAuditGroupGPU)==16);
static_assert(sizeof(MRHumanRestingVolumeAuditRangeGPU)==16);
static_assert(sizeof(MRHumanRestingVolumeAuditPartialGPU)==16);
#endif

