    mr_u32 dynamicNode;
    mr_u32 localVelocityOffset;
    mr_u32 velocityCount;
    mr_u32 factorIndex;
} MRIslandNodeRefGPU;

// ConstraintIR blocks remain canonical and are never physically reordered.
