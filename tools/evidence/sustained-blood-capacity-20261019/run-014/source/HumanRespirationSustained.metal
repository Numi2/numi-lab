    mr_float4 row1;
    mr_float4 row2;
} MRWave32PreconditionerGPU;

typedef struct MR_ALIGN16 MRWave32IslandStatusGPU {
    mr_u32 code;
    mr_u32 environment;
    mr_u32 islandIndex;
    mr_u32 iterations;

