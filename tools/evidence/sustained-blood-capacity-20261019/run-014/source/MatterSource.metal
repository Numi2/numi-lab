// restAndFixed.w is a small, versioned constraint tag rather than a boolean:
// 0 = free, 1 = authored static Dirichlet, 2 = moving Human attachment,
// 3 = temporary pure-FEM kinematic grip. Grip tag 3 is eliminated from the
// nodal unknowns like a static boundary, but unlike tag 1 it is acquired and
// released only through the accepted/candidate FEM transaction.
// A Human attachment is eliminated from Matter's nodal unknowns, but its
// unconstrained residual/operator row remains physically meaningful because
// the reduced articulated row owns J^T r and J^T A J.
inline bool femStaticConstraint(const float marker) {
    return marker == 1.0f || marker == 3.0f;
}

inline bool femAuthoredStaticConstraint(const float marker) {
    return marker == 1.0f;
}

inline bool femTemporaryKinematicGrip(const float marker) {
    return marker == 3.0f;
}

inline bool femHumanAttachmentConstraint(const float marker) {
    return marker == 2.0f;
}

struct NMPrimalContactArguments {
    device const NMContactPairGPU* pairs [[id(0)]];
    device const NMContactSampleGPU* samples [[id(1)]];
    device const uint* nodeIncidence [[id(2)]];
    device const NMIncidenceRangeGPU* nodeRanges [[id(3)]];
    device const uint* activePairs [[id(4)]];
    device const uint* activeSlotsByPair [[id(5)]];
    device const uint* activeCounts [[id(6)]];
    device NMDeformableContactGPU* deformableContacts [[id(7)]];
    device const uint* deformableNodeIncidence [[id(8)]];
    device const NMIncidenceRangeGPU* deformableNodeRanges [[id(9)]];
    device const uint* mpmNodeToActive [[id(10)]];
    device const uint* mpmActiveNodeCounts [[id(11)]];
    device const NMRigidProxyGPU* rigidProxies [[id(12)]];
    device const NMRigidStateGPU* rigidStates [[id(13)]];
    device const uint* deformableActiveCounts [[id(14)]];
    // 0 = canonical dense samples; 1 = active samples addressed through the
    // canonical pair->active-slot map after complete page enumeration.
    device const uint* sampleStorageMode [[id(15)]];
    device const uint* samplePageComplete [[id(16)]];
    // Dense mode ignores these; compact mode keeps pair->sample-slot separate
    // from the canonical active-pair iteration list.
    device const uint* sampleSlotsByPair [[id(17)]];
    device const uint* sampleCounts [[id(18)]];
    device const uint* sampleCapacity [[id(19)]];
};

inline NMContactSampleGPU contactSampleAt(
    const NMMatterDispatchGPU dispatch,
    device const NMContactSampleGPU* samples,
    device const uint* sampleStorageMode,
    device const uint* samplePageComplete,
    device const uint* sampleSlotsByPair,
    device const uint* sampleCounts,
    device const uint* sampleCapacity,
    const uint environment,
    const uint pairIndex
) {
    NMContactSampleGPU zero{};
    if (environment >= dispatch.environmentCount ||
        pairIndex >= dispatch.contactPairCount)
        return zero;
    const uint mode = sampleStorageMode[0];
    if (mode == 0u)
        return samples[environment * dispatch.contactPairCount + pairIndex];
    if (mode != 1u || samplePageComplete[environment] != 1u)
        return zero;
    const uint capacity = sampleCapacity[0];
    const uint count = min(sampleCounts[environment], capacity);
    const uint slot = sampleSlotsByPair[
        environment * dispatch.contactPairCount + pairIndex];
    if (capacity == 0u || slot == NM_INVALID_INDEX || slot >= count)
        return zero;
    return samples[environment * capacity + slot];
}

inline NMContactSampleGPU primalContactSample(
    const NMMatterDispatchGPU dispatch,
    constant NMPrimalContactArguments& contact,
    const uint environment,
    const uint pairIndex
) {
    return contactSampleAt(
        dispatch, contact.samples, contact.sampleStorageMode,
        contact.samplePageComplete, contact.sampleSlotsByPair,
        contact.sampleCounts, contact.sampleCapacity,
        environment, pairIndex);
}

// Reflection-only anchor for the monolithic contact argument table. Runtime
// obtains its MTLArgumentEncoder from this function but never dispatches it.
// Reading every member prevents Metal from pruning bindings that are consumed
// only by a subset of the KKT kernels.
kernel void nm_primal_contact_argument_layout(
    constant NMPrimalContactArguments& contact [[buffer(0)]],
    device uint* sink [[buffer(1)]],
    uint global [[thread_position_in_grid]]
) {
    if (global != 0u) return;
    uint checksum = 0u;
    checksum ^= reinterpret_cast<device const uint*>(contact.pairs)[0];
    checksum ^= reinterpret_cast<device const uint*>(contact.samples)[0];
    checksum ^= contact.nodeIncidence[0];
    checksum ^= reinterpret_cast<device const uint*>(contact.nodeRanges)[0];
    checksum ^= contact.activePairs[0];
    checksum ^= contact.activeSlotsByPair[0];
    checksum ^= contact.activeCounts[0];
    checksum ^=
        reinterpret_cast<device const uint*>(contact.deformableContacts)[0];
    checksum ^= contact.deformableNodeIncidence[0];
    checksum ^=
        reinterpret_cast<device const uint*>(contact.deformableNodeRanges)[0];
    checksum ^= contact.mpmNodeToActive[0];
    checksum ^= contact.mpmActiveNodeCounts[0];
    checksum ^=
        reinterpret_cast<device const uint*>(contact.rigidProxies)[0];
    checksum ^=
        reinterpret_cast<device const uint*>(contact.rigidStates)[0];
    checksum ^= contact.sampleStorageMode[0];
    checksum ^= contact.samplePageComplete[0];
    checksum ^= contact.sampleSlotsByPair[0];
    checksum ^= contact.sampleCounts[0];
    checksum ^= contact.sampleCapacity[0];
    checksum ^= contact.deformableActiveCounts[0];
    sink[0] = checksum;
}

inline void deformableContactFrame(
    const float3 normal,
    thread float3& tangent0,
    thread float3& tangent1
) {
    const float3 axis = abs(normal.x) < 0.57735026919f
        ? float3(1.0f, 0.0f, 0.0f)
        : (abs(normal.y) < 0.57735026919f
            ? float3(0.0f, 1.0f, 0.0f)
            : float3(0.0f, 0.0f, 1.0f));
    tangent0 = normalize(cross(normal, axis));
    tangent1 = cross(normal, tangent0);
}

inline float3 deformableMollifierGradient(
    const NMDeformableContactGPU contact,
    const uint local
) {
    if (local == 0u) return contact.mollifierGradientRow0.xyz;
    if (local == 1u) return contact.mollifierGradientRow1.xyz;
    if (local == 2u) return contact.mollifierGradientRow2.xyz;
    if (local == 3u) return contact.mollifierGradientRow3.xyz;
    if (local == 4u) return contact.mollifierGradientRow4.xyz;
    return contact.mollifierGradientRow5.xyz;
}

inline uint deformableContactNode(
    const NMDeformableContactGPU contact,
    const uint local
) {
    if (local < 4u) return contact.nodes[local];
    if (local == 4u) return contact.extraNodes.x;
    return contact.extraNodes.y;
}

inline float deformableContactWeight(
    const NMDeformableContactGPU contact,
    const uint local
) {
    if (local < 4u) return contact.weights[local];
    if (local == 4u) return contact.extraWeights.x;
    return contact.extraWeights.y;
}

inline float deformableContactTimeScale(
    const NMDeformableContactGPU contact,
    const uint local
) {
    if (local < 4u) return contact.timeScales[local];
    if (local == 4u) return contact.extraTimeScales.x;
    return contact.extraTimeScales.y;
}

