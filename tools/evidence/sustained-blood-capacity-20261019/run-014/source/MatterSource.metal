} NMRigidStateGPU;

typedef struct NM_ALIGN16 NMContactPairGPU {
    // Unified node index: MPM nodes first, then FEM nodes.
    nm_u32 continuumNode;
    nm_u32 rigidProxy;
    nm_u32 objectIndex;
