    // joint-side torque constant N*m/A, current limit A,
    // no-load speed rad/s (or m/s), efficiency [0,1].
    mr_float4 motorAndSpeed;
    // backlash play in joint units, command delay seconds,
    // cooked stall torque N*m (or N), reserved.
