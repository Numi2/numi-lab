kernel void nm_numi_human_assemble_tendon_fem_loads(
    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch [[buffer(0)]],
    device const NMNumiHumanTendonFEMNodeLoadGPU* nodeLoads [[buffer(1)]],
    device const MRNumiHumanTendonTransferResultGPU* transfers [[buffer(2)]],
    device float4* externalForces [[buffer(3)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.femNodeCount;
    if (global >= total) return;
    const uint environment = global / dispatch.femNodeCount;
    const uint node = global - environment * dispatch.femNodeCount;
    externalForces[global] = float4(0.0f);
    const NMNumiHumanTendonFEMNodeLoadGPU load = nodeLoads[node];
    if (!all(isfinite(load.scale))) return;
    float3 force = float3(0.0f);
    for (uint slot = 0u; slot < 4u; ++slot) {
        const uint endpoint = load.endpointIndex[slot];
        const float scale = load.scale[slot];
        if (endpoint == NM_INVALID_INDEX || scale == 0.0f) continue;
        if (endpoint >= dispatch.endpointCount) return;
        const MRNumiHumanTendonTransferResultGPU transfer = transfers[
            environment * dispatch.transferStride + endpoint
        ];
        if (transfer.status != MR_NUMI_HUMAN_TENDON_TRANSFER_SUCCESS ||
            transfer.environment != environment ||
            transfer.bindingIndex != endpoint ||
            !all(isfinite(transfer.terminalWorldForce))) return;
        // terminalWorldForce is the action on the load-side bone. The
        // continuum receives its equal-and-opposite force. Endpoint mode
        // retains the body's load-side J^T reaction; full-row mode restores
        // that reaction explicitly after removing the complete source row.
        // A declared negative distal-couple scale reverses this action at the
        // opposing attachment, giving the two entheses zero net force.
        force -= scale * transfer.terminalWorldForce.xyz;
    }
    externalForces[global] = float4(force, 0.0f);
}

kernel void nm_numi_human_assemble_internal_fem_contact_loads(
    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch [[buffer(0)]],
    device const NMNumiHumanFEMContactSampleGPU* samples [[buffer(1)]],
    device const NMNumiHumanFEMContactContributionGPU* contributions
        [[buffer(2)]],
    device const NMIncidenceRangeGPU* ranges [[buffer(3)]],
    device const NMFEMNodeStateGPU* acceptedNodes [[buffer(4)]],
    device float4* externalForces [[buffer(5)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.femNodeCount;
    if (global >= total || dispatch.femContactSampleCount == 0u) return;
    const uint environment = global / dispatch.femNodeCount;
    const uint node = global - environment * dispatch.femNodeCount;
    const uint nodeBase = environment * dispatch.femNodeCount;
    const NMIncidenceRangeGPU range = ranges[node];
    float3 nodeForce = float3(0.0f);
    for (uint local = 0u; local < range.count; ++local) {
        const NMNumiHumanFEMContactContributionGPU contribution =
            contributions[range.first + local];
        if (contribution.sampleIndex >= dispatch.femContactSampleCount ||
            contribution.role > 3u || contribution.reserved0 != 0u ||
            contribution.reserved1 != 0u) return;
        const NMNumiHumanFEMContactSampleGPU sample =
            samples[contribution.sampleIndex];
        const float3 weights =
            sample.barycentricAndReferenceSeparation.xyz;
        const float3 normal = sample.normalAndArea.xyz;
        const float3 slave = acceptedNodes[
            nodeBase + sample.slaveNode].positionAndMass.xyz;
        const float3 master =
            weights.x * acceptedNodes[
                nodeBase + sample.masterNode0].positionAndMass.xyz +
            weights.y * acceptedNodes[
                nodeBase + sample.masterNode1].positionAndMass.xyz +
            weights.z * acceptedNodes[
                nodeBase + sample.masterNode2].positionAndMass.xyz;
        const float separation = dot(slave - master, normal);
        // One tenth of a micron prevents an artificial preload caused only by
        // FP32 reconstruction of a preload-free reference correspondence.
        const float closure = max(
            0.0f,
            sample.barycentricAndReferenceSeparation.w - separation - 1.0e-7f
        );
        const float pressure = sample.stiffness.x * closure;
        const float3 sampleForce =
            normal * (pressure * sample.normalAndArea.w);
        const float contributionWeight = contribution.role == 0u
            ? 1.0f : -weights[contribution.role - 1u];
        nodeForce += contributionWeight * sampleForce;
    }
    externalForces[global].xyz += nodeForce;
}

kernel void nm_numi_human_assemble_fem_body_contact_loads(
    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch [[buffer(0)]],
    device const NMNumiHumanFEMBodyContactSampleGPU* samples [[buffer(1)]],
    device const NMFEMNodeStateGPU* acceptedNodes [[buffer(2)]],
    device const MRArticulatedBodyPoseGPU* bodyPoses [[buffer(3)]],
    device float4* externalForces [[buffer(4)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.femNodeCount;
    if (global >= total || dispatch.femBodyContactSampleCount == 0u) return;
    const uint environment = global / dispatch.femNodeCount;
    const uint node = global - environment * dispatch.femNodeCount;
    const uint nodeBase = environment * dispatch.femNodeCount;
    const uint poseBase = environment * dispatch.bodyPoseStride;
    float3 nodeForce = float3(0.0f);
    for (uint index = 0u; index < dispatch.femBodyContactSampleCount; ++index) {
        const NMNumiHumanFEMBodyContactSampleGPU sample = samples[index];
        if (sample.slaveNode != node || !validBody(sample.bodyIndex, dispatch))
            continue;
        float3 slavePoint;
        float3 bodyPoint;
        float3 normal;
        float closure;
        if (!humanFEMBodyContactState(
                sample, acceptedNodes[nodeBase + node],
                bodyPoses[poseBase + sample.bodyIndex -
                    dispatch.articulationFirstBody],
                slavePoint, bodyPoint, normal, closure)) return;
        const float pressure =
            sample.stiffnessAndNormalStrainPerPressure.x * closure;
        nodeForce += normal * (pressure * sample.bodyLocalPointAndArea.w);
    }
    externalForces[global].xyz += nodeForce;
}

kernel void nm_numi_human_assemble_fem_body_contact_wrenches(
    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch [[buffer(0)]],
    device const NMNumiHumanFEMBodyContactSampleGPU* samples [[buffer(1)]],
    device const NMFEMNodeStateGPU* acceptedNodes [[buffer(2)]],
    device const MRArticulatedBodyPoseGPU* bodyPoses [[buffer(3)]],
    device NMNumiHumanBodyWrenchGPU* bodyWrenches [[buffer(4)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.bodyPoseStride;
    if (global >= total || dispatch.femBodyContactSampleCount == 0u) return;
    const uint environment = global / dispatch.bodyPoseStride;
    const uint localBody = global - environment * dispatch.bodyPoseStride;
    const uint bodyIndex = dispatch.articulationFirstBody + localBody;
    const uint nodeBase = environment * dispatch.femNodeCount;
    const uint poseBase = environment * dispatch.bodyPoseStride;
    const MRArticulatedBodyPoseGPU bodyPose = bodyPoses[poseBase + localBody];
    float3 force = float3(0.0f);
    float3 torque = float3(0.0f);
    for (uint index = 0u; index < dispatch.femBodyContactSampleCount; ++index) {
        const NMNumiHumanFEMBodyContactSampleGPU sample = samples[index];
        if (sample.bodyIndex != bodyIndex ||
            sample.slaveNode >= dispatch.femNodeCount) continue;
        float3 slavePoint;
        float3 bodyPoint;
        float3 normal;
        float closure;
        if (!humanFEMBodyContactState(
                sample, acceptedNodes[nodeBase + sample.slaveNode], bodyPose,
                slavePoint, bodyPoint, normal, closure)) return;
        const float pressure =
            sample.stiffnessAndNormalStrainPerPressure.x * closure;
        const float3 ownedForce =
            -normal * (pressure * sample.bodyLocalPointAndArea.w);
        force += ownedForce;
        torque += cross(bodyPoint - bodyPose.position.xyz, ownedForce);
    }
    bodyWrenches[global].force = float4(force, 0.0f);
    bodyWrenches[global].torque = float4(torque, 0.0f);
}

kernel void nm_numi_human_audit_fem_body_contact(
    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch [[buffer(0)]],
    device const NMNumiHumanFEMBodyContactSampleGPU* samples [[buffer(1)]],
    device const NMFEMNodeStateGPU* acceptedNodes [[buffer(2)]],
    device const MRArticulatedBodyPoseGPU* bodyPoses [[buffer(3)]],
    device NMNumiHumanArticularContactAuditGPU* audits [[buffer(4)]],
    uint environment [[thread_position_in_grid]]
) {
    if (environment >= dispatch.environmentCount) return;
    const uint nodeBase = environment * dispatch.femNodeCount;
    const uint poseBase = environment * dispatch.bodyPoseStride;
    float3 forceResidual = float3(0.0f);
    float3 momentResidual = float3(0.0f);
    float maximumTangentialSlip = 0.0f;
    float maximumPressure = 0.0f;
    float normalForce = 0.0f;
    float contactArea = 0.0f;
    float closedSamples = 0.0f;
    float storedEnergy = 0.0f;
    float maximumNormalStrain = 0.0f;
    float maximumClosure = 0.0f;
    for (uint index = 0u; index < dispatch.femBodyContactSampleCount; ++index) {
        const NMNumiHumanFEMBodyContactSampleGPU sample = samples[index];
        if (sample.slaveNode >= dispatch.femNodeCount ||
            !validBody(sample.bodyIndex, dispatch)) {
            audits[environment].forceResidualAndL1 = float4(NAN);
            return;
        }
        float3 slavePoint;
        float3 bodyPoint;
        float3 normal;
        float closure;
        const MRArticulatedBodyPoseGPU bodyPose = bodyPoses[
            poseBase + sample.bodyIndex - dispatch.articulationFirstBody];
        if (!humanFEMBodyContactState(
                sample, acceptedNodes[nodeBase + sample.slaveNode],
                bodyPose,
                slavePoint, bodyPoint, normal, closure)) {
            audits[environment].forceResidualAndL1 = float4(NAN);
            return;
        }
        if (closure <= 0.0f) continue;
        const float pressure =
            sample.stiffnessAndNormalStrainPerPressure.x * closure;
        const float3 slaveForce =
            normal * (pressure * sample.bodyLocalPointAndArea.w);
        const float3 bodyForce = -slaveForce;
        forceResidual += slaveForce + bodyForce;
        momentResidual += cross(slavePoint, slaveForce) +
            cross(bodyPoint, bodyForce);
        const float3 planeOrigin = bodyPose.position.xyz +
            humanQuaternionRotate(
                bodyPose.orientation, sample.bodyLocalPointAndArea.xyz);
        maximumTangentialSlip = max(
            maximumTangentialSlip, length(bodyPoint - planeOrigin));
        normalForce += length(slaveForce);
        contactArea += sample.bodyLocalPointAndArea.w;
        closedSamples += 1.0f;
        maximumPressure = max(maximumPressure, pressure);
        storedEnergy += 0.5f * pressure * closure *
            sample.bodyLocalPointAndArea.w;
        maximumNormalStrain = max(
            maximumNormalStrain,
            pressure *
                sample.stiffnessAndNormalStrainPerPressure.y);
        maximumClosure = max(maximumClosure, closure);
    }
    NMNumiHumanArticularContactAuditGPU audit{};
    // w is maximum tangential glide for this sample family; unlike articular
    // audit rows this contact type has analytically balanced force magnitude.
    audit.forceResidualAndL1 =
        float4(forceResidual, maximumTangentialSlip);
    audit.momentResidualAndMaximumPressure =
        float4(momentResidual, maximumPressure);
    audit.normalForceAreaAndCounts =
        float4(normalForce, contactArea, closedSamples,
               float(dispatch.femBodyContactSampleCount));
    audit.energyStrainClosureAndAccepted =
        float4(storedEnergy, maximumNormalStrain, maximumClosure, 0.0f);
    audits[environment] = audit;
}

kernel void nm_numi_human_assemble_articular_contact_wrenches(
    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch [[buffer(0)]],
    device const NMNumiHumanArticularContactSampleGPU* samples [[buffer(1)]],
    device const MRArticulatedBodyPoseGPU* bodyPoses [[buffer(2)]],
    device NMNumiHumanBodyWrenchGPU* bodyWrenches [[buffer(3)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.bodyPoseStride;
    if (global >= total || dispatch.articularContactSampleCount == 0u) return;
    const uint environment = global / dispatch.bodyPoseStride;
    const uint localBody = global - environment * dispatch.bodyPoseStride;
    const uint bodyIndex = dispatch.articulationFirstBody + localBody;
    const uint poseBase = environment * dispatch.bodyPoseStride;
    const MRArticulatedBodyPoseGPU bodyPose = bodyPoses[poseBase + localBody];
    float3 force = float3(0.0f);
    float3 torque = float3(0.0f);
    for (uint index = 0u; index < dispatch.articularContactSampleCount;
         ++index) {
        const NMNumiHumanArticularContactSampleGPU sample = samples[index];
        if (sample.flags != NM_NUMI_HUMAN_ARTICULAR_CONTACT_ACTIVE ||
            (sample.slaveBodyIndex != bodyIndex &&
             sample.masterBodyIndex != bodyIndex)) continue;
        if (!validBody(sample.slaveBodyIndex, dispatch) ||
            !validBody(sample.masterBodyIndex, dispatch)) continue;
        const MRArticulatedBodyPoseGPU slavePose = bodyPoses[
            poseBase + sample.slaveBodyIndex - dispatch.articulationFirstBody];
        const MRArticulatedBodyPoseGPU masterPose = bodyPoses[
            poseBase + sample.masterBodyIndex - dispatch.articulationFirstBody];
        float3 slavePoint;
        float3 masterPoint;
        float3 normal;
        float closure;
        if (!humanArticularContactState(
                sample, slavePose, masterPose, slavePoint, masterPoint,
                normal, closure)) continue;
        const float3 sampleForce = normal * (
            sample.masterLocalTriangle1AndStiffness.w * closure *
            sample.slaveLocalPointAndArea.w);
        const bool slaveOwner = sample.slaveBodyIndex == bodyIndex;
        const float3 ownedForce = slaveOwner ? sampleForce : -sampleForce;
        const float3 ownedPoint = slaveOwner ? slavePoint : masterPoint;
        force += ownedForce;
        torque += cross(ownedPoint - bodyPose.position.xyz, ownedForce);
    }
    bodyWrenches[global].force = float4(force, 0.0f);
    bodyWrenches[global].torque = float4(torque, 0.0f);
}

kernel void nm_numi_human_audit_articular_contact_wrenches(
    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch [[buffer(0)]],
    device const NMNumiHumanArticularContactSampleGPU* samples [[buffer(1)]],
    device const MRArticulatedBodyPoseGPU* bodyPoses [[buffer(2)]],
    device const NMNumiHumanBodyWrenchGPU* bodyWrenches [[buffer(3)]],
    device NMNumiHumanArticularContactAuditGPU* audits [[buffer(4)]],
    uint environment [[thread_position_in_grid]]
) {
    if (environment >= dispatch.environmentCount) return;
    const uint poseBase = environment * dispatch.bodyPoseStride;
    float3 forceResidual = float3(0.0f);
    float3 momentResidual = float3(0.0f);
    float bodyForceL1 = 0.0f;
    for (uint localBody = 0u; localBody < dispatch.bodyPoseStride;
         ++localBody) {
        const NMNumiHumanBodyWrenchGPU wrench =
            bodyWrenches[poseBase + localBody];
        const MRArticulatedBodyPoseGPU pose = bodyPoses[poseBase + localBody];
        forceResidual += wrench.force.xyz;
        momentResidual += wrench.torque.xyz +
            cross(pose.position.xyz, wrench.force.xyz);
        bodyForceL1 += length(wrench.force.xyz);
    }
    float normalForce = 0.0f;
    float contactArea = 0.0f;
    float closedSamples = 0.0f;
    float sameBodySamples = 0.0f;
    float maximumPressure = 0.0f;
    float storedEnergy = 0.0f;
    float maximumNormalStrain = 0.0f;
    float maximumClosure = 0.0f;
    for (uint index = 0u; index < dispatch.articularContactSampleCount;
         ++index) {
        const NMNumiHumanArticularContactSampleGPU sample = samples[index];
        if (sample.flags ==
            NM_NUMI_HUMAN_ARTICULAR_CONTACT_INTERNAL_SAME_BODY) {
            sameBodySamples += 1.0f;
            continue;
        }
        if (sample.flags != NM_NUMI_HUMAN_ARTICULAR_CONTACT_ACTIVE ||
            !validBody(sample.slaveBodyIndex, dispatch) ||
            !validBody(sample.masterBodyIndex, dispatch)) continue;
        const MRArticulatedBodyPoseGPU slavePose = bodyPoses[
            poseBase + sample.slaveBodyIndex - dispatch.articulationFirstBody];
        const MRArticulatedBodyPoseGPU masterPose = bodyPoses[
            poseBase + sample.masterBodyIndex - dispatch.articulationFirstBody];
        float3 slavePoint;
        float3 masterPoint;
        float3 normal;
        float closure;
        if (!humanArticularContactState(
                sample, slavePose, masterPose, slavePoint, masterPoint,
                normal, closure)) continue;
        if (closure <= 0.0f) continue;
        const float pressure =
            sample.masterLocalTriangle1AndStiffness.w * closure;
        normalForce += pressure * sample.slaveLocalPointAndArea.w;
        contactArea += sample.slaveLocalPointAndArea.w;
        closedSamples += 1.0f;
        maximumPressure = max(maximumPressure, pressure);
        storedEnergy += 0.5f * pressure * closure *
            sample.slaveLocalPointAndArea.w;
        maximumNormalStrain = max(
            maximumNormalStrain,
            pressure *
                sample.masterLocalTriangle2AndNormalStrainPerPressure.w);
        maximumClosure = max(maximumClosure, closure);
    }
    audits[environment].forceResidualAndL1 =
        float4(forceResidual, bodyForceL1);
    audits[environment].momentResidualAndMaximumPressure =
        float4(momentResidual, maximumPressure);
    audits[environment].normalForceAreaAndCounts = float4(
        normalForce, contactArea, closedSamples, sameBodySamples);
    audits[environment].energyStrainClosureAndAccepted = float4(
        storedEnergy, maximumNormalStrain, maximumClosure, 0.0f);
}

// Exact source-order pair forces for accepted-state evidence. The final value
// in each row is accumulated sample-by-sample in source order to match the
// independent wrench audit, while the pair vector shares that GPU authority.
kernel void nm_numi_human_audit_articular_contact_pairs(
    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch [[buffer(0)]],
    device const NMNumiHumanArticularContactSampleGPU* samples [[buffer(1)]],
    device const NMIncidenceRangeGPU* pairRanges [[buffer(2)]],
    device const MRArticulatedBodyPoseGPU* bodyPoses [[buffer(3)]],
    device float* pairAudits [[buffer(4)]],
    uint environment [[thread_position_in_grid]]
) {
    if (environment >= dispatch.environmentCount ||
        dispatch.articularContactPairCount == 0u) return;
    const uint pairStride = dispatch.articularContactPairCount + 1u;
    const uint outputBase = environment * pairStride;
    const uint poseBase = environment * dispatch.bodyPoseStride;
    float aggregate = 0.0f;
    for (uint pairIndex = 0u;
         pairIndex < dispatch.articularContactPairCount; ++pairIndex) {
        const NMIncidenceRangeGPU range = pairRanges[pairIndex];
        float pairForce = 0.0f;
        if (range.count == 0u || range.first >
                dispatch.articularContactSampleCount ||
            range.count > dispatch.articularContactSampleCount - range.first) {
            pairAudits[outputBase + pairIndex] = NAN;
            pairAudits[outputBase + dispatch.articularContactPairCount] = NAN;
            return;
        }
        for (uint local = 0u; local < range.count; ++local) {
            const NMNumiHumanArticularContactSampleGPU sample =
                samples[range.first + local];
            if (sample.flags ==
                NM_NUMI_HUMAN_ARTICULAR_CONTACT_INTERNAL_SAME_BODY) {
                continue;
            }
            if (sample.flags != NM_NUMI_HUMAN_ARTICULAR_CONTACT_ACTIVE ||
                !validBody(sample.slaveBodyIndex, dispatch) ||
                !validBody(sample.masterBodyIndex, dispatch)) {
                pairAudits[outputBase + pairIndex] = NAN;
                pairAudits[
                    outputBase + dispatch.articularContactPairCount] = NAN;
                return;
            }
            const MRArticulatedBodyPoseGPU slavePose = bodyPoses[
                poseBase + sample.slaveBodyIndex -
                    dispatch.articulationFirstBody];
            const MRArticulatedBodyPoseGPU masterPose = bodyPoses[
                poseBase + sample.masterBodyIndex -
                    dispatch.articulationFirstBody];
            float3 slavePoint;
            float3 masterPoint;
            float3 normal;
            float closure;
            if (!humanArticularContactState(
                    sample, slavePose, masterPose, slavePoint, masterPoint,
                    normal, closure)) {
                pairAudits[outputBase + pairIndex] = NAN;
                pairAudits[
                    outputBase + dispatch.articularContactPairCount] = NAN;
                return;
            }
            if (closure <= 0.0f) continue;
            const float sampleForce =
                sample.masterLocalTriangle1AndStiffness.w * closure *
                sample.slaveLocalPointAndArea.w;
            pairForce += sampleForce;
            // Ranges are host-validated as contiguous source-order coverage.
            // Preserve the aggregate's FP32 reduction association with the
            // independent wrench audit rather than summing seven pair totals.
            aggregate += sampleForce;
        }
        pairAudits[outputBase + pairIndex] = pairForce;
    }
    pairAudits[outputBase + dispatch.articularContactPairCount] = aggregate;
}

kernel void nm_numi_human_commit_articular_contact_audit(
    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch [[buffer(0)]],
    device const MRNumiHumanStandStatusGPU* standStatuses [[buffer(1)]],
    device const NMNumiHumanArticularContactAuditGPU* provisionalAudits
        [[buffer(2)]],
    device NMNumiHumanArticularContactAuditGPU* acceptedHistory [[buffer(3)]],
    uint environment [[thread_position_in_grid]]
) {
    if (environment >= dispatch.environmentCount ||
        dispatch.stepIndex >=
            NM_NUMI_HUMAN_ARTICULAR_CONTACT_AUDIT_MAX_STEPS) return;
    const MRNumiHumanStandStatusGPU stand = standStatuses[environment];
    if (dispatch.abiVersion != NM_NUMI_HUMAN_TENDON_FEM_LOAD_ABI_VERSION ||
        stand.code != MR_NUMI_HUMAN_STAND_SUCCESS ||
        stand.environment != environment ||
        stand.completedSteps != dispatch.stepIndex + 1u) return;
    NMNumiHumanArticularContactAuditGPU accepted =
        provisionalAudits[environment];
    accepted.energyStrainClosureAndAccepted.w = 1.0f;
    acceptedHistory[
        environment * NM_NUMI_HUMAN_ARTICULAR_CONTACT_AUDIT_MAX_STEPS +
        dispatch.stepIndex] = accepted;
}

kernel void nm_numi_human_commit_articular_contact_pair_audit(
    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch [[buffer(0)]],
    device const MRNumiHumanStandStatusGPU* standStatuses [[buffer(1)]],
    device const float* provisionalPairs [[buffer(2)]],
    device float* acceptedHistory [[buffer(3)]],
    uint environment [[thread_position_in_grid]]
) {
    if (environment >= dispatch.environmentCount ||
        dispatch.articularContactPairCount == 0u ||
        dispatch.stepIndex >=
            NM_NUMI_HUMAN_ARTICULAR_CONTACT_AUDIT_MAX_STEPS) return;
    const MRNumiHumanStandStatusGPU stand = standStatuses[environment];
    if (dispatch.abiVersion != NM_NUMI_HUMAN_TENDON_FEM_LOAD_ABI_VERSION ||
        stand.code != MR_NUMI_HUMAN_STAND_SUCCESS ||
        stand.environment != environment ||
        stand.completedSteps != dispatch.stepIndex + 1u) return;
    const uint stride = dispatch.articularContactPairCount + 1u;
    const uint sourceBase = environment * stride;
    const uint targetBase = (
        environment * NM_NUMI_HUMAN_ARTICULAR_CONTACT_AUDIT_MAX_STEPS +
        dispatch.stepIndex) * stride;
    for (uint value = 0u; value < stride; ++value) {
        acceptedHistory[targetBase + value] =
            provisionalPairs[sourceBase + value];
    }
}

kernel void nm_numi_human_audit_tendon_fem_loads(
    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch [[buffer(0)]],
    device const float4* externalForces [[buffer(1)]],
    device float4* audits [[buffer(2)]],
    uint environment [[thread_position_in_grid]]
) {
    if (environment >= dispatch.environmentCount) return;
    float3 resultant = float3(0.0f);
    float magnitudeL1 = 0.0f;
    const uint base = environment * dispatch.femNodeCount;
    for (uint node = 0u; node < dispatch.femNodeCount; ++node) {
        const float3 force = externalForces[base + node].xyz;
        if (!all(isfinite(force))) {
            audits[environment] = float4(NAN);
            return;
        }
        resultant += force;
        magnitudeL1 += length(force);
    }
    audits[environment] = float4(resultant, magnitudeL1);
}

kernel void nm_numi_human_assemble_fem_kinematic_targets(
    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch [[buffer(0)]],
    device const NMNumiHumanTendonFEMNodeAnchorGPU* anchors [[buffer(1)]],
    device const MRArticulatedBodyPoseGPU* bodyPoses [[buffer(2)]],
    device float4* targets [[buffer(3)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.femNodeCount;
    if (global >= total) return;
    const uint environment = global / dispatch.femNodeCount;
    const uint node = global - environment * dispatch.femNodeCount;
    targets[global] = float4(0.0f);
    const NMNumiHumanTendonFEMNodeAnchorGPU anchor = anchors[node];
    if (anchor.flags != NM_NUMI_HUMAN_TENDON_FEM_NODE_ANCHOR_ACTIVE ||
        !validBody(anchor.bodyIndex, dispatch) ||
        !finite4(anchor.localPoint) || anchor.localPoint.w != 0.0f) return;
    const MRArticulatedBodyPoseGPU pose = bodyPoses[
        environment * dispatch.bodyPoseStride +
        anchor.bodyIndex - dispatch.articulationFirstBody
    ];
    targets[global] = float4(
        pose.position.xyz + humanQuaternionRotate(pose.orientation, anchor.localPoint.xyz),
        1.0f
    );
}

// Capture the exact reaction field consumed by the J^T projection while the
// borrowed Human command buffer still owns the accepted Matter candidate.
// Reading Runtime's private scratch after replay/rollback is not evidence of
// the accepted pass because restore is allowed to reuse that scratch.
kernel void nm_numi_human_audit_fem_anchor_reactions(
    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch [[buffer(0)]],
    device const NMNumiHumanTendonFEMNodeAnchorGPU* nodeAnchors [[buffer(1)]],
    device const float4* constraintReactions [[buffer(2)]],
    device const NMMatterStatusGPU* matterStatuses [[buffer(3)]],
    device float4* audits [[buffer(4)]],
    uint environment [[thread_position_in_grid]]
) {
    if (environment >= dispatch.environmentCount) return;
    float3 resultant = float3(0.0f);
    float l1 = 0.0f;
    if (matterStatuses[environment].code == NM_STATUS_SUCCESS) {
        const uint base = environment * dispatch.femNodeCount;
        for (uint node = 0u; node < dispatch.femNodeCount; ++node) {
            const NMNumiHumanTendonFEMNodeAnchorGPU anchor = nodeAnchors[node];
            if ((anchor.flags & NM_NUMI_HUMAN_TENDON_FEM_NODE_ANCHOR_ACTIVE) == 0u)
                continue;
            const float3 reaction = constraintReactions[base + node].xyz;
            if (!finite3(reaction)) {
                audits[environment] = float4(NAN);
                return;
            }
            resultant += reaction;
            l1 += length(reaction);
        }
    }
    const float4 audit = float4(resultant, l1);
    audits[environment] = audit;
}

kernel void nm_numi_human_commit_fem_anchor_reaction_audit(
    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch [[buffer(0)]],
    device const MRNumiHumanStandStatusGPU* standStatuses [[buffer(1)]],
    device const float4* provisionalAudits [[buffer(2)]],
    device float4* acceptedHistory [[buffer(3)]],
    uint environment [[thread_position_in_grid]]
) {
    if (environment >= dispatch.environmentCount ||
        dispatch.stepIndex >=
            NM_NUMI_HUMAN_ARTICULAR_CONTACT_AUDIT_MAX_STEPS) return;
    const MRNumiHumanStandStatusGPU stand = standStatuses[environment];
    if (dispatch.abiVersion != NM_NUMI_HUMAN_TENDON_FEM_LOAD_ABI_VERSION ||
        stand.code != MR_NUMI_HUMAN_STAND_SUCCESS ||
        stand.environment != environment ||
        stand.completedSteps != dispatch.stepIndex + 1u) return;
    const uint historyIndex =
        environment * NM_NUMI_HUMAN_ARTICULAR_CONTACT_AUDIT_MAX_STEPS +
        dispatch.stepIndex;
    const float4 accepted = provisionalAudits[environment];
    if (accepted.w >= acceptedHistory[historyIndex].w) {
        acceptedHistory[historyIndex] = accepted;
    }
}

kernel void nm_numi_human_audit_passive_ligaments(
    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch [[buffer(0)]],
    device const NMNumiHumanPassiveLigamentGPU* passiveLigaments [[buffer(1)]],
    device const MRArticulatedBodyPoseGPU* bodyPoses [[buffer(2)]],
    device NMNumiHumanPassiveLigamentAuditGPU* audits [[buffer(3)]],
    uint environment [[thread_position_in_grid]]
) {
    if (environment >= dispatch.environmentCount) return;
    float3 forceResidual = float3(0.0f);
    float3 momentResidual = float3(0.0f);
    float endpointForceL1 = 0.0f;
    float maximumTension = 0.0f;
    float minimumStretch = INFINITY;
    float maximumStretch = 0.0f;
    uint activeCount = 0u;
    for (uint index = 0u; index < dispatch.passiveLigamentCount; ++index) {
        float3 firstPoint;
        float3 secondPoint;
        float3 firstForce;
        float stretch;
        float tension;
        if (!passiveLigamentState(
                environment, dispatch, bodyPoses, passiveLigaments[index],
                firstPoint, secondPoint, firstForce, stretch, tension)) {
            audits[environment].forceResidualAndL1 = float4(NAN);
            audits[environment].momentResidualAndMaximumTension = float4(NAN);
            audits[environment].stretchCountAndAccepted = float4(NAN);
            return;
        }
        const float3 secondForce = -firstForce;
        forceResidual += firstForce + secondForce;
        momentResidual += cross(firstPoint, firstForce) +
            cross(secondPoint, secondForce);
        endpointForceL1 += 2.0f * tension;
        maximumTension = max(maximumTension, tension);
        minimumStretch = min(minimumStretch, stretch);
        maximumStretch = max(maximumStretch, stretch);
        ++activeCount;
    }
    if (activeCount == 0u) minimumStretch = 0.0f;
    NMNumiHumanPassiveLigamentAuditGPU audit{};
    audit.forceResidualAndL1 = float4(forceResidual, endpointForceL1);
    audit.momentResidualAndMaximumTension =
        float4(momentResidual, maximumTension);
    audit.stretchCountAndAccepted = float4(
        minimumStretch, maximumStretch, float(activeCount), 0.0f);
    audits[environment] = audit;
}

kernel void nm_numi_human_commit_passive_ligament_audit(
    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch [[buffer(0)]],
    device const MRNumiHumanStandStatusGPU* standStatuses [[buffer(1)]],
    device NMNumiHumanPassiveLigamentAuditGPU* audits [[buffer(2)]],
    uint environment [[thread_position_in_grid]]
) {
    if (environment >= dispatch.environmentCount) return;
    const MRNumiHumanStandStatusGPU stand = standStatuses[environment];
    if (dispatch.abiVersion == NM_NUMI_HUMAN_TENDON_FEM_LOAD_ABI_VERSION &&
        stand.code == MR_NUMI_HUMAN_STAND_SUCCESS &&
        stand.environment == environment &&
        stand.completedSteps == dispatch.stepIndex + 1u) {
        audits[environment].stretchCountAndAccepted.w = 1.0f;
    }
}

kernel void nm_numi_human_audit_passive_routed_bands(
    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch [[buffer(0)]],
    device const NMNumiHumanPassiveRoutedBandGPU* passiveRoutedBands
        [[buffer(1)]],
    device const MRArticulatedBodyPoseGPU* bodyPoses [[buffer(2)]],
    device NMNumiHumanPassiveRoutedBandAuditGPU* audits [[buffer(3)]],
    uint environment [[thread_position_in_grid]]
) {
    if (environment >= dispatch.environmentCount) return;
    float3 forceResidual = float3(0.0f);
    float3 momentResidual = float3(0.0f);
    float endpointForceL1 = 0.0f;
    float maximumTension = 0.0f;
    float minimumStrain = INFINITY;
    float maximumStrain = -INFINITY;
    float storedEnergy = 0.0f;
    float maximumExtension = 0.0f;
    uint activeCount = 0u;
    for (uint index = 0u; index < dispatch.passiveRoutedBandCount; ++index) {
        float3 originPoint;
        float3 pulleyPoint;
        float3 insertionPoint;
        float3 originForce;
        float3 pulleyForce;
        float3 insertionForce;
        float3 pulleyTorque;
        float3 insertionTorque;
        float strain;
        float tension;
        float extension;
        float energy;
        if (!passiveRoutedBandState(
                environment, dispatch, bodyPoses, passiveRoutedBands[index],
                originPoint, pulleyPoint, insertionPoint, originForce,
                pulleyForce, insertionForce, pulleyTorque, insertionTorque,
                strain, tension, extension, energy)) {
            audits[environment].forceResidualAndL1 = float4(NAN);
            audits[environment].momentResidualAndMaximumTension = float4(NAN);
            audits[environment].strainCountAndAccepted = float4(NAN);
            audits[environment].energyAndMaximumExtension = float4(NAN);
            return;
        }
        forceResidual += originForce + pulleyForce + insertionForce;
        momentResidual += cross(originPoint, originForce) +
            cross(pulleyPoint, pulleyForce) +
            cross(insertionPoint, insertionForce) + pulleyTorque +
            insertionTorque;
        endpointForceL1 += length(originForce) + length(pulleyForce) +
            length(insertionForce);
        maximumTension = max(maximumTension, tension);
        minimumStrain = min(minimumStrain, strain);
        maximumStrain = max(maximumStrain, strain);
        storedEnergy += energy;
        maximumExtension = max(maximumExtension, extension);
        ++activeCount;
    }
    if (activeCount == 0u) {
        minimumStrain = 0.0f;
        maximumStrain = 0.0f;
    }
    NMNumiHumanPassiveRoutedBandAuditGPU audit{};
    audit.forceResidualAndL1 = float4(forceResidual, endpointForceL1);
    audit.momentResidualAndMaximumTension =
        float4(momentResidual, maximumTension);
    audit.strainCountAndAccepted = float4(
        minimumStrain, maximumStrain, float(activeCount), 0.0f);
    audit.energyAndMaximumExtension = float4(
        storedEnergy, maximumExtension, 0.0f, 0.0f);
    audits[environment] = audit;
}

