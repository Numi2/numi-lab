        case NM_EXPR_SQRT: {
            const auto a=pop();
            if(less(a,{0,0}))valid=false;
            else push(a.high==0.0f&&a.low==0.0f?MRCompensatedScalar{0,0}:mrCompensatedSqrt(a));break;
