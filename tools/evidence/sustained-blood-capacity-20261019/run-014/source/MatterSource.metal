kernel void nm_fgmres_accumulate_mpm(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMFGMRESLayoutGPU& layout [[buffer(30)]],
    constant NMMixedSolverGPU& solver [[buffer(1)]],
    device const float4* preconditionedBasis [[buffer(2)]],
    device const float* leastSquares [[buffer(3)]],
    device const NMFGMRESStateGPU* states [[buffer(4)]],
    device float4* solution [[buffer(5)]],
    constant uint& restartCycle [[buffer(6)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount *
        dispatch.mpmActiveNodeCapacity;
    if (global >= total) return;
    const uint environment = global / dispatch.mpmActiveNodeCapacity;
    const uint row = fgmresMPMBase(dispatch) + global;
    const uint used = min(uint(states[environment].diagnostics.w), min(
        solver.nonlinearIterations.y, NM_MIXED_FGMRES_RESTART));
    const uint totalUnknowns = layout.unknownCount;
    float4 value = float4(0.0f);
    for (uint column = 0u; column < used; ++column)
        value += preconditionedBasis[column * totalUnknowns + row] *
            leastSquares[fgmresVectorIndex(environment, column)];
    if (restartCycle == 0u) solution[row] = value;
    else solution[row] += value;
}

kernel void nm_fgmres_restart_residual_mpm(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMFGMRESLayoutGPU& layout [[buffer(30)]],
    device const float4* basis [[buffer(1)]],
    device const float* coefficients [[buffer(2)]],
    device const NMFGMRESStateGPU* states [[buffer(3)]],
    device float4* residual [[buffer(4)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount *
        dispatch.mpmActiveNodeCapacity;
    if (global >= total) return;
    const uint environment = global / dispatch.mpmActiveNodeCapacity;
    const uint row = fgmresMPMBase(dispatch) + global;
    const uint used = min(uint(states[environment].diagnostics.w),
                          NM_MIXED_FGMRES_RESTART);
    const uint totalUnknowns = layout.unknownCount;
    const uint coefficientBase = environment *
        (NM_MIXED_FGMRES_RESTART + 1u);
    float4 value = float4(0.0f);
    for (uint basisRow = 0u; basisRow <= used; ++basisRow)
        value += coefficients[coefficientBase + basisRow] *
            basis[basisRow * totalUnknowns + row];
    residual[row] = value;
}

kernel void nm_mpm_apply_implicit_solution(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMMicrostepGPU& microstep [[buffer(1)]],
    device const uint* generations [[buffer(2)]],
    device const float4* solution [[buffer(3)]],
    device NMGridNodeStateGPU* nodes [[buffer(4)]],
    device const uint* activeIndices [[buffer(5)]],
    device const uint* activeCounts [[buffer(6)]],
    device const float4* lineSearch [[buffer(7)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount *
        dispatch.mpmActiveNodeCapacity;
    if (global >= total) return;
    const uint environment = global / dispatch.mpmActiveNodeCapacity;
    const uint slot = global - environment * dispatch.mpmActiveNodeCapacity;
    if (slot >= activeCounts[environment]) return;
    const uint nodeIndex = activeIndices[
        environment * dispatch.mpmActiveNodeCapacity + slot];
    const uint nodeGlobal = environment * dispatch.gridNodeCount + nodeIndex;
    if (nodeIndex >= dispatch.gridNodeCount ||
        generations[nodeGlobal] != microstep.reserved) return;
    const float alpha = dispatch.objectCount > 0u
        ? lineSearch[environment * dispatch.objectCount].x : 0.0f;
    nodes[nodeGlobal].candidateVelocity.xyz += alpha *
        solution[fgmresMPMIndex(dispatch, environment, slot)].xyz;
}


kernel void nm_fgmres_precondition_support(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMFGMRESLayoutGPU& layout [[buffer(30)]],
    device const float4* basis [[buffer(1)]],
    device float4* preconditioned [[buffer(2)]],
    device const NMFGMRESStateGPU* states [[buffer(3)]],
    uint global [[thread_position_in_grid]]
) {
    if (global >= dispatch.environmentCount * layout.supportContactCount) return;
    const uint environment = global / layout.supportContactCount;
    const uint row = layout.supportBase + global;
    preconditioned[row] = states[environment].diagnostics.z > 0.5f
        ? float4(0.0f) : float4(basis[row].xyz, 0.0f);
}

kernel void nm_fgmres_apply_support_dual(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMFGMRESLayoutGPU& layout [[buffer(30)]],
    constant NMHumanSupportDispatchGPU& support [[buffer(1)]],
    device const float4* direction [[buffer(2)]],
    device float4* work [[buffer(3)]],
    device const NMHumanSupportKKTGPU* linearizations [[buffer(4)]],
    device const float* pointJacobians [[buffer(5)]],
    device const NMFGMRESStateGPU* states [[buffer(6)]],
    uint global [[thread_position_in_grid]]
) {
    if (global >= dispatch.environmentCount * support.contactCount) return;
    const uint environment = global / support.contactCount;
    const uint row = layout.supportBase + global;
    work[row] = float4(0.0f);
    if (states[environment].diagnostics.z > 0.5f) return;
    const uint rigidBase = fgmresRigidIndex(dispatch, environment, 0u);
    const uint base = global * 3u * dispatch.rigidGeneralizedCapacity;
    float3 pointDirection(0.0f);
    for (uint dof = 0u; dof < support.articulatedNv; ++dof) {
        const float v = direction[rigidBase + dof].x;
        pointDirection += v * float3(pointJacobians[base + dof],
            pointJacobians[base + dispatch.rigidGeneralizedCapacity + dof],
            pointJacobians[base + 2u * dispatch.rigidGeneralizedCapacity + dof]);
    }
    const NMHumanSupportKKTGPU kkt = linearizations[global];
    const float3 impulseDirection = direction[row].xyz;
    // -d(P(lambda-rho*c)-lambda) = rho*D*J*dv + (I-D)*dlambda.
    // rho is one kg in the evaluator. D includes the sliding radial and
    // normal-to-tangent coupling; using a symmetric PSD tangent is incorrect.
    work[row] = float4(impulseDirection + multiplyRows(kkt.projectionRow0,
        kkt.projectionRow1, kkt.projectionRow2,
        pointDirection - impulseDirection), 0.0f);
}

// Boundary retraction endpoints are transient globalization state, not an
// accepted-law projection or substitute residual. Give them normal-range FP32
// slack, then validate the actual
// final shared-alpha interpolation after every coupled limiter has run. The
// natural Coulomb equation is still reassembled on the next solve and the
// terminal certificate remains strict.
inline float humanSupportConeInteriorMargin(
    const float normalImpulse,
    const float tangentMagnitude,
    const float friction
) {
    if (!(friction > 0.0f)) return 0.0f;
    // 2^-108 times 32*epsilon is FLT_MIN. Never request a subnormal guard:
    // Metal is permitted to flush either its inputs or result to zero.
    const float scale = max(max(abs(friction * normalImpulse),
        tangentMagnitude), 3.0814879110195774e-33f);
    return 32.0f * kEpsilon * scale;
}

inline float humanSupportTangentMagnitude(const float3 tangent) {
    return sqrt(fma(tangent.x, tangent.x,
        fma(tangent.y, tangent.y, tangent.z * tangent.z)));
}

inline float humanSupportTangentProjection(
    const float3 tangent,
    const float3 normal
) {
    return fma(tangent.x, normal.x,
        fma(tangent.y, normal.y, tangent.z * normal.z));
}

inline float humanSupportConeMargin(
    const float normalImpulse,
    const float tangentMagnitude,
    const float friction
) {
    return fma(friction, normalImpulse, -tangentMagnitude);
}

inline bool humanSupportStoredHistoryAdmissible(
    const float4 history,
    const float3 normal,
    const float friction,
    const bool requireInterior
) {
    const float tangentMagnitude =
        humanSupportTangentMagnitude(history.xyz);
    const float tangentProjection =
        humanSupportTangentProjection(history.xyz, normal);
    const float margin = humanSupportConeMargin(
        history.w, tangentMagnitude, friction);
    const float projectionTolerance = 8.0f * kEpsilon *
        max(1.0f, max(tangentMagnitude, history.w));
    const bool canonicalZero = history.w == 0.0f &&
        all(history.xyz == float3(0.0f));
    const float requiredMargin = requireInterior && !canonicalZero
        ? humanSupportConeInteriorMargin(
            history.w, tangentMagnitude, friction)
        : 0.0f;
    return all(isfinite(history)) && history.w >= 0.0f &&
        finiteNonnegativeNormalOrZero(friction) &&
        isfinite(tangentMagnitude) && isfinite(tangentProjection) &&
        isfinite(margin) && margin >= requiredMargin &&
        abs(tangentProjection) <= projectionTolerance &&
        ((history.w != 0.0f && friction != 0.0f) ||
         all(history.xyz == float3(0.0f)));
}

inline float3 humanSupportImpulse(
    const float4 history,
    const float3 normal
) {
    return fma(float3(history.w), normal, history.xyz);
}

inline float4 humanSupportConeSharedStep(
    const float4 history,
    const float4 target,
    const float alpha
) {
    return alpha == 1.0f
        ? target : fma(float4(alpha), target - history, history);
}

inline float4 humanSupportInactiveSharedStep(
    const float4 history,
    const float alpha
) {
    if (alpha == 1.0f) return float4(0.0f);
    return fma(float4(alpha), -history, history);
}

// Search only the positive normal FP32 domain. Subnormal shared fractions are
// not a portable execution contract on Apple GPUs because they may be flushed
// before either the feasibility test or the eventual application observes
// them. The raw positive-float encoding is monotone on [FLT_MIN, 1].
inline bool humanSupportPositiveNormalUnitAlpha(const float alpha) {
    const uint bits = as_type<uint>(alpha);
    return bits >= 0x00800000u && bits <= 0x3f800000u;
}

inline float3 humanSupportFreeSharedStep(
    const float3 impulse,
    const float3 correction,
    const float alpha
) {
    return fma(float3(alpha), correction, impulse);
}

inline bool humanSupportFreeConeFeasible(
    const float3 impulse,
    const float3 correction,
    const float alpha,
    const float3 normal,
    const float friction,
    const bool requireInterior
) {
    if (!humanSupportPositiveNormalUnitAlpha(alpha)) return false;
    const float3 trial = humanSupportFreeSharedStep(
        impulse, correction, alpha);
    const float normalImpulse =
        humanSupportTangentProjection(trial, normal);
    const float3 tangentImpulse =
        fma(float3(-normalImpulse), normal, trial);
    if (!finite3(trial) || !isfinite(normalImpulse) ||
        normalImpulse < 0.0f ||
        (normalImpulse == 0.0f &&
         any(tangentImpulse != float3(0.0f)))) return false;
    const float4 nextHistory = normalImpulse == 0.0f
        ? float4(0.0f) : float4(tangentImpulse, normalImpulse);
    return humanSupportStoredHistoryAdmissible(
        nextHistory, normal, friction, requireInterior);
}

// Find a terminally feasible shared fraction over the positive-normal FP32
// lattice, not over a fixed real-valued halving budget. The unguarded cone
// intersection is a prefix containing alpha=0; `lowerBits` always names a point
// evaluated with the exact application FMA, so a local roundoff hole can only
// make the returned point more conservative. Thirty bit bisections cover every
// encoding from FLT_MIN through 1.0f.
inline float humanSupportReconciledFreeAlpha(
    const float3 impulse,
    const float3 correction,
    const float maximumAlpha,
    const float3 normal,
    const float friction
) {
    if (!humanSupportPositiveNormalUnitAlpha(maximumAlpha)) return 0.0f;
    if (humanSupportFreeConeFeasible(
            impulse, correction, maximumAlpha, normal, friction, false)) {
        return maximumAlpha;
    }
    constexpr uint minimumNormalBits = 0x00800000u;
    uint upperBits = as_type<uint>(maximumAlpha);
    if (upperBits <= minimumNormalBits) return 0.0f;
    const float minimumNormal = as_type<float>(minimumNormalBits);
    if (!humanSupportFreeConeFeasible(
            impulse, correction, minimumNormal, normal, friction, false)) {
        return 0.0f;
    }
    uint lowerBits = minimumNormalBits;
    for (uint bit = 0u; bit < 30u && upperBits - lowerBits > 1u;
         ++bit) {
        const uint middleBits =
            lowerBits + ((upperBits - lowerBits) >> 1u);
        const float middle = as_type<float>(middleBits);
        if (humanSupportFreeConeFeasible(
                impulse, correction, middle, normal, friction, false)) {
            lowerBits = middleBits;
        } else {
            upperBits = middleBits;
        }
    }
    return as_type<float>(lowerBits);
}

inline bool humanSupportInactiveConeFeasible(
    const float4 history,
    const float alpha,
    const float3 normal,
    const float friction
) {
    return humanSupportPositiveNormalUnitAlpha(alpha) &&
        humanSupportStoredHistoryAdmissible(
            humanSupportInactiveSharedStep(history, alpha),
            normal, friction, false);
}

inline bool humanSupportTargetConeFeasible(
    const float4 history,
    const float4 target,
    const float alpha,
    const float3 normal,
    const float friction
) {
    return humanSupportPositiveNormalUnitAlpha(alpha) &&
        humanSupportStoredHistoryAdmissible(
            humanSupportConeSharedStep(history, target, alpha),
            normal, friction, false);
}

// Inactive scaling and fixed-target interpolation are physically feasible for
// the whole real segment; only component rounding can create isolated FP32
// holes. Check nearby predecessor encodings first to preserve the coupled
// step. The bit bisection fallback is conservative and always returns a point
// that the exact stored-step predicate evaluated feasible.
inline float humanSupportReconciledInactiveAlpha(
    const float4 history,
    const float maximumAlpha,
    const float3 normal,
    const float friction
) {
    if (!humanSupportPositiveNormalUnitAlpha(maximumAlpha)) return 0.0f;
    if (humanSupportInactiveConeFeasible(
            history, maximumAlpha, normal, friction)) return maximumAlpha;
    constexpr uint minimumNormalBits = 0x00800000u;
    const uint maximumBits = as_type<uint>(maximumAlpha);
    for (uint offset = 1u; offset <= 64u &&
         maximumBits >= minimumNormalBits + offset; ++offset) {
        const float candidate = as_type<float>(maximumBits - offset);
        if (humanSupportInactiveConeFeasible(
                history, candidate, normal, friction)) return candidate;
    }
    const float minimumNormal = as_type<float>(minimumNormalBits);
    if (!humanSupportInactiveConeFeasible(
            history, minimumNormal, normal, friction)) return 0.0f;
    uint lowerBits = minimumNormalBits;
    uint upperBits = maximumBits;
    for (uint bit = 0u; bit < 30u && upperBits - lowerBits > 1u; ++bit) {
        const uint middleBits =
            lowerBits + ((upperBits - lowerBits) >> 1u);
        const float middle = as_type<float>(middleBits);
        if (humanSupportInactiveConeFeasible(
                history, middle, normal, friction)) lowerBits = middleBits;
        else upperBits = middleBits;
    }
    return as_type<float>(lowerBits);
}

inline float humanSupportReconciledTargetAlpha(
    const float4 history,
    const float4 target,
    const float maximumAlpha,
    const float3 normal,
    const float friction
) {
    if (!humanSupportPositiveNormalUnitAlpha(maximumAlpha)) return 0.0f;
    if (humanSupportTargetConeFeasible(
            history, target, maximumAlpha, normal, friction)) {
        return maximumAlpha;
    }
    constexpr uint minimumNormalBits = 0x00800000u;
    const uint maximumBits = as_type<uint>(maximumAlpha);
    for (uint offset = 1u; offset <= 64u &&
         maximumBits >= minimumNormalBits + offset; ++offset) {
        const float candidate = as_type<float>(maximumBits - offset);
        if (humanSupportTargetConeFeasible(
                history, target, candidate, normal, friction)) {
            return candidate;
        }
    }
    const float minimumNormal = as_type<float>(minimumNormalBits);
    if (!humanSupportTargetConeFeasible(
            history, target, minimumNormal, normal, friction)) return 0.0f;
    uint lowerBits = minimumNormalBits;
    uint upperBits = maximumBits;
    for (uint bit = 0u; bit < 30u && upperBits - lowerBits > 1u; ++bit) {
        const uint middleBits =
            lowerBits + ((upperBits - lowerBits) >> 1u);
        const float middle = as_type<float>(middleBits);
        if (humanSupportTargetConeFeasible(
                history, target, middle, normal, friction)) {
            lowerBits = middleBits;
        } else {
            upperBits = middleBits;
        }
    }
    return as_type<float>(lowerBits);
}

// A free support direction that leaves the admissible impulse cone cannot be
// applied as an affine chord. The natural Alart-Curnier equation already owns
// the current active/inactive classification. If its solved direction exits
// the normal half-line while the freshly assembled inactive inequality is
// violated, installing lambda=0 as a substitute equation would contradict
// that classification and can create an exact two-cycle. Retract only the dual
// endpoint to the canonical cone apex in that case and retain the already
// coupled mechanical Newton direction. A normal exit with c_n >= 0 may still
// select the exact full-impulse inactive set and require a fresh coupled solve.
// An outward direction from a positive-normal Coulomb boundary similarly
// retracts only the support-dual endpoint to an exact feasible fixed-normal
// disk point. The natural Coulomb residual is reassembled immediately after
// either one-step retraction; no second-order claim is made at the cone apex.
kernel void nm_human_support_resolve_working_set(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMFGMRESLayoutGPU& layout [[buffer(30)]],
    constant NMHumanSupportDispatchGPU& support [[buffer(1)]],
    device float4* solution [[buffer(2)]],
    device const float4* histories [[buffer(3)]],
    device uint* workingSet [[buffer(4)]],
    device uint* changed [[buffer(5)]],
    device NMMatterStatusGPU* statuses [[buffer(6)]],
    device const NMHumanSupportContactGPU* contacts [[buffer(7)]],
    device uint* coneWorkingSet [[buffer(8)]],
    device float4* coneTargets [[buffer(9)]],
    device const NMContactSampleGPU* samples [[buffer(10)]],
    uint lane [[thread_index_in_threadgroup]],
    uint environment [[threadgroup_position_in_grid]]
) {
    if (lane >= 32u || environment >= dispatch.environmentCount) return;
    if (layout.supportContactCount == 0u) return;
    const bool previouslyChanged = changed[environment] != 0u;
    bool activated = false;
    const float3 normal = support.groundNormal.xyz;
    const uint supportBase = environment * layout.supportContactCount;
    if (environmentHealthy(statuses, environment) && !previouslyChanged) {
        if (support.contactCount != layout.supportContactCount ||
            !finite3(normal) || abs(length(normal) - 1.0f) > 1.0e-4f) {
            if (lane == 0u)
                recordFailure(statuses[environment], NM_STATUS_CONTACT_FAILURE,
                    NM_INVALID_INDEX, NM_INVALID_INDEX,
                    float4(float(support.contactCount),
                        float(layout.supportContactCount), length(normal), 0.0f));
        } else {
            for (uint row = lane; row < layout.supportContactCount; row += 32u) {
                const uint global = supportBase + row;
                const uint solutionRow = layout.supportBase + global;
                const float4 history = histories[global];
                const float3 direction = solution[solutionRow].xyz;
                const uint state = workingSet[global];
                const uint coneState = coneWorkingSet[global];
                const float normalConstraint =
                    samples[global].admissionVelocityAndNormal.w;
                const float friction =
                    contacts[row].frictionSlopAndStabilization.x;
                const float3 impulse = humanSupportImpulse(history, normal);
                if (state > 2u || coneState != 0u ||
                    !all(isfinite(history)) || !finite3(direction) ||
                    history.w < 0.0f || !isfinite(normalConstraint) ||
                    !finiteNonnegativeNormalOrZero(friction)) {
                    recordFailure(statuses[environment],
                        NM_STATUS_LINEAR_SOLVER_FAILURE,
                        NM_INVALID_INDEX, row,
                        float4(history.w, float(state), float(coneState),
                            normalConstraint));
                    continue;
                }
                if (state != 0u) {
                    // Exact affine particular solution for the complete
                    // inactive impulse constraint.
                    solution[solutionRow] = float4(-impulse, 0.0f);
                    continue;
                }
                const float3 predicted = impulse + direction;
                const float predictedNormal =
                    humanSupportTangentProjection(predicted, normal);
                const float3 predictedTangent =
                    fma(float3(-predictedNormal), normal, predicted);
                if (!finite3(predicted) || !isfinite(predictedNormal)) {
                    recordFailure(statuses[environment],
                        NM_STATUS_LINEAR_SOLVER_FAILURE,
                        NM_INVALID_INDEX, row,
                        float4(predicted, predictedNormal));
                } else if (predictedNormal < 0.0f ||
                           (predictedNormal == 0.0f &&
                            any(predictedTangent != float3(0.0f)))) {
                    if (normalConstraint < 0.0f) {
                        // lambda=0 is not an admissible inactive equation
                        // while c_n < 0. Project the solved dual endpoint to
                        // the canonical apex, preserve every coupled primal
                        // direction, and let the natural equation classify
                        // the freshly assembled next state.
                        coneTargets[global] = float4(0.0f);
                        coneWorkingSet[global] = 1u;
                        solution[solutionRow] = float4(-impulse, 0.0f);
                    } else {
                        workingSet[global] = 1u;
                        coneTargets[global] = float4(0.0f);
                        activated = true;
                    }
                } else {
                    const float currentMagnitude =
                        humanSupportTangentMagnitude(history.xyz);
                    const float predictedMagnitude =
                        humanSupportTangentMagnitude(predictedTangent);
                    const float currentMargin =
                        humanSupportConeMargin(
                            history.w, currentMagnitude, friction);
                    const float predictedMargin =
                        humanSupportConeMargin(
                            predictedNormal, predictedMagnitude, friction);
                    if (!isfinite(currentMargin) || currentMargin < 0.0f ||
                        !isfinite(predictedMargin)) {
                        recordFailure(statuses[environment],
                            NM_STATUS_CONTACT_FAILURE,
                            NM_INVALID_INDEX, row,
                            float4(history.w, currentMagnitude,
                                currentMargin, predictedMargin));
                    } else if (currentMargin <= 2.0f *
                                   humanSupportConeInteriorMargin(
                                       history.w, currentMagnitude, friction) &&
                               predictedMargin < 0.0f) {
                        // The retracted endpoint intentionally has FP32
                        // interior slack. Treat that same roundoff-scale band
                        // as boundary on the next assembly; exact-zero-only
                        // classification alternates retraction with near-zero
                        // shared steps. The second guard covers rounding of
                        // the guarded endpoint. This selects a direction only:
                        // stored histories and the strict certificate are
                        // unchanged, and inward/interior directions stay free.
                        // At the cone boundary a scalar shared alpha may have
                        // no positive feasible value (the apex is the canonical
                        // cold-start example). Retract the dual endpoint to the
                        // largest representable radial point inside the solved
                        // fixed-normal disk. This correction is chosen before
                        // globalization and is applied with the same shared
                        // alpha as every mechanical block; it is not an
                        // independent projection of accepted state.
                        float lower = 0.0f;
                        float upper = 1.0f;
                        for (uint iteration = 0u; iteration < 32u;
                             ++iteration) {
                            const float middle = 0.5f * (lower + upper);
                            if (middle == lower || middle == upper) break;
                            const float3 tangent = middle * predictedTangent;
                            const float tangentMagnitude =
                                humanSupportTangentMagnitude(tangent);
                            const float margin = humanSupportConeMargin(
                                predictedNormal, tangentMagnitude, friction);
                            const float interiorMargin =
                                humanSupportConeInteriorMargin(
                                    predictedNormal, tangentMagnitude,
                                    friction);
                            if (isfinite(margin) &&
                                margin >= interiorMargin)
                                lower = middle;
                            else
                                upper = middle;
                        }
                        const float3 targetTangent =
                            lower * predictedTangent;
                        const float targetTangentMagnitude =
                            humanSupportTangentMagnitude(targetTangent);
                        const float targetMargin = humanSupportConeMargin(
                            predictedNormal, targetTangentMagnitude,
                            friction);
                        const float targetInteriorMargin =
                            humanSupportConeInteriorMargin(
                                predictedNormal, targetTangentMagnitude,
                                friction);
                        const float4 targetHistory =
                            float4(targetTangent, predictedNormal);
                        if (!finite3(targetTangent) ||
                            !isfinite(targetMargin) ||
                            targetMargin < targetInteriorMargin ||
                            predictedNormal <= 0.0f ||
                            !humanSupportStoredHistoryAdmissible(
                                targetHistory, normal, friction, true)) {
                            recordFailure(statuses[environment],
                                NM_STATUS_CONTACT_FAILURE,
                                NM_INVALID_INDEX, row,
                                float4(predictedNormal,
                                    predictedMagnitude, lower,
                                    targetMargin));
                        } else {
                            coneTargets[global] = targetHistory;
                            coneWorkingSet[global] = 1u;
                            solution[solutionRow] = float4(
                                humanSupportImpulse(targetHistory, normal) -
                                    impulse,
                                0.0f);
                        }
                    }
                }
            }
        }
    }
    const bool anyActivated = simd_any(activated);
    if (lane == 0u)
        changed[environment] =
            (previouslyChanged || anyActivated) ? 1u : 0u;
    threadgroup_barrier(mem_flags::mem_device);
    if (!anyActivated) return;

    // A normal active-set pivot discards this coupled direction. Discard any
    // cone retraction selected by another lane at the same time as well; an
    // ephemeral marker must never survive into the next residual assembly.
    for (uint row = lane; row < layout.supportContactCount; row += 32u) {
        const uint global = supportBase + row;
        if (coneWorkingSet[global] != 0u) {
            coneWorkingSet[global] = 0u;
            coneTargets[global] = float4(0.0f);
        }
    }
    threadgroup_barrier(mem_flags::mem_device);

    // No limiter or partially coupled block may observe the stale direction.
    bool finiteDirection = true;
    const uint nodeBase = environment * dispatch.femNodeCount;
    const uint fieldBase = dispatch.environmentCount * dispatch.femNodeCount;
    for (uint i = lane; i < dispatch.femNodeCount; i += 32u) {
        finiteDirection = finiteDirection &&
            all(isfinite(solution[nodeBase + i])) &&
            all(isfinite(solution[fieldBase + nodeBase + i]));
        solution[nodeBase + i] = float4(0.0f);
        solution[fieldBase + nodeBase + i] = float4(0.0f);
    }
    for (uint i = lane; i < dispatch.rigidGeneralizedCapacity; i += 32u) {
        const uint row = fgmresRigidIndex(dispatch, environment, i);
        finiteDirection = finiteDirection && all(isfinite(solution[row]));
        solution[row] = float4(0.0f);
    }
    for (uint i = lane; i < dispatch.mpmActiveNodeCapacity; i += 32u) {
        const uint row = fgmresMPMIndex(dispatch, environment, i);
        finiteDirection = finiteDirection && all(isfinite(solution[row]));
        solution[row] = float4(0.0f);
    }
    for (uint i = lane; i < layout.supportContactCount; i += 32u) {
        const uint row = layout.supportBase +
            environment * layout.supportContactCount + i;
        finiteDirection = finiteDirection && all(isfinite(solution[row]));
        solution[row] = float4(0.0f);
    }
    for (uint i = lane; i < layout.vascularUnknownCount; i += 32u) {
        const uint row = layout.vascularBase +
            environment * layout.vascularUnknownCount + i;
        finiteDirection = finiteDirection && all(isfinite(solution[row]));
        solution[row] = float4(0.0f);
    }
    if (!simd_all(finiteDirection) && lane == 0u)
        recordFailure(statuses[environment], NM_STATUS_LINEAR_SOLVER_FAILURE,
            NM_INVALID_INDEX, NM_INVALID_INDEX,
            float4(INFINITY, 0.0f, 0.0f, 0.0f));
}

// The resolver above owns normal-cone pivots. The remaining free direction is
// intersected with the non-associated Coulomb disk at fixed solved normal:
// every mechanical and dual block receives this same alpha, so the boundary
// is reached without independently projecting or clipping lambda_t.
kernel void nm_human_support_limit_line_search(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMFGMRESLayoutGPU& layout [[buffer(30)]],
    constant NMHumanSupportDispatchGPU& support [[buffer(1)]],
    device const float4* solution [[buffer(2)]],
    device const float4* histories [[buffer(3)]],
    device float4* objectLineSearch [[buffer(4)]],
    device float* environmentLineSearch [[buffer(5)]],
    device NMMatterStatusGPU* statuses [[buffer(6)]],
    device const uint* workingSet [[buffer(7)]],
    device const uint* changed [[buffer(8)]],
    device const NMHumanSupportContactGPU* contacts [[buffer(9)]],
    device const uint* coneWorkingSet [[buffer(10)]],
    device const float4* coneTargets [[buffer(11)]],
    uint lane [[thread_index_in_threadgroup]],
    uint environment [[threadgroup_position_in_grid]]
) {
    if (lane >= 32u || environment >= dispatch.environmentCount) return;
    const bool deferred = changed[environment] != 0u;
    float alpha = environmentHealthy(statuses, environment) ? 1.0f : 0.0f;
    const uint objectBase = environment * dispatch.objectCount;
    for (uint object = lane; object < dispatch.objectCount; object += 32u) {
        const float objectAlpha = objectLineSearch[objectBase + object].x;
        if (!isfinite(objectAlpha) || objectAlpha < 0.0f) {
            alpha = 0.0f;
            recordFailure(
                statuses[environment], NM_STATUS_NONLINEAR_SOLVER_FAILURE,
                object, NM_INVALID_INDEX,
                float4(objectAlpha, 0.0f, 0.0f, 0.0f));
        } else {
            alpha = min(alpha, objectAlpha);
        }
    }
    alpha = simd_min(alpha);
    const float3 normal = support.groundNormal.xyz;
    const uint supportBase = environment * layout.supportContactCount;
    for (uint row = lane; !deferred && row < layout.supportContactCount;
         row += 32u) {
        const float4 history = histories[supportBase + row];
        const float3 correction = solution[
            layout.supportBase + supportBase + row].xyz;
        const float3 impulse = humanSupportImpulse(history, normal);
        const float3 predicted = impulse + correction;
        const float predictedNormal =
            humanSupportTangentProjection(predicted, normal);
        const float3 predictedTangent =
            fma(float3(-predictedNormal), normal, predicted);
        const uint state = workingSet[supportBase + row];
        const uint coneState = coneWorkingSet[supportBase + row];
        const float4 target = coneTargets[supportBase + row];
        const float3 targetImpulse = humanSupportImpulse(target, normal);
        const float friction = contacts[row].frictionSlopAndStabilization.x;
        if (!all(isfinite(history)) || !finite3(correction) ||
            state > 2u || coneState > 1u ||
            (state != 0u && coneState != 0u) ||
            history.w < 0.0f ||
            !finiteNonnegativeNormalOrZero(friction) ||
            !humanSupportStoredHistoryAdmissible(
                history, normal, friction, false) ||
            !isfinite(predictedNormal) || predictedNormal < 0.0f ||
            (predictedNormal == 0.0f &&
             any(predictedTangent != float3(0.0f))) ||
            (state != 0u && any(correction != -impulse)) ||
            (coneState != 0u &&
             (!all(isfinite(target)) ||
              !humanSupportStoredHistoryAdmissible(
                  target, normal, friction, true) ||
              any(correction != targetImpulse - impulse)))) {
            alpha = 0.0f;
            recordFailure(
                statuses[environment], NM_STATUS_CONTACT_FAILURE,
                NM_INVALID_INDEX, row,
                float4(history.w, predictedNormal, float(state),
                    float(coneState)));
            continue;
        }
        if (state == 0u && coneState == 0u) {
            const float currentMagnitude =
                humanSupportTangentMagnitude(history.xyz);
            const float predictedMagnitude =
                humanSupportTangentMagnitude(predictedTangent);
            const float currentMargin =
                humanSupportConeMargin(
                    history.w, currentMagnitude, friction);
            const float predictedMargin =
                humanSupportConeMargin(
                    predictedNormal, predictedMagnitude, friction);
            if (!isfinite(currentMargin) || currentMargin < 0.0f) {
                alpha = 0.0f;
                recordFailure(statuses[environment],
                    NM_STATUS_CONTACT_FAILURE, NM_INVALID_INDEX, row,
                    float4(history.w, currentMagnitude,
                        currentMargin, friction));
                continue;
            }
            if (!isfinite(predictedMargin)) {
                alpha = 0.0f;
                recordFailure(statuses[environment],
                    NM_STATUS_CONTACT_FAILURE, NM_INVALID_INDEX, row,
                    float4(history.w, predictedNormal,
                        predictedMargin, friction));
                continue;
            }
            const float feasibleAlpha =
                humanSupportReconciledFreeAlpha(
                    impulse, correction, alpha, normal, friction);
            if (!(feasibleAlpha > 0.0f)) {
                alpha = 0.0f;
                recordFailure(statuses[environment],
                    NM_STATUS_CONTACT_FAILURE, NM_INVALID_INDEX, row,
                    float4(history.w, predictedNormal, currentMargin,
                        predictedMargin));
            } else {
                alpha = feasibleAlpha;
            }
        }
    }
    alpha = simd_min(alpha);
    // A different lane may have reduced the shared alpha after this lane found
    // its own feasible point. Re-evaluate the exact FMA at the new common value
    // until every support row agrees on the same representable stored step. The
    // final no-write gate remains the authority if the bounded reconciliation
    // cannot reach a fixed point.
    const uint reconciliationPasses = min(
        max(support.contactCount, 1u), 32u);
    for (uint pass = 0u; !deferred && alpha > 0.0f &&
         pass < reconciliationPasses; ++pass) {
        const float previousAlpha = alpha;
        float reconciledAlpha = alpha;
        for (uint row = lane; row < layout.supportContactCount; row += 32u) {
            const uint global = supportBase + row;
            const float4 history = histories[global];
            const float3 impulse = humanSupportImpulse(history, normal);
            const float3 correction =
                solution[layout.supportBase + global].xyz;
            const float friction =
                contacts[row].frictionSlopAndStabilization.x;
            const uint state = workingSet[global];
            const uint coneState = coneWorkingSet[global];
            const float feasibleAlpha = state != 0u
                ? humanSupportReconciledInactiveAlpha(
                    history, alpha, normal, friction)
                : (coneState != 0u
                    ? humanSupportReconciledTargetAlpha(
                        history, coneTargets[global], alpha,
                        normal, friction)
                    : humanSupportReconciledFreeAlpha(
                        impulse, correction, alpha, normal, friction));
            if (!(feasibleAlpha > 0.0f)) {
                reconciledAlpha = 0.0f;
                recordFailure(statuses[environment],
                    NM_STATUS_CONTACT_FAILURE, NM_INVALID_INDEX, row,
                    float4(history.w,
                        humanSupportTangentMagnitude(history.xyz),
                        alpha, friction));
            } else {
                reconciledAlpha = min(reconciledAlpha, feasibleAlpha);
            }
        }
        alpha = simd_min(reconciledAlpha);
        if (alpha == previousAlpha) break;
    }
    // The vascular limiter owns alpha=0 deferral when that block exists. For
    // a support-only system the discarded direction is already all zeros, so
    // retain a positive no-op alpha; the empty vascular limiter otherwise
    // (correctly) treats zero as an unexplained globalization failure.
    if (deferred && layout.vascularUnknownCount != 0u) alpha = 0.0f;
    if (lane == 0u) {
        environmentLineSearch[environment] = alpha;
        if (!deferred && environmentHealthy(statuses, environment) &&
            (!(alpha > 0.0f) || !isfinite(alpha))) {
            recordFailure(
                statuses[environment], NM_STATUS_NONLINEAR_SOLVER_FAILURE,
                NM_INVALID_INDEX, NM_INVALID_INDEX,
                float4(alpha, 0.0f, 0.0f, 0.0f));
        }
    }
    for (uint object = lane; object < dispatch.objectCount; object += 32u)
        objectLineSearch[objectBase + object].x = alpha;
}

// Coupled blocks may reduce the shared alpha after the support limiter has
// selected its cone-retraction endpoint. Validate the exact final interpolation before any
// candidate arena is mutated. Failure zeros every shared-alpha owner as well
// as recording status, so apply kernels that do not consume status remain
// no-ops and transaction rollback retains sole publication authority.
kernel void nm_human_support_validate_final_line_search(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMFGMRESLayoutGPU& layout [[buffer(30)]],
    constant NMHumanSupportDispatchGPU& support [[buffer(1)]],
    device const float4* histories [[buffer(2)]],
    device float4* objectLineSearch [[buffer(3)]],
    device float* environmentLineSearch [[buffer(4)]],
    device NMMatterStatusGPU* statuses [[buffer(5)]],
    device const uint* changed [[buffer(6)]],
    device const NMHumanSupportContactGPU* contacts [[buffer(7)]],
    device const uint* coneWorkingSet [[buffer(8)]],
    device const float4* coneTargets [[buffer(9)]],
    device const float4* solution [[buffer(10)]],
    device const uint* workingSet [[buffer(11)]],
    uint lane [[thread_index_in_threadgroup]],
    uint environment [[threadgroup_position_in_grid]]
) {
    if (lane >= 32u || environment >= dispatch.environmentCount) return;
    const bool deferred = changed[environment] != 0u;
    const float alpha = environmentLineSearch[environment];
    const bool healthy = environmentHealthy(statuses, environment);
    const bool hasSupport = support.contactCount != 0u;
    const uint alphaBits = as_type<uint>(alpha);
    const bool positiveAlphaValid = hasSupport
        ? humanSupportPositiveNormalUnitAlpha(alpha)
        : (alphaBits > 0u && alphaBits <= 0x3f800000u);
    const bool alphaValid = positiveAlphaValid ||
        (deferred && alphaBits == 0u);
    const float3 normal = support.groundNormal.xyz;
    const bool countValid =
        support.contactCount == layout.supportContactCount &&
        (support.contactCount == 0u ||
         (finite3(normal) && abs(length(normal) - 1.0f) <= 1.0e-4f));
    bool valid = healthy && alphaValid && countValid;
    if (lane == 0u && healthy && (!alphaValid || !countValid))
        recordFailure(statuses[environment],
            NM_STATUS_NONLINEAR_SOLVER_FAILURE,
            NM_INVALID_INDEX, NM_INVALID_INDEX,
            float4(alpha, float(deferred), float(support.contactCount),
                float(layout.supportContactCount)));
    const uint objectBase = environment * dispatch.objectCount;
    for (uint object = lane; object < dispatch.objectCount; object += 32u) {
        const float objectAlpha = objectLineSearch[objectBase + object].x;
        const bool objectValid = isfinite(objectAlpha) &&
            objectAlpha == alpha;
        if (healthy && alphaValid && countValid && !objectValid)
            recordFailure(statuses[environment],
                NM_STATUS_NONLINEAR_SOLVER_FAILURE,
                object, NM_INVALID_INDEX,
                float4(alpha, objectAlpha, 0.0f, 0.0f));
        valid = valid && objectValid;
    }
    const uint supportBase = environment * support.contactCount;
    for (uint row = lane; valid && !deferred && row < support.contactCount;
         row += 32u) {
        const uint global = supportBase + row;
        const float4 history = histories[global];
        const float3 correction =
            solution[layout.supportBase + global].xyz;
        const uint state = workingSet[global];
        const uint coneState = coneWorkingSet[global];
        const float4 target = coneTargets[global];
        const float friction = contacts[row].frictionSlopAndStabilization.x;
        const float currentMagnitude =
            humanSupportTangentMagnitude(history.xyz);
        const float currentMargin =
            humanSupportConeMargin(history.w, currentMagnitude, friction);
        const float3 impulse = humanSupportImpulse(history, normal);
        bool rowValid = all(isfinite(history)) && finite3(correction) &&
            state <= 2u && coneState <= 1u &&
            (state == 0u || coneState == 0u) &&
            humanSupportStoredHistoryAdmissible(
                history, normal, friction, false);
        float4 diagnostics = float4(
            history.w, currentMagnitude, currentMargin, friction);
        if (rowValid && state != 0u) {
            const float4 nextHistory =
                humanSupportInactiveSharedStep(history, alpha);
            const float nextMagnitude =
                humanSupportTangentMagnitude(nextHistory.xyz);
            const float nextMargin =
                humanSupportConeMargin(
                    nextHistory.w, nextMagnitude, friction);
            rowValid = all(correction == -impulse) &&
                humanSupportStoredHistoryAdmissible(
                    nextHistory, normal, friction, false);
            diagnostics = float4(nextHistory.w,
                nextMagnitude, nextMargin, float(state));
        } else if (rowValid && coneState == 1u) {
            const float targetMagnitude =
                humanSupportTangentMagnitude(target.xyz);
            const float targetMargin = humanSupportConeMargin(
                target.w, targetMagnitude, friction);
            const float targetInteriorMargin = humanSupportConeInteriorMargin(
                target.w, targetMagnitude, friction);
            const bool canonicalTarget = target.w == 0.0f &&
                all(target.xyz == float3(0.0f));
            const float3 targetImpulse = humanSupportImpulse(target, normal);
            const float4 nextHistory = humanSupportConeSharedStep(
                history, target, alpha);
            const float nextMagnitude =
                humanSupportTangentMagnitude(nextHistory.xyz);
            const float nextMargin =
                humanSupportConeMargin(
                    nextHistory.w, nextMagnitude, friction);
            rowValid = all(isfinite(target)) &&
                all(correction == targetImpulse - impulse) &&
                isfinite(targetMargin) &&
                (canonicalTarget || targetMargin >= targetInteriorMargin) &&
                humanSupportStoredHistoryAdmissible(
                    target, normal, friction, true) &&
                humanSupportStoredHistoryAdmissible(
                    nextHistory, normal, friction, false);
            diagnostics = float4(nextHistory.w,
                nextMagnitude, nextMargin, targetMargin);
        } else if (rowValid) {
            const float3 next = humanSupportFreeSharedStep(
                impulse, correction, alpha);
            const float nextNormal =
                humanSupportTangentProjection(next, normal);
            const float3 nextTangent =
                fma(float3(-nextNormal), normal, next);
            const float nextMagnitude =
                humanSupportTangentMagnitude(nextTangent);
            const float nextMargin =
                humanSupportConeMargin(nextNormal, nextMagnitude, friction);
            rowValid = humanSupportFreeConeFeasible(
                impulse, correction, alpha, normal, friction, false);
            diagnostics = float4(nextNormal,
                nextMagnitude, nextMargin, friction);
        }
        if (!rowValid) {
            valid = false;
            recordFailure(statuses[environment], NM_STATUS_CONTACT_FAILURE,
                NM_INVALID_INDEX, row, diagnostics);
        }
    }
    const bool environmentValid = simd_all(valid);
    if (environmentValid) return;
    if (lane == 0u) environmentLineSearch[environment] = 0.0f;
    for (uint object = lane; object < dispatch.objectCount; object += 32u)
        objectLineSearch[objectBase + object].x = 0.0f;
}

kernel void nm_human_support_apply_solution(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMFGMRESLayoutGPU& layout [[buffer(30)]],
    constant NMHumanSupportDispatchGPU& support [[buffer(1)]],
    device const float4* solution [[buffer(2)]],
    device const float* environmentLineSearch [[buffer(3)]],
    device float4* histories [[buffer(4)]],
    device uint* workingSet [[buffer(5)]],
    device const uint* changed [[buffer(6)]],
    device NMMatterStatusGPU* statuses [[buffer(7)]],
    device const NMHumanSupportContactGPU* contacts [[buffer(8)]],
    device uint* coneWorkingSet [[buffer(9)]],
    device const float4* coneTargets [[buffer(10)]],
    uint global [[thread_position_in_grid]]
) {
    if (global >= dispatch.environmentCount * support.contactCount) return;
    const uint environment = global / support.contactCount;
    if (!environmentHealthy(statuses, environment) ||
        changed[environment] != 0u) return;
    const float alpha = environmentLineSearch[environment];
    if (alpha == 0.0f) return;
    const float3 normal = support.groundNormal.xyz;
    const float4 history = histories[global];
    const uint state = workingSet[global];
    const uint coneState = coneWorkingSet[global];
    const uint row = global - environment * support.contactCount;
    const float friction = contacts[row].frictionSlopAndStabilization.x;
    if (!isfinite(alpha) || !(alpha > 0.0f) || alpha > 1.0f ||
        !all(isfinite(history)) || state > 2u || coneState > 1u ||
        (state != 0u && coneState != 0u) || history.w < 0.0f ||
        !finiteNonnegativeNormalOrZero(friction)) {
        recordFailure(statuses[environment], NM_STATUS_CONTACT_FAILURE,
            NM_INVALID_INDEX, row,
            float4(alpha, history.w, float(state), float(coneState)));
        return;
    }
    if (state != 0u) {
        // Scaling the stored tangent and normal together is the exact shared
        // alpha application of delta-lambda=-lambda. Alpha one writes a
        // canonical zero, without a component-wise projection.
        const float4 nextHistory =
            humanSupportInactiveSharedStep(history, alpha);
        if (!humanSupportStoredHistoryAdmissible(
                nextHistory, normal, friction, false)) {
            const float tangentMagnitude =
                humanSupportTangentMagnitude(nextHistory.xyz);
            recordFailure(statuses[environment], NM_STATUS_CONTACT_FAILURE,
                NM_INVALID_INDEX, row,
                float4(nextHistory.w, tangentMagnitude,
                    humanSupportConeMargin(
                        nextHistory.w, tangentMagnitude, friction),
                    float(state)));
            return;
        }
        histories[global] = nextHistory;
        workingSet[global] = 2u;
        return;
    }
    if (coneState == 1u) {
        const float4 target = coneTargets[global];
        const float targetMagnitude =
            humanSupportTangentMagnitude(target.xyz);
        const float targetMargin =
            humanSupportConeMargin(target.w, targetMagnitude, friction);
        const float4 nextHistory = humanSupportConeSharedStep(
            history, target, alpha);
        const float nextMagnitude =
            humanSupportTangentMagnitude(nextHistory.xyz);
        const float nextMargin =
            humanSupportConeMargin(
                nextHistory.w, nextMagnitude, friction);
        if (!all(isfinite(target)) ||
            !isfinite(targetMargin) ||
            !humanSupportStoredHistoryAdmissible(
                target, normal, friction, true) ||
            !humanSupportStoredHistoryAdmissible(
                nextHistory, normal, friction, false)) {
            recordFailure(statuses[environment], NM_STATUS_CONTACT_FAILURE,
                NM_INVALID_INDEX, row,
                float4(nextHistory.w, nextMagnitude,
                    nextMargin, targetMargin));
            return;
        }
        histories[global] = nextHistory;
        // A cone target is a one-step retraction of the natural semismooth
        // Newton direction, not a persistent substitute equation. Even when a
        // different block shortens the shared step, the accepted chord remains
        // feasible by convexity and the next assembly must restore the natural
        // Coulomb residual immediately.
        coneWorkingSet[global] = 0u;
        return;
    }
    const float3 impulse = humanSupportImpulse(history, normal);
    const float3 next = humanSupportFreeSharedStep(
        impulse, solution[layout.supportBase + global].xyz, alpha);
    const float normalImpulse =
        humanSupportTangentProjection(next, normal);
    const float3 tangentImpulse =
        fma(float3(-normalImpulse), normal, next);
    const float tangentMagnitude =
        humanSupportTangentMagnitude(tangentImpulse);
    const float coneMargin =
        humanSupportConeMargin(normalImpulse, tangentMagnitude, friction);
    const float4 nextHistory = normalImpulse == 0.0f
        ? float4(0.0f) : float4(tangentImpulse, normalImpulse);
    if (!finite3(next) || !isfinite(normalImpulse) ||
        (normalImpulse == 0.0f &&
         any(tangentImpulse != float3(0.0f))) ||
        !humanSupportStoredHistoryAdmissible(
            nextHistory, normal, friction, false)) {
        recordFailure(statuses[environment], NM_STATUS_CONTACT_FAILURE,
            NM_INVALID_INDEX, row,
            float4(normalImpulse, tangentMagnitude,
                coneMargin, friction));
        return;
    }
    histories[global] = nextHistory;
}

kernel void nm_human_support_certify(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMFGMRESLayoutGPU& layout [[buffer(30)]],
    constant NMMixedSolverGPU& solver [[buffer(1)]],
    device const float4* residual [[buffer(2)]],
    device const NMFGMRESStateGPU* states [[buffer(3)]],
    device NMMatterStatusGPU* statuses [[buffer(4)]],
    device const float4* supportHistories [[buffer(5)]],
    constant NMHumanSupportDispatchGPU& support [[buffer(6)]],
    device const NMHumanSupportContactGPU* contacts [[buffer(7)]],
    uint lane [[thread_index_in_threadgroup]],
    uint environment [[threadgroup_position_in_grid]]
) {
    if (lane >= 32u || environment >= dispatch.environmentCount ||
        layout.supportContactCount == 0u ||
        !environmentHealthy(statuses, environment)) return;
    float norm2 = 0.0f;
    for (uint row = lane; row < layout.supportContactCount; row += 32u) {
        const float3 value = residual[layout.supportBase +
            environment * layout.supportContactCount + row].xyz;
        norm2 += dot(value, value);
    }
    const float supportNorm2 = norm2;
    float rigidNorm2 = 0.0f;
    // Also covers a rigid-only Human with no continuum object certificate.
    for (uint dof = lane; dof < dispatch.rigidGeneralizedCapacity; dof += 32u) {
        const float value = residual[fgmresRigidIndex(dispatch, environment, dof)].x;
        norm2 += value * value;
        rigidNorm2 += value * value;
    }
    norm2 = simd_sum(norm2);
    const float norm = sqrt(norm2);
    const float supportNorm = sqrt(simd_sum(supportNorm2));
    const float rigidNorm = sqrt(simd_sum(rigidNorm2));
    const float threshold = max(solver.regularization.x,
        solver.residualTolerances.x * max(min(states[environment].nonlinear.x,
            states[environment].nonlinear.y), 1.0f));
    bool invalidSupportImpulse = false;
    float4 invalidSupportDiagnostics = float4(0.0f);
    uint invalidSupportRow = NM_INVALID_INDEX;
    if (lane == 0u) {
        const float3 normal = support.groundNormal.xyz;
        for (uint row = 0u; row < layout.supportContactCount; ++row) {
            const float4 history = supportHistories[
                environment * layout.supportContactCount + row];
            const float normalImpulse = history.w;
            const float tangentMagnitude =
                humanSupportTangentMagnitude(history.xyz);
            const float friction = contacts[row].frictionSlopAndStabilization.x;
            const float coneMargin = humanSupportConeMargin(
                normalImpulse, tangentMagnitude, friction);
            const float tolerance = 8.0f * kEpsilon *
                max(1.0f, max(tangentMagnitude, normalImpulse));
            if (!humanSupportStoredHistoryAdmissible(
                    history, normal, friction, false)) {
                invalidSupportImpulse = true;
                invalidSupportDiagnostics = float4(
                    normalImpulse, tangentMagnitude, coneMargin, tolerance);
                invalidSupportRow = row;
                break;
            }
        }
    }
    if (lane == 0u && (!isfinite(norm) || norm > threshold))
        recordFailure(statuses[environment], NM_STATUS_NONLINEAR_SOLVER_FAILURE,
            NM_INVALID_INDEX, NM_INVALID_INDEX, float4(norm, threshold, supportNorm, rigidNorm));
    if (lane == 0u && invalidSupportImpulse)
        recordFailure(statuses[environment], NM_STATUS_CONTACT_FAILURE,
            NM_INVALID_INDEX, invalidSupportRow,
            invalidSupportDiagnostics);
}

kernel void nm_matter_capture_first_failure(
    device const NMMatterStatusGPU* statuses [[buffer(0)]],
    device const NMSolverCertificateGPU* certificates [[buffer(1)]],
    device NMMatterFirstFailureCaptureGPU* captures [[buffer(2)]],
    constant nm_uint4& context [[buffer(3)]],
    uint environment [[thread_position_in_grid]]
) {
    if (environment >= context.w ||
        captures[environment].capture.x != 0u) return;
    const NMMatterStatusGPU observed = statuses[environment];
    if (observed.code == NM_STATUS_SUCCESS) return;
    NMMatterFirstFailureCaptureGPU record = {};
    record.capture.x = 1u;
    record.capture.y = context.x;
    record.capture.z = context.y;
    record.capture.w = context.z;
    record.status = observed;
    record.certificate = certificates[environment];
    captures[environment] = record;
}

} // namespace numi_matter_metal

#include <metal_stdlib>

using namespace metal;

// Private, bounded CGLS vector recurrences for the existing matrix-free FEM
// operator.  These kernels never write production FGMRES state, histories,
// acceptance metrics, or certificates.  The host must gate this path to the
// exact two-block FEM layout U = 2 * environmentCount * femNodeCount, with
// field rows present only as zero-valued backing rows.
namespace numi_matter_metal {

constant uint kBaseCGLSRunning = 1u;
constant uint kBaseCGLSExhausted = 2u;
constant uint kBaseCGLSZeroNormalResidual = 3u;
constant uint kBaseCGLSBreakdown = 4u;
constant uint kBaseCGLSInvalidInput = 5u;

constant uint kBaseCGLSErrorBadShape = 1u;
constant uint kBaseCGLSErrorBadSelection = 2u;
constant uint kBaseCGLSErrorNonfinite = 4u;
constant uint kBaseCGLSErrorBadMask = 8u;
constant uint kBaseCGLSErrorNonzeroConstrainedRow = 16u;
constant uint kBaseCGLSErrorBadDenominator = 32u;
constant uint kBaseCGLSErrorInvalidRightScale = 64u;
constant uint kBaseCGLSErrorUnsupportedConstraint = 128u;

inline bool baseCGLSFinite4(const float4 value) {
    return all(isfinite(value));
}

inline bool baseCGLSZero4(const float4 value) {
    return all(value == float4(0.0f));
}

inline bool baseCGLSMaskComponent(const float value) {
    return value == 0.0f || value == 1.0f;
}

inline bool baseCGLSVectorLayoutValid(const uint unknownCount,
                                      const uint environmentCount) {
    return environmentCount > 0u && unknownCount > 0u &&
        environmentCount <= 0x7fffffffu &&
        unknownCount % (2u * environmentCount) == 0u &&
        unknownCount / (2u * environmentCount) > 0u;
}

inline void baseCGLSMarkError(
    device atomic_uint* errors,
    const uint environment,
    const uint errorBits
) {
    atomic_fetch_or_explicit(&errors[environment], errorBits,
        memory_order_relaxed);
}

inline void baseCGLSCompensatedAdd(
    thread float& sum,
    thread float& correction,
    const float value
) {
    const float adjusted = value - correction;
    const float next = sum + adjusted;
    correction = (next - sum) - adjusted;
    sum = next;
}

// Replace the private CGLS right-hand side with the fresh residual of the
// retained Newton solution. The production solution itself is read-only here
// and remains available as x0 until the final strict residual comparison.
kernel void nm_fgmres_base_cgls_seed_residual(
    constant uint& unknownCount [[buffer(0)]],
    constant uint& environmentCount [[buffer(1)]],
    device const float4* rowMask [[buffer(2)]],
    device const uint* rowEnvironment [[buffer(3)]],
    device const uint* selected [[buffer(4)]],
    device const float4* baseRHS [[buffer(5)]],
    device const float4* initialSolution [[buffer(6)]],
    device const float4* initialAction [[buffer(7)]],
    device float4* residualRHS [[buffer(8)]],
    device atomic_uint* errors [[buffer(9)]],
    uint index [[thread_position_in_grid]]) {
    if (index >= unknownCount) return;
    if (!baseCGLSVectorLayoutValid(unknownCount, environmentCount)) {
        if (environmentCount > 0u)
            baseCGLSMarkError(errors, 0u, kBaseCGLSErrorBadShape);
        residualRHS[index] = float4(0.0f);
        return;
    }

    const uint mechanicalRows = unknownCount / 2u;
    const uint nodeCount = mechanicalRows / environmentCount;
    const bool fieldRow = index >= mechanicalRows;
    const uint local = fieldRow ? index - mechanicalRows : index;
    const uint environment = local / nodeCount;
    if (environment >= environmentCount ||
        rowEnvironment[index] != environment) {
        baseCGLSMarkError(errors, environment < environmentCount ? environment : 0u,
            kBaseCGLSErrorBadShape);
        residualRHS[index] = float4(0.0f);
        return;
    }
    const uint selectedValue = selected[environment];
    if (selectedValue > 1u) {
        baseCGLSMarkError(errors, environment, kBaseCGLSErrorBadSelection);
        residualRHS[index] = float4(0.0f);
        return;
    }
    const float4 mask = rowMask[index];
    const float4 b = baseRHS[index];
    const float4 x0 = initialSolution[index];
    const float4 ax0 = initialAction[index];
    bool valid = selectedValue <= 1u && baseCGLSFinite4(mask) &&
        baseCGLSFinite4(b) && baseCGLSFinite4(x0) &&
        baseCGLSFinite4(ax0) && mask.w == 0.0f && b.w == 0.0f &&
        x0.w == 0.0f && ax0.w == 0.0f;
    if (!valid) {
        baseCGLSMarkError(errors, environment,
            kBaseCGLSErrorNonfinite | kBaseCGLSErrorBadMask);
        residualRHS[index] = float4(0.0f);
        return;
    }
    if (fieldRow) {
        if (!baseCGLSZero4(mask) || !baseCGLSZero4(b) ||
            !baseCGLSZero4(x0) || !baseCGLSZero4(ax0)) {
            baseCGLSMarkError(errors, environment,
                kBaseCGLSErrorNonzeroConstrainedRow);
        }
        residualRHS[index] = float4(0.0f);
        return;
    }
    if (selectedValue == 0u) {
        if (!baseCGLSZero4(mask) || !baseCGLSZero4(b) ||
            !baseCGLSZero4(x0) || !baseCGLSZero4(ax0)) {
            baseCGLSMarkError(errors, environment,
                kBaseCGLSErrorNonzeroConstrainedRow);
        }
        residualRHS[index] = float4(0.0f);
        return;
    }
    if (!baseCGLSMaskComponent(mask.x) ||
        !baseCGLSMaskComponent(mask.y) ||
        !baseCGLSMaskComponent(mask.z)) {
        baseCGLSMarkError(errors, environment, kBaseCGLSErrorBadMask);
        residualRHS[index] = float4(0.0f);
        return;
    }
    if (any((mask.xyz == float3(0.0f)) &
            ((b.xyz != float3(0.0f)) | (x0.xyz != float3(0.0f))))) {
        baseCGLSMarkError(errors, environment,
            kBaseCGLSErrorNonzeroConstrainedRow);
        residualRHS[index] = float4(0.0f);
        return;
    }
    const float3 residual = (b.xyz - ax0.xyz) * mask.xyz;
    if (!all(isfinite(residual))) {
        baseCGLSMarkError(errors, environment, kBaseCGLSErrorNonfinite);
        residualRHS[index] = float4(0.0f);
        return;
    }
    residualRHS[index] = float4(residual, 0.0f);
}

// Convert the converged correction y into the total candidate x0+S*y in
// private CGLS scratch. This never writes the production solution buffer.
kernel void nm_fgmres_base_cgls_add_initial_solution(
    constant uint& unknownCount [[buffer(0)]],
    constant uint& environmentCount [[buffer(1)]],
    device const float4* rowMask [[buffer(2)]],
    device const uint* rowEnvironment [[buffer(3)]],
    device const uint* selected [[buffer(4)]],
    device const float4* initialSolution [[buffer(5)]],
    device float4* candidateSolution [[buffer(6)]],
    device atomic_uint* errors [[buffer(7)]],
    device const float4* metrics [[buffer(8)]],
    uint index [[thread_position_in_grid]]) {
    if (index >= unknownCount) return;
    if (!baseCGLSVectorLayoutValid(unknownCount, environmentCount)) {
        if (environmentCount > 0u)
            baseCGLSMarkError(errors, 0u, kBaseCGLSErrorBadShape);
        candidateSolution[index] = float4(0.0f);
        return;
    }
    const uint mechanicalRows = unknownCount / 2u;
    const uint nodeCount = mechanicalRows / environmentCount;
    const bool fieldRow = index >= mechanicalRows;
    const uint local = fieldRow ? index - mechanicalRows : index;
    const uint environment = local / nodeCount;
    if (environment >= environmentCount ||
        rowEnvironment[index] != environment) {
        baseCGLSMarkError(errors, environment < environmentCount ? environment : 0u,
            kBaseCGLSErrorBadShape);
        candidateSolution[index] = float4(0.0f);
        return;
    }
    // Preserve the unfinished private correction on the exact warm-only
    // finite-breakdown decline; x0 remains the production solution.
    if (metrics[environment].w == 5.0f) return;
    const uint selectedValue = selected[environment];
    if (selectedValue > 1u) {
        baseCGLSMarkError(errors, environment, kBaseCGLSErrorBadSelection);
        candidateSolution[index] = float4(0.0f);
        return;
    }
    const float4 mask = rowMask[index];
    const float4 initial = initialSolution[index];
    const float4 correction = candidateSolution[index];
    bool valid = selectedValue <= 1u && baseCGLSFinite4(mask) &&
        baseCGLSFinite4(initial) && baseCGLSFinite4(correction) &&
        mask.w == 0.0f && initial.w == 0.0f && correction.w == 0.0f;
    if (!valid) {
        baseCGLSMarkError(errors, environment,
            kBaseCGLSErrorNonfinite | kBaseCGLSErrorBadMask);
        candidateSolution[index] = float4(0.0f);
        return;
    }
    if (fieldRow || selectedValue == 0u) {
        if (!baseCGLSZero4(mask) || !baseCGLSZero4(initial) ||
            !baseCGLSZero4(correction)) {
            baseCGLSMarkError(errors, environment,
                kBaseCGLSErrorNonzeroConstrainedRow);
        }
        candidateSolution[index] = float4(0.0f);
        return;
    }
    if (!baseCGLSMaskComponent(mask.x) ||
        !baseCGLSMaskComponent(mask.y) ||
        !baseCGLSMaskComponent(mask.z) ||
        any((mask.xyz == float3(0.0f)) &
            ((initial.xyz != float3(0.0f)) |
             (correction.xyz != float3(0.0f))))) {
        baseCGLSMarkError(errors, environment,
            kBaseCGLSErrorNonzeroConstrainedRow | kBaseCGLSErrorBadMask);
        candidateSolution[index] = float4(0.0f);
        return;
    }
    const float3 total = initial.xyz + correction.xyz;
    if (!all(isfinite(total))) {
        baseCGLSMarkError(errors, environment, kBaseCGLSErrorNonfinite);
        candidateSolution[index] = float4(0.0f);
        return;
    }
    candidateSolution[index] = float4(total * mask.xyz, 0.0f);
}

// Per-environment state layout:
//   scalars = (gamma, alpha, beta, ||b||^2)
//   control = (status, completed_iterations, iteration_cap, selected)
// errors is a uint32 bitmask per environment and must be zeroed here.
kernel void nm_fgmres_base_cgls_initialize_state(
    constant uint& environmentCount [[buffer(0)]],
    constant uint& iterationCap [[buffer(1)]],
    device const uint* selected [[buffer(2)]],
    device float4* scalars [[buffer(3)]],
    device uint4* control [[buffer(4)]],
    device atomic_uint* errors [[buffer(5)]],
    uint environment [[thread_position_in_grid]]) {
    if (environment >= environmentCount) return;

    const uint selectedValue = selected[environment];
    const bool shapeValid = environmentCount > 0u &&
        (iterationCap == 32u || iterationCap == 64u);
    const bool selectionValid = selectedValue <= 1u;
    const uint status = !shapeValid || !selectionValid
        ? kBaseCGLSInvalidInput
        : (selectedValue != 0u ? kBaseCGLSRunning : 0u);
    scalars[environment] = float4(0.0f);
    control[environment] = uint4(status, 0u, iterationCap,
        selectionValid ? selectedValue : 0u);
    atomic_store_explicit(&errors[environment],
        !shapeValid ? kBaseCGLSErrorBadShape :
        (!selectionValid ? kBaseCGLSErrorBadSelection : 0u),
        memory_order_relaxed);
}

// Input vectors b and A^T b are full float4 row arrays.  ATb and s may be the
// same buffer (the runtime contract uses that alias); the kernel masks s in
// place and initializes private x/r/p/q.  In this strict layout, the first
// E*N rows are mechanics and the second E*N rows are field backing.  Each
// environment's mechanical node rows are contiguous within the first block.
kernel void nm_fgmres_base_cgls_initialize_vectors(
    constant uint& unknownCount [[buffer(0)]],
    constant uint& environmentCount [[buffer(1)]],
    device const float4* rowMask [[buffer(2)]],
    device const uint* rowEnvironment [[buffer(3)]],
    device const uint* selected [[buffer(4)]],
    device const float4* rhs [[buffer(5)]],
    device const float4* ATb [[buffer(6)]],
    device float4* x [[buffer(7)]],
    device float4* r [[buffer(8)]],
    device float4* s [[buffer(9)]],
    device float4* p [[buffer(10)]],
    device float4* q [[buffer(11)]],
    device atomic_uint* errors [[buffer(12)]],
    constant uint& useRightScale [[buffer(13)]],
    device const float4* rightScaleRows [[buffer(14)]],
    uint index [[thread_position_in_grid]]) {
    if (index >= unknownCount) return;

    const uint mechanicalRows = unknownCount / 2u;
    const bool shapeValid = baseCGLSVectorLayoutValid(unknownCount,
                                                       environmentCount);
    if (!shapeValid) {
        if (environmentCount > 0u)
            baseCGLSMarkError(errors, 0u, kBaseCGLSErrorBadShape);
        x[index] = r[index] = s[index] = p[index] = q[index] = float4(0.0f);
        return;
    }

    const uint nodeCount = mechanicalRows / environmentCount;
    const uint localIndex = index < mechanicalRows ? index : index - mechanicalRows;
    const uint expectedEnvironment = localIndex / nodeCount;
    const uint environment = rowEnvironment[index];
    if (environment >= environmentCount) {
        baseCGLSMarkError(errors, 0u, kBaseCGLSErrorBadShape);
        x[index] = r[index] = s[index] = p[index] = q[index] = float4(0.0f);
        return;
    }
    if (environment != expectedEnvironment) {
        baseCGLSMarkError(errors, environment, kBaseCGLSErrorBadShape);
    }
    const uint selectedValue = selected[environment];
    if (selectedValue > 1u)
        baseCGLSMarkError(errors, environment, kBaseCGLSErrorBadSelection);

    const float4 mask = rowMask[index];
    const float4 b = rhs[index];
    const float4 atb = ATb[index];
    bool valid = baseCGLSFinite4(mask) && baseCGLSFinite4(b) &&
        baseCGLSFinite4(atb) && mask.w == 0.0f && b.w == 0.0f &&
        atb.w == 0.0f && baseCGLSMaskComponent(mask.x) &&
        baseCGLSMaskComponent(mask.y) && baseCGLSMaskComponent(mask.z);
    if (!valid) baseCGLSMarkError(errors, environment,
        kBaseCGLSErrorNonfinite | kBaseCGLSErrorBadMask);

    // The unselected quiet environment is part of this strict two-environment
    // layout, not an ignored tail. Reject any stale mechanical or field data
    // before clearing its private vectors.
    if (selectedValue == 0u) {
        if (!baseCGLSZero4(mask) || !baseCGLSZero4(b) ||
            !baseCGLSZero4(atb)) {
            baseCGLSMarkError(errors, environment,
                kBaseCGLSErrorNonzeroConstrainedRow);
        }
        x[index] = r[index] = s[index] = p[index] = q[index] = float4(0.0f);
        return;
    }

    const bool fieldRow = index >= mechanicalRows;
    float4 effectiveMask = float4(0.0f);
    if (!fieldRow) effectiveMask = float4(mask.xyz, 0.0f);
    if (fieldRow && (!baseCGLSZero4(mask) || !baseCGLSZero4(b) ||
                     !baseCGLSZero4(atb))) {
        baseCGLSMarkError(errors, environment,
            kBaseCGLSErrorNonzeroConstrainedRow);
    }
    const float4 constrained = float4(1.0f) - effectiveMask;
    const bool hasConstrainedInput = any(
        (constrained.xyz != float3(0.0f)) &
        ((b.xyz != float3(0.0f)) | (atb.xyz != float3(0.0f))));
    if (!fieldRow && hasConstrainedInput) {
        baseCGLSMarkError(errors, environment,
            kBaseCGLSErrorNonzeroConstrainedRow);
    }

    const float4 maskedB = float4(b.xyz * effectiveMask.xyz, 0.0f);
    float4 maskedATb = float4(atb.xyz * effectiveMask.xyz, 0.0f);
    if (useRightScale != 0u && !fieldRow &&
        all(effectiveMask.xyz == float3(1.0f))) {
        const uint node = index - environment * nodeCount;
        const uint base = (environment * nodeCount + node) * 3u;
        const float4 row0 = rightScaleRows[base];
        const float4 row1 = rightScaleRows[base + 1u];
        const float4 row2 = rightScaleRows[base + 2u];
        const float3 value = maskedATb.xyz;
        maskedATb = float4(
            dot(float3(row0.x, row1.x, row2.x), value),
            dot(float3(row0.y, row1.y, row2.y), value),
            dot(float3(row0.z, row1.z, row2.z), value), 0.0f);
        if (!baseCGLSFinite4(row0) || !baseCGLSFinite4(row1) ||
            !baseCGLSFinite4(row2) || row0.w != 1.0f ||
            row1.w != 0.0f || row2.w != 0.0f ||
            !baseCGLSFinite4(maskedATb)) {
            baseCGLSMarkError(errors, environment,
                kBaseCGLSErrorInvalidRightScale);
            maskedATb = float4(0.0f);
        }
    }
    x[index] = float4(0.0f);
    r[index] = maskedB;
    s[index] = maskedATb;
    p[index] = maskedATb;
    q[index] = float4(0.0f);
}

// One 32-lane SIMD group per environment. Host dispatch contract is exactly
// (environmentCount,1,1) threadgroups with (32,1,1) threads per group.
kernel void nm_fgmres_base_cgls_measure_initial(
    constant uint& unknownCount [[buffer(0)]],
    constant uint& environmentCount [[buffer(1)]],
    device const float4* rowMask [[buffer(2)]],
    device const uint* rowEnvironment [[buffer(3)]],
    device const float4* rhs [[buffer(4)]],
    device const float4* r [[buffer(5)]],
    device const float4* s [[buffer(6)]],
    device float4* scalars [[buffer(7)]],
    device uint4* control [[buffer(8)]],
    device atomic_uint* errors [[buffer(9)]],
    uint lane [[thread_index_in_simdgroup]],
    uint environment [[threadgroup_position_in_grid]]) {
    if (environment >= environmentCount) return;
    if (control[environment].x != kBaseCGLSRunning) return;
    if (!baseCGLSVectorLayoutValid(unknownCount, environmentCount)) {
        if (lane == 0u) {
            baseCGLSMarkError(errors, environment, kBaseCGLSErrorBadShape);
            control[environment].x = kBaseCGLSInvalidInput;
        }
        return;
    }

    const uint mechanicalRows = unknownCount / 2u;
    const uint nodeCount = mechanicalRows / environmentCount;
    float gamma = 0.0f, gammaCorrection = 0.0f;
    float bNorm2 = 0.0f, bCorrection = 0.0f;
    uint errorBits = 0u;
    for (uint local = lane; local < 2u * nodeCount; local += 32u) {
        const uint index = local < nodeCount
            ? environment * nodeCount + local
            : mechanicalRows + environment * nodeCount + (local - nodeCount);
        if (rowEnvironment[index] != environment) {
            errorBits |= kBaseCGLSErrorBadShape;
            continue;
        }
        const float4 mask = rowMask[index];
        const float4 ri = r[index];
        const float4 si = s[index];
        const float4 bi = rhs[index];
        if (!baseCGLSFinite4(ri) || !baseCGLSFinite4(si) ||
            !baseCGLSFinite4(bi)) {
            errorBits |= kBaseCGLSErrorNonfinite;
            continue;
        }
        if (local >= nodeCount) {
            if (!baseCGLSZero4(ri) || !baseCGLSZero4(si) ||
                !baseCGLSZero4(bi))
                errorBits |= kBaseCGLSErrorNonzeroConstrainedRow;
            continue;
        }
        if (mask.w != 0.0f || any((mask.xyz == float3(0.0f)) &
            ((ri.xyz != float3(0.0f)) | (si.xyz != float3(0.0f))))) {
            errorBits |= kBaseCGLSErrorNonzeroConstrainedRow;
        }
        const float3 mr = ri.xyz * mask.xyz;
        const float3 ms = si.xyz * mask.xyz;
        baseCGLSCompensatedAdd(gamma, gammaCorrection, dot(ms, ms));
        baseCGLSCompensatedAdd(bNorm2, bCorrection, dot(mr, mr));
    }
    gamma = simd_sum(gamma);
    bNorm2 = simd_sum(bNorm2);
    const uint errorsFound = simd_or(errorBits);
    if (lane != 0u) return;
    if (errorsFound != 0u ||
        atomic_load_explicit(&errors[environment], memory_order_relaxed) != 0u) {
        baseCGLSMarkError(errors, environment, errorsFound);
        control[environment].x = kBaseCGLSInvalidInput;
        return;
    }
    if (!isfinite(gamma) || !isfinite(bNorm2) || gamma < 0.0f ||
        bNorm2 < 0.0f) {
        baseCGLSMarkError(errors, environment, kBaseCGLSErrorNonfinite);
        control[environment].x = kBaseCGLSInvalidInput;
        return;
    }
    scalars[environment] = float4(gamma, 0.0f, 0.0f, bNorm2);
    if (gamma == 0.0f || bNorm2 == 0.0f) {
        control[environment].x = kBaseCGLSZeroNormalResidual;
        return;
    }
}

kernel void nm_fgmres_base_cgls_form_alpha(
    constant uint& unknownCount [[buffer(0)]],
    constant uint& environmentCount [[buffer(1)]],
    device const float4* rowMask [[buffer(2)]],
    device const uint* rowEnvironment [[buffer(3)]],
    device const float4* q [[buffer(4)]],
    device float4* scalars [[buffer(5)]],
    device uint4* control [[buffer(6)]],
    device atomic_uint* errors [[buffer(7)]],
    device const float4* p [[buffer(8)]],
    constant float& dampingSquared [[buffer(9)]],
    uint lane [[thread_index_in_simdgroup]],
    uint environment [[threadgroup_position_in_grid]]) {
    if (environment >= environmentCount) return;
    if (control[environment].x != kBaseCGLSRunning) return;
    if (!baseCGLSVectorLayoutValid(unknownCount, environmentCount)) {
        if (lane == 0u) {
            baseCGLSMarkError(errors, environment, kBaseCGLSErrorBadShape);
            control[environment].x = kBaseCGLSInvalidInput;
        }
        return;
    }
    const uint mechanicalRows = unknownCount / 2u;
    const uint nodeCount = mechanicalRows / environmentCount;
    float qNorm2 = 0.0f, correction = 0.0f;
    uint errorBits = (!isfinite(dampingSquared) || dampingSquared < 0.0f)
        ? kBaseCGLSErrorNonfinite : 0u;
    for (uint local = lane; local < 2u * nodeCount; local += 32u) {
        const uint index = local < nodeCount
            ? environment * nodeCount + local
            : mechanicalRows + environment * nodeCount + (local - nodeCount);
        const float4 value = q[index];
        if (rowEnvironment[index] != environment || !baseCGLSFinite4(value)) {
            errorBits |= rowEnvironment[index] != environment
                ? kBaseCGLSErrorBadShape : kBaseCGLSErrorNonfinite;
            continue;
        }
        const float4 mask = rowMask[index];
        if (mask.w != 0.0f) errorBits |= kBaseCGLSErrorBadMask;
        if (local >= nodeCount) {
            if (!baseCGLSZero4(value)) errorBits |= kBaseCGLSErrorNonzeroConstrainedRow;
            continue;
        }
        if (any((mask.xyz == float3(0.0f)) &
                (value.xyz != float3(0.0f))))
            errorBits |= kBaseCGLSErrorNonzeroConstrainedRow;
        const float3 active = value.xyz * mask.xyz;
        baseCGLSCompensatedAdd(qNorm2, correction, dot(active, active));
        if (dampingSquared > 0.0f) {
            const float4 pi = p[index];
            if (!baseCGLSFinite4(pi)) {
                errorBits |= kBaseCGLSErrorNonfinite;
                continue;
            }
            const float3 activeP = pi.xyz * mask.xyz;
            if (!all(isfinite(activeP))) {
                errorBits |= kBaseCGLSErrorNonfinite;
                continue;
            }
            baseCGLSCompensatedAdd(qNorm2, correction,
                dampingSquared * dot(activeP, activeP));
        }
    }
    qNorm2 = simd_sum(qNorm2);
    errorBits = simd_or(errorBits);
    if (lane != 0u) return;
    if (errorBits != 0u ||
        atomic_load_explicit(&errors[environment], memory_order_relaxed) != 0u) {
        baseCGLSMarkError(errors, environment, errorBits);
        control[environment].x = kBaseCGLSInvalidInput;
        return;
    }
    const float gamma = scalars[environment].x;
    const float alpha = gamma / qNorm2;
    if (!isfinite(gamma) || gamma <= 0.0f || !isfinite(qNorm2) ||
        qNorm2 <= 0.0f || !isfinite(alpha) || alpha <= 0.0f) {
        baseCGLSMarkError(errors, environment, kBaseCGLSErrorBadDenominator);
        control[environment].x = kBaseCGLSBreakdown;
        return;
    }
    scalars[environment].y = alpha;
}

kernel void nm_fgmres_base_cgls_update_xr(
    constant uint& unknownCount [[buffer(0)]],
    constant uint& environmentCount [[buffer(1)]],
    device const float4* rowMask [[buffer(2)]],
    device const uint* rowEnvironment [[buffer(3)]],
    device const float4* scalars [[buffer(4)]],
    device const uint4* control [[buffer(5)]],
    device const float4* p [[buffer(6)]],
    device const float4* q [[buffer(7)]],
    device float4* x [[buffer(8)]],
    device float4* r [[buffer(9)]],
    device atomic_uint* errors [[buffer(10)]],
    uint index [[thread_position_in_grid]]) {
    if (index >= unknownCount || environmentCount == 0u) return;
    if (!baseCGLSVectorLayoutValid(unknownCount, environmentCount)) {
        baseCGLSMarkError(errors, 0u, kBaseCGLSErrorBadShape);
        return;
    }
    const uint mechanicalRows = unknownCount / 2u;
    const uint localIndex = index < mechanicalRows ? index : index - mechanicalRows;
    const uint nodeCount = mechanicalRows / environmentCount;
    const uint expectedEnvironment = localIndex / nodeCount;
    const uint environment = rowEnvironment[index];
    if (environment >= environmentCount) {
        baseCGLSMarkError(errors, 0u, kBaseCGLSErrorBadShape);
        return;
    }
    if (environment != expectedEnvironment) {
        baseCGLSMarkError(errors, environment, kBaseCGLSErrorBadShape);
        return;
    }
    if (control[environment].x != kBaseCGLSRunning) return;
    const float4 mask = rowMask[index];
    const float4 pi = p[index];
    const float4 qi = q[index];
    const float4 xi = x[index];
    const float4 ri = r[index];
    const float alpha = scalars[environment].y;
    if (!isfinite(alpha) || alpha <= 0.0f || !baseCGLSFinite4(pi) ||
        !baseCGLSFinite4(qi) || !baseCGLSFinite4(xi) ||
        !baseCGLSFinite4(ri) || !baseCGLSFinite4(mask)) {
        baseCGLSMarkError(errors, environment, kBaseCGLSErrorNonfinite);
        return;
    }
    const bool fieldRow = index >= mechanicalRows;
    if (fieldRow) {
        x[index] = r[index] = float4(0.0f);
        return;
    }
    const float3 active = mask.xyz;
    const float3 nextX = (xi.xyz + alpha * pi.xyz) * active;
    const float3 nextR = (ri.xyz - alpha * qi.xyz) * active;
    if (!all(isfinite(nextX)) || !all(isfinite(nextR))) {
        baseCGLSMarkError(errors, environment, kBaseCGLSErrorNonfinite);
        return;
    }
    x[index] = float4(nextX, 0.0f);
    r[index] = float4(nextR, 0.0f);
}

// Separate E-thread boundary after U-thread x/r updates avoids racing a
// per-environment iteration counter against vector workers.
kernel void nm_fgmres_base_cgls_complete_iteration(
    constant uint& environmentCount [[buffer(0)]],
    device uint4* control [[buffer(1)]],
    device atomic_uint* errors [[buffer(2)]],
    uint environment [[thread_position_in_grid]]) {
    if (environment >= environmentCount ||
        control[environment].x != kBaseCGLSRunning) return;
    if (atomic_load_explicit(&errors[environment], memory_order_relaxed) != 0u) {
        control[environment].x = kBaseCGLSInvalidInput;
        return;
    }
    const uint next = control[environment].y + 1u;
    if (next == 0u || next > control[environment].z) {
        control[environment].x = kBaseCGLSBreakdown;
        atomic_store_explicit(&errors[environment],
            kBaseCGLSErrorBadShape, memory_order_relaxed);
        return;
    }
    control[environment].y = next;
}

kernel void nm_fgmres_base_cgls_form_beta(
    constant uint& unknownCount [[buffer(0)]],
    constant uint& environmentCount [[buffer(1)]],
    device const float4* rowMask [[buffer(2)]],
    device const uint* rowEnvironment [[buffer(3)]],
    device float4* s [[buffer(4)]],
    device float4* scalars [[buffer(5)]],
    device uint4* control [[buffer(6)]],
    device atomic_uint* errors [[buffer(7)]],
    device const float4* x [[buffer(8)]],
    constant float& dampingSquared [[buffer(9)]],
    uint lane [[thread_index_in_simdgroup]],
    uint environment [[threadgroup_position_in_grid]]) {
    if (environment >= environmentCount) return;
    if (control[environment].x != kBaseCGLSRunning) return;
    if (!baseCGLSVectorLayoutValid(unknownCount, environmentCount)) {
        if (lane == 0u) {
            baseCGLSMarkError(errors, environment, kBaseCGLSErrorBadShape);
            control[environment].x = kBaseCGLSInvalidInput;
        }
        return;
    }
    const uint mechanicalRows = unknownCount / 2u;
    const uint nodeCount = mechanicalRows / environmentCount;
    float nextGamma = 0.0f, correction = 0.0f;
    uint errorBits = (!isfinite(dampingSquared) || dampingSquared < 0.0f)
        ? kBaseCGLSErrorNonfinite : 0u;
    for (uint local = lane; local < 2u * nodeCount; local += 32u) {
        const uint index = local < nodeCount
            ? environment * nodeCount + local
            : mechanicalRows + environment * nodeCount + (local - nodeCount);
        const float4 value = s[index];
        if (rowEnvironment[index] != environment || !baseCGLSFinite4(value)) {
            errorBits |= rowEnvironment[index] != environment
                ? kBaseCGLSErrorBadShape : kBaseCGLSErrorNonfinite;
            continue;
        }
        const float4 mask = rowMask[index];
        if (mask.w != 0.0f) errorBits |= kBaseCGLSErrorBadMask;
        if (local >= nodeCount) {
            if (!baseCGLSZero4(value)) errorBits |= kBaseCGLSErrorNonzeroConstrainedRow;
            continue;
        }
        if (any((mask.xyz == float3(0.0f)) &
                (value.xyz != float3(0.0f))))
            errorBits |= kBaseCGLSErrorNonzeroConstrainedRow;
        float4 gradient = value;
        if (dampingSquared > 0.0f) {
            const float4 xi = x[index];
            if (!baseCGLSFinite4(xi)) {
                errorBits |= kBaseCGLSErrorNonfinite;
                continue;
            }
            if (any((mask.xyz == float3(0.0f)) &
                    (xi.xyz != float3(0.0f)))) {
                errorBits |= kBaseCGLSErrorNonzeroConstrainedRow;
                continue;
            }
            gradient = float4(value.xyz - dampingSquared * xi.xyz, 0.0f);
            if (!baseCGLSFinite4(gradient)) {
                errorBits |= kBaseCGLSErrorNonfinite;
                continue;
            }
            s[index] = gradient;
        }
        const float3 active = gradient.xyz * mask.xyz;
        baseCGLSCompensatedAdd(nextGamma, correction, dot(active, active));
    }
    nextGamma = simd_sum(nextGamma);
    errorBits = simd_or(errorBits);
    if (lane != 0u) return;
    if (errorBits != 0u ||
        atomic_load_explicit(&errors[environment], memory_order_relaxed) != 0u) {
        baseCGLSMarkError(errors, environment, errorBits);
        control[environment].x = kBaseCGLSInvalidInput;
        return;
    }
    if (!isfinite(nextGamma) || nextGamma < 0.0f) {
        baseCGLSMarkError(errors, environment, kBaseCGLSErrorNonfinite);
        control[environment].x = kBaseCGLSBreakdown;
        return;
    }
    if (nextGamma == 0.0f) {
        scalars[environment].x = 0.0f;
        scalars[environment].z = 0.0f;
        control[environment].x = kBaseCGLSZeroNormalResidual;
        return;
    }
    const float oldGamma = scalars[environment].x;
    const float beta = nextGamma / oldGamma;
    if (!isfinite(oldGamma) || oldGamma <= 0.0f ||
        !isfinite(beta) || beta <= 0.0f) {
        baseCGLSMarkError(errors, environment, kBaseCGLSErrorBadDenominator);
        control[environment].x = kBaseCGLSBreakdown;
        return;
    }
    scalars[environment].x = nextGamma;
    scalars[environment].z = beta;
    if (control[environment].y >= control[environment].z) {
        // A completed cap is terminal unless exact A^T r == 0 above.
        control[environment].x = kBaseCGLSExhausted;
    }
}

kernel void nm_fgmres_base_cgls_update_p(
    constant uint& unknownCount [[buffer(0)]],
    constant uint& environmentCount [[buffer(1)]],
    device const float4* rowMask [[buffer(2)]],
    device const uint* rowEnvironment [[buffer(3)]],
    device const float4* scalars [[buffer(4)]],
    device const uint4* control [[buffer(5)]],
    device const float4* s [[buffer(6)]],
    device float4* p [[buffer(7)]],
    device atomic_uint* errors [[buffer(8)]],
    uint index [[thread_position_in_grid]]) {
    if (index >= unknownCount || environmentCount == 0u) return;
    if (!baseCGLSVectorLayoutValid(unknownCount, environmentCount)) {
        baseCGLSMarkError(errors, 0u, kBaseCGLSErrorBadShape);
        return;
    }
    const uint mechanicalRows = unknownCount / 2u;
    const uint localIndex = index < mechanicalRows ? index : index - mechanicalRows;
    const uint nodeCount = mechanicalRows / environmentCount;
    const uint expectedEnvironment = localIndex / nodeCount;
    const uint environment = rowEnvironment[index];
    if (environment >= environmentCount) {
        baseCGLSMarkError(errors, 0u, kBaseCGLSErrorBadShape);
        return;
    }
    if (environment != expectedEnvironment) {
        baseCGLSMarkError(errors, environment, kBaseCGLSErrorBadShape);
        return;
    }
    if (control[environment].x != kBaseCGLSRunning) return;
    const float4 mask = rowMask[index];
    const float4 si = s[index];
    const float4 pi = p[index];
    const float beta = scalars[environment].z;
    if (!isfinite(beta) || beta <= 0.0f || !baseCGLSFinite4(mask) ||
        !baseCGLSFinite4(si) || !baseCGLSFinite4(pi)) {
        baseCGLSMarkError(errors, environment, kBaseCGLSErrorNonfinite);
        return;
    }
    if (index >= mechanicalRows) {
        p[index] = float4(0.0f);
        return;
    }
    const float3 nextP = (si.xyz + beta * pi.xyz) * mask.xyz;
    if (!all(isfinite(nextP))) {
        baseCGLSMarkError(errors, environment, kBaseCGLSErrorNonfinite);
        return;
    }
    p[index] = float4(nextP, 0.0f);
}

kernel void nm_fgmres_base_cgls_finalize(
    constant uint& environmentCount [[buffer(0)]],
    device uint4* control [[buffer(1)]],
    device atomic_uint* errors [[buffer(2)]],
    uint environment [[thread_position_in_grid]]) {
    if (environment >= environmentCount) return;
    if (atomic_load_explicit(&errors[environment], memory_order_relaxed) != 0u) {
        control[environment].x = kBaseCGLSInvalidInput;
        return;
    }
    if (control[environment].x == kBaseCGLSRunning) {
        control[environment].x = control[environment].y >= control[environment].z
            ? kBaseCGLSExhausted : kBaseCGLSBreakdown;
    }
}

// Check the exact candidate constraint tags and the freshly built inverse
// blocks before right scaling is used. This path admits only free tag 0 and
// eliminated static/grip tags 1 and 3; Human tag 2 is unsupported.
kernel void nm_fgmres_base_cgls_validate_right_scale(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const NMFEMNodeStateGPU* candidate [[buffer(1)]],
    device const float4* rowMask [[buffer(2)]],
    device const uint* selected [[buffer(3)]],
    device const float4* rightScaleRows [[buffer(4)]],
    device atomic_uint* errors [[buffer(5)]],
    uint global [[thread_position_in_grid]]) {
    const uint environments = dispatch.environmentCount;
    const uint nodes = dispatch.femNodeCount;
    const uint total = environments * nodes;
    if (global >= total || environments == 0u || nodes == 0u) return;
    const uint environment = global / nodes;
    if (selected[environment] > 1u) {
        baseCGLSMarkError(errors, environment, kBaseCGLSErrorBadSelection);
        return;
    }
    if (selected[environment] == 0u) return;

    const NMFEMNodeStateGPU node = candidate[global];
    const float tag = node.restAndFixed.w;
    const float4 mask = rowMask[global];
    if (!isfinite(tag) || (tag != 0.0f && tag != 1.0f && tag != 3.0f)) {
        baseCGLSMarkError(errors, environment,
            kBaseCGLSErrorUnsupportedConstraint);
        return;
    }
    if (!baseCGLSFinite4(mask) || mask.w != 0.0f) {
        baseCGLSMarkError(errors, environment, kBaseCGLSErrorBadMask);
        return;
    }
    const uint base = global * 3u;
    const float4 row0 = rightScaleRows[base];
    const float4 row1 = rightScaleRows[base + 1u];
    const float4 row2 = rightScaleRows[base + 2u];
    if (tag == 0.0f) {
        if (!isfinite(node.positionAndMass.w) ||
            node.positionAndMass.w <= 0.0f ||
            any(mask.xyz != float3(1.0f)) ||
            !baseCGLSFinite4(row0) || !baseCGLSFinite4(row1) ||
            !baseCGLSFinite4(row2) || row0.w != 1.0f ||
            row1.w != 0.0f || row2.w != 0.0f) {
            baseCGLSMarkError(errors, environment,
                kBaseCGLSErrorInvalidRightScale | kBaseCGLSErrorBadMask);
        }
    } else if (any(mask != float4(0.0f)) ||
               any(row0 != float4(0.0f)) ||
               any(row1 != float4(0.0f)) ||
               any(row2 != float4(0.0f))) {
        baseCGLSMarkError(errors, environment,
            kBaseCGLSErrorInvalidRightScale | kBaseCGLSErrorBadMask);
    }
}

// Apply S or S^T to a full CGLS vector. The mechanical block is the first
// E*N float4 rows; the second E*N field backing rows are required to stay
// zero. The input/output buffers may alias because each thread reads only
// its own row before writing it.
kernel void nm_fgmres_base_cgls_apply_right_scale(
    constant uint& unknownCount [[buffer(0)]],
    constant uint& environmentCount [[buffer(1)]],
    constant uint& transpose [[buffer(2)]],
    device const float4* rowMask [[buffer(3)]],
    device const uint* rowEnvironment [[buffer(4)]],
    device const uint* selected [[buffer(5)]],
    device const float4* rightScaleRows [[buffer(6)]],
    device const float4* input [[buffer(7)]],
    device float4* output [[buffer(8)]],
    device atomic_uint* errors [[buffer(9)]],
    uint index [[thread_position_in_grid]]) {
    if (index >= unknownCount) return;
    if (!baseCGLSVectorLayoutValid(unknownCount, environmentCount) ||
        transpose > 1u) {
        if (environmentCount > 0u)
            baseCGLSMarkError(errors, 0u, kBaseCGLSErrorBadShape);
        output[index] = float4(0.0f);
        return;
    }
    const uint mechanicalRows = unknownCount / 2u;
    const uint nodeCount = mechanicalRows / environmentCount;
    const uint localIndex = index < mechanicalRows
        ? index : index - mechanicalRows;
    const uint environment = localIndex / nodeCount;
    if (environment >= environmentCount || selected[environment] > 1u ||
        rowEnvironment[index] != environment) {
        if (environment < environmentCount)
            baseCGLSMarkError(errors, environment,
                kBaseCGLSErrorBadSelection | kBaseCGLSErrorBadShape);
        output[index] = float4(0.0f);
        return;
    }
    if (atomic_load_explicit(&errors[environment], memory_order_relaxed) != 0u) {
        output[index] = float4(0.0f);
        return;
    }
    const float4 value = input[index];
    const float4 mask = rowMask[index];
    if (!baseCGLSFinite4(value) || !baseCGLSFinite4(mask) ||
        value.w != 0.0f || mask.w != 0.0f) {
        baseCGLSMarkError(errors, environment,
            kBaseCGLSErrorNonfinite | kBaseCGLSErrorBadMask);
        output[index] = float4(0.0f);
        return;
    }
    if (selected[environment] == 0u || index >= mechanicalRows ||
        all(mask.xyz == float3(0.0f))) {
        if (any(value != float4(0.0f)))
            baseCGLSMarkError(errors, environment,
                kBaseCGLSErrorNonzeroConstrainedRow);
        output[index] = float4(0.0f);
        return;
    }
    if (any(mask.xyz != float3(1.0f))) {
        baseCGLSMarkError(errors, environment, kBaseCGLSErrorBadMask);
        output[index] = float4(0.0f);
        return;
    }
    const uint localNode = localIndex - environment * nodeCount;
    const uint base = (environment * nodeCount + localNode) * 3u;
    const float4 row0 = rightScaleRows[base];
    const float4 row1 = rightScaleRows[base + 1u];
    const float4 row2 = rightScaleRows[base + 2u];
    const float3 result = transpose == 0u
        ? float3(dot(row0.xyz, value.xyz), dot(row1.xyz, value.xyz),
                 dot(row2.xyz, value.xyz))
        : float3(row0.x * value.x + row1.x * value.y + row2.x * value.z,
                 row0.y * value.x + row1.y * value.y + row2.y * value.z,
                 row0.z * value.x + row1.z * value.y + row2.z * value.z);
    const float4 result4 = float4(result, 0.0f);
    if (!baseCGLSFinite4(row0) || !baseCGLSFinite4(row1) ||
        !baseCGLSFinite4(row2) || row0.w != 1.0f || row1.w != 0.0f ||
        row2.w != 0.0f || !baseCGLSFinite4(result4)) {
        baseCGLSMarkError(errors, environment,
            kBaseCGLSErrorInvalidRightScale);
        output[index] = float4(0.0f);
        return;
    }
    output[index] = result4;
}

