    // IPC normal impulse, velocity-space PSD curvature, thickness, barrier k.
    nm_float4 barrier;
    // Rows of the physical velocity-space barrier/friction Hessian. Exact
    // capsule-side geometry may make this block indefinite; preconditioners
    // apply their own PSD policy without changing the physical operator.
    nm_float4 barrierHessianRow0;
    nm_float4 barrierHessianRow1;
    nm_float4 barrierHessianRow2;
} NMContactSampleGPU;

// Immutable, source-authored Human support row. These rows are deliberately
// separate from the continuum/rigid contact-pair table: both endpoints are
// the articulated Human and a fixed world plane. Matter condenses the local
// Coulomb multiplier into its monolithic Newton/FGMRES operator through the
// exact point Jacobian supplied by the coupled Human service.
typedef struct NM_ALIGN16 NMHumanSupportContactGPU {
    // Global articulated body, source geometry, source point-query, shape (0 point, 1 sphere, 2 ellipsoid).
    nm_uint4 identity;
    // COM-relative point/centre xyz; w is zero for point, positive radius for sphere.
    nm_float4 localPoint;
    // Coulomb friction, activation slop metres, normal stabilization, reserved.
    nm_float4 frictionSlopAndStabilization;
    nm_float4 supportRadii;
    nm_float4 supportOrientation;
} NMHumanSupportContactGPU;

