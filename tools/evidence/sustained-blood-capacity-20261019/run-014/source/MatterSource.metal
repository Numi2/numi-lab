// Active MPM grid velocities occupy a first-class block of the monolithic
// Newton-FGMRES vector. P2G supplies the force predictor using the owning
// object's scheduled timestep; this block solves corrections around that
// predictor and must not reconstruct it with the frame timestep.
kernel void nm_fgmres_accumulate_vascular(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMFGMRESLayoutGPU& layout [[buffer(30)]],
    constant NMMixedSolverGPU& solver [[buffer(1)]],
    device const float4* preconditionedBasis [[buffer(2)]],
    device const float* leastSquares [[buffer(3)]],
    device const NMFGMRESStateGPU* states [[buffer(4)]],
    device float4* solution [[buffer(5)]],
    constant uint& restartCycle [[buffer(6)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount *
        layout.vascularUnknownCount;
    if (global >= total || layout.vascularUnknownCount == 0u) return;
    const uint environment = global / layout.vascularUnknownCount;
    const uint row = layout.vascularBase + global;
    const uint used = min(uint(states[environment].diagnostics.w), min(
        solver.nonlinearIterations.y, NM_MIXED_FGMRES_RESTART));
    const uint totalUnknowns = layout.unknownCount;
    float4 value = float4(0.0f);
    for (uint column = 0u; column < used; ++column)
        value += preconditionedBasis[column * totalUnknowns + row] *
            leastSquares[fgmresVectorIndex(environment, column)];
    if (restartCycle == 0u)
        solution[row] = value;
    else
        solution[row] += value;
}

// Active MPM grid velocities occupy a first-class block of the monolithic
// Newton-FGMRES vector. P2G supplies the force predictor using the owning
// object's scheduled timestep; this block solves corrections around that
// predictor and must not reconstruct it with the frame timestep.
kernel void nm_mpm_build_implicit_residual(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMMicrostepGPU& microstep [[buffer(1)]],
    device const NMGridNodeStateGPU* nodes [[buffer(2)]],
    device const uint* generations [[buffer(3)]],
    device const uint* contactIncidence [[buffer(4)]],
    device const NMIncidenceRangeGPU* contactRanges [[buffer(5)]],
    device const NMContactSampleGPU* samples [[buffer(6)]],
    device float4* residual [[buffer(7)]],
    device const uint* activeIndices [[buffer(8)]],
    device const uint* activeCounts [[buffer(9)]],
    constant NMPrimalContactArguments& contact [[buffer(10)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount *
        dispatch.mpmActiveNodeCapacity;
    if (global >= total || dispatch.mpmActiveNodeCapacity == 0u) return;
    const uint environment = global / dispatch.mpmActiveNodeCapacity;
    const uint slot = global - environment * dispatch.mpmActiveNodeCapacity;
    const uint output = fgmresMPMIndex(dispatch, environment, slot);
    residual[output] = float4(0.0f);
    if (slot >= activeCounts[environment]) return;
    const uint nodeIndex = activeIndices[
        environment * dispatch.mpmActiveNodeCapacity + slot];
    const uint nodeGlobal = environment * dispatch.gridNodeCount + nodeIndex;
    if (nodeIndex >= dispatch.gridNodeCount ||
        generations[nodeGlobal] != microstep.reserved) return;
    const NMGridNodeStateGPU node = nodes[nodeGlobal];
    if (!(node.positionAndMass.w > 0.0f)) return;
    float3 rightHandSide = float3(0.0f);
    const NMIncidenceRangeGPU range = contactRanges[nodeIndex];
    for (uint local = 0u; local < range.count; ++local) {
        const uint pair = contactIncidence[range.first + local];
        if (pair >= dispatch.contactPairCount) continue;
        const NMContactSampleGPU sample = primalContactSample(
            dispatch, contact, environment, pair);
        if ((sample.identity.w & NM_CONTACT_VALID) != 0u)
            rightHandSide -= sample.impulseAndNormal.xyz;
    }
    const uint unifiedCount = dispatch.gridNodeCount + dispatch.femNodeCount;
    const NMIncidenceRangeGPU deformableRange =
        contact.deformableNodeRanges[
            environment * unifiedCount + nodeIndex];
    const uint deformableBase =
        environment * dispatch.deformableContactCapacity;
    for (uint incidence = 0u; incidence < deformableRange.count;
         ++incidence) {
        const uint encoded = contact.deformableNodeIncidence[
            deformableRange.first + incidence];
        const uint contactSlot = encoded >> 3u;
        const uint contactLocal = encoded & 7u;
        if (contactSlot >= dispatch.deformableContactCapacity ||
            contactLocal >= 6u) continue;
        const NMDeformableContactGPU deformable =
            contact.deformableContacts[deformableBase + contactSlot];
        if ((deformable.identity.w & NM_CONTACT_VALID) == 0u ||
            deformableContactNode(deformable, contactLocal) != nodeIndex) continue;
        float3 tangent0, tangent1;
        deformableContactFrame(
            deformable.normalAndTOI.xyz, tangent0, tangent1);
        const float3 impulse =
            deformable.impulseAndFriction.x *
                deformable.normalAndTOI.xyz +
            deformable.impulseAndFriction.y * tangent0 +
            deformable.impulseAndFriction.z * tangent1;
        rightHandSide += deformableContactTimeScale(deformable, contactLocal) * (
            deformableContactWeight(deformable, contactLocal) * impulse -
            deformable.mollifier.y *
                deformableMollifierGradient(deformable, contactLocal));
    }
    residual[output] = float4(rightHandSide, 0.0f);
}

kernel void nm_fgmres_precondition_mpm(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const NMGridNodeStateGPU* nodes [[buffer(1)]],
    device const uint* generations [[buffer(2)]],
    constant NMMicrostepGPU& microstep [[buffer(3)]],
    device const float4* basis [[buffer(4)]],
    device float4* preconditioned [[buffer(5)]],
    device const NMFGMRESStateGPU* states [[buffer(6)]],
    device const uint* activeIndices [[buffer(7)]],
    device const uint* activeCounts [[buffer(8)]],
    constant NMPrimalContactArguments& contact [[buffer(9)]],
    device float4* mechanicalDiagonal [[buffer(10)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount *
        dispatch.mpmActiveNodeCapacity;
    if (global >= total) return;
    const uint environment = global / dispatch.mpmActiveNodeCapacity;
    const uint slot = global - environment * dispatch.mpmActiveNodeCapacity;
    const uint row = fgmresMPMIndex(dispatch, environment, slot);
    preconditioned[row] = float4(0.0f);
    mechanicalDiagonal[row] = float4(0.0f);
    if (states[environment].diagnostics.z > 0.5f ||
        slot >= activeCounts[environment]) return;
    const uint nodeIndex = activeIndices[
        environment * dispatch.mpmActiveNodeCapacity + slot];
    const uint nodeGlobal = environment * dispatch.gridNodeCount + nodeIndex;
    if (nodeIndex >= dispatch.gridNodeCount ||
        generations[nodeGlobal] != microstep.reserved) return;
    const float3 contactDiagonal = fgmresContactDiagonal(
        dispatch, contact, environment, nodeIndex, NM_INVALID_INDEX);
    const float mass = max(nodes[nodeGlobal].positionAndMass.w, 0.0f);
    mechanicalDiagonal[row] = float4(float3(mass) + contactDiagonal, 0.0f);
    if (all(contactDiagonal == float3(0.0f))) {
        preconditioned[row] = float4(
            nodes[nodeGlobal].velocityAndInverseMass.w * basis[row].xyz,
            0.0f);
        return;
    }
    preconditioned[row] = float4(
        basis[row].xyz /
            max(float3(mass) + contactDiagonal, float3(1.0e-20f)),
        0.0f);
}

inline uint mpmGridForNode(
    const NMMatterDispatchGPU dispatch,
    device const NMMPMGridGPU* grids,
    const uint nodeIndex
) {
    for (uint gridIndex = 0u; gridIndex < dispatch.mpmGridCount;
         ++gridIndex) {
        const NMMPMGridGPU grid = grids[gridIndex];
        const uint count = grid.nodeDimensionsAndOffset.x *
            grid.nodeDimensionsAndOffset.y *
            grid.nodeDimensionsAndOffset.z;
        const uint first = grid.nodeDimensionsAndOffset.w;
        if (nodeIndex >= first && nodeIndex - first < count)
            return gridIndex;
    }
    return NM_INVALID_INDEX;
}

kernel void nm_fgmres_precondition_mpm_patches(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMMicrostepGPU& microstep [[buffer(1)]],
    device const uint* generations [[buffer(3)]],
    device const NMMPMGridGPU* grids [[buffer(4)]],
    device const uint* nodeToActive [[buffer(5)]],
    device const uint* activeIndices [[buffer(6)]],
    device const uint* activeCounts [[buffer(7)]],
    device const float4* basis [[buffer(8)]],
    device float4* preconditioned [[buffer(9)]],
    device const NMFGMRESStateGPU* states [[buffer(10)]],
    device const float4* mechanicalDiagonal [[buffer(11)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount *
        dispatch.mpmActiveNodeCapacity;
    if (global >= total || dispatch.mpmActiveNodeCapacity == 0u) return;
    const uint environment = global / dispatch.mpmActiveNodeCapacity;
    const uint slot = global - environment * dispatch.mpmActiveNodeCapacity;
    if (states[environment].diagnostics.z > 0.5f ||
        slot >= activeCounts[environment]) return;
    const uint nodeIndex =
        activeIndices[environment * dispatch.mpmActiveNodeCapacity + slot];
    const uint gridIndex = mpmGridForNode(dispatch, grids, nodeIndex);
    if (gridIndex >= dispatch.mpmGridCount) return;
    const NMMPMGridGPU grid = grids[gridIndex];
    const uint first = grid.nodeDimensionsAndOffset.w;
    const uint local = nodeIndex - first;
    const uint nx = grid.nodeDimensionsAndOffset.x;
    const uint ny = grid.nodeDimensionsAndOffset.y;
    const uint nz = grid.nodeDimensionsAndOffset.z;
    if (nx == 0u || ny == 0u || nz == 0u) return;
    const uint plane = nx * ny;
    const int3 coordinate = int3(
        int(local % nx),
        int((local / nx) % ny),
        int(local / plane));
    float3 rhs = float3(0.0f);
    float3 diagonal = float3(0.0f);
    for (int z = -1; z <= 1; ++z) {
        for (int y = -1; y <= 1; ++y) {
            for (int x = -1; x <= 1; ++x) {
                const int3 other = coordinate + int3(x, y, z);
                if (any(other < int3(0)) ||
                    other.x >= int(nx) || other.y >= int(ny) ||
                    other.z >= int(nz)) continue;
                const uint otherNode = first + uint(other.x) +
                    nx * (uint(other.y) + ny * uint(other.z));
                const uint otherGlobal =
                    environment * dispatch.gridNodeCount + otherNode;
                const uint otherSlot = nodeToActive[otherGlobal];
                if (otherSlot >= activeCounts[environment] ||
                    generations[otherGlobal] != microstep.reserved) continue;
                rhs += basis[fgmresMPMIndex(
                    dispatch, environment, otherSlot)].xyz;
                diagonal += mechanicalDiagonal[fgmresMPMIndex(
                    dispatch, environment, otherSlot)].xyz;
            }
        }
    }
    if (any(diagonal <= float3(0.0f))) return;
    const uint row = fgmresMPMIndex(dispatch, environment, slot);
    const float3 translation = rhs / diagonal;
    preconditioned[row].xyz =
        0.75f * preconditioned[row].xyz + 0.25f * translation;
}

kernel void nm_fgmres_precondition_mpm_objects(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const NMContinuumObjectGPU* objects [[buffer(1)]],
    device const NMMPMGridGPU* grids [[buffer(2)]],
    device const uint* activeIndices [[buffer(4)]],
    device const uint* activeCounts [[buffer(5)]],
    device const float4* basis [[buffer(6)]],
    device float4* preconditioned [[buffer(7)]],
    device const NMFGMRESStateGPU* states [[buffer(8)]],
    device const float4* mechanicalDiagonal [[buffer(9)]],
    uint lane [[thread_index_in_threadgroup]],
    uint group [[threadgroup_position_in_grid]]
) {
    if (lane >= 32u || dispatch.objectCount == 0u) return;
    const uint environment = group / dispatch.objectCount;
    const uint objectIndex = group - environment * dispatch.objectCount;
    if (environment >= dispatch.environmentCount ||
        objects[objectIndex].representation != NM_REPRESENTATION_MPM ||
        states[environment].diagnostics.z > 0.5f) return;
    float3 localRhs = float3(0.0f);
    float3 localDiagonal = float3(0.0f);
    const uint activeCount = activeCounts[environment];
    for (uint slot = lane; slot < activeCount; slot += 32u) {
        const uint nodeIndex =
            activeIndices[
                environment * dispatch.mpmActiveNodeCapacity + slot];
        const uint gridIndex = mpmGridForNode(dispatch, grids, nodeIndex);
        if (gridIndex >= dispatch.mpmGridCount ||
            uint(grids[gridIndex].nodeMinimumAndObject.w) != objectIndex)
            continue;
        localRhs += basis[fgmresMPMIndex(
            dispatch, environment, slot)].xyz;
        localDiagonal += mechanicalDiagonal[fgmresMPMIndex(
            dispatch, environment, slot)].xyz;
    }
    const float3 rhs = float3(
        simd_sum(localRhs.x), simd_sum(localRhs.y), simd_sum(localRhs.z));
    const float3 diagonal = float3(
        simd_sum(localDiagonal.x), simd_sum(localDiagonal.y),
        simd_sum(localDiagonal.z));
    if (any(diagonal <= float3(0.0f))) return;
    const float3 translation = rhs / diagonal;
    for (uint slot = lane; slot < activeCount; slot += 32u) {
        const uint nodeIndex =
            activeIndices[
                environment * dispatch.mpmActiveNodeCapacity + slot];
        const uint gridIndex = mpmGridForNode(dispatch, grids, nodeIndex);
        if (gridIndex >= dispatch.mpmGridCount ||
            uint(grids[gridIndex].nodeMinimumAndObject.w) != objectIndex)
            continue;
        const uint row = fgmresMPMIndex(dispatch, environment, slot);
        preconditioned[row].xyz =
            0.5f * preconditioned[row].xyz + 0.5f * translation;
    }
}

kernel void nm_fgmres_apply_mpm(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const NMGridNodeStateGPU* nodes [[buffer(1)]],
    device const uint* generations [[buffer(2)]],
    constant NMMicrostepGPU& microstep [[buffer(3)]],
    device const uint* contactIncidence [[buffer(4)]],
    device const NMIncidenceRangeGPU* contactRanges [[buffer(5)]],
    device const NMContactSampleGPU* samples [[buffer(6)]],
    device const float4* direction [[buffer(7)]],
    device float4* work [[buffer(8)]],
    device const NMFGMRESStateGPU* states [[buffer(9)]],
    device const uint* activeIndices [[buffer(10)]],
    device const uint* activeCounts [[buffer(11)]],
    constant NMPrimalContactArguments& contact [[buffer(12)]],
    constant uint& articulatedNv [[buffer(13)]],
    device const float* coupledPointJacobians [[buffer(14)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount *
        dispatch.mpmActiveNodeCapacity;
    if (global >= total) return;
    const uint environment = global / dispatch.mpmActiveNodeCapacity;
    const uint slot = global - environment * dispatch.mpmActiveNodeCapacity;
    const uint row = fgmresMPMIndex(dispatch, environment, slot);
    work[row] = float4(0.0f);
    if (states[environment].diagnostics.z > 0.5f ||
        slot >= activeCounts[environment]) return;
    const uint nodeIndex = activeIndices[
        environment * dispatch.mpmActiveNodeCapacity + slot];
    const uint nodeGlobal = environment * dispatch.gridNodeCount + nodeIndex;
    if (nodeIndex >= dispatch.gridNodeCount ||
        generations[nodeGlobal] != microstep.reserved) return;
    const float3 nodeDirection = direction[row].xyz;
    float3 value = nodes[nodeGlobal].positionAndMass.w * nodeDirection;
    const NMIncidenceRangeGPU range = contactRanges[nodeIndex];
    for (uint local = 0u; local < range.count; ++local) {
        const uint pair = contactIncidence[range.first + local];
        if (pair >= dispatch.contactPairCount) continue;
        const NMContactSampleGPU sample = primalContactSample(
            dispatch, contact, environment, pair);
        if ((sample.identity.w & NM_CONTACT_VALID) == 0u) continue;
        const float3 rigidDirection = coupledRigidPointDirection(
            dispatch, contact, coupledPointJacobians, environment, pair,
            articulatedNv, direction);
        value += coupledBarrierDirectionalForce(
            sample, nodeDirection - rigidDirection);
    }
    const uint unifiedCount = dispatch.gridNodeCount + dispatch.femNodeCount;
    const NMIncidenceRangeGPU deformableRange =
        contact.deformableNodeRanges[
            environment * unifiedCount + nodeIndex];
    const uint deformableBase =
        environment * dispatch.deformableContactCapacity;
    for (uint incidence = 0u; incidence < deformableRange.count;
         ++incidence) {
        const uint encoded = contact.deformableNodeIncidence[
            deformableRange.first + incidence];
        const uint contactSlot = encoded >> 3u;
        const uint contactLocal = encoded & 7u;
        if (contactSlot >= dispatch.deformableContactCapacity ||
            contactLocal >= 6u) continue;
        const NMDeformableContactGPU deformable =
            contact.deformableContacts[deformableBase + contactSlot];
        if ((deformable.identity.w & NM_CONTACT_VALID) == 0u ||
            deformableContactNode(deformable, contactLocal) != nodeIndex) continue;
        float3 relativeDirection = float3(0.0f);
        float mollifierDirection = 0.0f;
        for (uint other = 0u; other < 6u; ++other) {
            const uint otherNode = deformableContactNode(deformable, other);
            float3 otherDirection = float3(0.0f);
            if (otherNode < dispatch.gridNodeCount) {
                const uint otherSlot = contact.mpmNodeToActive[
                    environment * dispatch.gridNodeCount + otherNode];
                if (otherSlot < contact.mpmActiveNodeCounts[environment]) {
                    otherDirection = direction[fgmresMPMIndex(
                        dispatch, environment, otherSlot)].xyz;
                    relativeDirection += deformableContactWeight(deformable, other) *
                        deformableContactTimeScale(deformable, other) * otherDirection;
                }
            } else if (otherNode - dispatch.gridNodeCount <
                       dispatch.femNodeCount) {
                otherDirection = direction[
                    environment * dispatch.femNodeCount +
                    otherNode - dispatch.gridNodeCount].xyz;
                relativeDirection += deformableContactWeight(deformable, other) *
                    deformableContactTimeScale(deformable, other) * otherDirection;
            }
            mollifierDirection += dot(
                deformableMollifierGradient(deformable, other),
                deformableContactTimeScale(deformable, other) * otherDirection);
        }
        value += deformableContactTimeScale(deformable, contactLocal) * (
            deformableContactWeight(deformable, contactLocal) *
                deformableBarrierDirectionalForce(
                    deformable, relativeDirection) +
            deformableMollifierGradient(deformable, contactLocal) *
                (deformable.mollifier.z * mollifierDirection));
    }
    work[row] = float4(value, 0.0f);
}

inline bool mpmImplicitVelocityGradients(
    const NMMatterDispatchGPU dispatch,
    const NMMicrostepGPU microstep,
    const uint environment,
    const NMParticleStateGPU particle,
    const NMMPMGridGPU grid,
    device const NMGridNodeStateGPU* nodes,
    device const uint* generations,
    device const uint* nodeToActive,
    device const float4* direction,
    const bool applyDirection,
    thread float3x3& velocityGradient,
    thread float3x3& directionGradient
) {
    velocityGradient = float3x3(0.0f);
    directionGradient = float3x3(0.0f);
    const float3 cell = particle.positionAndMass.xyz * grid.metrics.y;
    const int3 base = int3(floor(cell - 0.5f));
    for (int z = 0; z < 3; ++z) {
        for (int y = 0; y < 3; ++y) {
            for (int x = 0; x < 3; ++x) {
                const int3 coordinate = base + int3(x, y, z);
                const uint nodeIndex = gridNodeIndex(grid, coordinate);
                if (nodeIndex == NM_INVALID_INDEX ||
                    nodeIndex >= dispatch.gridNodeCount) return false;
                const uint nodeGlobal = environment *
                    dispatch.gridNodeCount + nodeIndex;
                if (generations[nodeGlobal] != microstep.reserved) return false;
                float wx, wy, wz, dx, dy, dz;
                const float3 nodePosition =
                    float3(coordinate) * grid.metrics.x;
                const float3 deltaCells =
                    (nodePosition - particle.positionAndMass.xyz) *
                    grid.metrics.y;
                if (!quadraticKernel(deltaCells.x, grid.metrics.y, wx, dx) ||
                    !quadraticKernel(deltaCells.y, grid.metrics.y, wy, dy) ||
                    !quadraticKernel(deltaCells.z, grid.metrics.y, wz, dz))
                    continue;
                const float3 gradient = float3(
                    dx * wy * wz, wx * dy * wz, wx * wy * dz);
                velocityGradient += outerProduct(
                    nodes[nodeGlobal].candidateVelocity.xyz, gradient);
                const uint activeSlot = nodeToActive[nodeGlobal];
                if (applyDirection && activeSlot == NM_INVALID_INDEX) {
                    // A P2G support-edge node pruned by the relative mass
                    // floor extends both candidate velocity and Newton
                    // direction by zero. A positive-mass missing node still
                    // signals an undersized active arena.
                    if (!(nodes[nodeGlobal].positionAndMass.w > 0.0f))
                        continue;
                    return false;
                }
                if (applyDirection)
                    directionGradient += outerProduct(
                        direction[fgmresMPMIndex(
                            dispatch, environment, activeSlot)].xyz,
                        gradient);
            }
        }
    }
    return true;
}

// Extend the shared Newton globalization to the active MPM block. Each
// SIMD32 group certifies all particles of one environment/object for the same
// candidate alpha used by FEM, fields, and rigid generalized increments.
kernel void nm_mpm_limit_implicit_line_search(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMMicrostepGPU& microstep [[buffer(1)]],
    constant NMMixedSolverGPU& solver [[buffer(2)]],
    device const NMContinuumObjectGPU* objects [[buffer(3)]],
    device const NMMaterialGPU* materials [[buffer(4)]],
    device const NMScalarProgramGPU* programs [[buffer(5)]],
    device const NMExpressionInstructionGPU* instructions [[buffer(6)]],
    device const float* environmentParameters [[buffer(7)]],
    device const NMParticleStateGPU* particles [[buffer(8)]],
    device const float* particleMaterialState [[buffer(9)]],
    device const NMGridNodeStateGPU* nodes [[buffer(10)]],
    device const NMMPMGridGPU* grids [[buffer(11)]],
    device const uint* generations [[buffer(12)]],
    device const uint* nodeToActive [[buffer(13)]],
    device const float4* correction [[buffer(14)]],
    device const NMSchedulerStateGPU* schedulers [[buffer(15)]],
    device const NMAdaptiveStateGPU* adaptive [[buffer(16)]],
    device float4* lineSearch [[buffer(17)]],
    device NMMatterStatusGPU* statuses [[buffer(18)]],
    uint lane [[thread_index_in_threadgroup]],
    uint group [[threadgroup_position_in_grid]]
) {
    if (lane >= 32u || dispatch.objectCount == 0u) return;
    const uint environment = group / dispatch.objectCount;
    const uint objectIndex = group - environment * dispatch.objectCount;
    if (environment >= dispatch.environmentCount ||
        !environmentHealthy(statuses, environment)) return;
    const NMContinuumObjectGPU object = objects[objectIndex];
    const uint objectGlobal =
        environment * dispatch.objectCount + objectIndex;
    const NMSchedulerStateGPU scheduler = schedulers[objectGlobal];
    if (object.representation != NM_REPRESENTATION_MPM ||
        !objectDue(object, scheduler, adaptive[objectGlobal], microstep))
        return;
    if (object.elementOffset >= dispatch.mpmGridCount) {
        if (lane == 0u)
            recordFailure(
                statuses[environment], NM_STATUS_INVALID_DISPATCH,
                objectIndex, object.elementOffset, float4(0.0f));
        return;
    }
    const NMMPMGridGPU grid = grids[object.elementOffset];
    const float dt = objectTimestep(dispatch, scheduler);
    const uint candidateCount = min(
        solver.nonlinearIterations.w, NM_MIXED_LINE_SEARCH_MAX_STEPS);
    float chosen = 0.0f;
    float chosenMinimum = -INFINITY;
    for (uint trial = 0u; trial < candidateCount; ++trial) {
        const float alpha = exp2(-float(trial));
        bool localValid = true;
        float localMinimum = INFINITY;
        for (uint local = lane; local < object.stateCount; local += 32u) {
            const uint particleIndex = object.stateOffset + local;
            const uint particleGlobal =
                environment * dispatch.particleCount + particleIndex;
            if (particleIndex >= dispatch.particleCount) {
                localValid = false;
                continue;
            }
            const NMParticleStateGPU particle = particles[particleGlobal];
            if ((particle.identity.w & NM_OBJECT_ACTIVE) == 0u) continue;
            if (particle.identity.x != objectIndex ||
                particle.identity.y >= dispatch.materialCount) {
                localValid = false;
                continue;
            }
            float3x3 velocityGradient, directionGradient;
            if (!mpmImplicitVelocityGradients(
                    dispatch, microstep, environment, particle, grid,
                    nodes, generations, nodeToActive, correction, true,
                    velocityGradient, directionGradient)) {
                localValid = false;
                continue;
            }
            const float3x3 acceptedDeformation = matrixFromRows(
                particle.deformationRow0,
                particle.deformationRow1,
                particle.deformationRow2);
            const float3x3 trialGradient =
                velocityGradient + alpha * directionGradient;
            const float3x3 trialDeformation =
                (float3x3(1.0f) + dt * trialGradient) *
                acceptedDeformation;
            const float3x3 trialRate =
                trialGradient * trialDeformation;
            const float determinantValue = determinant(trialDeformation);
            localMinimum = min(localMinimum, determinantValue);
            const NMMaterialGPU material = materials[particle.identity.y];
            device const float* internalState = material.stateCount == 0u
                ? nullptr
                : particleMaterialState +
                    particleGlobal * dispatch.materialStateStride;
            float validityMargin = 1.0f;
            bool materialValid = isfinite(determinantValue) &&
                determinantValue >= max(
                    dispatch.numericalLimits.z, material.validity.x) &&
                determinantValue <= material.validity.y &&
                evaluateMaterialValidity(
                    material, programs, instructions,
                    environmentParameters +
                        environment * dispatch.parameterCount,
                    internalState, trialDeformation, trialRate, dt,
                    particle.referenceAndTemperature.w,
                    validityMargin) && validityMargin > 0.0f;
            float projectedState[NM_MAX_MATERIAL_STATE];
            if (materialValid)
                materialValid = projectMaterialState(
                    material, programs, instructions,
                    environmentParameters +
                        environment * dispatch.parameterCount,
                    internalState, trialDeformation, trialRate, dt,
                    particle.referenceAndTemperature.w,
                    projectedState);
            localValid = localValid && materialValid;
        }
        const bool valid = simd_all(localValid) != 0u;
        const float minimum = simd_min(localMinimum);
        if (valid) {
            chosen = alpha;
            chosenMinimum = minimum;
            break;
        }
    }
    if (chosen == 0.0f) {
        if (lane == 0u)
            recordFailure(
                statuses[environment], NM_STATUS_LOCAL_MATERIAL_FAILURE,
                objectIndex, microstep.solverIteration,
                float4(chosenMinimum, float(candidateCount), dt, 0.0f));
        return;
    }
    if (lane == 0u) {
        float4 state = lineSearch[objectGlobal];
        state.x = min(state.x, chosen);
        state.y = min(state.y, chosenMinimum);
        lineSearch[objectGlobal] = state;
    }
}

inline void evaluateSparseMPMImplicitNode(
    const NMMatterDispatchGPU dispatch,
    const NMMicrostepGPU microstep,
    const uint environment,
    const uint activeBlockIndex,
    const uint localNode,
    const bool applyOperator,
    device const NMContinuumObjectGPU* objects,
    device const NMMaterialGPU* materials,
    device const NMScalarProgramGPU* programs,
    device const NMExpressionInstructionGPU* instructions,
    device const float* environmentParameters,
    device const NMParticleStateGPU* particles,
    device const float* particleMaterialState,
    device const NMGridNodeStateGPU* nodes,
    device const NMMPMGridGPU* grids,
    device const NMMPMBlockGPU* blocks,
    device const uint* blockLookup,
    device const atomic_uint* blockCounts,
    device const uint* blockOffsets,
    device const uint* sortedParticleIndices,
    device const NMSchedulerStateGPU* schedulers,
    device const NMAdaptiveStateGPU* adaptive,
    device const uint* generations,
    device const uint* nodeToActive,
    device const float4* direction,
    device float4* vector,
    device const NMFGMRESStateGPU* states,
    device NMMatterStatusGPU* statuses
) {
    if (activeBlockIndex >= dispatch.mpmBlockCount ||
        localNode >= NM_MPM_BLOCK_NODE_COUNT ||
        !environmentHealthy(statuses, environment) ||
        (applyOperator && states[environment].diagnostics.z > 0.5f)) return;
    const NMMPMBlockGPU block = blocks[activeBlockIndex];
    if (block.identity.z >= dispatch.mpmGridCount ||
        block.identity.w >= dispatch.objectCount) return;
    const uint objectIndex = block.identity.w;
    const NMContinuumObjectGPU object = objects[objectIndex];
    const uint objectGlobal = environment * dispatch.objectCount + objectIndex;
    const NMSchedulerStateGPU scheduler = schedulers[objectGlobal];
    if (object.representation != NM_REPRESENTATION_MPM ||
        !objectDue(object, scheduler, adaptive[objectGlobal], microstep)) return;
    const NMMPMGridGPU grid = grids[block.identity.z];
    const int3 localCoordinate = int3(
        int(localNode & 7u), int((localNode >> 3u) & 7u),
        int((localNode >> 6u) & 7u));
    const int3 nodeCoordinate = int3(
        block.coordinateAndLookup.x, block.coordinateAndLookup.y,
        block.coordinateAndLookup.z) * int(NM_MPM_BLOCK_EDGE) +
        localCoordinate;
    const uint nodeIndex = gridNodeIndex(grid, nodeCoordinate);
    if (nodeIndex == NM_INVALID_INDEX || nodeIndex >= dispatch.gridNodeCount)
        return;
    const uint nodeGlobal = environment * dispatch.gridNodeCount + nodeIndex;
    if (generations[nodeGlobal] != microstep.reserved ||
        !(nodes[nodeGlobal].positionAndMass.w > 0.0f)) return;
    const uint activeSlot = nodeToActive[nodeGlobal];
    if (activeSlot == NM_INVALID_INDEX) return;
    const uint row = fgmresMPMIndex(dispatch, environment, activeSlot);
    const float3 nodePosition = float3(nodeCoordinate) * grid.metrics.x;
    const float dt = objectTimestep(dispatch, scheduler);
    float3 force = float3(0.0f);
    device const float* parameters = environmentParameters +
        environment * dispatch.parameterCount;
    const int3 blockCoordinate = int3(
        block.coordinateAndLookup.x, block.coordinateAndLookup.y,
        block.coordinateAndLookup.z);
    const uint particleBase = environment * dispatch.particleCount;
    const uint blockBase = environment * dispatch.mpmBlockCount;
    for (int neighborZ = -1; neighborZ <= 1; ++neighborZ) {
        for (int neighborY = -1; neighborY <= 1; ++neighborY) {
            for (int neighborX = -1; neighborX <= 1; ++neighborX) {
                const uint neighborBlock = gridBlockIndex(
                    grid, blockCoordinate + int3(
                        neighborX, neighborY, neighborZ),
                    blockLookup, dispatch.mpmBlockLookupCount);
                if (neighborBlock == NM_INVALID_INDEX ||
                    neighborBlock >= dispatch.mpmBlockCount) continue;
                const uint blockSlot = blockBase + neighborBlock;
                const uint count = min(atomic_load_explicit(
                    blockCounts + blockSlot, memory_order_relaxed),
                    dispatch.maximumParticlesPerBlock);
                const uint first = blockOffsets[blockSlot];
                for (uint local = 0u; local < count; ++local) {
                    const uint particleIndex = sortedParticleIndices[
                        particleBase + first + local];
                    if (particleIndex >= dispatch.particleCount) continue;
                    const NMParticleStateGPU particle =
                        particles[particleBase + particleIndex];
                    if (particle.identity.x != objectIndex ||
                        (particle.identity.w & NM_OBJECT_ACTIVE) == 0u)
                        continue;
                    float wx, wy, wz, dx, dy, dz;
                    const float3 deltaCells =
                        (nodePosition - particle.positionAndMass.xyz) *
                        grid.metrics.y;
                    if (!quadraticKernel(
                            deltaCells.x, grid.metrics.y, wx, dx) ||
                        !quadraticKernel(
                            deltaCells.y, grid.metrics.y, wy, dy) ||
                        !quadraticKernel(
                            deltaCells.z, grid.metrics.y, wz, dz)) continue;
                    const float3 particleGradient = -float3(
                        dx * wy * wz, wx * dy * wz, wx * wy * dz);
                    float3x3 velocityGradient, directionGradient;
                    if (!mpmImplicitVelocityGradients(
                            dispatch, microstep, environment, particle, grid,
                            nodes, generations, nodeToActive, direction,
                            applyOperator,
                            velocityGradient, directionGradient)) {
                        recordFailure(statuses[environment],
                            NM_STATUS_CAPACITY_OVERFLOW, objectIndex,
                            particleIndex, float4(float3(nodeCoordinate), 0.0f));
                        return;
                    }
                    const float3x3 acceptedDeformation = matrixFromRows(
                        particle.deformationRow0, particle.deformationRow1,
                        particle.deformationRow2);
                    const float3x3 candidateDeformation =
                        (float3x3(1.0f) + dt * velocityGradient) *
                        acceptedDeformation;
                    const float3x3 candidateRate =
                        velocityGradient * candidateDeformation;
                    const NMMaterialGPU material =
                        materials[particle.identity.y];
                    device const float* internalState =
                        material.stateCount == 0u ? nullptr :
                        particleMaterialState +
                            (particleBase + particleIndex) *
                                dispatch.materialStateStride;
                    bool valid = true;
                    if (applyOperator) {
                        const float3x3 deformationDirection =
                            dt * directionGradient * acceptedDeformation;
                        const float3x3 rateDirection =
                            directionGradient * candidateDeformation +
                            velocityGradient * deformationDirection;
                        float3x3 stress, tangent;
                        evaluateAlgorithmicStressTangent(
                            material, programs, instructions, parameters,
                            internalState, candidateDeformation,
                            deformationDirection, candidateRate,
                            rateDirection, dt,
                            particle.referenceAndTemperature.w,
                            stress, tangent, valid);
                        if (valid) {
                            const float3x3 forceDirection =
                                tangent * transpose(candidateDeformation) +
                                stress * transpose(deformationDirection);
                            force += particle.velocityAndReferenceVolume.w *
                                (forceDirection * particleGradient);
                        }
                    } else {
                        const float3x3 stress = evaluateAlgorithmicStress(
                            material, programs, instructions, parameters,
                            internalState, candidateDeformation, candidateRate,
                            dt, particle.referenceAndTemperature.w, valid);
                        if (valid)
                            force += particle.velocityAndReferenceVolume.w *
                                ((stress * transpose(candidateDeformation)) *
                                 particleGradient);
                    }
                    if (!valid) {
                        recordFailure(statuses[environment],
                            NM_STATUS_LOCAL_MATERIAL_FAILURE, objectIndex,
                            particleIndex,
                            float4(determinant(candidateDeformation), dt,
                                   maximumAbs(velocityGradient), 0.0f));
                        return;
                    }
                }
            }
        }
    }
    if (applyOperator) {
        vector[row].xyz -= dt * force;
    } else {
        const NMGridNodeStateGPU node = nodes[nodeGlobal];
        const float inverseMass = node.velocityAndInverseMass.w;
        const float3 predictor = node.velocityAndInverseMass.xyz + dt *
            (node.forceAndEnergy.xyz * inverseMass +
             dispatch.gravityAndTimestep.xyz);
        vector[row].xyz += node.positionAndMass.w *
            (predictor - node.candidateVelocity.xyz) +
            dt * (force - node.forceAndEnergy.xyz);
    }
}

kernel void nm_mpm_build_constitutive_residual(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMMicrostepGPU& microstep [[buffer(1)]],
    device const NMContinuumObjectGPU* objects [[buffer(2)]],
    device const NMMaterialGPU* materials [[buffer(3)]],
    device const NMScalarProgramGPU* programs [[buffer(4)]],
    device const NMExpressionInstructionGPU* instructions [[buffer(5)]],
    device const float* environmentParameters [[buffer(6)]],
    device const NMParticleStateGPU* particles [[buffer(7)]],
    device const float* particleMaterialState [[buffer(8)]],
    device const NMGridNodeStateGPU* nodes [[buffer(9)]],
    device const NMMPMGridGPU* grids [[buffer(10)]],
    device const NMMPMBlockGPU* blocks [[buffer(11)]],
    device const uint* blockLookup [[buffer(12)]],
    device const NMActiveMPMBlockGPU* activeBlocks [[buffer(13)]],
    device const atomic_uint* blockCounts [[buffer(14)]],
    device const uint* blockOffsets [[buffer(15)]],
    device const uint* sortedParticleIndices [[buffer(16)]],
    device const NMSchedulerStateGPU* schedulers [[buffer(17)]],
    device const NMAdaptiveStateGPU* adaptive [[buffer(18)]],
    device const uint* generations [[buffer(19)]],
    device const float4* direction [[buffer(20)]],
    device float4* residual [[buffer(21)]],
    device const NMFGMRESStateGPU* states [[buffer(22)]],
    device NMMatterStatusGPU* statuses [[buffer(23)]],
    device const uint* nodeToActive [[buffer(24)]],
    uint lane [[thread_index_in_threadgroup]],
    uint group [[threadgroup_position_in_grid]]
) {
    const NMActiveMPMBlockGPU active = activeBlocks[group];
    if (active.environment >= dispatch.environmentCount) return;
    evaluateSparseMPMImplicitNode(
        dispatch, microstep, active.environment, active.blockIndex, lane,
        false, objects, materials, programs, instructions,
        environmentParameters, particles, particleMaterialState, nodes,
        grids, blocks, blockLookup, blockCounts, blockOffsets,
        sortedParticleIndices, schedulers, adaptive, generations,
        nodeToActive, direction, residual, states, statuses);
    evaluateSparseMPMImplicitNode(
        dispatch, microstep, active.environment, active.blockIndex, lane + 256u,
        false, objects, materials, programs, instructions,
        environmentParameters, particles, particleMaterialState, nodes,
        grids, blocks, blockLookup, blockCounts, blockOffsets,
        sortedParticleIndices, schedulers, adaptive, generations,
        nodeToActive, direction, residual, states, statuses);
}

kernel void nm_fgmres_apply_mpm_constitutive(
