using namespace metal;

namespace numi_matter_metal {
namespace accepted_state_proof_detail {

constant ulong kFNVOffset = 14695981039346656037ul;
constant ulong kFNVPrime = 1099511628211ul;
constant uint kPhysicsDomain = 0x4e585053u;
constant uint kHumanDomain = 0x4e584855u;
constant uint kMatterDomain = 0x4e584d41u;
constant uint kChunkDomain = 0x4e584348u;
constant uint kTreeDomain = 0x4e585452u;
constant uint kSharedSource = 1u;

struct BeginGPU {
    uint environmentCount;
    uint schemaVersion;
    uint reserved0;
    uint reserved1;
    ulong transactionPolicyFingerprint;
    ulong reserved2;
};

struct ChunkGPU {
    uint environmentCount;
    uint source;
    uint flags;
    uint chunkBytes;
    uint chunkCount;
    uint scratchStride;
    uint reserved0;
    uint reserved1;
    ulong bytesPerEnvironment;
    ulong sharedBytes;
};

struct ReduceGPU {
    uint environmentCount;
    uint source;
    uint inputCount;
    uint outputCount;
    uint scratchStride;
    uint level;
    uint reserved0;
    uint reserved1;
};

struct FoldGPU {
    uint environmentCount;
    uint source;
    uint target;
    uint flags;
    uint scratchStride;
    uint reserved0;
    uint reserved1;
    uint reserved2;
    ulong bytesPerEnvironment;
    ulong sharedBytes;
};

struct FinalizeGPU {
    uint abiVersion;
    uint structSize;
    uint environmentCount;
    uint environmentIdentifierBase;
    uint matterStatusStride;
    uint acceptedStateProofStride;
    uint controlStep;
    uint physicsSubstep;
    uint transactionSlot;
    uint environmentStatusStride;
    ulong transactionFingerprint;
    ulong substepFingerprint;
    ulong acceptedTimestampMicroseconds;
    ulong physicsGeneration;
    ulong matterSourcePhysicsFingerprint;
    ulong matterDeviceProgramFingerprint;
    ulong stateProofProgramFingerprint;
    ulong adapterProgramFingerprint;
    ulong transactionPolicyFingerprint;
    ulong linearizationEpoch;
    ulong slotGeneration;
};

struct FinalizeGPUV2 {
    uint abiVersion;
    uint structSize;
    uint environmentCount;
    uint environmentIdentifierBase;
    uint matterStatusStride;
    uint acceptedStateProofStride;
    uint controlStep;
    uint physicsSubstep;
    uint transactionSlot;
    uint environmentStatusStride;
    uint clockDomain;
    uint clockQuantumNanoseconds;
    uint reserved0;
    uint reserved1;
    ulong transactionFingerprint;
    ulong substepFingerprint;
    ulong acceptedTimestampNanoseconds;
    ulong physicsGeneration;
    ulong matterSourcePhysicsFingerprint;
    ulong matterDeviceProgramFingerprint;
    ulong stateProofProgramFingerprint;
    ulong adapterProgramFingerprint;
    ulong transactionPolicyFingerprint;
    ulong linearizationEpoch;
    ulong slotGeneration;
    ulong motorCandidateFingerprint;
};

inline void mixUInt(thread ulong& hash, const uint value) {
    for (uint byte = 0u; byte < 4u; ++byte) {
        hash ^= ulong((value >> (8u * byte)) & 0xffu);
        hash *= kFNVPrime;
    }
}

inline void mixULong(thread ulong& hash, const ulong value) {
    for (uint byte = 0u; byte < 8u; ++byte) {
        hash ^= (value >> (8u * byte)) & 0xfful;
        hash *= kFNVPrime;
    }
}

inline ulong physicsFingerprint(
    const ulong human,
    const ulong matter,
    constant FinalizeGPU& pass,
    const uint environment
) {
    ulong hash = kFNVOffset;
    mixUInt(hash, kPhysicsDomain);
    mixUInt(hash, NM_MATTER_ACCEPTED_STATE_PROOF_ABI_VERSION);
    mixULong(hash, human);
    mixULong(hash, matter);
    mixULong(hash, pass.matterSourcePhysicsFingerprint);
    mixULong(hash, pass.matterDeviceProgramFingerprint);
    mixULong(hash, pass.stateProofProgramFingerprint);
    mixULong(hash, pass.adapterProgramFingerprint);
    mixULong(hash, pass.transactionPolicyFingerprint);
    mixULong(hash, pass.transactionFingerprint);
    mixULong(hash, pass.substepFingerprint);
    mixULong(hash, pass.physicsGeneration);
    mixUInt(hash, environment);
    return hash;
}

inline ulong recordFingerprint(thread const NMAcceptedStateProofGPU& proof) {
    ulong hash = kFNVOffset;
    mixUInt(hash, proof.abiVersion);
    mixUInt(hash, proof.structSize);
    mixUInt(hash, proof.status);
    mixUInt(hash, proof.environment);
    mixULong(hash, proof.transactionFingerprint);
    mixULong(hash, proof.substepFingerprint);
    mixULong(hash, proof.acceptedTimestampMicroseconds);
    mixULong(hash, proof.physicsGeneration);
    mixULong(hash, proof.humanStateFingerprint);
    mixULong(hash, proof.matterStateFingerprint);
    mixULong(hash, proof.physicsStateFingerprint);
    mixULong(hash, proof.matterSourcePhysicsFingerprint);
    mixULong(hash, proof.matterDeviceProgramFingerprint);
    mixULong(hash, proof.linearizationEpoch);
    mixULong(hash, proof.slotGeneration);
    mixULong(hash, proof.adapterProgramFingerprint);
    mixULong(hash, proof.transactionPolicyFingerprint);
    return hash;
}

inline ulong preparedTokenFingerprint(
    thread const NMAcceptedStateProofGPU& proof,
    constant FinalizeGPU& pass,
    const uint environment
) {
    ulong hash = kFNVOffset;
    mixUInt(hash, 1u);
    mixULong(hash, proof.transactionFingerprint);
    mixULong(hash, proof.substepFingerprint);
    mixULong(hash, proof.physicsStateFingerprint);
    mixULong(hash, proof.acceptedTimestampMicroseconds);
    mixULong(hash, proof.physicsGeneration);
    mixUInt(hash, pass.environmentIdentifierBase + environment);
    mixUInt(hash, 0u);
    // NBAcceptedPhysicsStateToken::reserved is canonical zero. The policy is
    // already bound by proof.physicsStateFingerprint.
    mixULong(hash, 0ul);
    return hash;
}

inline ulong inboundAuthorityFingerprint(
    thread const NMExactInboundAuthorityGPUV2& authority
) {
    ulong hash = kFNVOffset;
    mixUInt(
        hash, NM_MATTER_FINGERPRINT_DOMAIN_EXACT_INBOUND_AUTHORITY_V2);
    mixUInt(hash, authority.abiVersion);
    mixUInt(hash, authority.structSize);
    mixUInt(hash, authority.clockDomain);
    mixUInt(hash, authority.clockQuantumNanoseconds);
    mixULong(hash, authority.acceptedBrainTimestampNanoseconds);
    mixULong(hash, authority.brainGeneration);
    mixULong(hash, authority.transactionFingerprint);
    mixULong(hash, authority.substepFingerprint);
    mixULong(hash, authority.motorCandidateFingerprint);
    mixULong(hash, authority.motorOutputFingerprint);
    mixULong(hash, authority.motorProfileFingerprint);
    mixULong(hash, authority.motorReadyGateFingerprint);
    mixULong(hash, authority.brainProgramFingerprint);
    mixULong(hash, authority.fastProgramFingerprint);
    mixULong(hash, authority.decisionGateFingerprint);
    return hash;
}

inline bool validInboundAuthority(
    thread const NMExactInboundAuthorityGPUV2& authority,
    constant FinalizeGPUV2& pass
) {
    const ulong expected = inboundAuthorityFingerprint(authority);
    return authority.abiVersion ==
            NM_MATTER_EXACT_INBOUND_AUTHORITY_ABI_VERSION_V2 &&
        authority.structSize == NM_MATTER_EXACT_INBOUND_AUTHORITY_V2_BYTES &&
        authority.clockDomain == pass.clockDomain &&
        authority.clockQuantumNanoseconds == pass.clockQuantumNanoseconds &&
        authority.brainGeneration != 0ul &&
        authority.transactionFingerprint == pass.transactionFingerprint &&
        authority.substepFingerprint == pass.substepFingerprint &&
        authority.motorCandidateFingerprint ==
            pass.motorCandidateFingerprint &&
        authority.motorOutputFingerprint != 0ul &&
        authority.motorProfileFingerprint != 0ul &&
        authority.motorReadyGateFingerprint != 0ul &&
        authority.brainProgramFingerprint != 0ul &&
        authority.fastProgramFingerprint != 0ul &&
        authority.decisionGateFingerprint != 0ul &&
        authority.inboundAuthorityFingerprint != 0ul &&
        authority.inboundAuthorityFingerprint == expected;
}

inline ulong physicsFingerprintV2(
    const ulong human,
    const ulong matter,
    thread const NMExactInboundAuthorityGPUV2& authority,
    constant FinalizeGPUV2& pass,
    const uint environment
) {
    ulong hash = kFNVOffset;
    mixUInt(hash, NM_MATTER_FINGERPRINT_DOMAIN_PHYSICS_STATE_V2);
    mixUInt(hash, NM_MATTER_ACCEPTED_STATE_PROOF_ABI_VERSION_V2);
    mixUInt(hash, pass.clockDomain);
    mixUInt(hash, pass.clockQuantumNanoseconds);
    mixULong(hash, human);
    mixULong(hash, matter);
    mixULong(hash, pass.matterSourcePhysicsFingerprint);
    mixULong(hash, pass.matterDeviceProgramFingerprint);
    mixULong(hash, pass.stateProofProgramFingerprint);
    mixULong(hash, pass.adapterProgramFingerprint);
    mixULong(hash, pass.transactionPolicyFingerprint);
    mixULong(hash, pass.motorCandidateFingerprint);
    mixULong(hash, authority.inboundAuthorityFingerprint);
    mixULong(hash, pass.transactionFingerprint);
    mixULong(hash, pass.substepFingerprint);
    mixULong(hash, pass.acceptedTimestampNanoseconds);
    mixULong(hash, pass.physicsGeneration);
    mixUInt(hash, pass.environmentIdentifierBase + environment);
    return hash;
}

inline ulong recordFingerprintV2(
    thread const NMAcceptedStateProofGPUV2& proof
) {
    ulong hash = kFNVOffset;
    mixUInt(hash, NM_MATTER_FINGERPRINT_DOMAIN_ACCEPTED_STATE_PROOF_V2);
    mixUInt(hash, proof.abiVersion);
    mixUInt(hash, proof.structSize);
    mixUInt(hash, proof.status);
    mixUInt(hash, proof.environment);
    mixULong(hash, proof.transactionFingerprint);
    mixULong(hash, proof.substepFingerprint);
    mixULong(hash, proof.acceptedTimestampNanoseconds);
    mixULong(hash, proof.physicsGeneration);
    mixUInt(hash, proof.clockDomain);
    mixUInt(hash, proof.clockQuantumNanoseconds);
    mixULong(hash, proof.humanStateFingerprint);
    mixULong(hash, proof.matterStateFingerprint);
    mixULong(hash, proof.physicsStateFingerprint);
    mixULong(hash, proof.matterSourcePhysicsFingerprint);
    mixULong(hash, proof.matterDeviceProgramFingerprint);
    mixULong(hash, proof.stateProofProgramFingerprint);
