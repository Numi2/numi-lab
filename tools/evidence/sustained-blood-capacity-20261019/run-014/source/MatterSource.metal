// For fixed convex geometry, positive-distance supporting planes certify
// outward affine continuum motion. Dynamic/rotating/nonconvex proxies retain
// the general Lipschitz travel bound. Unresolved normal/dot rounding also
// retains that bound. The final trial CCD and production certificate still run.
inline bool nmFixedConvexContactOutward(
    const nm_u32 flags, const nm_u32 shape, const float separation,
    const float feasibleSeparation, const float travel,
    const float directionalSeparation, const float geometryRoundoff) {
    if ((flags & (NM_RIGID_DYNAMIC | NM_RIGID_ARTICULATED |
                  NM_RIGID_SUTURE_STRAND | NM_RIGID_PUNCTURE_TIP |
                  NM_RIGID_PUNCTURE_DILATOR)) != 0u ||
        !(shape == NM_RIGID_PLANE || shape == NM_RIGID_SPHERE ||
          shape == NM_RIGID_CAPSULE || shape == NM_RIGID_BOX) ||
        !(separation > feasibleSeparation) || !(travel > 0.0f) ||
        !(geometryRoundoff >= 0.0f)) return false;
    const float normalUncertainty = 32.0f * 0x1p-23f +
        8.0f * geometryRoundoff / separation;
    if (!(normalUncertainty < 0.25f)) return false;
    const float outwardMargin = normalUncertainty * travel +
        2.0f * geometryRoundoff;
    return directionalSeparation > outwardMargin;
}

#endif



kernel void nm_contact_limit_rigid_line_search(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const NMContinuumObjectGPU* objects [[buffer(1)]],
    device const NMIncidenceRangeGPU* femNodeRanges [[buffer(2)]],
    device const NMSchedulerStateGPU* schedulers [[buffer(3)]],
    device const NMFEMNodeStateGPU* candidate [[buffer(4)]],
    device const float4* correction [[buffer(5)]],
    device float4* lineSearch [[buffer(6)]],
    device NMMatterStatusGPU* statuses [[buffer(7)]],
    device const NMGridNodeStateGPU* gridNodes [[buffer(8)]],
    constant NMPrimalContactArguments& contact [[buffer(9)]],
    constant uint& articulatedNv [[buffer(10)]],
    device const float* coupledPointJacobians [[buffer(11)]],
    constant NMMixedSolverGPU& solver [[buffer(12)]],
    uint lane [[thread_index_in_threadgroup]],
    uint environment [[threadgroup_position_in_grid]]
) {
    if (lane >= 32u || environment >= dispatch.environmentCount ||
        !environmentHealthy(statuses, environment)) return;
    const uint activeCapacity = dispatch.reservedMixed1;
    const uint activeCount = min(
        contact.activeCounts[environment], activeCapacity);
    const uint activeBase = environment * activeCapacity;
    const uint objectBase = environment * dispatch.objectCount;
    const float existing = dispatch.objectCount > 0u
        ? lineSearch[objectBase].x : 1.0f;
    float bound = 1.0f;
    for (uint activeSlot = lane; activeSlot < activeCount;
         activeSlot += 32u) {
        const uint pairIndex = contact.activePairs[activeBase + activeSlot];
        if (pairIndex >= dispatch.contactPairCount) {
            bound = 0.0f;
            continue;
        }
        const NMContactPairGPU pair = contact.pairs[pairIndex];
        const NMContactSampleGPU sample = primalContactSample(
            dispatch, contact, environment, pairIndex);
        if ((sample.identity.w & NM_CONTACT_VALID) == 0u ||
            pair.objectIndex >= dispatch.objectCount) continue;
        const NMContinuumObjectGPU object = objects[pair.objectIndex];
        const float dt = objectTimestep(
            dispatch,
            schedulers[environment * dispatch.objectCount +
                       pair.objectIndex]);
        float3 continuumDisplacement = float3(0.0f);
        if (pair.continuumNode < dispatch.gridNodeCount) {
            const uint nodeGlobal =
                environment * dispatch.gridNodeCount + pair.continuumNode;
            const uint slot = contact.mpmNodeToActive[nodeGlobal];
            if (object.representation != NM_REPRESENTATION_MPM ||
                slot >= contact.mpmActiveNodeCounts[environment] ||
                !(gridNodes[nodeGlobal].positionAndMass.w > 0.0f)) {
                bound = 0.0f;
                continue;
            }
            continuumDisplacement = dt * correction[fgmresMPMIndex(
                dispatch, environment, slot)].xyz;
        } else {
            const uint node = pair.continuumNode - dispatch.gridNodeCount;
            const uint nodeGlobal =
                environment * dispatch.femNodeCount + node;
            if (node >= dispatch.femNodeCount ||
                object.representation != NM_REPRESENTATION_FEM ||
                femNodeRanges[nodeGlobal].objectIndex != pair.objectIndex ||
                !(candidate[nodeGlobal].positionAndMass.w > 0.0f)) {
                bound = 0.0f;
                continue;
            }
            continuumDisplacement = dt * correction[nodeGlobal].xyz;
        }
        const float3 rigidDisplacement = dt * coupledRigidPointDirection(
            dispatch, contact, coupledPointJacobians, environment, pairIndex,
            articulatedNv, correction);
        const float3 relativeDisplacement =
            continuumDisplacement - rigidDisplacement;
        const float travel = length(relativeDisplacement);
        const float separation = sample.pointAndSeparation.w;
        const float directionalSeparation = dot(
            sample.normalAndVelocity.xyz, relativeDisplacement);
        const float coordinateScale = max(
            sample.barrier.z,
            max(max(abs(sample.pointAndSeparation.x),
                    abs(sample.pointAndSeparation.y)),
                abs(sample.pointAndSeparation.z)));
        const float collisionThickness = max(
            solver.contactAcceptance.x * dispatch.numericalLimits.x,
            16.0f * kEpsilon * max(coordinateScale, 1.0e-12f));
        const float boundaryRoundoff =
            ccdDistanceRoundoff(collisionThickness, coordinateScale);
        const float feasibleSeparation = collisionThickness +
            boundaryRoundoff;
        if (!isfinite(separation) || !isfinite(travel) ||
            !isfinite(directionalSeparation) ||
            separation < collisionThickness - boundaryRoundoff) {
            recordFailure(
                statuses[environment], NM_STATUS_CONTACT_FAILURE,
                pair.objectIndex, pairIndex,
                float4(
                    separation,
                    travel,
                    collisionThickness,
                    directionalSeparation
                ));
            bound = 0.0f;
            continue;
        }
        if (travel > kGeometryFloor) {
            if (separation <= feasibleSeparation) {
                // Equality with the authored floor is collision-free. Do not
                // latch a failure before an outward Newton direction can
                // restore the FP32 margin. An inward or stationary direction
                // receives a zero step and still has to satisfy the final,
                // strictly-above-floor certificate.
                if (!(directionalSeparation > 0.0f)) {
                    bound = 0.0f;
                }
            } else {
                // The fixed convex obstacle's supporting plane proves that
                // a resolved outward affine FEM trial cannot approach it.
                // Tangential/uncertain and every moving/nonconvex proxy still
                // use the general travel bound. Trial CCD is unchanged.
                const bool certifiedOutward =
                    object.representation == NM_REPRESENTATION_FEM &&
                    pair.rigidProxy < dispatch.rigidProxyCount &&
                    nmFixedConvexContactOutward(
                        contact.rigidProxies[pair.rigidProxy].flags,
                        contact.rigidProxies[pair.rigidProxy].shapeKind,
                        separation, feasibleSeparation, travel,
                        directionalSeparation, boundaryRoundoff);
                if (!certifiedOutward)
                bound = min(bound, clamp(
                    0.9f * (separation - feasibleSeparation) / travel,
                    0.0f, 1.0f));
            }
        }
        // MPM's grid-node contact is local to this barrier feature. Preserve
        // its descent when the KKT direction is a descent direction, while
        // allowing a globally coupled ascent feature to be governed by the
        // feasibility bound and the complete Newton residual.
        const float currentEnergy = ipcBarrierEnergy(
            separation, sample.barrier.z, sample.barrier.w);
        const float directionalDerivative =
            -sample.barrier.x * directionalSeparation /
                max(dt, 1.0e-20f);
        if (!isfinite(currentEnergy) ||
            !isfinite(directionalDerivative)) {
            recordFailure(
                statuses[environment], NM_STATUS_CONTACT_FAILURE,
                pair.objectIndex, pairIndex,
                float4(currentEnergy, directionalDerivative, bound, 0.0f));
            bound = 0.0f;
            continue;
        }
        if (object.representation == NM_REPRESENTATION_MPM &&
            currentEnergy > 0.0f && directionalDerivative < 0.0f &&
            bound > 0.0f) {
            const float startAlpha = min(existing, bound);
            float armijoAlpha = 0.0f;
            const uint lineSearchSteps = min(
                solver.nonlinearIterations.w,
                NM_MIXED_LINE_SEARCH_MAX_STEPS);
            for (uint trial = 0u; trial < lineSearchSteps; ++trial) {
                const float alpha = startAlpha * exp2(-float(trial));
                const float trialSeparation =
                    separation + alpha * directionalSeparation;
                const float trialEnergy = ipcBarrierEnergy(
                    trialSeparation, sample.barrier.z, sample.barrier.w);
                const float armijoRight = currentEnergy +
                    1.0e-4f * alpha * directionalDerivative;
                if (isfinite(trialEnergy) &&
                    trialSeparation > feasibleSeparation &&
                    trialEnergy <= armijoRight) {
                    armijoAlpha = alpha;
                    break;
                }
            }
            if (!(armijoAlpha > 0.0f)) {
                recordFailure(
                    statuses[environment], NM_STATUS_CONTACT_FAILURE,
                    pair.objectIndex, pairIndex,
                    float4(currentEnergy, directionalDerivative,
                           startAlpha, 0.0f));
                bound = 0.0f;
            } else {
                bound = min(bound, armijoAlpha);
            }
        }
        // This kernel owns feasibility only. The direction is a monolithic
        // KKT direction, so one rigid feature may gain barrier energy while
        // the coupled residual decreases; a per-feature Armijo test would
        // incorrectly reject that valid global step. The MPM guard above is
        // deliberately narrower because its grid-node barrier is local.
    }
    bound = simd_min(bound);
    const float alpha = min(existing, bound);
    for (uint objectIndex = lane; objectIndex < dispatch.objectCount;
         objectIndex += 32u) {
        float4 state = lineSearch[objectBase + objectIndex];
        state.x = alpha;
        lineSearch[objectBase + objectIndex] = state;
    }
}

kernel void nm_contact_publish_deformable_history(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const NMDeformableContactGPU* contacts [[buffer(1)]],
    device const uint* globalActiveIndices [[buffer(2)]],
    device const NMIndirectDispatchGPU* activeDispatch [[buffer(3)]],
    device NMDeformableContactHistoryGPU* histories [[buffer(4)]],
    uint global [[thread_position_in_grid]]
) {
    const uint capacity = dispatch.deformableContactCapacity;
    const uint activeTotal = activeDispatch[0].reserved;
    if (capacity == 0u || global >= activeTotal) return;
    const uint encoded = globalActiveIndices[global];
    const uint environment = encoded / capacity;
    const uint slot = encoded - environment * capacity;
    if (environment >= dispatch.environmentCount || slot >= capacity) return;
    const NMDeformableContactGPU contact =
        contacts[environment * capacity + slot];
    NMDeformableContactHistoryGPU history{};
    history.source = contact.source;
    history.normalAndBarrier = float4(
        contact.normalAndTOI.xyz, contact.barrier.x);
    history.laggedTangentAndFriction = float4(
        contact.impulseAndFriction.yz,
        contact.impulseAndFriction.w, 1.0f);
    histories[environment * capacity + slot] = history;
}
kernel void nm_contact_accumulate_fem_residual(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const uint* nodeIncidence [[buffer(1)]],
    device const NMIncidenceRangeGPU* nodeRanges [[buffer(2)]],
    device const NMContactSampleGPU* samples [[buffer(3)]],
    device float4* residual [[buffer(4)]],
    device const uint* sampleStorageMode [[buffer(5)]],
    device const uint* samplePageComplete [[buffer(6)]],
    device const uint* sampleSlotsByPair [[buffer(7)]],
    device const uint* sampleCounts [[buffer(8)]],
    device const uint* sampleCapacity [[buffer(9)]],
    device const NMFEMNodeStateGPU* candidate [[buffer(10)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.femNodeCount;
    if (global >= total || dispatch.femNodeCount == 0u) return;
    // Prescribed static rows receive support reactions through the separate
    // publication kernel, never an unsatisfiable Newton equation. Human tag 2
    // remains dynamic and must retain its J^T attachment residual.
    const auto nodeState = candidate[global];
    if (femStaticConstraint(nodeState.restAndFixed.w) ||
        (!femHumanAttachmentConstraint(nodeState.restAndFixed.w) &&
         !(nodeState.positionAndMass.w > 0.0f))) return;
    const uint environment = global / dispatch.femNodeCount;
    const uint femNode = global - environment * dispatch.femNodeCount;
    const uint unifiedNode = dispatch.gridNodeCount + femNode;
    const NMIncidenceRangeGPU range = nodeRanges[unifiedNode];
    float3 impulse = float3(0.0f);
    for (uint local = 0u; local < range.count; ++local) {
        const uint pair = nodeIncidence[range.first + local];
        if (pair >= dispatch.contactPairCount) continue;
        const NMContactSampleGPU sample = contactSampleAt(
            dispatch, samples, sampleStorageMode, samplePageComplete,
            sampleSlotsByPair, sampleCounts, sampleCapacity,
            environment, pair);
        if ((sample.identity.w & NM_CONTACT_VALID) != 0u)
            impulse -= sample.impulseAndNormal.xyz;
    }
    // Assemble the contact block into the already evaluated nonlinear
    // mechanical/pressure residual. Replacing this value would discard
    // internal force, pressure, field-coupling and learned-material terms and
    // reduce the following solve to a staged contact-only correction.
    residual[global] += float4(impulse, 0.0f);
}

inline bool sameArmijoContactSampleFields(
    const NMContactSampleGPU first,
    const NMContactSampleGPU second
) {
    return all(first.identity == second.identity) &&
        all(as_type<uint4>(first.pointAndSeparation) ==
            as_type<uint4>(second.pointAndSeparation)) &&
        all(as_type<uint4>(first.normalAndVelocity) ==
            as_type<uint4>(second.normalAndVelocity)) &&
        all(as_type<uint4>(first.admissionVelocityAndNormal) ==
            as_type<uint4>(second.admissionVelocityAndNormal)) &&
        all(as_type<uint4>(first.impulseAndNormal) ==
            as_type<uint4>(second.impulseAndNormal)) &&
        all(as_type<uint4>(first.angularImpulseAndTangent) ==
            as_type<uint4>(second.angularImpulseAndTangent)) &&
        all(as_type<uint4>(first.barrier) == as_type<uint4>(second.barrier)) &&
        all(as_type<uint4>(first.barrierHessianRow0) ==
            as_type<uint4>(second.barrierHessianRow0)) &&
        all(as_type<uint4>(first.barrierHessianRow1) ==
            as_type<uint4>(second.barrierHessianRow1)) &&
        all(as_type<uint4>(first.barrierHessianRow2) ==
            as_type<uint4>(second.barrierHessianRow2));
}

kernel void nm_contact_compare_armijo_sparse_samples(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant uint& candidateCapacity [[buffer(1)]],
    device const NMContactSampleGPU* denseSamples [[buffer(2)]],
    device const NMContactSampleGPU* sparseSamples [[buffer(3)]],
    device const uint* candidateSlotByPair [[buffer(4)]],
    device const uint* candidatePairIds [[buffer(5)]],
    device NMMatterStatusGPU* statuses [[buffer(6)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.contactPairCount;
    if (global >= total || dispatch.contactPairCount == 0u) return;
    const uint environment = global / dispatch.contactPairCount;
    const uint pairIndex = global - environment * dispatch.contactPairCount;
    if (!environmentHealthy(statuses, environment)) return;
    const uint slot = candidateSlotByPair[global];
    NMContactSampleGPU sparseSample{};
    if (slot != NM_INVALID_INDEX) {
        if (slot >= candidateCapacity) {
            recordFailure(statuses[environment], NM_STATUS_INVALID_DISPATCH,
                NM_INVALID_INDEX, pairIndex,
                float4(float(slot), float(candidateCapacity), float(pairIndex), 1.0f));
            return;
        }
        if (candidatePairIds[environment * candidateCapacity + slot] != pairIndex) {
            recordFailure(statuses[environment], NM_STATUS_CONTACT_FAILURE,
                NM_INVALID_INDEX, pairIndex,
                float4(float(slot),
                    float(candidatePairIds[environment * candidateCapacity + slot]),
                    float(pairIndex), 2.0f));
            return;
        }
        sparseSample = sparseSamples[
            environment * candidateCapacity + slot];
    }
    const NMContactSampleGPU denseSample = denseSamples[global];
    if (!sameArmijoContactSampleFields(denseSample, sparseSample)) {
        recordFailure(statuses[environment], NM_STATUS_CONTACT_FAILURE,
            denseSample.identity.z, pairIndex,
            float4(float(denseSample.identity.w), float(sparseSample.identity.w),
                float(slot), 3.0f));
    }
}

kernel void nm_contact_accumulate_fem_residual_sparse(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const uint* nodeIncidence [[buffer(1)]],
    device const NMIncidenceRangeGPU* nodeRanges [[buffer(2)]],
    device const NMContactSampleGPU* samples [[buffer(3)]],
    device const uint* candidateSlotByPair [[buffer(4)]],
    constant uint& candidateCapacity [[buffer(5)]],
    device float4* residual [[buffer(6)]],
    device NMMatterStatusGPU* statuses [[buffer(7)]],
    device const NMFEMNodeStateGPU* candidate [[buffer(8)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.femNodeCount;
    if (global >= total || dispatch.femNodeCount == 0u) return;
    // Prescribed static rows receive support reactions through the separate
    // publication kernel, never an unsatisfiable Newton equation. Human tag 2
    // remains dynamic and must retain its J^T attachment residual.
    const auto nodeState = candidate[global];
    if (femStaticConstraint(nodeState.restAndFixed.w) ||
        (!femHumanAttachmentConstraint(nodeState.restAndFixed.w) &&
         !(nodeState.positionAndMass.w > 0.0f))) return;
    const uint environment = global / dispatch.femNodeCount;
    if (!environmentHealthy(statuses, environment)) return;
    const uint femNode = global - environment * dispatch.femNodeCount;
    const uint unifiedNode = dispatch.gridNodeCount + femNode;
    const NMIncidenceRangeGPU range = nodeRanges[unifiedNode];
    float3 impulse = float3(0.0f);
    const uint pairBase = environment * dispatch.contactPairCount;
    const uint sampleBase = environment * candidateCapacity;
    for (uint local = 0u; local < range.count; ++local) {
        const uint pair = nodeIncidence[range.first + local];
        if (pair >= dispatch.contactPairCount) continue;
        const uint slot = candidateSlotByPair[pairBase + pair];
        if (slot == NM_INVALID_INDEX) continue;
        if (slot >= candidateCapacity) {
            recordFailure(statuses[environment], NM_STATUS_INVALID_DISPATCH,
                NM_INVALID_INDEX, pair,
                float4(float(slot), float(candidateCapacity), float(femNode), 4.0f));
            return;
        }
        const NMContactSampleGPU sample = samples[sampleBase + slot];
        if ((sample.identity.w & NM_CONTACT_VALID) != 0u)
            impulse -= sample.impulseAndNormal.xyz;
    }
    residual[global] += float4(impulse, 0.0f);
}

kernel void nm_contact_reduce_rigid(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const uint* rigidIncidence [[buffer(1)]],
    device const NMIncidenceRangeGPU* rigidRanges [[buffer(2)]],
    device const NMContactSampleGPU* samples [[buffer(3)]],
    device NMRigidReactionGPU* reactions [[buffer(4)]],
    device const uint* sampleStorageMode [[buffer(5)]],
    device const uint* samplePageComplete [[buffer(6)]],
    device const uint* sampleSlotsByPair [[buffer(7)]],
    device const uint* sampleCounts [[buffer(8)]],
    device const uint* sampleCapacity [[buffer(9)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.rigidProxyCount;
    if (global >= total || dispatch.rigidProxyCount == 0u) {
        return;
    }
    const uint environment = global / dispatch.rigidProxyCount;
    const uint proxy = global - environment * dispatch.rigidProxyCount;
    const NMIncidenceRangeGPU range = rigidRanges[proxy];
    float3 impulse = float3(0.0f);
    float3 angularImpulse = float3(0.0f);
    float count = 0.0f;
    for (uint local = 0u; local < range.count; ++local) {
        const uint pair = rigidIncidence[range.first + local];
        if (pair >= dispatch.contactPairCount) continue;
        const NMContactSampleGPU sample = contactSampleAt(
            dispatch, samples, sampleStorageMode, samplePageComplete,
            sampleSlotsByPair, sampleCounts, sampleCapacity,
            environment, pair);
        if ((sample.identity.w & NM_CONTACT_VALID) != 0u) {
            impulse += sample.impulseAndNormal.xyz;
            angularImpulse += sample.angularImpulseAndTangent.xyz;
            count += 1.0f;
        }
    }
    NMRigidReactionGPU reaction{};
    reaction.impulseAndCount = float4(impulse, count);
    reaction.angularImpulse = float4(angularImpulse, 0.0f);
    reactions[global] = reaction;
}

kernel void nm_accumulate_rigid_reactions(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const NMRigidReactionGPU* microstepReactions [[buffer(1)]],
    device NMRigidReactionGPU* frameReactions [[buffer(2)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.rigidProxyCount;
    if (global >= total) {
        return;
    }
    frameReactions[global].impulseAndCount +=
        microstepReactions[global].impulseAndCount;
    frameReactions[global].angularImpulse +=
        microstepReactions[global].angularImpulse;
}

// One thread owns one DER node and deterministically gathers all adjacent
// suture-proxy contact samples. Barycentric endpoint weights conserve the
// rigid-side impulse exactly while avoiding atomics at shared segment nodes.
// The velocity update precedes MetalWorld's implicit DER substep; rejected
// enclosing transactions publish the rod checkpoint instead of this source.
kernel void nm_apply_suture_strand_reactions(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMBridgeDispatchGPU& bridge [[buffer(1)]],
    device const NMRigidProxyGPU* proxies [[buffer(2)]],
    device const uint* rigidIncidence [[buffer(3)]],
    device const NMIncidenceRangeGPU* rigidRanges [[buffer(4)]],
    device const NMContactSampleGPU* samples [[buffer(5)]],
    device const float* inverseMasses [[buffer(6)]],
    device MRRodNodeStateGPU* rodNodes [[buffer(7)]],
    device NMMatterStatusGPU* statuses [[buffer(8)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * bridge.rodNodeCount;
    if (global >= total || bridge.rodNodeCount == 0u ||
        bridge.rodNodeStride < bridge.rodNodeCount) return;
    const uint environment = global / bridge.rodNodeCount;
    const uint node = global - environment * bridge.rodNodeCount;
    if (!environmentHealthy(statuses, environment)) return;
    const uint nodeBase = environment * bridge.rodNodeStride;
    float3 impulse = float3(0.0f);
    for (uint proxyIndex = 0u; proxyIndex < dispatch.rigidProxyCount;
         ++proxyIndex) {
        const NMRigidProxyGPU proxy = proxies[proxyIndex];
        if ((proxy.flags & NM_RIGID_SUTURE_STRAND) == 0u ||
            (proxy.bodyIndex != node && proxy.sceneBodyIndex != node) ||
            proxy.bodyIndex >= bridge.rodNodeCount ||
            proxy.sceneBodyIndex >= bridge.rodNodeCount) continue;
        const float3 endpointA =
            rodNodes[nodeBase + proxy.bodyIndex].position.xyz;
        const float3 endpointB =
            rodNodes[nodeBase + proxy.sceneBodyIndex].position.xyz;
        const float3 edge = endpointB - endpointA;
        const float lengthSquared = dot(edge, edge);
        if (!(lengthSquared > kGeometryFloor)) continue;
        const NMIncidenceRangeGPU range = rigidRanges[proxyIndex];
        for (uint local = 0u; local < range.count; ++local) {
            const uint pairIndex = rigidIncidence[range.first + local];
            if (pairIndex >= dispatch.contactPairCount) continue;
            const NMContactSampleGPU sample = samples[
                environment * dispatch.contactPairCount + pairIndex
            ];
            if ((sample.identity.w & NM_CONTACT_VALID) == 0u) continue;
            const float coordinate = clamp(
                dot(sample.pointAndSeparation.xyz - endpointA, edge) /
                    lengthSquared,
                0.0f,
                1.0f
            );
            const float weight = proxy.bodyIndex == node
                ? 1.0f - coordinate : coordinate;
            impulse += weight * sample.impulseAndNormal.xyz;
        }
    }
    const float inverseMass = inverseMasses[node];
    const float3 deltaVelocity = inverseMass * impulse;
    if (!isfinite(inverseMass) || !(inverseMass > 0.0f) ||
        !finite3(deltaVelocity)) {
        recordFailure(
            statuses[environment],
            NM_STATUS_NONFINITE_RESULT,
            NM_INVALID_INDEX,
            node,
            float4(deltaVelocity, inverseMass)
        );
        return;
    }
    rodNodes[nodeBase + node].velocity.xyz += deltaVelocity;
}

kernel void nm_mask_primal_rigid_candidate(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    device const NMMatterStatusGPU* statuses [[buffer(1)]],
    device float* candidate [[buffer(2)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount *
        dispatch.rigidGeneralizedCapacity;
    if (global >= total || dispatch.rigidGeneralizedCapacity == 0u) return;
    const uint environment = global / dispatch.rigidGeneralizedCapacity;
    if (!environmentHealthy(statuses, environment)) candidate[global] = 0.0f;
}

// Publishes the accepted free-body block as the unique world-frame wrench
// consumed by MetalWorld. Articulated blocks are published by the borrowed
// owning mass operator; this kernel owns only compact free-body indices.
kernel void nm_publish_primal_free_rigid_candidate(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMBridgeDispatchGPU& bridge [[buffer(1)]],
    constant uint& articulatedNv [[buffer(2)]],
    device const NMRigidProxyGPU* proxies [[buffer(3)]],
    device const MRBodyStateGPU* currentBodies [[buffer(4)]],
    device const float* candidate [[buffer(5)]],
    device MRABABodyWrenchGPU* bodyWrenches [[buffer(6)]],
    device NMMatterStatusGPU* statuses [[buffer(7)]],
    device const uint* bodyProxyIncidence [[buffer(8)]],
    device const NMIncidenceRangeGPU* bodyProxyRanges [[buffer(9)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * bridge.reactionBodyCount;
    if (global >= total || bridge.reactionBodyCount == 0u) return;
    const uint environment = global / bridge.reactionBodyCount;
    const uint bodyIndex = global - environment * bridge.reactionBodyCount;
    if (!environmentHealthy(statuses, environment) ||
        bodyIndex >= bridge.currentBodyCount ||
        bodyIndex >= bridge.bodyWrenchCount ||
        bridge.currentBodyStride < bridge.currentBodyCount) return;
    const NMIncidenceRangeGPU range = bodyProxyRanges[bodyIndex];
    uint freeIndex = NM_INVALID_INDEX;
    for (uint local = 0u; local < range.count; ++local) {
        const uint proxyIndex = bodyProxyIncidence[range.first + local];
        if (proxyIndex >= dispatch.rigidProxyCount) continue;
        const NMRigidProxyGPU proxy = proxies[proxyIndex];
        if (proxy.bodyIndex != bodyIndex ||
            (proxy.flags & NM_RIGID_DYNAMIC) == 0u ||
            (proxy.flags & NM_RIGID_ARTICULATED) != 0u) continue;
        if (freeIndex == NM_INVALID_INDEX)
            freeIndex = proxy.generalizedFreeBodyIndex;
        else if (freeIndex != proxy.generalizedFreeBodyIndex) {
            recordFailure(
                statuses[environment], NM_STATUS_INVALID_DISPATCH,
                NM_INVALID_INDEX, proxyIndex,
                float4(float(bodyIndex), float(freeIndex),
                    float(proxy.generalizedFreeBodyIndex), 0.0f));
            return;
        }
    }
    if (freeIndex == NM_INVALID_INDEX) return;
    const uint base = environment * dispatch.rigidGeneralizedCapacity +
        articulatedNv + 6u * freeIndex;
    if (articulatedNv + 6u * freeIndex + 6u >
        dispatch.rigidGeneralizedCapacity) {
        recordFailure(
            statuses[environment], NM_STATUS_CAPACITY_OVERFLOW,
            NM_INVALID_INDEX, bodyIndex,
            float4(float(articulatedNv), float(freeIndex),
                float(dispatch.rigidGeneralizedCapacity), 0.0f));
        return;
    }
    const MRBodyStateGPU source = currentBodies[
        environment * bridge.currentBodyStride + bodyIndex];
    if (source.flagsAndIndices[0] > MR_MOTION_DYNAMIC) {
        recordFailure(
            statuses[environment], NM_STATUS_INVALID_DISPATCH,
            NM_INVALID_INDEX, bodyIndex,
            float4(float(source.flagsAndIndices[0]), 0.0f, 0.0f, 0.0f));
        return;
    }
    if (source.flagsAndIndices[0] != MR_MOTION_DYNAMIC) {
        // A pre-authored free-body capability is intentionally dormant while
        // the live source is static or kinematic. MetalWorld clears the shared
        // wrench arena, so returning publishes the required exact zero.
        return;
    }
    const float inverseMass = source.linearVelocityAndInverseMass.w;
    float3x3 inertia;
    if (!(inverseMass > 0.0f) ||
        !invert3x3(matrixFromRows(
            source.inverseInertiaWorldRow0,
            source.inverseInertiaWorldRow1,
            source.inverseInertiaWorldRow2), inertia)) {
        recordFailure(
            statuses[environment], NM_STATUS_INVALID_DISPATCH,
            NM_INVALID_INDEX, bodyIndex,
            float4(inverseMass, 0.0f, 0.0f, 0.0f));
        return;
    }
    const float3 deltaLinear = float3(
        candidate[base + 0u], candidate[base + 1u], candidate[base + 2u]);
    const float3 deltaAngular = float3(
        candidate[base + 3u], candidate[base + 4u], candidate[base + 5u]);
    const float3 force = bridge.time.x * deltaLinear / inverseMass;
    const float3 torque = bridge.time.x * (inertia * deltaAngular);
    if (!finite3(force) || !finite3(torque)) {
        recordFailure(
            statuses[environment], NM_STATUS_NONFINITE_RESULT,
            NM_INVALID_INDEX, bodyIndex,
            float4(max(max(abs(force), abs(torque)), float3(0.0f)), 0.0f));
        return;
    }
    device MRABABodyWrenchGPU& wrench = bodyWrenches[
        environment * bridge.bodyWrenchStride + bodyIndex];
    wrench.force.xyz += force;
    wrench.torque.xyz += torque;
}

