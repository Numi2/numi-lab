typedef struct MR_ALIGN16 MRMeshBVHNodeGPU {
    mr_uint4 quantizedLower[MR_MESH_BVH_BRANCHING];
    mr_uint4 quantizedUpper[MR_MESH_BVH_BRANCHING];
