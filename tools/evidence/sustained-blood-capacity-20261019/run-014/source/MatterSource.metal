inline mr_u32 mrCompensatedBits(float value) {
#ifdef __METAL_VERSION__
    return as_type<uint>(value);
#else
    mr_u32 bits;
    std::memcpy(&bits, &value, sizeof(bits));
    return bits;
#endif
