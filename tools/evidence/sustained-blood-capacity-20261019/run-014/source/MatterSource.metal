// Conservative closed RLC network and passive tissue transport, integrated in
// the Matter Newton state. Every dynamic value is physical / authored scale.
// All reservoirs and fluxes use SI units; no biological parameter defaults.
inline float vascularPhysical(device const float4* state,
    device const NMVascularUnknownGPU* unknowns, uint base, uint local) {
    return state[base + local].x * unknowns[local].initialAndScaling.y;
}
inline float vascularConcentration(float amount, float volume) {
    const float value = amount / volume;
    return isfinite(amount) && amount >= 0.0f && isfinite(volume) &&
        volume > 0.0f && isfinite(value) && (amount == 0.0f || value > 0.0f)
        ? value : INFINITY;
}
inline float2 vascularPressureTangent(const NMVascularCompartmentGPU node, float volume, float elastance) {
    if (node.identity.w != 3u)
        return float2(node.compliance.w + node.compliance.y +
            (volume - node.compliance.x) * elastance, elastance);
    const float displacement = volume - node.compliance.x;
    const float maximum = node.pressureParameters.x;
    if (!isfinite(volume) || !(volume > 0.0f) || !(abs(displacement) < maximum))
        return float2(INFINITY);
    const float angle = (0.5f * node.waveform.x) * (displacement / maximum);
    if (!(cos(angle) > 0.0f)) return float2(INFINITY);
    const float t = tan(angle);
    const float pressure = node.compliance.w + node.compliance.y +
        (2.0f * maximum / node.waveform.x / node.compliance.z) * t;
    const float derivative = (1.0f + t * t) / node.compliance.z;
    return isfinite(pressure) && isfinite(derivative) && derivative > 0.0f
        ? float2(pressure, derivative) : float2(INFINITY);
}
inline float vascularPressure(const NMVascularCompartmentGPU node, float volume, float elastance) {
    return vascularPressureTangent(node, volume, elastance).x;
}
// Read the ordinary device direction, or one implicit unit vector while
// assembling a dense vascular-only Jacobian through the same evaluator.
inline float vascularDirection(device const float4* direction, uint base,
    uint row, uint basisColumn) {
    return basisColumn == NM_INVALID_INDEX ? direction[base + row].x :
        (row == basisColumn ? 1.0f : 0.0f);
}

// Return absolute pressure and its physical directional derivative. A
// deforming cavity has an independent pressure row, never lumped compliance.
inline float2 vascularNodePressure(uint nodeIndex, uint stateBase, uint coefficientBase,
    uint directionBase, bool derivative, float trialAlpha,
    device const NMVascularUnknownGPU* unknowns,
    device const NMVascularCompartmentGPU* compartments,
    device const NMVascularCavityGPU* cavities, device const uint* compartmentCavity,
    device const float4* candidate, device const float4* direction,
    device const float* elastance, uint basisColumn = NM_INVALID_INDEX,
    threadgroup const float2* preparedPressure = nullptr) {
    const bool cavity = compartments[nodeIndex].identity.w == 5u;
    const uint row = cavity ? cavities[compartmentCavity[nodeIndex]].identity.w : nodeIndex;
    const float dv = derivative || trialAlpha != 0.0f ?
        vascularDirection(direction, directionBase, row, basisColumn) * unknowns[row].initialAndScaling.y : 0.0f;
    const float value = vascularPhysical(candidate, unknowns, stateBase, row) + trialAlpha * dv;
    if (cavity) return float2(value, derivative ? dv : 0.0f);
    const float2 pressure = preparedPressure != nullptr && trialAlpha == 0.0f
        ? preparedPressure[nodeIndex]
        : vascularPressureTangent(compartments[nodeIndex], value, elastance[coefficientBase + nodeIndex]);
    return float2(pressure.x, derivative ? pressure.y * dv : 0.0f);
}
inline float vascularDrivingPressure(const NMVascularConnectionGPU edge, float pa, float pb) {
    return pa - (edge.identity.w == 3u ? max(pb, edge.physical.w) : pb);
}
inline bool vascularUnilateral(const NMVascularConnectionGPU edge) {
    return edge.identity.w >= 1u && edge.identity.w <= 3u;
}
// At Q=0 select one joint hydraulic/transport generalized Jacobian by pressure.
// The exact pressure tie uses the forward branch, without hysteresis or epsilon.
inline bool vascularDirectionalReverse(float q, float dp) {
    return q < 0.0f || (q == 0.0f && dp < 0.0f);
}
// A single explicit rounding operation is shared by breakpoint detection,
// physical-merit trial and application for the new signed flow law. Legacy
// flow laws and every other state retain their existing arithmetic.
inline float vascularDirectionalAffine(float value, float alpha, float correction) {
    return fma(alpha, correction, value);
}
inline float vascularDirectionalResistance(const NMVascularConnectionGPU edge, float q, float dp) {
    return vascularDirectionalReverse(q, dp) ? edge.directional.x : edge.physical.x;
}
inline float vascularOpenEquation(const NMVascularConnectionGPU edge, float q, float dp) {
    if (edge.identity.w == 1u) { const float qcv = q / edge.physical.z; return qcv * qcv - dp; }
    return edge.physical.x * q - dp;
}
inline float vascularOpenDiagonal(const NMVascularConnectionGPU edge, float q) {
    return edge.identity.w == 1u ? 2.0f * (q / edge.physical.z) / edge.physical.z : edge.physical.x;
}
inline bool vascularPositiveVariable(const NMVascularLayoutGPU graph, uint row,
    device const NMVascularCompartmentGPU* compartments,
    device const NMVascularConnectionGPU* connections) {
    if (row >= graph.cavities.z) return false;
    return row < graph.offsets.y ? compartments[row].identity.z == 0u :
        (row < graph.offsets.z ? vascularUnilateral(connections[row - graph.offsets.y]) : true);
}
inline bool vascularAdmissible(const NMVascularLayoutGPU graph, uint row, float value,
    device const NMVascularCompartmentGPU* compartments,
    device const NMVascularConnectionGPU* connections,
    device const NMVascularUnknownGPU* unknowns) {
    const float physical = value * unknowns[row].initialAndScaling.y;
    if (!isfinite(value) || !isfinite(physical) ||
        (vascularPositiveVariable(graph, row, compartments, connections) &&
        (row < graph.offsets.y ? !(physical > 0.0f) : physical < 0.0f))) return false;
    return row >= graph.offsets.y || compartments[row].identity.w != 3u ||
        all(isfinite(vascularPressureTangent(compartments[row], physical, 0.0f)));
}
inline ulong vascularClockRemainder(const NMVascularClockGPU clock, ulong period) {
    // Compiler admits 0 < period <= INT64_MAX; each shifted remainder fits.
    ulong remainder = 0ul;
    for (int bit = 127; bit >= 0; --bit) {
        const ulong digit = bit >= 64 ? (clock.high >> uint(bit - 64)) & 1ul :
            (clock.low >> uint(bit)) & 1ul;
        remainder = (remainder << 1u) | digit;
        if (remainder >= period) remainder -= period;
    }
    return remainder;
}
inline ulong vascularClockPhaseRemainder(const NMVascularClockGPU clock, ulong numerator, ulong multiplier) {
    // Reduce first, then multiply modulo the bounded numerator. Each add is
    // below 2*numerator <= UINT64_MAX; no 128/192-bit product can overflow.
    ulong a = vascularClockRemainder(clock, numerator), result = 0ul;
    while (multiplier != 0ul) {
        if ((multiplier & 1ul) != 0ul) { result += a; if (result >= numerator) result -= numerator; }
        multiplier >>= 1u;
        if (multiplier != 0ul) { a += a; if (a >= numerator) a -= numerator; }
    }
    return result;
}

inline uint vascularPressureRow(const NMVascularLayoutGPU graph, uint compartment,
    device const NMVascularCompartmentGPU* compartments,
    device const NMVascularCavityGPU* cavities) {
    if (compartment >= graph.counts.x) return NM_INVALID_INDEX;
    if (compartments[compartment].identity.w != 5u) return compartment;
    for (uint i = 0u; i < graph.cavities.x; ++i)
        if (cavities[i].identity.y == compartment) return cavities[i].identity.w;
    return NM_INVALID_INDEX;
}

inline float2 vascularCompartmentPressure(const NMVascularLayoutGPU graph,
    uint compartment, uint stateBase, uint coefficientBase, uint directionBase, bool derivative,
    device const NMVascularUnknownGPU* unknowns,
    device const NMVascularCompartmentGPU* compartments,
    device const NMVascularCavityGPU* cavities,
    device const float* elastance, device const float4* vascularState,
    device const float4* direction) {
    const uint row = vascularPressureRow(graph, compartment, compartments, cavities);
    if (row == NM_INVALID_INDEX) return float2(INFINITY);
    const float value = vascularPhysical(vascularState, unknowns, stateBase, row);
    if (compartments[compartment].identity.w == 5u) {
        const float tangent = derivative
            ? direction[directionBase + row].x * unknowns[row].initialAndScaling.y
            : 0.0f;
        return float2(value, tangent);
    }
    const float2 pressure = vascularPressureTangent(compartments[compartment],
        value, elastance[coefficientBase + compartment]);
    const float tangent = derivative
        ? pressure.y * direction[directionBase + row].x * unknowns[row].initialAndScaling.y
        : 0.0f;
    return float2(pressure.x, tangent);
}

// Explicit pressure-gradient wall reaction. The source contract supplies the
// two pressure compartments, a unit path direction, and cross-sectional area;
// the registered FEM region receives -A (p_from - p_to) direction. This is a
// conservative reaction path, not an implicit blood density or perfusion law.
// An explicitly flagged owner may additionally receive finite-volume fluid-momentum
// reaction from the matching inertial vascular edge; the source must opt in.
inline float3 vascularPressureReactionNodeForce(
    const NMVascularLayoutGPU graph, uint node, uint nodeBase, uint stateBase,
    device const NMVascularUnknownGPU* unknowns,
    device const NMVascularCompartmentGPU* compartments,
    device const NMVascularCavityGPU* cavities,
    device const NMVascularConnectionGPU* connections,
    device const NMVascularTissueGPU* tissues,
    device const NMVascularTissueBindingGPU* bindings,
    device const float* elastance, device const float4* vascularState,
    device const float4* acceptedVascularState,
    device const float4* direction,
    uint directionBase, float dt, bool derivative) {
    float3 result = float3(0.0f);
    for (uint tissueIndex = 0u; tissueIndex < graph.counts.w; ++tissueIndex) {
        const NMVascularTissueGPU tissue = tissues[tissueIndex];
        if (tissue.region.z == 0u || tissue.region.w == 0u) continue;
        const float2 from = vascularCompartmentPressure(graph, tissue.region.z - 1u,
            stateBase, (stateBase / graph.ranges.z) * graph.counts.x, directionBase,
            derivative, unknowns, compartments, cavities, elastance, vascularState,
            direction);
        const float2 to = vascularCompartmentPressure(graph, tissue.region.w - 1u,
            stateBase, (stateBase / graph.ranges.z) * graph.counts.x, directionBase,
            derivative, unknowns, compartments, cavities, elastance, vascularState,
            direction);
        const float3 unit = float3(tissue.spatialFirst.w,
            tissue.spatialSecond0.w, tissue.spatialSecond1.w);
        const float pressureDifference = derivative ? from.y - to.y : from.x - to.x;
        float3 reaction = -pressureDifference * tissue.physical.w * unit;
        if ((tissue.identity.w & NM_VASCULAR_TISSUE_MOMENTUM_TRANSFER) != 0u) {
            const uint fromCompartment = tissue.region.z - 1u;
            const uint toCompartment = tissue.region.w - 1u;
            uint flowEdge = NM_INVALID_INDEX;
            for (uint edge = 0u; edge < graph.counts.y; ++edge) {
                if (connections[edge].identity.y == fromCompartment &&
                    connections[edge].identity.z == toCompartment &&
                    connections[edge].physical.y > 0.0f) {
                    if (flowEdge != NM_INVALID_INDEX) return float3(INFINITY);
                    flowEdge = edge;
                }
            }
            if (flowEdge == NM_INVALID_INDEX || !(tissue.physical.w > 0.0f) ||
                !(tissue.physical.y > 0.0f) || !(tissue.physical.x > 0.0f))
                return float3(INFINITY);
            const uint flowRow = graph.offsets.y + flowEdge;
            const float safeDt = max(dt, 1.0e-12f);
            const float flowDelta = derivative
                ? direction[directionBase + flowRow].x * unknowns[flowRow].initialAndScaling.y
                : vascularPhysical(vascularState, unknowns, stateBase, flowRow) -
                  vascularPhysical(acceptedVascularState, unknowns, stateBase, flowRow);
            const float momentumFactor = tissue.physical.y * tissue.physical.x / tissue.physical.w;
            reaction += -momentumFactor * flowDelta / safeDt * unit;
        }
        if (!all(isfinite(reaction))) return float3(INFINITY);
        for (uint slot = 0u; slot < tissue.region.y; ++slot) {
            const NMVascularTissueBindingGPU binding = bindings[tissue.region.x + slot];
            if (binding.identity.y == node)
                result += binding.physical.x * reaction;
        }
    }
    return result;
}
kernel void nm_vascular_prepare_clock(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant ulong& timestepTicks [[buffer(1)]],
    device const NMVascularClockGPU* accepted [[buffer(2)]],
    device NMVascularClockGPU* candidate [[buffer(3)]],
    device NMMatterStatusGPU* statuses [[buffer(4)]],
    uint environment [[thread_position_in_grid]]) {
    if (environment >= dispatch.environmentCount) return;
    NMVascularClockGPU next = accepted[environment];
    candidate[environment] = next;
    if (!environmentHealthy(statuses, environment)) return;
    next.low += timestepTicks;
    if (next.low < accepted[environment].low) {
        next.high += 1ul;
        if (next.high == 0ul) {
            recordFailure(statuses[environment], NM_STATUS_NONLINEAR_SOLVER_FAILURE,
                NM_INVALID_INDEX, NM_INVALID_INDEX, float4(INFINITY, 0.0f, 0.0f, 0.0f));
            return;
        }
    }
    candidate[environment] = next;
}
kernel void nm_vascular_prepare_elastance(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMVascularLayoutGPU& graph [[buffer(1)]],
    device const NMVascularCompartmentGPU* compartments [[buffer(2)]],
    device const NMVascularClockGPU* clock [[buffer(3)]],
    device float* elastance [[buffer(4)]],
    device NMMatterStatusGPU* statuses [[buffer(5)]],
    uint global [[thread_position_in_grid]]) {
    if (global >= dispatch.environmentCount * graph.counts.x) return;
    const uint environment = global / graph.counts.x;
    const NMVascularCompartmentGPU node = compartments[global % graph.counts.x];
    float value = 1.0f;
    if (node.identity.w == 0u || node.identity.w == 3u) value = 1.0f / node.compliance.z;
    else if (node.identity.w != 5u) {
        const float phase = float(vascularClockPhaseRemainder(clock[environment], node.periodTicks, node.periodMultiplier)) /
            float(node.periodTicks) - node.waveform.y;
        const float start = node.elastance.z;
        const float end = node.elastance.w;
        const float pi = node.waveform.x;
        float activation = 0.0f;
        if (node.identity.w == 1u || node.identity.w == 4u) {
            if (phase < 0.0f) activation = 0.0f;
            else if (phase <= start) activation = 1.0f - cos(pi * phase / start);
            else if (phase <= end) activation = 1.0f + cos(pi * (phase - start) / (end - start));
        } else {
            // Literal source three-branch atrial activation, including the
            // tail carried across a cycle boundary; end is pulse duration.
            if (phase <= start + end - 1.0f)
                activation = 1.0f - cos(2.0f * pi * (phase - start + 1.0f) / end);
            else if (phase > start)
                activation = 1.0f - cos(2.0f * pi * (phase - start) / end);
        }
        value = node.elastance.x + 0.5f * (node.elastance.y - node.elastance.x) * activation;
    }
    elastance[global] = value;
    if (!isfinite(value) || !(value > 0.0f))
        recordFailure(statuses[environment], NM_STATUS_NONLINEAR_SOLVER_FAILURE,
            NM_INVALID_INDEX, global % graph.counts.x, float4(value, 0.0f, 0.0f, 0.0f));
}

kernel void nm_vascular_episode_reset(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMVascularLayoutGPU& graph [[buffer(1)]],
    constant NMResetPassGPU& pass [[buffer(2)]],
    device const uint* resetMasks [[buffer(3)]],
    device const NMVascularUnknownGPU* unknowns [[buffer(4)]],
    device float4* accepted [[buffer(5)]],
    device float4* candidate [[buffer(6)]],
    device float4* checkpoint [[buffer(7)]],
    device NMVascularClockGPU* acceptedClock [[buffer(8)]],
    device NMVascularClockGPU* candidateClock [[buffer(9)]],
    device NMVascularClockGPU* checkpointClock [[buffer(10)]],
    uint global [[thread_position_in_grid]]) {
    if (global >= dispatch.environmentCount * graph.ranges.z ||
        (pass.flags & NM_RESET_ENABLED) == 0u || pass.resetMaskStepStride == 0u) return;
    const uint environment = global / graph.ranges.z;
    if (resetMasks[pass.controlStep * pass.resetMaskStepStride + environment] == 0u) return;
    const uint local = global - environment * graph.ranges.z;
    const float4 initial = float4(unknowns[local].initialAndScaling.x /
        unknowns[local].initialAndScaling.y, 0.0f, 0.0f, 0.0f);
    accepted[global] = initial;
    candidate[global] = initial;
    checkpoint[global] = initial;
    if (local == 0u) { acceptedClock[environment] = {0ul, 0ul};
        candidateClock[environment] = {0ul, 0ul}; checkpointClock[environment] = {0ul, 0ul}; }
}

kernel void nm_vascular_checkpoint(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMVascularLayoutGPU& graph [[buffer(1)]],
    device const float4* accepted [[buffer(2)]],
    device float4* candidate [[buffer(3)]],
    device float4* checkpoint [[buffer(4)]],
    device NMVascularClockGPU* acceptedClock [[buffer(5)]],
    device NMVascularClockGPU* candidateClock [[buffer(6)]],
    device NMVascularClockGPU* checkpointClock [[buffer(7)]],
    uint global [[thread_position_in_grid]]) {
    if (global >= dispatch.environmentCount * graph.ranges.z) return;
    candidate[global] = accepted[global];
    checkpoint[global] = accepted[global];
    if (global % graph.ranges.z == 0u) {
        const uint environment = global / graph.ranges.z;
        candidateClock[environment] = acceptedClock[environment];
        checkpointClock[environment] = acceptedClock[environment];
    }
}
kernel void nm_vascular_prepare_candidate(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMVascularLayoutGPU& graph [[buffer(1)]],
    device const float4* accepted [[buffer(2)]],
    device float4* candidate [[buffer(3)]],
    uint global [[thread_position_in_grid]]) {
    if (global < dispatch.environmentCount * graph.ranges.z)
        candidate[global] = accepted[global];
}
kernel void nm_vascular_commit(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMVascularLayoutGPU& graph [[buffer(1)]],
    device const NMMatterStatusGPU* statuses [[buffer(2)]],
    device float4* accepted [[buffer(3)]],
    device const float4* candidate [[buffer(4)]],
    device NMVascularClockGPU* acceptedClock [[buffer(5)]],
    device const NMVascularClockGPU* candidateClock [[buffer(6)]],
    uint global [[thread_position_in_grid]]) {
    if (global < dispatch.environmentCount * graph.ranges.z &&
        environmentHealthy(statuses, global / graph.ranges.z))
    {
        accepted[global] = candidate[global];
        if (global % graph.ranges.z == 0u)
            acceptedClock[global / graph.ranges.z] = candidateClock[global / graph.ranges.z];
    }
}
kernel void nm_vascular_rollback(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMVascularLayoutGPU& graph [[buffer(1)]],
    device const NMMatterStatusGPU* statuses [[buffer(2)]],
    device float4* accepted [[buffer(3)]],
    device float4* candidate [[buffer(4)]],
    device const float4* checkpoint [[buffer(5)]],
    device NMVascularClockGPU* acceptedClock [[buffer(6)]],
    device NMVascularClockGPU* candidateClock [[buffer(7)]],
    device const NMVascularClockGPU* checkpointClock [[buffer(8)]],
    uint global [[thread_position_in_grid]]) {
    if (global < dispatch.environmentCount * graph.ranges.z &&
        !environmentHealthy(statuses, global / graph.ranges.z)) {
        accepted[global] = checkpoint[global];
        candidate[global] = checkpoint[global];
        if (global % graph.ranges.z == 0u) {
            const uint environment = global / graph.ranges.z;
            acceptedClock[environment] = checkpointClock[environment];
            candidateClock[environment] = checkpointClock[environment];
        }
    }
}

// A closed cavity has a cubic signed volume. All evaluations use one fixed
// accepted vertex as origin, avoiding translation-dependent cancellation.
inline float2 vascularCavityVolume(const NMVascularCavityGPU cavity,
    device const NMVascularCavityFaceGPU* faces,
    device const NMFEMNodeStateGPU* accepted,
    device const NMFEMNodeStateGPU* candidate,
    device const float4* direction, uint nodeBase, float dt,
    bool derivative, float trialAlpha) {
    const float3 origin = accepted[nodeBase + faces[cavity.faces.x].nodes.x].positionAndMass.xyz;
    float2 sum = float2(0.0f), compensation = float2(0.0f);
    for (uint slot = 0u; slot < cavity.faces.y; ++slot) {
        const uint3 n = faces[cavity.faces.x + slot].nodes.xyz + nodeBase;
        float3 a = candidate[n.x].positionAndMass.xyz - origin;
        float3 b = candidate[n.y].positionAndMass.xyz - origin;
        float3 c = candidate[n.z].positionAndMass.xyz - origin;
        const bool needsDirection = derivative || trialAlpha != 0.0f;
        const float3 da = needsDirection ? dt * direction[n.x].xyz : float3(0.0f);
        const float3 db = needsDirection ? dt * direction[n.y].xyz : float3(0.0f);
        const float3 dc = needsDirection ? dt * direction[n.z].xyz : float3(0.0f);
        a += trialAlpha * da; b += trialAlpha * db; c += trialAlpha * dc;
        const float v = dot(a, cross(b, c)) / 6.0f;
        const float dv = derivative ?
            (dot(da, cross(b, c)) + dot(a, cross(db, c) + cross(b, dc))) / 6.0f : 0.0f;
        const float2 y = float2(v, dv) - compensation;
        const float2 next = sum + y;
        compensation = (next - sum) - y;
        sum = next;
    }
    return sum.x > 0.0f && all(isfinite(sum)) ? sum : float2(INFINITY);
}

inline float3 vascularCavityGradient(float3 b, float3 c) { return cross(b, c) / 6.0f; }
inline float3 vascularCavityGradientDirection(float3 b, float3 c, float3 db, float3 dc) {
    return (cross(db, c) + cross(b, dc)) / 6.0f;
}
// Cyclically rotate the face so its differentiated node is first.
inline uint3 vascularCavityRotate(uint3 n, uint node) {
    return n.x == node ? n : (n.y == node ? n.yzx : n.zxy);
}
inline float3 vascularCavityNodeForce(uint node, uint nodeBase, uint stateBase,
    const NMVascularLayoutGPU graph, float dt, bool derivative,
    device const NMVascularUnknownGPU* unknowns,
    device const NMVascularCompartmentGPU* compartments,
    device const NMVascularCavityGPU* cavities,
    device const NMVascularCavityFaceGPU* faces,
    device const uint* incidence, device const NMVascularRangeGPU* ranges,
    device const NMFEMNodeStateGPU* accepted, device const NMFEMNodeStateGPU* candidate,
    device const float4* vascularState, device const float4* direction, uint directionBase) {
    float3 result = float3(0.0f);
    const NMVascularRangeGPU range = ranges[node];
    for (uint slot = 0u; slot < range.count; ++slot) {
        const NMVascularCavityFaceGPU face = faces[incidence[range.first + slot]];
        const NMVascularCavityGPU cavity = cavities[face.identity.x];
        const uint3 n = vascularCavityRotate(face.nodes.xyz, node) + nodeBase;
        const float3 origin = accepted[nodeBase + faces[cavity.faces.x].nodes.x].positionAndMass.xyz;
        const float3 b0 = accepted[n.y].positionAndMass.xyz - origin;
        const float3 c0 = accepted[n.z].positionAndMass.xyz - origin;
        const float3 b1 = candidate[n.y].positionAndMass.xyz - origin;
        const float3 c1 = candidate[n.z].positionAndMass.xyz - origin;
        const float3 bm = 0.5f * (b0 + b1), cm = 0.5f * (c0 + c1);
        const float3 g = (vascularCavityGradient(b0, c0) +
            4.0f * vascularCavityGradient(bm, cm) + vascularCavityGradient(b1, c1)) / 6.0f;
        const uint row = cavity.identity.w;
        const float p = vascularPhysical(vascularState, unknowns, stateBase, row) -
            compartments[cavity.identity.y].compliance.w;
        if (derivative) {
            const float3 db = dt * direction[n.y].xyz, dc = dt * direction[n.z].xyz;
            const float3 dg = (2.0f * vascularCavityGradientDirection(bm, cm, db, dc) +
                vascularCavityGradientDirection(b1, c1, db, dc)) / 6.0f;
            const float dp = direction[directionBase + row].x * unknowns[row].initialAndScaling.y;
            result += dp * g + p * dg;
        } else result += p * g;
    }
    return result;
}

// Initial blood mass is partitioned into the registered FEM nodes by the
// compiler. The hydraulic compartment remains the only volume authority.
// This kernel supplies the current-volume correction, including co-moving
// inertial transfer, so initial gravity/inertia is not double-counted by an
// external force. No cavity-volume or tissue-reservoir mass is implicit.
inline float3 vascularBloodMassNodeForce(
    constant NMMatterDispatchGPU& dispatch,
    const NMVascularLayoutGPU graph, uint node, uint nodeBase, uint stateBase,
    float dt,
    device const NMVascularUnknownGPU* unknowns,
    device const NMVascularTissueGPU* tissues,
    device const NMVascularTissueBindingGPU* bindings,
    device const NMFEMNodeStateGPU* accepted,
    device const NMFEMNodeStateGPU* candidate,
    device const float4* vascularState) {
    float3 result = float3(0.0f);
    const float safeDt = max(dt, 1.0e-12f);
    for (uint tissueIndex = 0u; tissueIndex < graph.counts.w; ++tissueIndex) {
        const NMVascularTissueGPU tissue = tissues[tissueIndex];
        const uint ownerCode = tissue.identity.w & ~NM_VASCULAR_TISSUE_MOMENTUM_TRANSFER;
        if (ownerCode == 0u || tissue.region.y == 0u) continue;
        const uint compartment = ownerCode - 1u;
        const float volume = vascularPhysical(vascularState, unknowns, stateBase, compartment);
        const float currentMass = tissue.physical.y * volume;
        const float deltaMass = currentMass - tissue.physical.z;
        if (!isfinite(currentMass) || currentMass <= 0.0f || !isfinite(deltaMass))
            return float3(INFINITY);
        if (abs(deltaMass) <= 1.0e-12f) continue;
        for (uint slot = 0u; slot < tissue.region.y; ++slot) {
            const NMVascularTissueBindingGPU binding = bindings[tissue.region.x + slot];
            if (binding.identity.y != node) continue;
            const uint globalNode = nodeBase + binding.identity.y;
            const float3 acceleration =
                (candidate[globalNode].velocityAndInverseMass.xyz -
                 accepted[globalNode].velocityAndInverseMass.xyz) / safeDt;
            result += (dispatch.gravityAndTimestep.xyz + acceleration) *
                deltaMass * binding.physical.x;
        }
    }
    return result;
}

kernel void nm_vascular_blood_moments(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMVascularLayoutGPU& graph [[buffer(1)]],
    device const NMFEMNodeStateGPU* nodes [[buffer(2)]],
    device const NMVascularUnknownGPU* unknowns [[buffer(3)]],
    device const NMVascularTissueGPU* tissues [[buffer(4)]],
    device const NMVascularTissueBindingGPU* bindings [[buffer(5)]],
    device const float4* vascularState [[buffer(6)]],
    device NMVascularTissueMomentGPU* output [[buffer(7)]],
    device NMMatterStatusGPU* statuses [[buffer(8)]],
    uint global [[thread_position_in_grid]]) {
    const uint tissueCount = graph.counts.w;
    if (tissueCount == 0u || global >= dispatch.environmentCount * tissueCount) return;
    const uint environment = global / tissueCount;
    const uint tissueIndex = global - environment * tissueCount;
    NMVascularTissueMomentGPU moment{};
    const NMVascularTissueGPU tissue = tissues[tissueIndex];
    const uint ownerCode = tissue.identity.w & ~NM_VASCULAR_TISSUE_MOMENTUM_TRANSFER;
    if (ownerCode != 0u && tissue.region.y != 0u) {
        const uint nodeBase = environment * dispatch.femNodeCount;
        const uint stateBase = environment * graph.ranges.z;
        const uint compartment = ownerCode - 1u;
        const float volume = vascularPhysical(vascularState, unknowns, stateBase, compartment);
        const float mass = tissue.physical.y * volume;
        if (!isfinite(mass) || !(mass > 0.0f)) {
            recordFailure(statuses[environment], NM_STATUS_NONLINEAR_SOLVER_FAILURE,
                NM_INVALID_INDEX, tissueIndex, float4(mass, volume, 0.0f, 0.0f));
            output[global] = moment;
            return;
        }
        float3 first = float3(0.0f), velocity = float3(0.0f);
        float3 second0 = float3(0.0f), second1 = float3(0.0f);
        for (uint slot = 0u; slot < tissue.region.y; ++slot) {
            const NMVascularTissueBindingGPU binding = bindings[tissue.region.x + slot];
            const float weight = binding.physical.x;
            const NMFEMNodeStateGPU node = nodes[nodeBase + binding.identity.y];
            const float3 x = node.positionAndMass.xyz;
            const float3 v = node.velocityAndInverseMass.xyz;
            first += weight * x;
            velocity += weight * v;
            second0 += weight * float3(x.x * x.x, x.x * x.y, x.x * x.z);
            second1 += weight * float3(x.y * x.y, x.y * x.z, x.z * x.z);
        }
        moment.firstMassMoment = float4(mass * first, mass);
        moment.secondMassMoment0 = float4(mass * second0, 0.0f);
        moment.secondMassMoment1 = float4(mass * second1, 0.0f);
        moment.linearMomentum = float4(mass * velocity, 0.0f);
        if (!all(isfinite(moment.firstMassMoment)) ||
            !all(isfinite(moment.secondMassMoment0)) ||
            !all(isfinite(moment.secondMassMoment1)) ||
            !all(isfinite(moment.linearMomentum))) {
            recordFailure(statuses[environment], NM_STATUS_NONLINEAR_SOLVER_FAILURE,
                NM_INVALID_INDEX, tissueIndex, moment.firstMassMoment);
            moment = NMVascularTissueMomentGPU{};
        }
    }
    output[global] = moment;
}

kernel void nm_vascular_cavity_forces(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMVascularLayoutGPU& graph [[buffer(1)]],
    constant NMMicrostepGPU& microstep [[buffer(2)]],
    device const NMVascularUnknownGPU* unknowns [[buffer(3)]],
    device const NMVascularCompartmentGPU* compartments [[buffer(4)]],
    device const NMVascularCavityGPU* cavities [[buffer(5)]],
    device const NMVascularCavityFaceGPU* faces [[buffer(6)]],
    device const uint* incidence [[buffer(7)]],
    device const NMVascularRangeGPU* ranges [[buffer(8)]],
    device const NMFEMNodeStateGPU* accepted [[buffer(9)]],
    device const NMFEMNodeStateGPU* candidate [[buffer(10)]],
    device const float4* vascularState [[buffer(11)]],
    device const float4* borrowed [[buffer(12)]],
    constant uint& hasBorrowed [[buffer(13)]],
    device float4* merged [[buffer(14)]],
    device NMMatterStatusGPU* statuses [[buffer(15)]],
    device const NMVascularTissueGPU* tissues [[buffer(16)]],
    device const NMVascularTissueBindingGPU* tissueBindings [[buffer(17)]],
    device const float* elastance [[buffer(18)]],
    device const NMVascularConnectionGPU* connections [[buffer(19)]],
    device const float4* acceptedVascularState [[buffer(20)]],
    uint global [[thread_position_in_grid]]) {
    if (global >= dispatch.environmentCount * dispatch.femNodeCount) return;
    const uint environment = global / dispatch.femNodeCount;
    const uint nodeBase = environment * dispatch.femNodeCount;
    float3 force = hasBorrowed != 0u ? borrowed[global].xyz : float3(0.0f);
    if (environmentHealthy(statuses, environment))
        force += vascularCavityNodeForce(global - nodeBase, nodeBase, environment * graph.ranges.z,
            graph, microstep.time.x, false, unknowns, compartments, cavities, faces, incidence, ranges,
            accepted, candidate, vascularState, vascularState, 0u);
    if (environmentHealthy(statuses, environment))
        force += vascularBloodMassNodeForce(dispatch, graph, global - nodeBase, nodeBase,
            environment * graph.ranges.z, microstep.time.x, unknowns, tissues, tissueBindings,
            accepted, candidate, vascularState);
    if (environmentHealthy(statuses, environment))
        force += vascularPressureReactionNodeForce(graph, global - nodeBase, nodeBase,
            environment * graph.ranges.z, unknowns, compartments, cavities, connections, tissues,
            tissueBindings, elastance, vascularState, acceptedVascularState, vascularState, 0u,
            microstep.time.x, false);
    merged[global] = float4(force, 0.0f);
    if (!all(isfinite(force))) recordFailure(statuses[environment], NM_STATUS_NONLINEAR_SOLVER_FAILURE,
        NM_INVALID_INDEX, global - nodeBase, float4(force, 0.0f));
}
kernel void nm_vascular_cavity_operator(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMVascularLayoutGPU& graph [[buffer(1)]],
    constant NMMicrostepGPU& microstep [[buffer(2)]],
    device const NMVascularUnknownGPU* unknowns [[buffer(3)]],
    device const NMVascularCompartmentGPU* compartments [[buffer(4)]],
    device const NMVascularCavityGPU* cavities [[buffer(5)]],
    device const NMVascularCavityFaceGPU* faces [[buffer(6)]],
    device const uint* incidence [[buffer(7)]],
    device const NMVascularRangeGPU* ranges [[buffer(8)]],
    device const NMFEMNodeStateGPU* accepted [[buffer(9)]],
    device const NMFEMNodeStateGPU* candidate [[buffer(10)]],
    device const float4* vascularState [[buffer(11)]],
    device const float4* direction [[buffer(12)]],
    device float4* output [[buffer(13)]],
    device const NMFGMRESStateGPU* states [[buffer(14)]],
    device NMMatterStatusGPU* statuses [[buffer(15)]],
    device const NMVascularTissueGPU* tissues [[buffer(16)]],
    device const NMVascularTissueBindingGPU* tissueBindings [[buffer(17)]],
    device const float* elastance [[buffer(18)]],
    device const NMVascularConnectionGPU* connections [[buffer(19)]],
    device const float4* acceptedVascularState [[buffer(20)]],
    constant NMFGMRESLayoutGPU& layout [[buffer(30)]],
    uint global [[thread_position_in_grid]]) {
    if (global >= dispatch.environmentCount * dispatch.femNodeCount) return;
    const uint environment = global / dispatch.femNodeCount;
    if (!environmentHealthy(statuses, environment) || states[environment].diagnostics.z > 0.5f) return;
    const NMFEMNodeStateGPU node = candidate[global];
    if ((node.restAndFixed.w > 0.5f && node.restAndFixed.w < 1.5f) || !(node.positionAndMass.w > 0.0f)) return;
    const uint nodeBase = environment * dispatch.femNodeCount, stateBase = environment * graph.ranges.z;
    float3 tangent = float3(0.0f);
    if (graph.cavities.x != 0u)
        tangent = -microstep.time.x * vascularCavityNodeForce(global - nodeBase,
            nodeBase, stateBase, graph, microstep.time.x, true, unknowns, compartments, cavities,
            faces, incidence, ranges, accepted, candidate, vascularState, direction, layout.vascularBase + stateBase);
    const float3 pressureTangent = -microstep.time.x *
        vascularPressureReactionNodeForce(graph, global - nodeBase, nodeBase, stateBase,
            unknowns, compartments, cavities, connections, tissues, tissueBindings, elastance,
            vascularState, acceptedVascularState, direction, layout.vascularBase + stateBase,
            microstep.time.x, true);
    output[global].xyz += tangent + pressureTangent;
    if (!all(isfinite(tangent)) || !all(isfinite(pressureTangent))) recordFailure(statuses[environment], NM_STATUS_NONLINEAR_SOLVER_FAILURE,
        NM_INVALID_INDEX, global - nodeBase, float4(tangent + pressureTangent, 0.0f));
}

// Primal valve working set, private to one microtick. 0 is free, 1 is a
// newly constrained affine row, 2 has completed a constrained free-variable
// solve. A pending zero-flow row must get that solve before pressure release.
kernel void nm_vascular_begin_working_set(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMVascularLayoutGPU& graph [[buffer(1)]],
    constant NMMicrostepGPU& microstep [[buffer(2)]],
    device const NMVascularUnknownGPU* unknowns [[buffer(3)]],
    device const NMVascularCompartmentGPU* compartments [[buffer(4)]],
    device const NMVascularConnectionGPU* connections [[buffer(5)]],
    device const float4* candidate [[buffer(6)]],
    device const float* elastance [[buffer(7)]],
    device uint* workingSet [[buffer(8)]],
    device const NMVascularCavityGPU* cavities [[buffer(9)]],
    device const uint* compartmentCavity [[buffer(10)]],
    uint global [[thread_position_in_grid]]) {
    if (global >= dispatch.environmentCount * graph.ranges.z) return;
    const uint environment = global / graph.ranges.z;
    const uint local = global - environment * graph.ranges.z;
    if (microstep.solverIteration == 0u) workingSet[global] = 0u;
    if (local < graph.offsets.y || local >= graph.offsets.z) return;
    const NMVascularConnectionGPU edge = connections[local - graph.offsets.y];
    if (!vascularUnilateral(edge)) return;
    const uint base = environment * graph.ranges.z;
    const uint eb = environment * graph.counts.x;
    const float q = vascularPhysical(candidate, unknowns, base, local);
    const float dp = vascularDrivingPressure(edge,
        vascularNodePressure(edge.identity.y, base, eb, 0u, false, 0.0f, unknowns, compartments, cavities, compartmentCavity, candidate, candidate, elastance).x,
        vascularNodePressure(edge.identity.z, base, eb, 0u, false, 0.0f, unknowns, compartments, cavities, compartmentCavity, candidate, candidate, elastance).x);
    if (workingSet[global] == 2u && q == 0.0f && dp > 0.0f) workingSet[global] = 0u;
    const float closed = q * unknowns[local].initialAndScaling.z / unknowns[local].initialAndScaling.y;
    if (workingSet[global] == 0u && closed <= vascularOpenEquation(edge, q, dp)) workingSet[global] = 1u;
}

// Shift to the affine Q=0 manifold before a constrained solve; all other
// physical variables stay at the current candidate. This is exactly the
// particular correction deltaQ=-Q, including its incident transport fluxes.
inline bool vascularConstrained(const NMVascularLayoutGPU graph, uint stateBase,
    uint edge, device const uint* workingSet, bool useWorkingSet) {
    return useWorkingSet && workingSet[stateBase + graph.offsets.y + edge] != 0u;
}

// Shared residual/Jacobian evaluator. A directional value of a normalized
// state is converted to physical units before differentiating any flux. The
// exact same signed edge/exchange contribution enters both adjacent rows.
inline float2 vascularEquation(
    const NMVascularLayoutGPU graph, float dt, uint local, uint stateBase,
    uint directionBase, bool derivative,
    device const NMVascularUnknownGPU* unknowns,
    device const NMVascularCompartmentGPU* compartments,
    device const NMVascularConnectionGPU* connections,
    device const NMVascularTissueGPU* tissues,
    device const NMVascularExchangeGPU* exchanges,
    device const uint* connectionIncidence,
    device const NMVascularRangeGPU* connectionRanges,
    device const uint* bloodExchangeIncidence,
    device const NMVascularRangeGPU* bloodExchangeRanges,
    device const uint* tissueExchangeIncidence,
    device const NMVascularRangeGPU* tissueExchangeRanges,
    device const float4* accepted, device const float4* candidate,
    device const float4* direction, device const float* elastance,
    device const uint* workingSet, bool useWorkingSet,
    device const NMVascularCavityGPU* cavities, device const NMVascularCavityFaceGPU* cavityFaces,
    device const uint* compartmentCavity, device const NMFEMNodeStateGPU* femCandidate,
    device const NMFEMNodeStateGPU* femAccepted, uint nodeBase, float femTrialAlpha,
    uint basisColumn = NM_INVALID_INDEX,
    threadgroup const float2* preparedPressure = nullptr) {
    const float scale = unknowns[local].initialAndScaling.y;
    const float value = vascularPhysical(candidate, unknowns, stateBase, local);
    const float delta = derivative ? vascularDirection(direction, directionBase, local, basisColumn) * scale : 0.0f;
    float equation = scale * (candidate[stateBase + local].x - accepted[stateBase + local].x);
    float tangent = delta;
    if (local < graph.offsets.y) {
        const NMVascularRangeGPU range = connectionRanges[local];
        for (uint slot = 0u; slot < range.count; ++slot) {
            const uint edge = connectionIncidence[range.first + slot];
            const float sign = connections[edge].identity.y == local ? 1.0f : -1.0f;
            const uint flowRow = graph.offsets.y + edge;
            if (vascularConstrained(graph, stateBase, edge, workingSet, useWorkingSet)) continue;
            equation += dt * sign * vascularPhysical(candidate, unknowns, stateBase, flowRow);
            if (derivative) tangent += dt * sign * vascularDirection(direction, directionBase, flowRow, basisColumn) *
                unknowns[flowRow].initialAndScaling.y;
        }
    } else if (local < graph.offsets.z) {
        if (vascularConstrained(graph, stateBase, local - graph.offsets.y, workingSet, useWorkingSet))
            return float2(0.0f);
        const NMVascularConnectionGPU edge = connections[local - graph.offsets.y];
        const uint a = edge.identity.y;
        const uint b = edge.identity.z;
        const uint coefficientBase = (stateBase / graph.ranges.z) * graph.counts.x;
        const float2 pa = vascularNodePressure(a, stateBase, coefficientBase, directionBase, derivative, 0.0f,
            unknowns, compartments, cavities, compartmentCavity, candidate, direction, elastance, basisColumn, preparedPressure);
        const float2 pb = vascularNodePressure(b, stateBase, coefficientBase, directionBase, derivative, 0.0f,
            unknowns, compartments, cavities, compartmentCavity, candidate, direction, elastance, basisColumn, preparedPressure);
        const float dp = vascularDrivingPressure(edge, pa.x, pb.x);
        // At the Starling floor tie use the fixed downstream-pressure branch.
        const float downstreamDerivative = edge.identity.w == 3u && pb.x <= edge.physical.w ? 0.0f : pb.y;
        const float dPressure = derivative ? pa.y - downstreamDerivative : 0.0f;
        if (edge.identity.w == 4u) {
            const float resistance = vascularDirectionalResistance(edge, value, dp);
            equation = resistance * value - dp;
            tangent = resistance * delta - dPressure;
        } else if (vascularUnilateral(edge)) {
            const float flowPressure = unknowns[local].initialAndScaling.z / scale;
            const float closed = value * flowPressure;
            const float open = vascularOpenEquation(edge, value, dp);
            const bool closedBranch = closed <= open;
            equation = closedBranch ? closed : open;
            tangent = closedBranch ? flowPressure * delta : vascularOpenDiagonal(edge, value) * delta - dPressure;
        } else {
            equation = edge.physical.y * scale *
                (candidate[stateBase + local].x - accepted[stateBase + local].x) / dt +
                edge.physical.x * value - dp;
            tangent = (edge.physical.y / dt + edge.physical.x) * delta - dPressure;
        }
    } else if (local < graph.cavities.z) {
        const bool blood = local < graph.offsets.w;
        const uint amount = local - (blood ? graph.offsets.z : graph.offsets.w);
        const uint reservoir = amount / graph.counts.z;
        const uint species = amount - reservoir * graph.counts.z;
        if (blood) {
            const NMVascularRangeGPU range = connectionRanges[reservoir];
            for (uint slot = 0u; slot < range.count; ++slot) {
                const uint edgeIndex = connectionIncidence[range.first + slot];
                if (vascularConstrained(graph, stateBase, edgeIndex, workingSet, useWorkingSet)) continue;
                const NMVascularConnectionGPU edge = connections[edgeIndex];
                const uint flowRow = graph.offsets.y + edgeIndex;
                const float flow = vascularPhysical(candidate, unknowns, stateBase, flowRow);
                bool reverse = flow < 0.0f;
                if (edge.identity.w == 4u && flow == 0.0f) {
                    const uint coefficientBase = (stateBase / graph.ranges.z) * graph.counts.x;
                    const float pa = vascularNodePressure(edge.identity.y, stateBase, coefficientBase,
                        directionBase, false, 0.0f, unknowns, compartments, cavities, compartmentCavity,
                        candidate, direction, elastance).x;
                    const float pb = vascularNodePressure(edge.identity.z, stateBase, coefficientBase,
                        directionBase, false, 0.0f, unknowns, compartments, cavities, compartmentCavity,
                        candidate, direction, elastance).x;
                    reverse = vascularDirectionalReverse(flow, pa - pb);
                }
                const uint donor = reverse ? edge.identity.z : edge.identity.y;
                const uint donorRow = graph.offsets.z + donor * graph.counts.z + species;
                const float volume = vascularPhysical(candidate, unknowns, stateBase, donor);
                const float mass = vascularPhysical(candidate, unknowns, stateBase, donorRow);
                const float concentration = vascularConcentration(mass, volume);
                const float sign = edge.identity.y == reservoir ? 1.0f : -1.0f;
                equation += dt * sign * flow * concentration;
                if (derivative) {
                    const float dq = vascularDirection(direction, directionBase, flowRow, basisColumn) * unknowns[flowRow].initialAndScaling.y;
                    const float dm = vascularDirection(direction, directionBase, donorRow, basisColumn) * unknowns[donorRow].initialAndScaling.y;
                    const float dv = vascularDirection(direction, directionBase, donor, basisColumn) * unknowns[donor].initialAndScaling.y;
                    tangent += dt * sign * (dq * concentration + flow * (dm - concentration * dv) / volume);
                }
            }
        }
        const NMVascularRangeGPU range = blood ? bloodExchangeRanges[amount] : tissueExchangeRanges[amount];
        for (uint slot = 0u; slot < range.count; ++slot) {
            const uint exchangeIndex = blood ? bloodExchangeIncidence[range.first + slot] :
                tissueExchangeIncidence[range.first + slot];
            const NMVascularExchangeGPU exchange = exchanges[exchangeIndex];
            const uint node = exchange.identity.y;
            const uint tissue = exchange.identity.z;
            const uint bloodRow = graph.offsets.z + node * graph.counts.z + species;
            const uint tissueRow = graph.offsets.w + tissue * graph.counts.z + species;
            const float bloodVolume = vascularPhysical(candidate, unknowns, stateBase, node);
            const float bloodMass = vascularPhysical(candidate, unknowns, stateBase, bloodRow);
            const float tissueMass = vascularPhysical(candidate, unknowns, stateBase, tissueRow);
            const float bloodConcentration = vascularConcentration(bloodMass, bloodVolume);
            const float partitionVolume = tissues[tissue].physical.x * exchange.physical.y;
            const float sign = blood ? 1.0f : -1.0f;
            const float tissueConcentration = vascularConcentration(tissueMass, partitionVolume);
            equation += dt * sign * exchange.physical.x * (bloodConcentration - tissueConcentration);
            if (derivative) {
                const float dm = vascularDirection(direction, directionBase, bloodRow, basisColumn) * unknowns[bloodRow].initialAndScaling.y;
                const float dv = vascularDirection(direction, directionBase, node, basisColumn) * unknowns[node].initialAndScaling.y;
                const float mt = vascularDirection(direction, directionBase, tissueRow, basisColumn) * unknowns[tissueRow].initialAndScaling.y;
                tangent += dt * sign * exchange.physical.x *
                    ((dm - bloodConcentration * dv) / bloodVolume - mt / partitionVolume);
            }
        }
    }
    if (local >= graph.cavities.z) {
        const NMVascularCavityGPU cavity = cavities[local - graph.cavities.z];
        const uint volumeRow = cavity.identity.y;
        const float2 geometry = vascularCavityVolume(cavity, cavityFaces, femAccepted, femCandidate,
            direction, nodeBase, dt, derivative, femTrialAlpha);
        equation = vascularPhysical(candidate, unknowns, stateBase, volumeRow) - geometry.x;
        tangent = derivative ? vascularDirection(direction, directionBase, volumeRow, basisColumn) *
            unknowns[volumeRow].initialAndScaling.y - geometry.y : 0.0f;
    }
    return float2(equation, tangent) / unknowns[local].initialAndScaling.z;
}

// Identical bindings for residual and Jacobian-vector kernels make their
// constitutive state and timestep impossible to pair with different arenas.
#define NM_VASCULAR_EQUATION_ARGUMENTS \
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]], \
    constant NMVascularLayoutGPU& graph [[buffer(1)]], \
    constant NMMicrostepGPU& microstep [[buffer(2)]], \
    device const NMVascularUnknownGPU* unknowns [[buffer(3)]], \
    device const NMVascularCompartmentGPU* compartments [[buffer(4)]], \
    device const NMVascularConnectionGPU* connections [[buffer(5)]], \
    device const NMVascularTissueGPU* tissues [[buffer(6)]], \
    device const NMVascularExchangeGPU* exchanges [[buffer(7)]], \
    device const uint* connectionIncidence [[buffer(8)]], \
    device const NMVascularRangeGPU* connectionRanges [[buffer(9)]], \
    device const uint* bloodExchangeIncidence [[buffer(10)]], \
    device const NMVascularRangeGPU* bloodExchangeRanges [[buffer(11)]], \
    device const uint* tissueExchangeIncidence [[buffer(12)]], \
    device const NMVascularRangeGPU* tissueExchangeRanges [[buffer(13)]], \
    device const float4* accepted [[buffer(14)]], \
    device const float4* candidate [[buffer(15)]], \
    device const float4* direction [[buffer(16)]], \
    device float4* output [[buffer(17)]], \
    device const NMFGMRESStateGPU* states [[buffer(18)]], \
    device NMMatterStatusGPU* statuses [[buffer(19)]], \
    device const float* elastance [[buffer(20)]], \
    device const uint* workingSet [[buffer(21)]], \
    constant uint& useWorkingSet [[buffer(22)]], \
    device const NMVascularCavityGPU* cavities [[buffer(23)]], \
    device const NMVascularCavityFaceGPU* cavityFaces [[buffer(24)]], \
    device const uint* compartmentCavity [[buffer(25)]], \
    device const NMFEMNodeStateGPU* femCandidate [[buffer(26)]], \
    device const NMFEMNodeStateGPU* femAccepted [[buffer(27)]], \
    constant NMFGMRESLayoutGPU& layout [[buffer(30)]], \
    uint global [[thread_position_in_grid]]
#define NM_VASCULAR_EVALUATE(derivative) vascularEquation(graph, microstep.time.x, local, \
    environment * graph.ranges.z, layout.vascularBase + environment * graph.ranges.z, \
    derivative, unknowns, compartments, connections, tissues, exchanges, \
    connectionIncidence, connectionRanges, bloodExchangeIncidence, bloodExchangeRanges, \
    tissueExchangeIncidence, tissueExchangeRanges, accepted, candidate, direction, elastance, workingSet, useWorkingSet != 0u, \
    cavities, cavityFaces, compartmentCavity, femCandidate, femAccepted, environment * dispatch.femNodeCount, 0.0f)

kernel void nm_vascular_residual(NM_VASCULAR_EQUATION_ARGUMENTS) {
    if (global >= dispatch.environmentCount * graph.ranges.z) return;
    const uint environment = global / graph.ranges.z;
    const uint local = global - environment * graph.ranges.z;
    output[layout.vascularBase + global] = float4(0.0f);
    if (!environmentHealthy(statuses, environment)) return;
    if (!vascularAdmissible(graph, local, candidate[global].x, compartments, connections, unknowns) ||
        any(candidate[global].yzw != float3(0.0f))) {
        recordFailure(statuses[environment], NM_STATUS_NONLINEAR_SOLVER_FAILURE,
            NM_INVALID_INDEX, local, float4(candidate[global].x, 0.0f, 0.0f, 0.0f));
        return;
    }
    const float value = NM_VASCULAR_EVALUATE(false).x;
    if (!isfinite(value)) {
        recordFailure(statuses[environment], NM_STATUS_NONLINEAR_SOLVER_FAILURE,
            NM_INVALID_INDEX, local, float4(value, 0.0f, 0.0f, 0.0f));
        return;
    }
    output[layout.vascularBase + global] = float4(-value, 0.0f, 0.0f, 0.0f);
}

// Opt-in direct solve for the exact 21-compartment/24-edge vascular-only
// network. It assembles each Jacobian column through vascularEquation(), so
// the source pressure, valve, and flow laws stay owned by the normal evaluator.
// The host selects this kernel only for a validated 45-unknown graph with no
// inertance, transport species, tissue, cavity, or mechanical unknowns.
kernel void nm_vascular_dense_solve(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMVascularLayoutGPU& graph [[buffer(1)]],
    constant NMMicrostepGPU& microstep [[buffer(2)]],
    device const NMVascularUnknownGPU* unknowns [[buffer(3)]],
    device const NMVascularCompartmentGPU* compartments [[buffer(4)]],
    device const NMVascularConnectionGPU* connections [[buffer(5)]],
    device const NMVascularTissueGPU* tissues [[buffer(6)]],
    device const NMVascularExchangeGPU* exchanges [[buffer(7)]],
    device const uint* connectionIncidence [[buffer(8)]],
    device const NMVascularRangeGPU* connectionRanges [[buffer(9)]],
    device const uint* bloodExchangeIncidence [[buffer(10)]],
    device const NMVascularRangeGPU* bloodExchangeRanges [[buffer(11)]],
    device const uint* tissueExchangeIncidence [[buffer(12)]],
    device const NMVascularRangeGPU* tissueExchangeRanges [[buffer(13)]],
    device const float4* accepted [[buffer(14)]],
    device const float4* candidate [[buffer(15)]],
    device float4* direction [[buffer(16)]],
    device float4* output [[buffer(17)]],
    device NMFGMRESStateGPU* states [[buffer(18)]],
    device NMMatterStatusGPU* statuses [[buffer(19)]],
    device const float* elastance [[buffer(20)]],
    device const uint* workingSet [[buffer(21)]],
    constant uint& useWorkingSet [[buffer(22)]],
    device const NMVascularCavityGPU* cavities [[buffer(23)]],
    device const NMVascularCavityFaceGPU* cavityFaces [[buffer(24)]],
    device const uint* compartmentCavity [[buffer(25)]],
    device const NMFEMNodeStateGPU* femCandidate [[buffer(26)]],
    device const NMFEMNodeStateGPU* femAccepted [[buffer(27)]],
    device const float4* residual [[buffer(28)]],
    constant NMFGMRESLayoutGPU& layout [[buffer(30)]],
    uint lane [[thread_index_in_threadgroup]],
    uint environment [[threadgroup_position_in_grid]]) {
    constexpr uint unknownCount = 45u;
    constexpr uint augmentedWidth = unknownCount + 1u;
    threadgroup float matrix[unknownCount * augmentedWidth];
    threadgroup float2 preparedPressure[21u];
    threadgroup uint pivotRow;
    threadgroup atomic_uint failed;

    if (environment >= dispatch.environmentCount || lane >= 32u) return;
    const uint base = environment * graph.ranges.z;
    const uint directionBase = layout.vascularBase + base;
    if (graph.counts.x != 21u || graph.counts.y != 24u ||
        graph.counts.z != 0u || graph.counts.w != 0u ||
        graph.ranges.z != unknownCount || layout.vascularUnknownCount != unknownCount ||
        layout.vascularBase != 0u) {
        if (lane == 0u) recordFailure(statuses[environment],
            NM_STATUS_LINEAR_SOLVER_FAILURE, NM_INVALID_INDEX,
            graph.ranges.z, float4(float(graph.ranges.z), 0.0f, 0.0f, 0.0f));
        for (uint local = lane; local < unknownCount; local += 32u)
            output[directionBase + local] = float4(0.0f);
        return;
    }
    if (!environmentHealthy(statuses, environment)) {
        for (uint local = lane; local < unknownCount; local += 32u)
            output[directionBase + local] = float4(0.0f);
        return;
    }

    // The begin kernel owns nonlinear convergence/history. A converged or
    // rejected candidate must not leave a stale correction in the shared
    // Newton arena.
    if (states[environment].diagnostics.z > 0.5f) {
        for (uint local = lane; local < unknownCount; local += 32u)
            output[directionBase + local] = float4(0.0f);
        return;
    }

    if (lane == 0u)
        atomic_store_explicit(&failed, 0u, memory_order_relaxed);
    // Candidate volumes and elastance are invariant throughout this one
    // Jacobian assembly. Reuse the same constitutive evaluation for all 45
    // basis columns; this is transient threadgroup scratch, not new state.
    if (lane < graph.counts.x) {
        const float value = vascularPhysical(candidate, unknowns, base, lane) + 0.0f;
        preparedPressure[lane] = vascularPressureTangent(compartments[lane],
            value, elastance[environment * graph.counts.x + lane]);
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    // This specialization contains only vascular equations. The publication
    // certificate is each authored, scaled equation tolerance, not a mechanical
    // residual norm. After two completed Newton corrections, stop only when the
    // original physical equations (without working-set row substitution) and
    // admissibility checks already satisfy that unchanged certificate. This
    // avoids repeating floating-point-limit corrections in the fixed GPU tail.
    // Final nm_vascular_certify still independently validates publication.
    if (microstep.solverIteration >= 2u &&
        isfinite(states[environment].nonlinear.z)) {
        bool certified = true;
        for (uint row = lane; row < unknownCount; row += 32u) {
            const float value = vascularEquation(
                graph, microstep.time.x, row, base, directionBase, false,
                unknowns, compartments, connections, tissues, exchanges,
                connectionIncidence, connectionRanges, bloodExchangeIncidence,
                bloodExchangeRanges, tissueExchangeIncidence,
                tissueExchangeRanges, accepted, candidate, direction, elastance,
                workingSet, false, cavities, cavityFaces, compartmentCavity,
                femCandidate, femAccepted, environment * dispatch.femNodeCount,
                0.0f, NM_INVALID_INDEX, preparedPressure).x;
            const float4 state = candidate[base + row];
            certified = certified && isfinite(value) &&
                abs(value) <= unknowns[row].initialAndScaling.w &&
                all(state.yzw == float3(0.0f)) &&
                vascularAdmissible(graph, row, state.x, compartments,
                    connections, unknowns) &&
                workingSet[base + row] != 1u &&
                (workingSet[base + row] == 0u || state.x == 0.0f);
        }
        if (simd_all(certified)) {
            for (uint row = lane; row < unknownCount; row += 32u)
                output[directionBase + row] = float4(0.0f);
            if (lane == 0u) {
                states[environment].diagnostics.z = 1.0f;
                states[environment].diagnostics.w = 0.0f;
            }
            return;
        }
    }
    // Initialize structural zeros, then ask the ordinary JVP for every
    // potentially nonzero entry. In this validated vascular-only graph a
    // continuity row depends on its volume and incident edge flows; an edge
    // row depends on its flow and its two endpoint volumes. Constitutive,
    // valve, working-set and normalization arithmetic remains in the JVP.
    for (uint entry = lane; entry < unknownCount * unknownCount; entry += 32u) {
        const uint row = entry / unknownCount;
        const uint column = entry - row * unknownCount;
        matrix[row * augmentedWidth + column] = 0.0f;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    for (uint row = lane; row < unknownCount; row += 32u) {
        const bool constrainedFlow = row >= graph.offsets.y &&
            row < graph.offsets.z && useWorkingSet != 0u &&
            workingSet[base + row] != 0u;
        if (constrainedFlow) continue;
        const bool volumeRow = row < graph.offsets.y;
        const NMVascularRangeGPU incidence = volumeRow ?
            connectionRanges[row] : NMVascularRangeGPU{0u, 0u};
        const uint columns = volumeRow ? 1u + incidence.count : 3u;
        for (uint slot = 0u; slot < columns; ++slot) {
            const uint column = slot == 0u ? row : (volumeRow ?
                graph.offsets.y + connectionIncidence[incidence.first + slot - 1u] :
                (slot == 1u ? connections[row - graph.offsets.y].identity.y :
                    connections[row - graph.offsets.y].identity.z));
            const float tangent = vascularEquation(
            graph, microstep.time.x, row, base, directionBase, true,
            unknowns, compartments, connections, tissues, exchanges,
            connectionIncidence, connectionRanges, bloodExchangeIncidence,
            bloodExchangeRanges, tissueExchangeIncidence,
            tissueExchangeRanges, accepted, candidate, direction, elastance,
            workingSet, useWorkingSet != 0u, cavities, cavityFaces,
            compartmentCavity, femCandidate, femAccepted,
            environment * dispatch.femNodeCount, 0.0f, column, preparedPressure).y;
            if (!isfinite(tangent)) {
                recordFailure(statuses[environment],
                    NM_STATUS_LINEAR_SOLVER_FAILURE, NM_INVALID_INDEX,
                    row, float4(tangent, float(column), 0.0f, 0.0f));
                atomic_store_explicit(&failed, 1u,
                    memory_order_relaxed);
            }
            matrix[row * augmentedWidth + column] = tangent;
        }
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    for (uint row = lane; row < unknownCount; row += 32u) {
        const bool constrainedFlow = row >= graph.offsets.y &&
            row < graph.offsets.z && useWorkingSet != 0u &&
            workingSet[base + row] != 0u;
        if (constrainedFlow) {
            for (uint column = 0u; column < unknownCount; ++column)
                matrix[row * augmentedWidth + column] = row == column ? 1.0f : 0.0f;
            matrix[row * augmentedWidth + unknownCount] = 0.0f;
        } else {
            matrix[row * augmentedWidth + unknownCount] =
                residual[directionBase + row].x;
        }
    }
    threadgroup_barrier(mem_flags::mem_threadgroup | mem_flags::mem_device);

    if (atomic_load_explicit(&failed, memory_order_relaxed) != 0u) {
        for (uint local = lane; local < unknownCount; local += 32u)
            output[directionBase + local] = float4(0.0f);
        return;
    }

    // Parallel partial-pivot LU of the assembled normalized Jacobian.
    // A singular/nonfinite pivot rejects through the ordinary Matter status;
    // no regularized shadow system is substituted.
    for (uint pivot = 0u; pivot < unknownCount; ++pivot) {
        if (lane == 0u) {
            float maximum = 0.0f;
            pivotRow = pivot;
            for (uint row = pivot; row < unknownCount; ++row) {
                const float value = abs(matrix[row * augmentedWidth + pivot]);
                if (!isfinite(value)) {
                    maximum = NAN;
                    break;
                }
                if (value > maximum) {
                    maximum = value;
                    pivotRow = row;
                }
            }
            const float diagonal = matrix[pivotRow * augmentedWidth + pivot];
            if (!isfinite(maximum) || !(maximum > 1.0e-30f) ||
                !isfinite(diagonal)) {
                atomic_store_explicit(&failed, 1u, memory_order_relaxed);
                recordFailure(statuses[environment],
                    NM_STATUS_LINEAR_SOLVER_FAILURE, NM_INVALID_INDEX,
                    pivot, float4(maximum, diagonal, 0.0f, 0.0f));
            }
        }
        threadgroup_barrier(mem_flags::mem_threadgroup | mem_flags::mem_device);
        if (atomic_load_explicit(&failed, memory_order_relaxed) != 0u) break;
        if (pivotRow != pivot) {
            for (uint column = lane; column <= unknownCount; column += 32u) {
                const uint a = pivot * augmentedWidth + column;
                const uint b = pivotRow * augmentedWidth + column;
                const float value = matrix[a];
                matrix[a] = matrix[b];
                matrix[b] = value;
            }
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        const float diagonal = matrix[pivot * augmentedWidth + pivot];
        for (uint row = pivot + 1u + lane; row < unknownCount; row += 32u) {
            const uint rowBase = row * augmentedWidth;
            const float factor = matrix[rowBase + pivot] / diagonal;
            matrix[rowBase + pivot] = 0.0f;
            for (uint column = pivot + 1u; column <= unknownCount; ++column)
                matrix[rowBase + column] = fma(-factor,
                    matrix[pivot * augmentedWidth + column],
                    matrix[rowBase + column]);
        }
        threadgroup_barrier(mem_flags::mem_threadgroup | mem_flags::mem_device);
    }

    if (atomic_load_explicit(&failed, memory_order_relaxed) != 0u) {
        for (uint local = lane; local < unknownCount; local += 32u)
            output[directionBase + local] = float4(0.0f);
        return;
    }

    if (lane == 0u) {
        // Forward substitution through unit-lower L, then backward through U.
        for (uint row = 0u; row < unknownCount; ++row) {
            float value = matrix[row * augmentedWidth + unknownCount];
            for (uint column = 0u; column < row; ++column)
                value -= matrix[row * augmentedWidth + column] *
                    matrix[column * augmentedWidth + unknownCount];
            matrix[row * augmentedWidth + unknownCount] = value;
        }
        for (int row = int(unknownCount) - 1; row >= 0; --row) {
            float value = matrix[uint(row) * augmentedWidth + unknownCount];
            for (uint column = uint(row) + 1u; column < unknownCount; ++column)
                value -= matrix[uint(row) * augmentedWidth + column] *
                    matrix[column * augmentedWidth + unknownCount];
            matrix[uint(row) * augmentedWidth + unknownCount] = value /
                matrix[uint(row) * augmentedWidth + uint(row)];
            if (!isfinite(matrix[uint(row) * augmentedWidth + unknownCount])) {
                atomic_store_explicit(&failed, 1u, memory_order_relaxed);
                recordFailure(statuses[environment],
                    NM_STATUS_LINEAR_SOLVER_FAILURE, NM_INVALID_INDEX,
                    uint(row), float4(matrix[uint(row) * augmentedWidth + unknownCount],
                        0.0f, 0.0f, 0.0f));
                break;
            }
        }
    }
    threadgroup_barrier(mem_flags::mem_threadgroup | mem_flags::mem_device);
    if (atomic_load_explicit(&failed, memory_order_relaxed) != 0u) {
        for (uint local = lane; local < unknownCount; local += 32u)
            output[directionBase + local] = float4(0.0f);
        return;
    }
    for (uint local = lane; local < unknownCount; local += 32u)
        output[directionBase + local] = float4(
            matrix[local * augmentedWidth + unknownCount], 0.0f, 0.0f, 0.0f);
    threadgroup_barrier(mem_flags::mem_device);

    float residualNorm2 = 0.0f;
    for (uint row = lane; row < unknownCount; row += 32u) {
        const float applied = vascularEquation(graph, microstep.time.x, row,
            base, directionBase, true, unknowns, compartments, connections,
            tissues, exchanges, connectionIncidence, connectionRanges,
            bloodExchangeIncidence, bloodExchangeRanges, tissueExchangeIncidence,
            tissueExchangeRanges, accepted, candidate, direction, elastance,
            workingSet, useWorkingSet != 0u, cavities, cavityFaces,
            compartmentCavity, femCandidate, femAccepted,
            environment * dispatch.femNodeCount, 0.0f).y;
        const bool constrainedFlow = row >= graph.offsets.y &&
            row < graph.offsets.z && useWorkingSet != 0u &&
            workingSet[base + row] != 0u;
        const float expected = constrainedFlow ? 0.0f : residual[directionBase + row].x;
        const float error = expected - applied;
        residualNorm2 += error * error;
        if (!isfinite(error)) {
            recordFailure(statuses[environment],
                NM_STATUS_LINEAR_SOLVER_FAILURE, NM_INVALID_INDEX,
                row, float4(error, applied, expected, 0.0f));
        }
    }
    residualNorm2 = simd_sum(residualNorm2);
    if (lane == 0u && environmentHealthy(statuses, environment)) {
        states[environment].diagnostics.x = sqrt(max(residualNorm2, 0.0f));
        states[environment].diagnostics.z = 1.0f;
        // `w` is the count of Krylov columns; the direct solve took none.
        states[environment].diagnostics.w = 0.0f;
    }
}
kernel void nm_vascular_operator(NM_VASCULAR_EQUATION_ARGUMENTS) {
    if (global >= dispatch.environmentCount * graph.ranges.z) return;
    const uint environment = global / graph.ranges.z;
    const uint local = global - environment * graph.ranges.z;
    output[layout.vascularBase + global] = float4(0.0f);
    if (!environmentHealthy(statuses, environment) || states[environment].diagnostics.z > 0.5f) return;
    const float value = NM_VASCULAR_EVALUATE(true).y;
    if (!isfinite(value)) {
        recordFailure(statuses[environment], NM_STATUS_NONLINEAR_SOLVER_FAILURE,
            NM_INVALID_INDEX, local, float4(value, 0.0f, 0.0f, 0.0f));
        return;
    }
    output[layout.vascularBase + global] = float4(value, 0.0f, 0.0f, 0.0f);
}
#undef NM_VASCULAR_EVALUATE
#undef NM_VASCULAR_EQUATION_ARGUMENTS

// Positive diagonal scaling for the pressure/volume/species mixed units.
// The nonsymmetric transport/compliance cross-block remains in the operator.
kernel void nm_vascular_precondition(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMVascularLayoutGPU& graph [[buffer(1)]],
    constant NMMicrostepGPU& microstep [[buffer(2)]],
    device const NMVascularUnknownGPU* unknowns [[buffer(3)]],
    device const NMVascularConnectionGPU* connections [[buffer(4)]],
    device const float4* basis [[buffer(5)]],
    device float4* preconditioned [[buffer(6)]],
    device const NMFGMRESStateGPU* states [[buffer(7)]],
    device const float4* candidate [[buffer(8)]],
    device const NMVascularTissueGPU* tissues [[buffer(9)]],
    device const NMVascularExchangeGPU* exchanges [[buffer(10)]],
    device const uint* connectionIncidence [[buffer(11)]],
    device const NMVascularRangeGPU* connectionRanges [[buffer(12)]],
    device const uint* bloodExchangeIncidence [[buffer(13)]],
    device const NMVascularRangeGPU* bloodExchangeRanges [[buffer(14)]],
    device const uint* tissueExchangeIncidence [[buffer(15)]],
    device const NMVascularRangeGPU* tissueExchangeRanges [[buffer(16)]],
    device NMMatterStatusGPU* statuses [[buffer(17)]],
    device const NMVascularCompartmentGPU* compartments [[buffer(18)]],
    device const float* elastance [[buffer(19)]],
    device const uint* workingSet [[buffer(20)]],
    device const NMVascularCavityGPU* cavities [[buffer(21)]],
    device const uint* compartmentCavity [[buffer(22)]],
    constant NMFGMRESLayoutGPU& layout [[buffer(30)]],
    uint global [[thread_position_in_grid]]) {
    if (global >= dispatch.environmentCount * graph.ranges.z) return;
    const uint environment = global / graph.ranges.z;
    const uint local = global - environment * graph.ranges.z;
    const uint row = layout.vascularBase + global;
    if (workingSet[global] != 0u) { preconditioned[row] = float4(0.0f); return; }
    float diagonal = unknowns[local].initialAndScaling.y / unknowns[local].initialAndScaling.z;
    if (local >= graph.offsets.y && local < graph.offsets.z) {
        const NMVascularConnectionGPU edge = connections[local - graph.offsets.y];
        if (edge.identity.w != 0u) {
            const uint stateBase = environment * graph.ranges.z;
            const uint coefficientBase = environment * graph.counts.x;
            const uint a = edge.identity.y, b = edge.identity.z;
            const float dp = vascularDrivingPressure(edge,
                vascularNodePressure(a, stateBase, coefficientBase, 0u, false, 0.0f, unknowns, compartments, cavities, compartmentCavity, candidate, candidate, elastance).x,
                vascularNodePressure(b, stateBase, coefficientBase, 0u, false, 0.0f, unknowns, compartments, cavities, compartmentCavity, candidate, candidate, elastance).x);
            const float q = vascularPhysical(candidate, unknowns, stateBase, local);
            const float flowPressure = unknowns[local].initialAndScaling.z /
                unknowns[local].initialAndScaling.y;
            if (edge.identity.w == 4u) {
                const float physicalDiagonal = vascularDirectionalResistance(edge, q, dp);
                // A zero physical diagonal is retained in Jv; this fallback is
                // normalized preconditioner scaling only, never resistance.
                diagonal *= physicalDiagonal > 0.0f ? physicalDiagonal : flowPressure;
            } else {
                const bool closedBranch = q * flowPressure <= vascularOpenEquation(edge, q, dp);
                // A closed zero-flow row is an exact active constraint. Eliminate
                // its tangent rather than allow Krylov roundoff to reverse flow.
                if (closedBranch && q == 0.0f) {
                    preconditioned[row] = float4(0.0f);
                    return;
                }
                // At opening Q=0, the physical diagonal is zero; use unit scaling
                // only as a preconditioner, preserving the exact coupled Jv.
                const float physicalDiagonal = closedBranch ? flowPressure :
                    vascularOpenDiagonal(edge, q);
                diagonal *= physicalDiagonal > 0.0f ? physicalDiagonal : flowPressure;
            }
        } else diagonal *= edge.physical.x + edge.physical.y / microstep.time.x;
    } else if (local >= graph.offsets.z && local < graph.cavities.z) {
        const bool blood = local < graph.offsets.w;
        const uint amount = local - (blood ? graph.offsets.z : graph.offsets.w);
        const uint reservoir = amount / graph.counts.z;
        const uint stateBase = environment * graph.ranges.z;
        float rate = 0.0f;
        if (blood) {
            const float volume = vascularPhysical(candidate, unknowns, stateBase, reservoir);
            const NMVascularRangeGPU range = connectionRanges[reservoir];
            for (uint slot = 0u; slot < range.count; ++slot) {
                const uint edgeIndex = connectionIncidence[range.first + slot];
                if (vascularConstrained(graph, stateBase, edgeIndex, workingSet, true)) continue;
                const NMVascularConnectionGPU edge = connections[edgeIndex];
                const float flow = vascularPhysical(candidate, unknowns,
                    stateBase, graph.offsets.y + edgeIndex);
                const uint donor = flow >= 0.0f ? edge.identity.y : edge.identity.z;
                if (donor == reservoir) rate += abs(flow) / volume;
            }
        }
        const NMVascularRangeGPU range = blood ? bloodExchangeRanges[amount] : tissueExchangeRanges[amount];
        for (uint slot = 0u; slot < range.count; ++slot) {
            const uint exchangeIndex = blood ? bloodExchangeIncidence[range.first + slot] :
                tissueExchangeIncidence[range.first + slot];
            const NMVascularExchangeGPU exchange = exchanges[exchangeIndex];
            const float capacity = blood ? vascularPhysical(candidate, unknowns,
                stateBase, exchange.identity.y) :
                tissues[exchange.identity.z].physical.x * exchange.physical.y;
            rate += exchange.physical.x / capacity;
        }
        diagonal *= 1.0f + microstep.time.x * rate;
    }
    // Geometry/pressure is a saddle-point row with a zero true diagonal.
    // Unit normalized scaling is only a preconditioner, not an invented law.
    if (local >= graph.cavities.z) diagonal = 1.0f;
    if (!isfinite(diagonal) || !(diagonal > 0.0f)) {
        preconditioned[row] = float4(0.0f);
        recordFailure(statuses[environment], NM_STATUS_NONLINEAR_SOLVER_FAILURE,
            NM_INVALID_INDEX, local, float4(diagonal, 0.0f, 0.0f, 0.0f));
        return;
    }
    preconditioned[row] = states[environment].diagnostics.z > 0.5f ? float4(0.0f) :
        float4(basis[row].x / diagonal, 0.0f, 0.0f, 0.0f);
}

// A free Newton direction crossing a unilateral valve bound selects that
// affine constraint and requests another solve without applying this iterate.
// Existing constrained directions contain their exact particular correction.
kernel void nm_vascular_resolve_working_set(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMVascularLayoutGPU& graph [[buffer(1)]],
    device const NMVascularConnectionGPU* connections [[buffer(2)]],
    device const float4* candidate [[buffer(3)]],
    device float4* solution [[buffer(4)]],
    device uint* workingSet [[buffer(5)]],
    device uint* changed [[buffer(6)]],
    device NMMatterStatusGPU* statuses [[buffer(7)]],
    device const NMVascularUnknownGPU* unknowns [[buffer(8)]],
    device const NMVascularCompartmentGPU* compartments [[buffer(9)]],
    device const float* elastance [[buffer(10)]],
    device const NMVascularCavityGPU* cavities [[buffer(11)]],
    device const uint* compartmentCavity [[buffer(12)]],
    constant NMFGMRESLayoutGPU& layout [[buffer(30)]],
    uint lane [[thread_index_in_threadgroup]],
    uint environment [[threadgroup_position_in_grid]]) {
    if (lane >= 32u || environment >= dispatch.environmentCount) return;
    bool activated = false;
    if (environmentHealthy(statuses, environment)) {
        for (uint edge = lane; edge < graph.counts.y; edge += 32u) {
            if (!vascularUnilateral(connections[edge])) continue;
            const uint row = environment * graph.ranges.z + graph.offsets.y + edge;
            const float q = candidate[row].x;
            if (!all(isfinite(solution[layout.vascularBase + row]))) {
                recordFailure(statuses[environment], NM_STATUS_LINEAR_SOLVER_FAILURE,
                    NM_INVALID_INDEX, graph.offsets.y + edge, solution[layout.vascularBase + row]);
                continue;
            }
            if (workingSet[row] != 0u) {
                // A completed constrained free solve may need no movement.
                // When Q=0 violates the pressure inequality at the current
                // and full trial states, release now; do not let an Armijo
                // rejection prevent a solved working set from being released.
                const uint a = connections[edge].identity.y, b = connections[edge].identity.z;
                const uint base = environment * graph.ranges.z;
                const uint eb = environment * graph.counts.x;
                const uint db = layout.vascularBase + base;
                const float dp = vascularDrivingPressure(connections[edge],
                    vascularNodePressure(a, base, eb, db, false, 0.0f, unknowns, compartments, cavities, compartmentCavity, candidate, solution, elastance).x,
                    vascularNodePressure(b, base, eb, db, false, 0.0f, unknowns, compartments, cavities, compartmentCavity, candidate, solution, elastance).x);
                const float nextDP = vascularDrivingPressure(connections[edge],
                    vascularNodePressure(a, base, eb, db, false, 1.0f, unknowns, compartments, cavities, compartmentCavity, candidate, solution, elastance).x,
                    vascularNodePressure(b, base, eb, db, false, 1.0f, unknowns, compartments, cavities, compartmentCavity, candidate, solution, elastance).x);
                if (q == 0.0f && isfinite(dp) && isfinite(nextDP) &&
                    dp > 0.0f && nextDP > 0.0f) {
                    workingSet[row] = 0u;
                    activated = true;
                } else solution[layout.vascularBase + row].x = -q;
            } else if (q + solution[layout.vascularBase + row].x < 0.0f) {
                workingSet[row] = 1u;
                activated = true;
            }
        }
    }
    const bool anyActivated = simd_any(activated);
    if (lane == 0u) changed[environment] = anyActivated ? 1u : 0u;
    threadgroup_barrier(mem_flags::mem_device);
    if (anyActivated) {
        // The discarded Newton direction must also be a no-op for every
        // mechanical line limiter, before any can reject its feasibility.
        bool finiteDirection = true;
        const uint nodeBase = environment * dispatch.femNodeCount;
        for (uint i = lane; i < dispatch.femNodeCount; i += 32u) {
            const uint field = dispatch.environmentCount * dispatch.femNodeCount + nodeBase + i;
            finiteDirection = finiteDirection && all(isfinite(solution[nodeBase + i])) && all(isfinite(solution[field]));
            solution[nodeBase + i] = float4(0.0f);
            solution[field] = float4(0.0f);
        }
        for (uint i = lane; i < dispatch.rigidGeneralizedCapacity; i += 32u) {
            const uint row = fgmresRigidIndex(dispatch, environment, i);
            finiteDirection = finiteDirection && all(isfinite(solution[row]));
            solution[row] = float4(0.0f);
        }
        for (uint i = lane; i < dispatch.mpmActiveNodeCapacity; i += 32u) {
            const uint row = fgmresMPMIndex(dispatch, environment, i);
            finiteDirection = finiteDirection && all(isfinite(solution[row]));
            solution[row] = float4(0.0f);
        }
        for (uint i = lane; i < layout.supportContactCount; i += 32u) {
            const uint row = layout.supportBase + environment * layout.supportContactCount + i;
            finiteDirection = finiteDirection && all(isfinite(solution[row]));
            solution[row] = float4(0.0f);
        }
        for (uint i = lane; i < graph.ranges.z; i += 32u) {
            const uint row = layout.vascularBase + environment * graph.ranges.z + i;
            finiteDirection = finiteDirection && all(isfinite(solution[row]));
            solution[row] = float4(0.0f);
        }
        if (!simd_all(finiteDirection) && lane == 0u)
            recordFailure(statuses[environment], NM_STATUS_LINEAR_SOLVER_FAILURE,
                NM_INVALID_INDEX, NM_INVALID_INDEX, float4(INFINITY, 0.0f, 0.0f, 0.0f));
    }
}

kernel void nm_vascular_limit_line_search(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMVascularLayoutGPU& graph [[buffer(1)]],
    device const float4* candidate [[buffer(2)]],
    device const float4* solution [[buffer(3)]],
    device float4* lineSearch [[buffer(4)]],
    device float* environmentLineSearch [[buffer(5)]],
    device NMMatterStatusGPU* statuses [[buffer(6)]],
    device const NMVascularCompartmentGPU* compartments [[buffer(7)]],
    device const NMVascularConnectionGPU* connections [[buffer(8)]],
    device const uint* workingSet [[buffer(9)]],
    device const uint* changed [[buffer(10)]],
    constant NMMicrostepGPU& microstep [[buffer(11)]],
    device const NMVascularUnknownGPU* unknowns [[buffer(12)]],
    device const float4* accepted [[buffer(13)]],
    device const NMVascularTissueGPU* tissues [[buffer(14)]],
    device const NMVascularExchangeGPU* exchanges [[buffer(15)]],
    device const uint* connectionIncidence [[buffer(16)]],
    device const NMVascularRangeGPU* connectionRanges [[buffer(17)]],
    device const uint* bloodExchangeIncidence [[buffer(18)]],
    device const NMVascularRangeGPU* bloodExchangeRanges [[buffer(19)]],
    device const uint* tissueExchangeIncidence [[buffer(20)]],
    device const NMVascularRangeGPU* tissueExchangeRanges [[buffer(21)]],
    device const float* elastance [[buffer(22)]],
    device float4* trial [[buffer(23)]],
    constant NMMixedSolverGPU& solver [[buffer(24)]],
    device const NMVascularCavityGPU* cavities [[buffer(25)]],
    device const NMVascularCavityFaceGPU* cavityFaces [[buffer(26)]],
    device const uint* compartmentCavity [[buffer(27)]],
    device const NMFEMNodeStateGPU* femCandidate [[buffer(28)]],
    device const NMFEMNodeStateGPU* femAccepted [[buffer(29)]],
    constant NMFGMRESLayoutGPU& layout [[buffer(30)]],
    uint lane [[thread_index_in_threadgroup]],
    uint environment [[threadgroup_position_in_grid]]) {
    if (lane >= 32u || environment >= dispatch.environmentCount) return;
    float alpha = environmentLineSearch[environment];
    for (uint local = lane; local < graph.ranges.z; local += 32u) {
        const uint row = environment * graph.ranges.z + local;
        const float value = candidate[row].x;
        const float correction = solution[layout.vascularBase + row].x;
        if (!vascularAdmissible(graph, local, value, compartments, connections, unknowns) || !isfinite(correction)) {
            alpha = 0.0f;
            recordFailure(statuses[environment], NM_STATUS_NONLINEAR_SOLVER_FAILURE,
                NM_INVALID_INDEX, local, float4(value, correction, 0.0f, 0.0f));
        } else {
            if (local < graph.offsets.y && compartments[local].identity.w == 3u && correction != 0.0f) {
                const float variableScale = unknowns[local].initialAndScaling.y;
                const float displacement = value * variableScale - compartments[local].compliance.x;
                const float maximum = compartments[local].pressureParameters.x;
                const float step = correction * variableScale;
                alpha = min(alpha, 0.99f * (correction > 0.0f ? maximum - displacement : maximum + displacement) / abs(step));
            }
            if (local >= graph.offsets.y && local < graph.offsets.z &&
                connections[local - graph.offsets.y].identity.w == 4u &&
                ((value > 0.0f && correction < 0.0f) || (value < 0.0f && correction > 0.0f))) {
                // Stop the *shared* Newton path at its first directional-law
                // breakpoint. Crossing an arbitrarily stiff reverse branch in
                // one trial need not satisfy Armijo, even for a linear storage
                // Schur block. Every mechanical/transport variable receives
                // the same alpha; no flow is clipped or projected separately.
                float breakpoint = -value / correction;
                if (breakpoint <= alpha) {
                    // A rounded quotient can leave Q + alpha*dQ on the old
                    // side. Advance only to the first adjacent representable
                    // common alpha that reaches the new side (or exact zero).
                    // Check the actual affine expression; if rounding cannot
                    // represent the crossing, fail rather than invent Q=0.
                    for (uint rounding = 0u; rounding < 2u; ++rounding) {
                        const float atBreakpoint = vascularDirectionalAffine(value, breakpoint, correction);
                        if (value > 0.0f ? atBreakpoint <= 0.0f : atBreakpoint >= 0.0f) break;
                        breakpoint = nextafter(breakpoint, INFINITY);
                    }
                    const float atBreakpoint = vascularDirectionalAffine(value, breakpoint, correction);
                    if (!(breakpoint > 0.0f) || !isfinite(breakpoint) ||
                        (value > 0.0f ? atBreakpoint > 0.0f : atBreakpoint < 0.0f)) {
                        alpha = 0.0f;
                        recordFailure(statuses[environment], NM_STATUS_NONLINEAR_SOLVER_FAILURE,
                            NM_INVALID_INDEX, local, float4(value, correction, breakpoint, 4.0f));
                    } else alpha = min(alpha, breakpoint);
                }
            }
            if (workingSet[row] == 0u && vascularPositiveVariable(graph, local, compartments, connections) && correction < 0.0f) {
            // Fraction to boundary preserves strict volume positivity and
            // never clips an amount or hides a failed Newton direction.
                alpha = min(alpha, 0.99f * value / -correction);
            }
        }
    }
    alpha = simd_min(alpha);
    if (graph.ranges.z != 0u && changed[environment] != 0u) alpha = 0.0f;
    // Positivity alone cannot globalize an opening valve: at Q=0 its
    // pressure-coupled Newton direction can overshoot the quadratic law.
    // Evaluate the original physical residual along the shared correction,
    // including the affine particular Q(alpha)=(1-alpha)*Q for constraints.
    // Trial storage is scratch and never an accepted state or second solve.
    if (graph.ranges.z != 0u && alpha > 0.0f &&
        environmentHealthy(statuses, environment)) {
        const uint base = environment * graph.ranges.z;
        const uint directionBase = layout.vascularBase + base;
        float initialMerit = 0.0f;
        for (uint local = lane; local < graph.ranges.z; local += 32u) {
            const float value = vascularEquation(graph, microstep.time.x, local, base,
                directionBase, false, unknowns, compartments, connections, tissues,
                exchanges, connectionIncidence, connectionRanges, bloodExchangeIncidence,
                bloodExchangeRanges, tissueExchangeIncidence, tissueExchangeRanges,
                accepted, candidate, solution, elastance, workingSet, false, cavities, cavityFaces,
                compartmentCavity, femCandidate, femAccepted, environment * dispatch.femNodeCount, 0.0f).x;
            initialMerit += value * value;
        }
        initialMerit = simd_sum(initialMerit);
        bool acceptedTrial = false;
        float trialMerit = INFINITY;
        const uint trials = max(solver.nonlinearIterations.w, 1u);
        for (uint attempt = 0u; attempt < trials; ++attempt) {
            for (uint local = lane; local < graph.ranges.z; local += 32u) {
                const uint row = base + local;
                const bool directional = local >= graph.offsets.y && local < graph.offsets.z &&
                    connections[local - graph.offsets.y].identity.w == 4u;
                const float value = workingSet[row] != 0u ?
                    (1.0f - alpha) * candidate[row].x :
                    (directional ? vascularDirectionalAffine(candidate[row].x, alpha, solution[directionBase + local].x) :
                        candidate[row].x + alpha * solution[directionBase + local].x);
                trial[row] = float4(value, 0.0f, 0.0f, 0.0f);
            }
            threadgroup_barrier(mem_flags::mem_device);
            float merit = 0.0f;
            bool admissible = true;
            bool certified = true;
            for (uint local = lane; local < graph.ranges.z; local += 32u) {
                const float value = vascularEquation(graph, microstep.time.x, local, base,
                    directionBase, false, unknowns, compartments, connections, tissues,
                    exchanges, connectionIncidence, connectionRanges, bloodExchangeIncidence,
                    bloodExchangeRanges, tissueExchangeIncidence, tissueExchangeRanges,
                    accepted, trial, solution, elastance, workingSet, false, cavities, cavityFaces,
                    compartmentCavity, femCandidate, femAccepted, environment * dispatch.femNodeCount, alpha).x;
                admissible = admissible && isfinite(value) &&
                    vascularAdmissible(graph, local, trial[base + local].x, compartments, connections, unknowns);
                certified = certified && abs(value) <= unknowns[local].initialAndScaling.w;
                merit += value * value;
            }
            trialMerit = simd_sum(merit);
            acceptedTrial = simd_all(admissible) && isfinite(trialMerit) &&
                (simd_all(certified) || trialMerit <=
                    (1.0f - solver.globalization.x * alpha) * initialMerit);
            threadgroup_barrier(mem_flags::mem_device);
            if (acceptedTrial) break;
            alpha *= 0.5f;
        }
        if (!acceptedTrial) {
            if (lane == 0u) recordFailure(statuses[environment], NM_STATUS_NONLINEAR_SOLVER_FAILURE,
                NM_INVALID_INDEX, NM_INVALID_INDEX, float4(alpha, initialMerit, trialMerit, float(trials)));
            alpha = 0.0f;
        }
    }
    if (lane == 0u) {
        environmentLineSearch[environment] = alpha;
        if ((graph.ranges.z == 0u || changed[environment] == 0u) &&
            environmentHealthy(statuses, environment) &&
            (!(alpha > 0.0f) || !isfinite(alpha)))
            recordFailure(statuses[environment], NM_STATUS_NONLINEAR_SOLVER_FAILURE,
                NM_INVALID_INDEX, NM_INVALID_INDEX, float4(alpha, 0.0f, 0.0f, 0.0f));
    }
    for (uint object = lane; object < dispatch.objectCount; object += 32u)
        lineSearch[environment * dispatch.objectCount + object].x = alpha;
}
kernel void nm_vascular_apply_solution(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMVascularLayoutGPU& graph [[buffer(1)]],
    device const float4* solution [[buffer(2)]],
    device const float* alpha [[buffer(3)]],
    device float4* candidate [[buffer(4)]],
    device const NMMatterStatusGPU* statuses [[buffer(5)]],
    device uint* workingSet [[buffer(6)]],
    device const uint* changed [[buffer(7)]],
    device const NMVascularConnectionGPU* connections [[buffer(8)]],
    constant NMFGMRESLayoutGPU& layout [[buffer(30)]],
    uint global [[thread_position_in_grid]]) {
    if (global >= dispatch.environmentCount * graph.ranges.z) return;
    const uint environment = global / graph.ranges.z;
    if (!environmentHealthy(statuses, environment) || changed[environment] != 0u) return;
    if (workingSet[global] != 0u) {
        candidate[global].x *= 1.0f - alpha[environment];
        if (alpha[environment] > 0.0f) workingSet[global] = 2u;
    } else {
        const uint local = global - environment * graph.ranges.z;
        const bool directional = local >= graph.offsets.y && local < graph.offsets.z &&
            connections[local - graph.offsets.y].identity.w == 4u;
        candidate[global].x = directional ?
            vascularDirectionalAffine(candidate[global].x, alpha[environment], solution[layout.vascularBase + global].x) :
            candidate[global].x + alpha[environment] * solution[layout.vascularBase + global].x;
    }
}
kernel void nm_vascular_certify(
    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
    constant NMVascularLayoutGPU& graph [[buffer(1)]],
    device const NMVascularUnknownGPU* unknowns [[buffer(2)]],
    device const float4* candidate [[buffer(3)]],
    device const float4* residual [[buffer(4)]],
    device NMMatterStatusGPU* statuses [[buffer(5)]],
    device const NMVascularCompartmentGPU* compartments [[buffer(6)]],
    device const NMVascularConnectionGPU* connections [[buffer(7)]],
    constant NMFGMRESLayoutGPU& layout [[buffer(30)]],
    uint global [[thread_position_in_grid]]) {
    if (global >= dispatch.environmentCount * graph.ranges.z) return;
    const uint environment = global / graph.ranges.z;
    const uint local = global - environment * graph.ranges.z;
    if (!environmentHealthy(statuses, environment)) return;
    const float value = abs(residual[layout.vascularBase + global].x);
    const float tolerance = unknowns[local].initialAndScaling.w;
    if (!isfinite(value) || value > tolerance || !vascularAdmissible(graph, local, candidate[global].x, compartments, connections, unknowns))
        recordFailure(statuses[environment], NM_STATUS_NONLINEAR_SOLVER_FAILURE,
            NM_INVALID_INDEX, local, float4(value, tolerance, candidate[global].x, 0.0f));
}

