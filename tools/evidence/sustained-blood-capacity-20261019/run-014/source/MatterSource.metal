inline bool humanPreSourceRigidCorrection(
    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch,
    device const NMNumiHumanTendonFEMEndpointReplacementGPU* replacements,
    device const MRNumiHumanTendonBindingGPU* bindings,
    device const MRNumiHumanTendonTransferResultGPU* transfers,
    device const MRArticulatedBodyPoseGPU* bodyPoses,
    device const float* pointJacobians,
    device const float* generalizedForces,
    device const NMNumiHumanBodyWrenchGPU* articularBodyWrenches,
    device const NMNumiHumanPassiveLigamentGPU* passiveLigaments,
    device const NMNumiHumanBodyWrenchGPU* femBodyContactWrenches,
    device const NMNumiHumanPassiveRoutedBandGPU* passiveRoutedBands,
    const uint environment,
    const uint dof,
    thread float& correction
) {
    correction = 0.0f;
    for (uint index = 0u; index < dispatch.replacementCount; ++index) {
        const NMNumiHumanTendonFEMEndpointReplacementGPU replacement =
            replacements[index];
        const bool fullMuscleRow = (replacement.flags &
            NM_NUMI_HUMAN_TENDON_FEM_ENDPOINT_REPLACEMENT_FULL_MUSCLE_ROW) != 0u;
        const uint endpointIndex = fullMuscleRow
            ? replacement.loadEndpointIndex
            : replacement.anchorEndpointIndex;
        const MRNumiHumanTendonBindingGPU endpoint = bindings[endpointIndex];
        const MRNumiHumanTendonTransferResultGPU transfer = transfers[
            environment * dispatch.transferStride + endpointIndex
        ];
        const uint localBody =
            endpoint.bodyIndex - dispatch.articulationFirstBody;
        const MRArticulatedBodyPoseGPU pose = bodyPoses[
            environment * dispatch.bodyPoseStride + localBody
        ];
        const float3 worldPoint = pose.position.xyz + humanQuaternionRotate(
            pose.orientation, endpoint.sourceLocalPoint.xyz
        );
        const float endpointEffort = dot(
            transfer.terminalWorldForce.xyz,
            humanPointJacobian(
                environment, dof, dispatch, bodyPoses, pointJacobians,
                endpoint.bodyIndex, worldPoint
            )
        );
        if (fullMuscleRow) {
            const uint rowIndex =
                (environment * dispatch.muscleCount + endpoint.muscleIndex) *
                    dispatch.dofCount + dof;
            correction += replacement.forceOwnerFraction.x *
                (endpointEffort - generalizedForces[rowIndex]);
        } else {
            correction -=
                replacement.forceOwnerFraction.x * endpointEffort;
        }
    }
    if (dispatch.articularContactSampleCount > 0u) {
        for (uint localBody = 0u; localBody < dispatch.bodyPoseStride;
             ++localBody) {
            const NMNumiHumanBodyWrenchGPU wrench = articularBodyWrenches[
                environment * dispatch.bodyPoseStride + localBody];
            if (!finite4(wrench.force) || !finite4(wrench.torque)) return false;
            const uint bodyIndex = dispatch.articulationFirstBody + localBody;
            const MRArticulatedBodyPoseGPU pose = bodyPoses[
                environment * dispatch.bodyPoseStride + localBody];
            correction += dot(
                wrench.force.xyz,
                humanPointJacobian(
                    environment, dof, dispatch, bodyPoses, pointJacobians,
                    bodyIndex, pose.position.xyz));
            correction += dot(
                wrench.torque.xyz,
                humanAngularJacobian(
                    environment, dof, dispatch, bodyPoses, pointJacobians,
                    bodyIndex));
        }
    }
    if (dispatch.femBodyContactSampleCount > 0u) {
        for (uint localBody = 0u; localBody < dispatch.bodyPoseStride;
             ++localBody) {
            const NMNumiHumanBodyWrenchGPU wrench = femBodyContactWrenches[
                environment * dispatch.bodyPoseStride + localBody];
            if (!finite4(wrench.force) || !finite4(wrench.torque)) return false;
            const uint bodyIndex = dispatch.articulationFirstBody + localBody;
            const MRArticulatedBodyPoseGPU pose = bodyPoses[
                environment * dispatch.bodyPoseStride + localBody];
            correction += dot(
                wrench.force.xyz,
                humanPointJacobian(
                    environment, dof, dispatch, bodyPoses, pointJacobians,
                    bodyIndex, pose.position.xyz));
            correction += dot(
                wrench.torque.xyz,
                humanAngularJacobian(
                    environment, dof, dispatch, bodyPoses, pointJacobians,
                    bodyIndex));
        }
    }
    for (uint index = 0u; index < dispatch.passiveLigamentCount; ++index) {
        const NMNumiHumanPassiveLigamentGPU ligament = passiveLigaments[index];
        float3 firstPoint;
        float3 secondPoint;
        float3 firstForce;
        float stretch;
        float tension;
        if (!passiveLigamentState(
                environment, dispatch, bodyPoses, ligament, firstPoint,
                secondPoint, firstForce, stretch, tension)) return false;
        correction += dot(
            firstForce,
            humanPointJacobian(
                environment, dof, dispatch, bodyPoses, pointJacobians,
                ligament.firstBodyIndex, firstPoint));
        correction += dot(
            -firstForce,
            humanPointJacobian(
                environment, dof, dispatch, bodyPoses, pointJacobians,
                ligament.secondBodyIndex, secondPoint));
    }
    for (uint index = 0u; index < dispatch.passiveRoutedBandCount; ++index) {
        const NMNumiHumanPassiveRoutedBandGPU band = passiveRoutedBands[index];
        float3 originPoint;
        float3 pulleyPoint;
        float3 insertionPoint;
        float3 originForce;
        float3 pulleyForce;
        float3 insertionForce;
        float3 pulleyTorque;
        float3 insertionTorque;
        float strain;
        float tension;
        float extension;
        float storedEnergy;
        if (!passiveRoutedBandState(
                environment, dispatch, bodyPoses, band, originPoint,
                pulleyPoint, insertionPoint, originForce, pulleyForce,
                insertionForce, pulleyTorque, insertionTorque, strain,
                tension, extension, storedEnergy)) return false;
        correction += dot(
            originForce,
            humanPointJacobian(
                environment, dof, dispatch, bodyPoses, pointJacobians,
                band.originBodyIndex, originPoint));
        correction += dot(
            pulleyForce,
            humanPointJacobian(
                environment, dof, dispatch, bodyPoses, pointJacobians,
                band.pulleyBodyIndex, pulleyPoint));
        correction += dot(
            insertionForce,
            humanPointJacobian(
                environment, dof, dispatch, bodyPoses, pointJacobians,
                band.insertionBodyIndex, insertionPoint));
        correction += dot(
            pulleyTorque,
            humanAngularJacobian(
                environment, dof, dispatch, bodyPoses, pointJacobians,
                band.pulleyBodyIndex));
        correction += dot(
            insertionTorque,
            humanAngularJacobian(
                environment, dof, dispatch, bodyPoses, pointJacobians,
                band.insertionBodyIndex));
    }
    return isfinite(correction);
}

kernel void nm_numi_human_apply_fem_anchor_reactions(
    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch [[buffer(0)]],
    device const NMNumiHumanTendonFEMNodeAnchorGPU* nodeAnchors [[buffer(1)]],
    device const NMNumiHumanTendonFEMEndpointReplacementGPU* replacements [[buffer(2)]],
    device const MRNumiHumanTendonBindingGPU* bindings [[buffer(3)]],
    device const MRNumiHumanTendonTransferResultGPU* transfers [[buffer(4)]],
    device const float4* constraintReactions [[buffer(5)]],
    device const NMMatterStatusGPU* matterStatuses [[buffer(6)]],
    device const MRArticulatedBodyPoseGPU* bodyPoses [[buffer(7)]],
    device const float* pointJacobians [[buffer(8)]],
    device float* generalizedForces [[buffer(9)]],
    device const NMNumiHumanBodyWrenchGPU* articularBodyWrenches [[buffer(10)]],
    device const NMNumiHumanPassiveLigamentGPU* passiveLigaments [[buffer(11)]],
    device const NMNumiHumanBodyWrenchGPU* femBodyContactWrenches [[buffer(12)]],
    device const NMNumiHumanPassiveRoutedBandGPU* passiveRoutedBands
        [[buffer(13)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.dofCount;
    if (global >= total) return;
    const uint environment = global / dispatch.dofCount;
    const uint dof = global - environment * dispatch.dofCount;
    if (matterStatuses[environment].code != NM_STATUS_SUCCESS) return;
    float correction = 0.0f;
    if (!humanPreSourceRigidCorrection(
            dispatch, replacements, bindings, transfers, bodyPoses,
            pointJacobians, generalizedForces, articularBodyWrenches,
            passiveLigaments, femBodyContactWrenches, passiveRoutedBands,
            environment, dof, correction)) return;
    const uint reactionBase = environment * dispatch.femNodeCount;
    for (uint node = 0u; node < dispatch.femNodeCount; ++node) {
        const NMNumiHumanTendonFEMNodeAnchorGPU anchor = nodeAnchors[node];
        if ((anchor.flags & NM_NUMI_HUMAN_TENDON_FEM_NODE_ANCHOR_ACTIVE) == 0u)
            continue;
        const uint localBody = anchor.bodyIndex - dispatch.articulationFirstBody;
        const MRArticulatedBodyPoseGPU pose = bodyPoses[
            environment * dispatch.bodyPoseStride + localBody
        ];
        const float3 worldPoint = pose.position.xyz +
            humanQuaternionRotate(pose.orientation, anchor.localPoint.xyz);
        const float3 reaction = constraintReactions[reactionBase + node].xyz;
        correction += dot(
            reaction,
            humanPointJacobian(
                environment, dof, dispatch, bodyPoses, pointJacobians,
                anchor.bodyIndex, worldPoint
            )
        );
    }
    if (!isfinite(correction)) return;
    const uint forceIndex = environment * dispatch.generalizedForceStride +
        dispatch.generalizedForceOffset + dof;
    generalizedForces[forceIndex] += correction;
}

// Deferred NumanX mode applies only source-row replacement and reduced rigid
// forces known before Matter. Fixed-node reactions stay inside Matter's
// generic coupled Human attachments and return once through the NumanX staged
// generalized reaction.
kernel void nm_numi_human_apply_pre_source_rigid_corrections(
    constant NMNumiHumanTendonFEMLoadDispatchGPU& dispatch [[buffer(0)]],
    device const NMNumiHumanTendonFEMEndpointReplacementGPU* replacements
        [[buffer(1)]],
    device const MRNumiHumanTendonBindingGPU* bindings [[buffer(2)]],
    device const MRNumiHumanTendonTransferResultGPU* transfers [[buffer(3)]],
    device const MRArticulatedBodyPoseGPU* bodyPoses [[buffer(4)]],
    device const float* pointJacobians [[buffer(5)]],
    device float* generalizedForces [[buffer(6)]],
    device const NMNumiHumanBodyWrenchGPU* articularBodyWrenches [[buffer(7)]],
    device const NMNumiHumanPassiveLigamentGPU* passiveLigaments [[buffer(8)]],
    device const NMNumiHumanBodyWrenchGPU* femBodyContactWrenches [[buffer(9)]],
    device const NMNumiHumanPassiveRoutedBandGPU* passiveRoutedBands
        [[buffer(10)]],
    device const MRMetalWorldStatusGPU* validationStatuses [[buffer(11)]],
    uint global [[thread_position_in_grid]]
) {
    const uint total = dispatch.environmentCount * dispatch.dofCount;
    if (global >= total) return;
    const uint environment = global / dispatch.dofCount;
    const uint dof = global - environment * dispatch.dofCount;
    const MRMetalWorldStatusGPU validation = validationStatuses[environment];
    if (validation.code != MR_STEP_SUCCESS ||
        validation.environment != environment ||
        validation.controlStep != dispatch.stepIndex ||
        validation.successfulSubsteps != 1u) return;
    float correction = 0.0f;
    if (!humanPreSourceRigidCorrection(
            dispatch, replacements, bindings, transfers, bodyPoses,
            pointJacobians, generalizedForces, articularBodyWrenches,
            passiveLigaments, femBodyContactWrenches, passiveRoutedBands,
            environment, dof, correction)) return;
    const uint forceIndex = environment * dispatch.generalizedForceStride +
        dispatch.generalizedForceOffset + dof;
    generalizedForces[forceIndex] += correction;
}

