        }
        case NM_EXPR_POW_INTEGER: {
            const auto a=pop();const int exponent=instruction.integer;
            const float value=a.high+a.low;
            if(exponent<0&&!(value>1e-12f||value<-1e-12f)) {valid=false;break;}
