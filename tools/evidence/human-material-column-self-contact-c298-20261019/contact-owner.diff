@@ -1249,8 +1249,24 @@
             if (leftNode >= dispatch.femNodeCount ||
                 rightNode >= dispatch.femNodeCount) continue;
             const uint base = environment * dispatch.femNodeCount;
-            if (topologyNodes[base + leftNode].identity.x ==
