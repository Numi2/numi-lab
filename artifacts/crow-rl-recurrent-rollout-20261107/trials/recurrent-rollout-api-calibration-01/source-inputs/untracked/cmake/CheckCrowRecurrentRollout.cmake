if(NOT DEFINED PROGRAM OR NOT DEFINED SWIFT_PROGRAM OR NOT DEFINED OUTPUT_PARENT OR NOT DEFINED OLD_METALLIB)
    message(FATAL_ERROR "Recurrent rollout check needs native/Swift programs, OUTPUT_PARENT and OLD_METALLIB")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef trial_id)
set(trial "${OUTPUT_PARENT}/crow-recurrent-rollout-${trial_id}")
file(MAKE_DIRECTORY "${trial}")
execute_process(COMMAND "${PROGRAM}" "${trial}/native" "${OLD_METALLIB}"
    RESULT_VARIABLE result OUTPUT_VARIABLE evidence ERROR_VARIABLE failure TIMEOUT 180)
file(WRITE "${trial}/native.stdout" "${evidence}")
file(WRITE "${trial}/native.stderr" "${failure}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Native recurrent rollout check failed; evidence ${trial}: ${failure}")
endif()
execute_process(COMMAND "${SWIFT_PROGRAM}" "${trial}/native" "${trial}/swift"
    RESULT_VARIABLE result OUTPUT_VARIABLE evidence ERROR_VARIABLE failure TIMEOUT 180)
file(WRITE "${trial}/swift.stdout" "${evidence}")
file(WRITE "${trial}/swift.stderr" "${failure}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Swift recurrent rollout check failed; evidence ${trial}: ${failure}")
endif()
message(STATUS "${evidence} Evidence retained at ${trial}")
